MODULE WBOrdersElectronics;

REQUIRE WBOrders;

NAMESPACE WB;

EXTEND CLASS OrderMeta {
    imei 'IMEI'
}

apiMetaPath(OrderMeta m) += WHEN m == OrderMeta.imei THEN 'imei';
apiMetaBodyKey(OrderMeta m) += WHEN m == OrderMeta.imei THEN 'imei';
apiMetaBatchKey(OrderMeta m) += WHEN m == OrderMeta.imei THEN 'imei';