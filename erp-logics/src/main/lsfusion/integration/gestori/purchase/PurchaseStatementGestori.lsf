MODULE PurchaseStatementGestori;

REQUIRE PurchaseLedger, PurchaseInvoice, PurchaseReturnInvoice, SaleReportsGestory, PriceListContract;

NAMESPACE Purchase;

incomeIsReturn (PurchaseLedger l) = l IS PurchaseReturn.InvoiceDetail;

incomeQuantity 'Количество закупаемого товара' (PurchaseLedger l) = quantity(l) IF NOT incomeIsReturn(l);
incomeSum 'Сумма прихода по закупочной цене' (PurchaseLedger l) = sum(l) IF NOT incomeIsReturn(l);
incomeCostSum 'Сумма прихода по бух. себестоимости' (PurchaseLedger l) =
    NUMERIC[18,4](SaleReports.priceSku(sku(l), stock(l), date(l)) * quantity(l)) IF NOT incomeIsReturn(l);

returnQuantity 'Количество возврата поставщику' (PurchaseLedger l) = quantity(l) IF incomeIsReturn(l);
returnSum 'Сумма возврата по цене возврата' (PurchaseLedger l) = sum(l) IF incomeIsReturn(l);
returnSumWtVAT 'Сумма возврата по цене возврата без НДС' (PurchaseLedger l) =
    (sum(l) (-) sumVAT(l)) IF incomeIsReturn(l);

incomeSpecificationDetail = GROUP LAST PriceListDetail d
    ORDER fromDateTime(d), d
    WHERE isPosted(d) AND fromDateTime(d) <= DATETIME dateTime AND in(priceList(d), Stock st)
        AND operation(priceList(d)) == PriceList.operation('supplier')
    BY sku(d), st, dateTime;

incomeSpecification (PurchaseLedger l) = incomeSpecificationDetail(sku(l), stock(l), dateTime(l));

incomeSpecNumber 'Номер спецификации' (PurchaseLedger l) = number(priceList(incomeSpecification(l)));
incomeSpecName 'Наименование спецификации' (PurchaseLedger l) = nameOperation(priceList(incomeSpecification(l)));
incomeContractNumber 'Номер договора' (PurchaseLedger l) = seriesNumberContractSku(incomeSpecification(l));

incomeShowRow (PurchaseLedger l) = isPosted(l) AND (l IS Purchase.InvoiceDetail OR incomeIsReturn(l));

incomeInterval (PurchaseLedger l) = SaleReports.filterFrom() <= date(l) AND SaleReports.filterTo() >= date(l);

incomePassesStock (PurchaseLedger l) = SaleReports.passesReportStockFilterStock(stock(l));
incomePassesSku (PurchaseLedger l) = SaleReports.passesReportSkuFilterSku(sku(l));
incomePassesSupplier (PurchaseLedger l) = NOT SaleReports.inSaleReportSupplier() OR SaleReports.inSupplier(supplier(l));

initIncomeStatement() {
    SaleReports.filterFrom() <- currentDate();
    SaleReports.filterTo() <- currentDate();
}

FORM incomeStatementGestori 'Ведомость приходов'
    PROPERTIES incomeDateFrom 'Дата (с)' = SaleReports.filterFrom(), incomeDateTo 'Дата (по)' = SaleReports.filterTo()
    PROPERTIES incomeStockList = SaleReports.nameStockList() READONLY SHOWIF SaleReports.stockList()
    PROPERTIES incomeStocks 'Подразделения' = SaleReports.inSaleReportStocks() ON CHANGE Inventory.changeStocksInventory() READONLYIF SaleReports.stockList()
    PROPERTIES incomeLegalEntityList = SaleReports.nameLegalEntityList() READONLY SHOWIF SaleReports.legalEntityList()
    PROPERTIES incomeSuppliers 'Поставщики' = SaleReports.inSaleReportSupplier() ON CHANGE { DIALOG SaleReports.dialogLegalEntitiesSupplier; } READONLYIF SaleReports.legalEntityList()
    PROPERTIES incomeSkuLists = Inventory.nameSkuLists() READONLY SHOWIF Inventory.anySkuList()
    PROPERTIES incomeSkuGroups 'Товарные группы' = Inventory.selectedSkuGroups() READONLY SHOWIF Inventory.anySkuGroup()
    PROPERTIES incomeSkus 'Товары' = Inventory.inSkus() ON CHANGE Inventory.selectSkus() READONLYIF Inventory.anySkuList() OR Inventory.anySkuGroup()

    OBJECTS l = PurchaseLedger
    PROPERTIES(l) READONLY numberDocument, date, seriesNumberDocument, shipmentDate
    PROPERTIES READONLY codeNameSupplier 'Код и наименование поставщика' = (CONCAT ' ', id(supplier(l)), nameSupplier(l)),
        idStockIncome 'Код подразделения' = id(stock(l))
    PROPERTIES(l) READONLY incomeContractNumber, incomeSpecNumber, incomeSpecName, idSku, nameSku
    PROPERTIES READONLY brandIncome 'Бренд' = nameBrand(sku(l)),
        manufacturerIncome 'Производитель' = nameManufacturer(sku(l))
    PROPERTIES(l) READONLY incomeQuantity, valueVAT, incomeCostSum, incomeSum,
        returnQuantity, returnSumWtVAT, returnSum
    PROPERTIES(l) READONLY nameOperation

    ORDERS idStockIncome, date(l), numberDocument(l), nameSku(l)
    FILTERS incomeShowRow(l),
        incomeInterval(l),
        incomePassesStock(l),
        incomePassesSku(l),
        incomePassesSupplier(l)

    EVENTS ON INIT initIncomeStatement()
;

@definePrintReport(incomeStatementGestori, 'Ведомость приходов');

EXTEND FORM incomeStatementGestori
    PROPERTIES() DISABLEIF NOT SaleReports.filterFrom() OR NOT SaleReports.filterTo() incomeStatementGestori
;

DESIGN incomeStatementGestori {
    NEW filters FIRST {
        alignment = STRETCH;
        NEW topRow {
            horizontal = TRUE;
            MOVE PROPERTY(incomeDateFrom);
            MOVE PROPERTY(incomeDateTo);
            MOVE PROPERTY(incomeStatementGestori()) { valueClass = 'btn-primary'; }
        }
        MOVE PROPERTY(incomeStockList) { alignment = STRETCH; }
        MOVE PROPERTY(incomeStocks) { alignment = STRETCH; }
        MOVE PROPERTY(incomeLegalEntityList) { alignment = STRETCH; }
        MOVE PROPERTY(incomeSuppliers) { alignment = STRETCH; }
        MOVE PROPERTY(incomeSkuLists) { alignment = STRETCH; }
        MOVE PROPERTY(incomeSkuGroups) { alignment = STRETCH; }
        MOVE PROPERTY(incomeSkus) { alignment = STRETCH; }
    }
}

NAVIGATOR {
    purchasesReports {
        NEW incomeStatementGestori;
    }
}
