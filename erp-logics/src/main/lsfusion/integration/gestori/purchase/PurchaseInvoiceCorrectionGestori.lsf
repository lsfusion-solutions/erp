MODULE PurchaseInvoiceCorrectionGestori;

REQUIRE PurchaseInvoiceCorrection, PurchaseInvoiceGestori;

NAMESPACE Purchase;

// ---- Суммы факт (по Количество поставлено) ----

shipmentVATSum[PurchaseLedger] (InvoiceCorrectionDetail d) += VATSum(d);
shipmentInvoiceSum[PurchaseLedger] (InvoiceCorrectionDetail d) += OVERRIDE overInvoiceSum(d), invoiceSum(d);
