MODULE SkuLedgerLotGestori;

REQUIRE SkuLedgerLot;

NAMESPACE Stock;

notActiveSkuBalance = GROUP SUM signedQuantity(SkuLedger ledger, Lot lot) IF NOT active(ledger) BY lot, stock(ledger) CHARWIDTH 7;
availableQuantity 'Доступный остаток' (Lot l, Stock st) = currentBalance(l, st) (+) notActiveSkuBalance(l, st);

availableQuantity 'Доступный остаток' (Lot l) = GROUP SUM availableQuantity(l, Stock st);

// марки, для которых доступный остаток при сохранении документа не проверяется (правила задаёт внедрение)
skipAvailableQuantity = ABSTRACT VALUE BOOLEAN (Lot);

EXTEND FORM lots
    PROPERTIES(l) READONLY availableQuantity
    
    FILTERGROUP lotBalance
        FILTER 'С остатком' currentBalance(l)
        FILTER 'С положительным остатком' currentBalance(l) > 0
        FILTER 'С отрицательным остатком' currentBalance(l) < 0
;

// ---- Подбор партии по маркам расхода ----

quantityLotBatch 'Марок из партии' (OutFIFOSkuLedger l, Batch b) =
    GROUP SUM NUMERIC[16,5](-signedQuantity(l, Lot lt) * count(lt)) IF batch(lt) = b;

order(OutFIFOSkuLedger l, Batch b) += (IF quantityLotBatch(l, b) THEN 1L ELSE 2L) IF (GROUP SUM quantityLotBatch(l, Batch bb)) AND b IS Batch;
reserve(Batch b, OutFIFOSkuLedger l) += NUMERIC[16,5](currentBalance(b, stock(l)) - quantityLotBatch(l, b)) IF currentBalance(b, stock(l)) > quantityLotBatch(l, b);
