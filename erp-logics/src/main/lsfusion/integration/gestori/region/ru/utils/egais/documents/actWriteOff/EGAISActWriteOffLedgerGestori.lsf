MODULE EGAISActWriteOffLedgerGestori;

REQUIRE EGAISActWriteOffLedger, EGAISFRegLedgerGestori, EGAISActWriteOffGestori, EGAISActWriteOffExchange;

NAMESPACE EGAIS;

stock(ActWriteOffPosition l) += stockOriginalDocument(l);
typeOriginalDocument(ActWriteOffPosition l) += typeOriginalDocument(l);
numberOriginalDocument(ActWriteOffPosition l) += numberOriginalDocument(l);
dateOriginalDocument(ActWriteOffPosition l)  += dateOriginalDocument(l);

dateTimeOutDoc(ActWriteOffPosition l) += dateTimeTicket(actWriteOffOutDoc(actWriteOff(l)));