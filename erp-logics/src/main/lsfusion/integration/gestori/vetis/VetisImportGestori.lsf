MODULE VetisImportGestori;

REQUIRE ImportGestoriSettings, VetisBusinessEntity, VetisBusinessEntityOwn, VetisEnterprise,
        VetisProductItem, VetisProductItemExport, VetisStockEntry, VetisDocument, VetisStock,
        VetisItem, VetisDocumentGestori;

NAMESPACE Vetis;

// --- Строка подключения (переиспользуем Gestori) ---

vetisDbUrl() = ImportGestori.connectionString();

// коды складов Gestori через запятую; если не заданы, записи журнала и ВСД импортируются по всем складам
vetisInitImportStocks 'Коды складов (записи журнала, ВСД)' = DATA STRING[500] ();
vetisInitImportStockCodes () = rtrim(ltrim(replace(vetisInitImportStocks(), ' ', ''), ','), ',');

// --- Локальные переменные для MercFirm ---

firmLocalGuid = DATA LOCAL STRING(INTEGER);
firmLocalName = DATA LOCAL STRING(INTEGER);
firmLocalInn = DATA LOCAL STRING(INTEGER);
firmLocalKpp = DATA LOCAL STRING(INTEGER);
firmLocalType = DATA LOCAL STRING(INTEGER);

// --- Локальные переменные для MercArea ---

areaLocalGuidFirm = DATA LOCAL STRING(INTEGER);
areaLocalGuid = DATA LOCAL STRING(INTEGER);
areaLocalName = DATA LOCAL STRING(INTEGER);
areaLocalCodFirm = DATA LOCAL STRING(INTEGER);

// --- Локальные переменные для MercItemProd ---

itemLocalGuidSubProd = DATA LOCAL STRING(INTEGER);
itemLocalGuidItemProd = DATA LOCAL STRING(INTEGER);
itemLocalUuidItemProd = DATA LOCAL STRING(INTEGER);
itemLocalGuidFirmProducer = DATA LOCAL STRING(INTEGER);
itemLocalGuidFirmOwner = DATA LOCAL STRING(INTEGER);
itemLocalName = DATA LOCAL STRING(INTEGER);
itemLocalCode = DATA LOCAL STRING(INTEGER);
itemLocalGtin = DATA LOCAL STRING(INTEGER);
itemLocalCodGood = DATA LOCAL NUMERIC[13,0](INTEGER);

// --- Локальные переменные для MercRestShop ---

seLocalGuidShop = DATA LOCAL STRING(INTEGER);
seLocalGuid = DATA LOCAL STRING(INTEGER);
seLocalNumber = DATA LOCAL STRING(INTEGER);
seLocalVolume = DATA LOCAL NUMERIC[16,5](INTEGER);
seLocalCodGood = DATA LOCAL NUMERIC[13,0](INTEGER);

// --- Локальные переменные для MercVetDoc ---

vetLocalUuid = DATA LOCAL STRING(INTEGER);
vetLocalIssueDate = DATA LOCAL DATE(INTEGER);
vetLocalStatus = DATA LOCAL STRING(INTEGER);
vetLocalType = DATA LOCAL STRING(INTEGER);
vetLocalGuidConsignorFirm = DATA LOCAL STRING(INTEGER);
vetLocalGuidConsignorArea = DATA LOCAL STRING(INTEGER);
vetLocalGuidConsigneeFirm = DATA LOCAL STRING(INTEGER);
vetLocalGuidConsigneeArea = DATA LOCAL STRING(INTEGER);
vetLocalGuidItemProd = DATA LOCAL STRING(INTEGER);
vetLocalVolume = DATA LOCAL NUMERIC[16,5](INTEGER);
vetLocalGuidStockEntry = DATA LOCAL STRING(INTEGER);
vetLocalQuantity = DATA LOCAL NUMERIC[16,5](INTEGER);
vetLocalGuidMeas = DATA LOCAL STRING(INTEGER);
vetLocalDateProd = DATA LOCAL STRING(INTEGER);
vetLocalDateExp = DATA LOCAL STRING(INTEGER);
vetLocalGuidPurpose = DATA LOCAL STRING(INTEGER);
vetLocalBatchId = DATA LOCAL STRING(INTEGER);
vetLocalLastUpdateDate = DATA LOCAL DATE(INTEGER);
vetLocalLastUpdateTime = DATA LOCAL STRING(INTEGER);
vetLocalGlobalId = DATA LOCAL STRING(INTEGER);
vetLocalMarkType = DATA LOCAL STRING(INTEGER);
vetLocalMark = DATA LOCAL STRING(INTEGER);
vetLocalStorageType = DATA LOCAL STRING(INTEGER);
vetLocalGuidOrigCountry = DATA LOCAL STRING(INTEGER);
vetLocalGuidOrigProdList = DATA LOCAL STRING(INTEGER);
vetLocalGuidFirmOwner = DATA LOCAL STRING(INTEGER);
vetLocalRoleOrigProdList = DATA LOCAL STRING(INTEGER);
vetLocalPerishFlg = DATA LOCAL BOOLEAN(INTEGER);
vetLocalLowGradeFlg = DATA LOCAL BOOLEAN(INTEGER);
vetLocalCodeTypeProd = DATA LOCAL INTEGER(INTEGER);
vetLocalGuidProd = DATA LOCAL STRING(INTEGER);
vetLocalGuidSubProd = DATA LOCAL STRING(INTEGER);
vetLocalNumOrdDoc = DATA LOCAL STRING(INTEGER);
vetLocalDateOrdDoc = DATA LOCAL DATE(INTEGER);
vetLocalSeriesDoc = DATA LOCAL STRING(INTEGER);
vetLocalNumDoc = DATA LOCAL STRING(INTEGER);
vetLocalDateDoc = DATA LOCAL DATE(INTEGER);
vetLocalSeriesWayBill = DATA LOCAL STRING(INTEGER);
vetLocalNumWayBill = DATA LOCAL STRING(INTEGER);
vetLocalDateWayBill = DATA LOCAL DATE(INTEGER);
vetLocalNumUtdDoc = DATA LOCAL STRING(INTEGER);
vetLocalDateUtdDoc = DATA LOCAL DATE(INTEGER);
vetLocalNumTrDoc = DATA LOCAL STRING(INTEGER);
vetLocalDateTrDoc = DATA LOCAL DATE(INTEGER);

// в Gestori тип, статус и способ хранения — номер элемента списка (с единицы); нечисловое значение даёт NULL
vetisListWordGestori = FORMULA NULL STRING 'CASE WHEN trim($2) ~ \'^[0-9]+$\' THEN NULLIF(split_part($1, \',\', trim($2)::integer), \'\') END';

// даты выработки и срока годности в Gestori — период «год.месяц.день.час - год.месяц.день.час», берём начало периода
vetisPeriodDateGestori = FORMULA NULL DATE 'CASE WHEN split_part(split_part($1, \' - \', 1), \'.\', 1) ~ \'^ *[0-9][0-9][0-9][0-9] *$\' AND split_part(split_part($1, \' - \', 1), \'.\', 2) ~ \'^ *(0?[1-9]|1[0-2]) *$\' AND split_part(split_part($1, \' - \', 1), \'.\', 3) ~ \'^ *(0?[1-9]|[12][0-9]|3[01]) *$\' THEN make_date(split_part(split_part($1, \' - \', 1), \'.\', 1)::integer, split_part(split_part($1, \' - \', 1), \'.\', 2)::integer, split_part(split_part($1, \' - \', 1), \'.\', 3)::integer) END';
vetisPeriodHourGestori = FORMULA NULL INTEGER 'CASE WHEN split_part(split_part($1, \' - \', 1), \'.\', 4) ~ \'^ *([01]?[0-9]|2[0-3]) *$\' THEN split_part(split_part($1, \' - \', 1), \'.\', 4)::integer END';

// время последнего изменения может прийти числом секунд от начала суток или строкой чч:мм[:сс]
vetisUpdateDateTimeGestori = FORMULA NULL DATETIME 'CASE WHEN trim($2) ~ \'^[0-9]+$\' THEN ($1)::timestamp + trim($2)::integer * interval \'1 second\' WHEN trim($2) ~ \'^[0-9][0-9]?:[0-9][0-9](:[0-9][0-9])?$\' THEN ($1)::timestamp + trim($2)::time ELSE ($1)::timestamp END';

EXTEND CLASS VetDocumentStatus {
    FINALIZED 'Закрыт'
}

// --- Локальные переменные для MercObject ---

objLocalGuid = DATA LOCAL STRING(INTEGER);
objLocalApiKey = DATA LOCAL STRING(INTEGER);
objLocalSoapUser = DATA LOCAL STRING(INTEGER);
objLocalSoapPswd = DATA LOCAL STRING(INTEGER);

// --- Локальные переменные для MercUser / MercUserShop ---

userLocalLogin = DATA LOCAL STRING(INTEGER);
userLocalCodShop = DATA LOCAL STRING(INTEGER);

// в Gestori пустые строки хранятся как '' или пробелы
vetisNonEmptyGestori = FORMULA NULL STRING 'NULLIF(trim($1), \'\')';

// --- Блок 4: Хозяйствующие субъекты из MercFirm ---

importFirmGestori 'Импорт ХС Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT GuidFirm, SUBSTR(NameFirm, 1, 500), InnFirm, KppFirm, CAST(TypeFirm AS VARCHAR(5)) ' +
             'FROM Pub.MercFirm'
        TO file;

    IMPORT TABLE FROM file() TO firmLocalGuid, firmLocalName, firmLocalInn, firmLocalKpp, firmLocalType;

    FOR firmLocalGuid(INTEGER i) AND NOT businessEntity(firmLocalGuid(i)) DO NEW e = BusinessEntity {
        guid(e) <- firmLocalGuid(i);
    }
    FOR BusinessEntity e = businessEntity(firmLocalGuid(INTEGER i)) AND vetisNonEmptyGestori(firmLocalName(i)) AND NOT name(e) = ISTRING(firmLocalName(i)) DO name(e) <- ISTRING(firmLocalName(i));
    FOR BusinessEntity e = businessEntity(firmLocalGuid(INTEGER i)) AND vetisNonEmptyGestori(firmLocalInn(i)) AND NOT inn(e) = STRING[12](firmLocalInn(i)) DO inn(e) <- STRING[12](firmLocalInn(i));
    FOR BusinessEntity e = businessEntity(firmLocalGuid(INTEGER i)) AND vetisNonEmptyGestori(firmLocalKpp(i)) AND NOT kpp(e) = STRING[9](firmLocalKpp(i)) DO kpp(e) <- STRING[9](firmLocalKpp(i));
    // тип контрагента: 1 — юридическое лицо, 2 — физическое лицо, 3 — ИП (коды совпадают с dt:type Ветис)
    FOR BusinessEntity e = businessEntity(firmLocalGuid(INTEGER i)) AND vetisNonEmptyGestori(firmLocalType(i)) AND NOT type(e) = firmLocalType(i) DO type(e) <- firmLocalType(i);

    APPLY;
}

// --- Блоки 5–6: Площадки и связи склад↔площадка из MercArea ---

importAreaGestori 'Импорт площадок Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT GuidFirm, GuidArea, SUBSTR(NameArea, 1, 500), CAST(cod_firm AS CHAR(20)) ' +
             'FROM Pub.MercArea'
        TO file;

    IMPORT TABLE FROM file() TO areaLocalGuidFirm, areaLocalGuid, areaLocalName, areaLocalCodFirm;

    FOR areaLocalGuid(INTEGER i) AND NOT enterprise(areaLocalGuid(i)) DO NEW e = Enterprise {
        guid(e) <- areaLocalGuid(i);
    }
    FOR Enterprise e = enterprise(areaLocalGuid(INTEGER i)) AND vetisNonEmptyGestori(areaLocalName(i)) AND NOT name(e) = ISTRING(areaLocalName(i)) DO name(e) <- ISTRING(areaLocalName(i));
    FOR Enterprise e = enterprise(areaLocalGuid(INTEGER i)) AND BusinessEntity b = businessEntity(areaLocalGuidFirm(i)) AND NOT owner(e) = b DO owner(e) <- b;

    FOR areaLocalCodFirm(INTEGER i) AND LegalEntity l = legalEntity(Stock.stock(STRING[100](trim(areaLocalCodFirm(i)))))
        AND BusinessEntity b = businessEntity(areaLocalGuidFirm(i)) AND NOT businessEntity(l) = b
    DO businessEntity(l) <- b;
    FOR areaLocalCodFirm(INTEGER i) AND Stock st = Stock.stock(STRING[100](trim(areaLocalCodFirm(i))))
        AND Enterprise e = enterprise(areaLocalGuid(i)) AND NOT enterprise(st) = e
    DO enterprise(st) <- e;

    APPLY;
}

// --- Блок 1: Классификатор из MercTypeProd, MercProd, MercSubProd ---

importClassifierGestori 'Импорт классификатора Ветис' () {
    LOCAL file = FILE();

    // типы продукции
    LOCAL typeCode = INTEGER (INTEGER);
    LOCAL typeName = STRING (INTEGER);

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT CodeTypeProd, SUBSTR(NameTypeProd, 1, 500) FROM Pub.MercTypeProd'
        TO file;

    IMPORT TABLE FROM file() TO typeCode, typeName;

    FOR [GROUP MIN INTEGER i BY typeCode(i)](INTEGER code) AND NOT productType(code) DO NEW t = ProductType {
        id(t) <- code;
    }
    // наименования стандартных типов не затираем
    FOR ProductType t = productType(typeCode(INTEGER i)) AND NOT name(t) DO
        name(t) <- typeName(i);

    // продукция
    LOCAL prodTypeCode = INTEGER (INTEGER);
    LOCAL prodName = STRING (INTEGER);
    LOCAL prodGuid = STRING (INTEGER);

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT CodeTypeProd, SUBSTR(NameProd, 1, 500), GuidProd FROM Pub.MercProd'
        TO file;

    IMPORT TABLE FROM file() TO prodTypeCode, prodName, prodGuid;

    FOR [GROUP MIN INTEGER i BY prodGuid(i)](STRING str) AND NOT product(str) DO NEW p = Product {
        guid(p) <- str;
    }
    FOR Product p = product(prodGuid(INTEGER i)) DO {
        name(p) <- prodName(i);
        productType(p) <- productType(prodTypeCode(i));
    }

    // виды продукции
    LOCAL subProdGuid = STRING (INTEGER);
    LOCAL subName = STRING (INTEGER);
    LOCAL subGuid = STRING (INTEGER);

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT GuidProd, SUBSTR(NameSubProd, 1, 500), GuidSubProd FROM Pub.MercSubProd'
        TO file;

    IMPORT TABLE FROM file() TO subProdGuid, subName, subGuid;

    FOR [GROUP MIN INTEGER i BY subGuid(i)](STRING str) AND NOT subProduct(str) DO NEW sp = SubProduct {
        guid(sp) <- str;
    }
    FOR SubProduct sp = subProduct(subGuid(INTEGER i)) DO {
        name(sp) <- subName(i);
        product(sp) <- product(subProdGuid(i));
    }

    APPLY;
}

// --- Блоки 2–3: Номенклатура и связи с товарами из MercItemProd ---

importProductItemsGestori 'Импорт номенклатуры Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT GuidSubProd, GuidItemProd, UuidItemProd, GuidFirmProducer, GuidFirmOwner, ' +
             'SUBSTR(NameItemProd, 1, 500), CodeItemProd, GtinItemProd, cod_good ' +
             'FROM Pub.MercItemProd'
        TO file;

    IMPORT TABLE FROM file() TO
        itemLocalGuidSubProd, itemLocalGuidItemProd, itemLocalUuidItemProd,
        itemLocalGuidFirmProducer, itemLocalGuidFirmOwner,
        itemLocalName, itemLocalCode, itemLocalGtin, itemLocalCodGood;

    FOR [GROUP MIN INTEGER i BY itemLocalGuidItemProd(i)](STRING str) AND NOT productItem(str) DO NEW p = ProductItem {
        guid(p) <- str;
    }

    skipOwnConstraint() <- TRUE;

    FOR ProductItem p = productItem(itemLocalGuidItemProd(INTEGER i)) DO {
        uuid(p) <- itemLocalUuidItemProd(i);
        name(p) <- ISTRING[100](itemLocalName(i));
        code(p) <- itemLocalCode(i);
        globalID(p) <- itemLocalGtin(i);
        subProduct(p) <- subProduct(itemLocalGuidSubProd(i));
        producer(p) <- businessEntity(itemLocalGuidFirmProducer(i));
        owner(p) <- businessEntity(itemLocalGuidFirmOwner(i));
    }

    // Блок 3: связать товар (Item) с номенклатурой по cod_good
    FOR ProductItem p = productItem(itemLocalGuidItemProd(INTEGER i)) AND
        itemLocalCodGood(i) AND Item it = item(TEXT(itemLocalCodGood(i)))
    DO
        in(it, p) <- TRUE;

    APPLY;
}

// --- Блок 7: Записи складского журнала из MercRestShop ---

importStockEntriesGestori 'Импорт записей журнала Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT GuidShop, GuidStockEntry, CAST(NumStockEntry AS VARCHAR(50)), Volume, cod_good ' +
             'FROM Pub.MercRestShop WHERE ActiveStockEntry = 1' +
             (IF vetisInitImportStockCodes() THEN ' AND cod_shop IN (' + vetisInitImportStockCodes() + ')' ELSE '')
        TO file;

    IMPORT TABLE FROM file() TO seLocalGuidShop, seLocalGuid, seLocalNumber, seLocalVolume, seLocalCodGood;

    FOR seLocalGuid(INTEGER i) AND NOT stockEntry(seLocalGuid(i)) DO NEW s = StockEntry {
        guid(s) <- seLocalGuid(i);
    }
    FOR StockEntry s = stockEntry(seLocalGuid(INTEGER i)) DO {
        number(s) <- seLocalNumber(i);
        volume(s) <- seLocalVolume(i);
        enterprise(s) <- enterprise(seLocalGuidShop(i));
        active(s) <- TRUE;
    }

    // Связать запись журнала с номенклатурой через cod_good → Item → ProductItem
    FOR StockEntry s = stockEntry(seLocalGuid(INTEGER i)) AND seLocalCodGood(i) AND
        ProductItem p = (GROUP MIN ProductItem pi IF in(item(TEXT(seLocalCodGood(i))), pi))
    DO
        in(s, p) <- TRUE;

    APPLY;
}

vetisVsdDateFrom 'Дата ВСД (с)' = DATA DATE ();

// --- Блок 8: ВСД из MercVetDoc ---

// ВСД берутся только по действующим записям журнала (остаткам) выбранных магазинов; связь — по IdDoc

// один ВСД приходит несколькими строками (по записям журнала) — свойства ВСД берутся из первой
vetLocalFirst = DATA LOCAL BOOLEAN (INTEGER);
vetRowGestori (VetDocument d, INTEGER i) = vetLocalFirst(i) AND vetDocument(vetLocalUuid(i)) = d;

statusRowGestori (INTEGER i) = vetDocumentStatus(vetisListWordGestori('CONFIRMED,WITHDRAWN,UTILIZED,FINALIZED', vetLocalStatus(i)));
typeRowGestori (INTEGER i) = vetDocumentType(vetisListWordGestori('PRODUCTIVE,RETURNABLE,TRANSPORT', vetLocalType(i)));
storageTypeRowGestori (INTEGER i) = vetisListWordGestori('FROZEN,CHILLED,COOLED,VENTILATED', vetLocalStorageType(i));
updateDateTimeRowGestori (INTEGER i) = vetisUpdateDateTimeGestori(vetLocalLastUpdateDate(i), vetLocalLastUpdateTime(i));

// связанные документы (relationshipType = 1), коды DocumentType_v2.0: заказ 16, ТОРГ-12 6, ТТН 1, УПД 23, транспортная накладная 5
seriesReferenceGestori (INTEGER i, INTEGER t) = CASE
    WHEN t = 6 THEN vetisNonEmptyGestori(vetLocalSeriesDoc(i))
    WHEN t = 1 THEN vetisNonEmptyGestori(vetLocalSeriesWayBill(i));
numberReferenceGestori (INTEGER i, INTEGER t) = CASE
    WHEN t = 16 THEN vetisNonEmptyGestori(vetLocalNumOrdDoc(i))
    WHEN t = 6 THEN vetisNonEmptyGestori(vetLocalNumDoc(i))
    WHEN t = 1 THEN vetisNonEmptyGestori(vetLocalNumWayBill(i))
    WHEN t = 23 THEN vetisNonEmptyGestori(vetLocalNumUtdDoc(i))
    WHEN t = 5 THEN vetisNonEmptyGestori(vetLocalNumTrDoc(i));
dateReferenceGestori (INTEGER i, INTEGER t) = CASE
    WHEN t = 16 THEN vetLocalDateOrdDoc(i)
    WHEN t = 6 THEN vetLocalDateDoc(i)
    WHEN t = 1 THEN vetLocalDateWayBill(i)
    WHEN t = 23 THEN vetLocalDateUtdDoc(i)
    WHEN t = 5 THEN vetLocalDateTrDoc(i);
// на тип документа у ВСД одна запись — та, что выбирается в приоритете накладной
referenceRowGestori (VetReferenceDocument rd, INTEGER i) = vetRowGestori(vetDocument(rd), i) AND waybillByTypeGestori(vetDocument(rd), type(rd)) = rd
    AND (seriesReferenceGestori(i, type(rd)) OR numberReferenceGestori(i, type(rd)));

importVetDocumentsWhereGestori (STRING where) {
    LOCAL file = FILE();

    logToFile('vetisImportGestori', 'ВСД: запрос к Gestori, условие ' + where);
    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT v.UuidDoc, v.DocIssueDate, CAST(v.DocStatus AS VARCHAR(50)), CAST(v.DocType AS VARCHAR(50)), ' +
             'v.GuidFirmConsignor, v.GuidAreaConsignor, v.GuidFirmConsignee, v.GuidAreaConsignee, ' +
             'v.GuidItemProd, v.Volume, j.GuidStockEntry, ' +
             'v.Quantity, v.GuidMeas, SUBSTR(v.DateProd, 1, 100), SUBSTR(v.DateExp, 1, 100), v.GuidPurpose, ' +
             'SUBSTR(v.BatchId, 1, 500), v.LastUpdateDate, CAST(v.LastUpdateTime AS VARCHAR(30)), ' +
             'SUBSTR(v.GlobalId, 1, 100), CAST(v.MarkTypeItemProd AS VARCHAR(100)), SUBSTR(v.MarkItemProd, 1, 500), ' +
             'CAST(v.TranspStorageType AS VARCHAR(20)), ' +
             'v.GuidOrigCountry, SUBSTR(v.GuidOrigProdList, 1, 2000), v.GuidFirmOwner, SUBSTR(v.RoleOrigProdList, 1, 2000), ' +
             'v.PerishFlg, v.LowGradeFlg, v.CodeTypeProd, v.GuidProd, v.GuidSubProd, ' +
             'SUBSTR(v.NumOrdDoc, 1, 100), v.DateOrdDoc, SUBSTR(v.SeriesDoc, 1, 100), SUBSTR(v.NumDoc, 1, 100), v.DateDoc, ' +
             'SUBSTR(v.SeriesWayBill, 1, 100), SUBSTR(v.NumWayBill, 1, 100), v.DateWayBill, ' +
             'SUBSTR(v.NumUtdDoc, 1, 100), v.DateUtdDoc, SUBSTR(v.NumTrDoc, 1, 100), v.DateTrDoc ' +
             'FROM Pub.MercVetDoc v JOIN Pub.MercRestShop j ON j.IdDoc = v.IdDoc ' +
             'WHERE ' + where + ' AND j.ActiveStockEntry = 1' +
             (IF vetisInitImportStockCodes() THEN ' AND j.cod_shop IN (' + vetisInitImportStockCodes() + ')' ELSE '')
        TO file;
    logToFile('vetisImportGestori', 'ВСД: выборка из Gestori получена');

    IMPORT TABLE FROM file() TO
        vetLocalUuid, vetLocalIssueDate, vetLocalStatus, vetLocalType,
        vetLocalGuidConsignorFirm, vetLocalGuidConsignorArea,
        vetLocalGuidConsigneeFirm, vetLocalGuidConsigneeArea,
        vetLocalGuidItemProd, vetLocalVolume, vetLocalGuidStockEntry,
        vetLocalQuantity, vetLocalGuidMeas, vetLocalDateProd, vetLocalDateExp, vetLocalGuidPurpose,
        vetLocalBatchId, vetLocalLastUpdateDate, vetLocalLastUpdateTime,
        vetLocalGlobalId, vetLocalMarkType, vetLocalMark, vetLocalStorageType,
        vetLocalGuidOrigCountry, vetLocalGuidOrigProdList, vetLocalGuidFirmOwner, vetLocalRoleOrigProdList,
        vetLocalPerishFlg, vetLocalLowGradeFlg, vetLocalCodeTypeProd, vetLocalGuidProd, vetLocalGuidSubProd,
        vetLocalNumOrdDoc, vetLocalDateOrdDoc, vetLocalSeriesDoc, vetLocalNumDoc, vetLocalDateDoc,
        vetLocalSeriesWayBill, vetLocalNumWayBill, vetLocalDateWayBill,
        vetLocalNumUtdDoc, vetLocalDateUtdDoc, vetLocalNumTrDoc, vetLocalDateTrDoc;

    vetLocalFirst(INTEGER i) <- NULL WHERE vetLocalFirst(i);
    vetLocalFirst(INTEGER i) <- TRUE WHERE i = [GROUP MIN INTEGER j BY vetLocalUuid(j)](vetLocalUuid(i));
    logToFile('vetisImportGestori', 'ВСД: строк ' + (OVERRIDE (GROUP SUM 1 IF vetLocalUuid(INTEGER i)), 0)
        + ', ВСД ' + (OVERRIDE (GROUP SUM 1 IF vetLocalFirst(INTEGER i)), 0)
        + ', новых ' + (OVERRIDE (GROUP SUM 1 IF vetLocalFirst(INTEGER i) AND NOT vetDocument(vetLocalUuid(i))), 0));

    FOR vetLocalFirst(INTEGER i) AND NOT vetDocument(vetLocalUuid(i)) DO NEW d = VetDocument {
        uuid(d) <- vetLocalUuid(i);
    }
    logToFile('vetisImportGestori', 'ВСД: новые созданы');

    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT issueDate(d) = vetLocalIssueDate(i) AND (issueDate(d) OR vetLocalIssueDate(i)) DO issueDate(d) <- vetLocalIssueDate(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT status(d) = statusRowGestori(i) AND (status(d) OR statusRowGestori(i)) DO status(d) <- statusRowGestori(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT type(d) = typeRowGestori(i) AND (type(d) OR typeRowGestori(i)) DO type(d) <- typeRowGestori(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT consignorBusinessEntity(d) = businessEntity(vetLocalGuidConsignorFirm(i)) AND (consignorBusinessEntity(d) OR businessEntity(vetLocalGuidConsignorFirm(i))) DO consignorBusinessEntity(d) <- businessEntity(vetLocalGuidConsignorFirm(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT consignorEnterprise(d) = enterprise(vetLocalGuidConsignorArea(i)) AND (consignorEnterprise(d) OR enterprise(vetLocalGuidConsignorArea(i))) DO consignorEnterprise(d) <- enterprise(vetLocalGuidConsignorArea(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT consigneeBusinessEntity(d) = businessEntity(vetLocalGuidConsigneeFirm(i)) AND (consigneeBusinessEntity(d) OR businessEntity(vetLocalGuidConsigneeFirm(i))) DO consigneeBusinessEntity(d) <- businessEntity(vetLocalGuidConsigneeFirm(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT consigneeEnterprise(d) = enterprise(vetLocalGuidConsigneeArea(i)) AND (consigneeEnterprise(d) OR enterprise(vetLocalGuidConsigneeArea(i))) DO consigneeEnterprise(d) <- enterprise(vetLocalGuidConsigneeArea(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT productItem(d) = productItem(vetLocalGuidItemProd(i)) AND (productItem(d) OR productItem(vetLocalGuidItemProd(i))) DO productItem(d) <- productItem(vetLocalGuidItemProd(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT volume(d) = vetLocalVolume(i) AND (volume(d) OR vetLocalVolume(i)) DO volume(d) <- vetLocalVolume(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT quantityPackGestori(d) = vetLocalQuantity(i) AND (quantityPackGestori(d) OR vetLocalQuantity(i)) DO quantityPackGestori(d) <- vetLocalQuantity(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT unit(d) = unit(vetLocalGuidMeas(i)) AND (unit(d) OR unit(vetLocalGuidMeas(i))) DO unit(d) <- unit(vetLocalGuidMeas(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT dateOfProduction(d) = vetisPeriodDateGestori(vetLocalDateProd(i)) AND (dateOfProduction(d) OR vetisPeriodDateGestori(vetLocalDateProd(i))) DO dateOfProduction(d) <- vetisPeriodDateGestori(vetLocalDateProd(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT dateOfProductionHour(d) = vetisPeriodHourGestori(vetLocalDateProd(i)) AND (dateOfProductionHour(d) OR vetisPeriodHourGestori(vetLocalDateProd(i))) DO dateOfProductionHour(d) <- vetisPeriodHourGestori(vetLocalDateProd(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT expiryDate(d) = vetisPeriodDateGestori(vetLocalDateExp(i)) AND (expiryDate(d) OR vetisPeriodDateGestori(vetLocalDateExp(i))) DO expiryDate(d) <- vetisPeriodDateGestori(vetLocalDateExp(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT expiryDateHour(d) = vetisPeriodHourGestori(vetLocalDateExp(i)) AND (expiryDateHour(d) OR vetisPeriodHourGestori(vetLocalDateExp(i))) DO expiryDateHour(d) <- vetisPeriodHourGestori(vetLocalDateExp(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT purpose(d) = purpose(vetLocalGuidPurpose(i)) AND (purpose(d) OR purpose(vetLocalGuidPurpose(i))) DO purpose(d) <- purpose(vetLocalGuidPurpose(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT batchID(d) = vetLocalBatchId(i) AND (batchID(d) OR vetLocalBatchId(i)) DO batchID(d) <- vetLocalBatchId(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT updateDateTimeGestori(d) = updateDateTimeRowGestori(i) AND (updateDateTimeGestori(d) OR updateDateTimeRowGestori(i)) DO updateDateTimeGestori(d) <- updateDateTimeRowGestori(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT packingTypeGlobalIDGestori(d) = vetLocalGlobalId(i) AND (packingTypeGlobalIDGestori(d) OR vetLocalGlobalId(i)) DO packingTypeGlobalIDGestori(d) <- vetLocalGlobalId(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT productMarksClassGestori(d) = vetLocalMarkType(i) AND (productMarksClassGestori(d) OR vetLocalMarkType(i)) DO productMarksClassGestori(d) <- vetLocalMarkType(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT productMarksGestori(d) = vetLocalMark(i) AND (productMarksGestori(d) OR vetLocalMark(i)) DO productMarksGestori(d) <- vetLocalMark(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT transportStorageType(d) = storageTypeRowGestori(i) AND (transportStorageType(d) OR storageTypeRowGestori(i)) DO transportStorageType(d) <- storageTypeRowGestori(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT countryOriginGuidGestori(d) = vetLocalGuidOrigCountry(i) AND (countryOriginGuidGestori(d) OR vetLocalGuidOrigCountry(i)) DO countryOriginGuidGestori(d) <- vetLocalGuidOrigCountry(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT producersOriginGuidGestori(d) = vetLocalGuidOrigProdList(i) AND (producersOriginGuidGestori(d) OR vetLocalGuidOrigProdList(i)) DO producersOriginGuidGestori(d) <- vetLocalGuidOrigProdList(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT ownerBEGuidGestori(d) = vetLocalGuidFirmOwner(i) AND (ownerBEGuidGestori(d) OR vetLocalGuidFirmOwner(i)) DO ownerBEGuidGestori(d) <- vetLocalGuidFirmOwner(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT producersOriginRoleGestori(d) = vetLocalRoleOrigProdList(i) AND (producersOriginRoleGestori(d) OR vetLocalRoleOrigProdList(i)) DO producersOriginRoleGestori(d) <- vetLocalRoleOrigProdList(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT perishable(d) = vetLocalPerishFlg(i) AND (perishable(d) OR vetLocalPerishFlg(i)) DO perishable(d) <- vetLocalPerishFlg(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT lowGradeCargo(d) = vetLocalLowGradeFlg(i) AND (lowGradeCargo(d) OR vetLocalLowGradeFlg(i)) DO lowGradeCargo(d) <- vetLocalLowGradeFlg(i);
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT productType(d) = productType(vetLocalCodeTypeProd(i)) AND (productType(d) OR productType(vetLocalCodeTypeProd(i))) DO productType(d) <- productType(vetLocalCodeTypeProd(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT product(d) = product(vetLocalGuidProd(i)) AND (product(d) OR product(vetLocalGuidProd(i))) DO product(d) <- product(vetLocalGuidProd(i));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND NOT subProduct(d) = subProduct(vetLocalGuidSubProd(i)) AND (subProduct(d) OR subProduct(vetLocalGuidSubProd(i))) DO subProduct(d) <- subProduct(vetLocalGuidSubProd(i));
    logToFile('vetisImportGestori', 'ВСД: свойства записаны');

    // связь ВСД с записями складского журнала
    FOR VetDocument d = vetDocument(vetLocalUuid(INTEGER i)) AND StockEntry s = stockEntry(vetLocalGuidStockEntry(i)) AND NOT in(s, d) DO in(s, d) <- TRUE;

    // связанные документы: пустые удаляются, недостающие создаются, существующие обновляются по месту
    DELETE VetReferenceDocument rd WHERE relationshipType(rd) = 1 AND (GROUP SUM 1 IF vetRowGestori(vetDocument(rd), INTEGER i))
        AND NOT vetisNonEmptyGestori(issueSeries(rd)) AND NOT vetisNonEmptyGestori(issueNumber(rd));
    FOR vetRowGestori(VetDocument d, INTEGER i) AND (INTEGER t = 16 OR t = 6 OR t = 1 OR t = 23 OR t = 5)
        AND (seriesReferenceGestori(i, t) OR numberReferenceGestori(i, t)) AND NOT waybillByTypeGestori(d, t) DO NEW rd = VetReferenceDocument {
        vetDocument(rd) <- d;
        type(rd) <- t;
        relationshipType(rd) <- 1;
    }
    FOR referenceRowGestori(VetReferenceDocument rd, INTEGER i) AND NOT issueSeries(rd) = seriesReferenceGestori(i, type(rd)) AND (issueSeries(rd) OR seriesReferenceGestori(i, type(rd))) DO issueSeries(rd) <- seriesReferenceGestori(i, type(rd));
    FOR referenceRowGestori(VetReferenceDocument rd, INTEGER i) AND NOT issueNumber(rd) = numberReferenceGestori(i, type(rd)) AND (issueNumber(rd) OR numberReferenceGestori(i, type(rd))) DO issueNumber(rd) <- numberReferenceGestori(i, type(rd));
    FOR referenceRowGestori(VetReferenceDocument rd, INTEGER i) AND NOT issueDate(rd) = dateReferenceGestori(i, type(rd)) AND (issueDate(rd) OR dateReferenceGestori(i, type(rd))) DO issueDate(rd) <- dateReferenceGestori(i, type(rd));
    logToFile('vetisImportGestori', 'ВСД: связи и связанные документы записаны, сохранение');

    // APPLY очищает локальные свойства, поэтому количество считаем заранее
    LOCAL NESTED count = INTEGER ();
    count() <- OVERRIDE (GROUP SUM 1 IF vetLocalFirst(INTEGER i)), 0;

    APPLY;

    logToFile('vetisImportGestori', 'ВСД: ' + (IF canceled() THEN 'сохранение отменено: ' + applyMessage() ELSE 'сохранено, ВСД ' + count()));
    IF NOT canceled() THEN MESSAGE 'Импортировано ' + count() + ' ВСД';
}

importVetDocumentsGestori 'Импорт ВСД Ветис' () {
    importVetDocumentsWhereGestori('1 = 1');
}

importFilteredVetDocumentsGestori 'Импорт ВСД Ветис (по дате)' () {
    IF NOT vetisVsdDateFrom() THEN {
        MESSAGE 'Укажите дату ВСД (с)';
        RETURN;
    }

    importVetDocumentsWhereGestori('v.DocIssueDate >= DATE \'' + toChar(vetisVsdDateFrom(), 'yyyy-MM-dd') + '\'');
}

// --- Блок 9: Настройки обмена из MercObject ---

importObjectSettingsGestori 'Импорт настроек ХС Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT GuidObject, ApiKey, SoapUser, SoapPswd ' +
             'FROM Pub.MercObject'
        TO file;

    IMPORT TABLE FROM file() TO objLocalGuid, objLocalApiKey, objLocalSoapUser, objLocalSoapPswd;

    FOR BusinessEntity be = businessEntity(objLocalGuid(INTEGER i)) DO {
        apiKey(be) <- objLocalApiKey(i);
        login(be) <- objLocalSoapUser(i);
        password(be) <- objLocalSoapPswd(i);
    }

    APPLY;
}

// --- Блок 10: Пользователи Ветис из MercUser ---

importUsersGestori 'Импорт пользователей Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT UserLogin ' +
             'FROM Pub.MercUser'
        TO file;

    IMPORT TABLE FROM file() TO userLocalLogin;

    // Установить loginMercury для пользователей, найденных по системному логину
    FOR userLocalLogin(INTEGER i) AND CustomUser u = [GROUP MAX CustomUser cu BY login(cu)](userLocalLogin(i)) DO
        loginMercury(u) <- userLocalLogin(i);

    APPLY;
}

// --- Блок 11: Привязка пользователей к складам из MercUserShop ---

importUserShopsGestori 'Импорт привязок пользователей к складам Ветис' () {
    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT mu.UserLogin, CAST(mus.cod_shop AS CHAR(20)) ' +
             'FROM Pub.MercUserShop mus ' +
             'JOIN Pub.MercUser mu ON mus.UuidUser = mu.UuidUser'
        TO file;

    IMPORT TABLE FROM file() TO userLocalLogin, userLocalCodShop;

    // Установить логин Меркурий по умолчанию для ХС склада (если ещё не задан)
    FOR userLocalLogin(INTEGER i) AND userLocalCodShop(i) AND
        Stock st = stockExtId(userLocalCodShop(i)) AND
        Enterprise e = enterprise(st) AND BusinessEntity be = owner(e) AND
        NOT defaultLoginMercury(be)
    DO
        defaultLoginMercury(be) <- userLocalLogin(i);

    APPLY;
}

// --- Блок 7а: Отбор актуальных записей журнала по ВСД с учётом типа магазина ---

// Локальные переменные для фильтрованного импорта MercRestShop
seFilGuidShop    = DATA LOCAL STRING(INTEGER);
seFilGuid        = DATA LOCAL STRING(INTEGER);
seFilNumber      = DATA LOCAL STRING(INTEGER);
seFilVolume      = DATA LOCAL NUMERIC[16,5](INTEGER);
seFilCodGood     = DATA LOCAL NUMERIC[13,0](INTEGER);
seFilDateExpiry  = DATA LOCAL DATE(INTEGER);

importFilteredStockEntriesGestori 'Импорт актуальных записей журнала' () {
    IF NOT vetisVsdDateFrom() THEN {
        MESSAGE 'Укажите дату ВСД (с)';
        RETURN;
    }

    LOCAL file = FILE();

    EXTERNAL SQL vetisDbUrl()
        EXEC 'SELECT j.GuidShop, j.GuidStockEntry, CAST(j.NumStockEntry AS VARCHAR(50)), j.Volume, j.cod_good, v.DateExpiry ' +
             'FROM Pub.MercRestShop j ' +
             'JOIN Pub.MercVetDoc v ON v.IdDoc = j.IdDoc ' +
             'WHERE j.ActiveStockEntry = 1 AND (v.DateExpiry >= CURRENT_DATE) AND ' +
             '(v.DocIssueDate >= DATE \'' + toChar(vetisVsdDateFrom(), 'yyyy-MM-dd') + '\')' +
             (IF vetisInitImportStockCodes() THEN ' AND j.cod_shop IN (' + vetisInitImportStockCodes() + ')' ELSE '')
        TO file;

    IMPORT TABLE FROM file() TO
        seFilGuidShop, seFilGuid, seFilNumber, seFilVolume, seFilCodGood, seFilDateExpiry;

    FOR seFilGuid(INTEGER i) AND NOT stockEntry(seFilGuid(i)) DO NEW s = StockEntry {
        guid(s) <- seFilGuid(i);
    }
    FOR StockEntry s = stockEntry(seFilGuid(INTEGER i)) DO {
        number(s)     <- seFilNumber(i);
        volume(s)     <- seFilVolume(i);
        enterprise(s) <- enterprise(seFilGuidShop(i));
        active(s)     <- TRUE;
        expiryDate(s) <- seFilDateExpiry(i);
    }

    FOR StockEntry s = stockEntry(seFilGuid(INTEGER i)) AND seFilCodGood(i) AND
        ProductItem p = (GROUP MIN ProductItem pi IF in(item(TEXT(seFilCodGood(i))), pi))
    DO
        in(s, p) <- TRUE;

    LOCAL NESTED count = INTEGER ();
    count() <- OVERRIDE (GROUP SUM 1 IF seFilGuid(INTEGER i)), 0;

    APPLY;

    IF NOT canceled() THEN MESSAGE 'Импортировано ' + count() + ' актуальных записей журнала';
}

// --- Мастер-действие ---

importAllVetisGestori 'Импорт начальных данных Ветис' () {
    importFirmGestori();
    importAreaGestori();
    importClassifierGestori();
    importProductItemsGestori();
    importStockEntriesGestori();
    importVetDocumentsGestori();
    importObjectSettingsGestori();
    importUsersGestori();
    importUserShopsGestori();
    MESSAGE 'Импорт начальных данных Ветис завершён';
}

EXTEND FORM integrationData
    PROPERTIES() importAllVetisGestori, vetisInitImportStocks,
                 importFirmGestori, importAreaGestori, importClassifierGestori, importProductItemsGestori,
                 importStockEntriesGestori,
                 vetisVsdDateFrom, importFilteredStockEntriesGestori,
                 importVetDocumentsGestori, importFilteredVetDocumentsGestori,
                 importObjectSettingsGestori, importUsersGestori, importUserShopsGestori
;

DESIGN integrationData {
    gestori {
        NEW vetisInitImport {
            caption = 'Начальный импорт ВЕТИС';
            MOVE PROPERTY(vetisInitImportStocks());
            MOVE PROPERTY(importAllVetisGestori());
            MOVE PROPERTY(importFirmGestori());
            MOVE PROPERTY(importAreaGestori());
            MOVE PROPERTY(importClassifierGestori());
            MOVE PROPERTY(importProductItemsGestori());
            MOVE PROPERTY(importStockEntriesGestori());
            MOVE PROPERTY(vetisVsdDateFrom());
            MOVE PROPERTY(importFilteredStockEntriesGestori());
            MOVE PROPERTY(importVetDocumentsGestori());
            MOVE PROPERTY(importFilteredVetDocumentsGestori());
            MOVE PROPERTY(importObjectSettingsGestori());
            MOVE PROPERTY(importUsersGestori());
            MOVE PROPERTY(importUserShopsGestori());
        }
    }
}
