MODULE VetisProductionOrderGestori;

REQUIRE VetisProductionOrder, VetisRegisterProductionOperation, VetisStockEntryGestori;

PRIORITY Production;

NAMESPACE Vetis;

// --- Заявка Ветис по производственному заказу ---

lastRequestProductionGestori (Production.Order o) =
    GROUP LAST RegisterProductionOperationRequest r ORDER r WHERE productionOrder(r) = o;
issueDateLastRequestProductionGestori 'Время заявки' (Production.Order o) = issueDate(lastRequestProductionGestori(o));
nameStatusLastRequestProductionGestori 'Статус заявки' (Production.Order o) = nameStatus(lastRequestProductionGestori(o));
errorLastRequestProductionGestori 'Ошибка заявки' (Production.Order o) = error(lastRequestProductionGestori(o));

fillVolumeApplyProductionGestori 'Заполнить' (Production.Order o) {
    VetisSale.fillVolume(o);
    APPLY;
}

hasProductItemProductionGestori (Production.Order o) =
    GROUP SUM 1 IF in(sku(Production.ComponentDetail vd), ProductItem pi) AND Production.order(vd) = o;

// --- Форма редактирования производственного заказа: вкладка ВЕТИС ---

// объём по строке в пересчёте на вес нетто товара
volumeShippedProductionGestori 'Объем (поставлено)' (Production.ComponentDetail d) =
    NUMERIC[16,5](bruttoQuantity(d) * netWeight[Stock.Sku](sku(d)));

// суммарный объём по строкам, связанным с записью журнала
totalVolumeSEProductionGestori 'Объем всего' (StockEntry se) =
    GROUP SUM VetisSale.volume(Production.ComponentDetail d, se);

// заявки Ветис по производственному заказу
filterProductionOrderRequestGestori = DATA LOCAL Production.Order ();

EXTEND FORM applicationRequests
    FILTERS NOT filterProductionOrderRequestGestori() OR productionOrder(r AS RegisterProductionOperationRequest) = filterProductionOrderRequestGestori()
;

showVetisRequestsProductionGestori 'Заявки ВЕТИС' (Production.Order o) {
    filterProductionOrderRequestGestori() <- o;
    SHOW applicationRequests;
}

EXTEND FORM Production.order
    PROPERTIES(vd) READONLY volumeShippedProductionGestori
    PROPERTIES(se) READONLY totalVolumeSEProductionGestori
    PROPERTIES showVetisRequestsProductionGestori(o) DRAW vd TOOLBAR
;

DESIGN Production.order {
    vetis { caption = 'ВЕТИС'; }
    PROPERTY(volumeStockEntry(vd)) { caption = 'Объем по строке'; }
    PROPERTY(guid(se)) { caption = 'GUID записи журнала'; }
    PROPERTY(volume(vd, se)) { caption = 'Объем по строке'; }
}

// --- Связь строк с производственными ВСД: последняя заявка с участием пары строка × запись журнала ---

lastRequestComponentGestori (Production.ComponentDetail d, StockEntry se) =
    GROUP LAST RegisterProductionOperationRequest r ORDER r WHERE volume(r, d, se);
uuidVetDocumentComponentGestori 'GUID ВСД' (Production.ComponentDetail d, StockEntry se) = uuid(vetDocument(lastRequestComponentGestori(d, se)));
nameStatusVetDocumentComponentGestori 'Статус ВСД' (Production.ComponentDetail d, StockEntry se) = nameStatus(vetDocument(lastRequestComponentGestori(d, se)));

// --- Скрытие кнопок, когда весь состав отправлен (созданы ВСД или отправлены запросы) ---

toProcessProductionGestori (Production.Order o) =
    GROUP SUM 1 IF VetisSale.volume(Production.ComponentDetail d, StockEntry se) AND NOT requested(d, se) AND Production.order(d) == o;
coveredAllProductionGestori (Production.Order o) =
    (GROUP SUM 1 IF VetisSale.volume(Production.ComponentDetail d, StockEntry se) AND Production.order(d) == o) AND NOT toProcessProductionGestori(o);

showIfVetisOverride(Production.Order o) += TRUE IF toProcessProductionGestori(o);

showFillVolumeProductionGestori (Production.Order o) = hasProductItemProductionGestori(o) AND NOT coveredAllProductionGestori(o);

// кнопка отправки в тулбаре таблицы строк (рядом с «Заполнить»); базовая кнопка формы скрывается
sendVetisProductionGestori 'Отправить в Ветис' (Production.Order o) {
    registerProductionOperationRequest(o);
}

// --- Запрет редактирования после отправки запросов в Ветис ---

// заявка без зафиксированного состава (создана до его появления) блокирует все строки своего заказа
lockedComponentGestori (Production.ComponentDetail d) =
    OVERRIDE (GROUP SUM 1 IF volume(RegisterProductionOperationRequest r, d, StockEntry se) AND (notCompleted(r) OR succeeded(r))),
        hasLegacyRequest(order(d));

CONSTRAINT CHANGED(Production.quantity(Production.ComponentDetail d)) AND lockedComponentGestori(d)
    MESSAGE 'Запрещено изменять количество по строке производственного заказа: по строке отправлен запрос в Ветис';

CONSTRAINT CHANGED(VetisSale.volume(Production.ComponentDetail d, StockEntry se)) AND lockedComponentGestori(d)
    MESSAGE 'Запрещено изменять объём по записям журнала: по строке отправлен запрос в Ветис';

// строку нельзя удалить (в т.ч. удалением заказа), пока по ней есть незавершённые или успешные запросы
CONSTRAINT DROPPED(d IS Production.ComponentDetail) AND PREV(lockedComponentGestori(d))
    MESSAGE 'Запрещено удалять строку производственного заказа: по строке отправлен запрос в Ветис или создан производственный ВСД';

lockedProductGestori (Production.ProductDetail d) =
    OVERRIDE (GROUP SUM 1 IF volume(RegisterProductionOperationRequest r, d) AND ((notCompleted(r) OR succeeded(r)) OR vetDocument(r))),
        hasLegacyRequest(order(d));

CONSTRAINT CHANGED(Production.quantity(Production.ProductDetail d)) AND lockedProductGestori(d)
    MESSAGE 'Запрещено изменять количество по позиции: по ней отправлен запрос в Ветис или создан производственный ВСД';

// --- Остатки записей журнала ---

// сумма объёмов по строкам, по которым ещё не созданы ВСД
totalVolumeNoVSDSEGestori (StockEntry se) =
    GROUP SUM VetisSale.volume(Production.ComponentDetail d, se) IF NOT vetDocument(lastRequestComponentGestori(d, se));

guidSEProductionGestori 'GUID записи журнала' (StockEntry se) = guid(se);
numberSEProductionGestori 'Номер записи журнала' (StockEntry se) = number(se);
volumeSEProductionGestori 'Объем продукции' (StockEntry se) = volume(se);
nameProductItemSEProductionGestori 'Номенклатура' (StockEntry se) = nameProductItem(se);

// проверка только при изменении подбора (объёма пары строка × запись): списание остатка записи
// при обработке ответа Ветис не должно блокироваться превышениями по строкам других документов
CONSTRAINT CHANGED(VetisSale.volume(Production.ComponentDetail d, StockEntry se)) AND totalVolumeNoVSDSEGestori(se) > volume(se)
    MESSAGE 'Суммарный объём по строкам, связанным с записью журнала, превышает текущий остаток записи журнала'
    PROPERTIES guidSEProductionGestori(se), numberSEProductionGestori(se), volumeSEProductionGestori(se), nameProductItemSEProductionGestori(se);

CONSTRAINT VetisSale.volumeStockEntry(Production.ComponentDetail d) > volumeShippedProductionGestori(d)
    MESSAGE 'Суммарный объём по связанным со строкой записям журнала превышает объём по строке';

// --- Вкладка ВЕТИС на списке производственных заказов ---

EXTEND FORM Production.orders
    OBJECTS vse = (vd = Production.ComponentDetail, se = StockEntry)
    PROPERTIES(vd) READONLY index, idBarcodeSku, idSku, nameSku, shortNameUOMSku
    PROPERTIES(se) READONLY guid, number, nameProductItem
    PROPERTIES(vd, se) READONLY volume
    PROPERTIES(vd, se) READONLY uuidVetDocumentComponentGestori, nameStatusVetDocumentComponentGestori
    ORDERS index(vd)
    FILTERS Production.order(vd) = o, VetisSale.volume(vd, se)

    PROPERTIES(o) fillVolumeApplyProductionGestori DRAW vse TOOLBAR SHOWIF showFillVolumeProductionGestori(o)
    PROPERTIES(o) sendVetisProductionGestori DRAW vse TOOLBAR SHOWIF showIfVetis(o)

    PROPERTIES(o) READONLY issueDateLastRequestProductionGestori DRAW vse, nameStatusLastRequestProductionGestori DRAW vse
    PROPERTIES(o) READONLY errorLastRequestProductionGestori PANEL
;

DESIGN Production.orders {
    vetisContainer {
        caption = 'ВЕТИС';
        horizontal = FALSE;
        MOVE BOX(vse) { fill = 1; }
        MOVE PROPERTY(errorLastRequestProductionGestori(o)) {
            alignment = STRETCH;
            panelCaptionVertical = TRUE;
        }
    }
    PROPERTY(registerProductionOperationRequest(o)) { hide = TRUE; }
    PROPERTY(nameSku(vd)) { caption = 'Наименование'; }
    PROPERTY(guid(se)) { caption = 'GUID записи журнала'; }
    PROPERTY(volume(vd, se)) { caption = 'Объем по строке'; }
}
