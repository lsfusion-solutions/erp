    OBJECTS c = INTEGER EXTID 'dt:street' IN ikarStreetListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
                  ikarViewGestori EXTID 'dt:view'
;

// --- Выполнение запроса к Икару ---

ikarRequestErrorGestori = DATA LOCAL BOOLEAN ();
ikarResponseFileGestori = DATA LOCAL FILE ();

postIkarGestori (FILE requestFile) {
    ikarRequestErrorGestori() <- NULL;
    LOCAL response = FILE ();
    TRY {
        EXTERNAL HTTP urlIkarGestori() HEADERS httpHeaders PARAMS requestFile TO response;
    } CATCH {
        fileToString(response());
        MESSAGE CONCAT ' ', 'Ошибка при запросе к службе Икар:', messageCaughtException(), resultString();
        ikarRequestErrorGestori() <- TRUE;
        RETURN;
    }
    ikarResponseFileGestori() <- response();
}

// --- Диалог выбора адресного объекта ---

FORM dialogIkarSelectGestori 'Справочник адресных объектов Ветис'
    OBJECTS ipg = (pg = INTEGER, i = INTEGER)
    PROPERTIES READONLY nameIkar 'Наименование' = ikarAccNameGestori(pg, i), viewIkar 'Полное наименование' = ikarAccViewGestori(pg, i), guidIkar 'GUID' = ikarAccGuidGestori(pg, i)
    ORDERS nameIkar
    FILTERS ikarAccGuidGestori(pg, i)
;

// разбор очередной страницы пишет свойства по индексам с нуля — остатки предыдущей страницы нужно убрать,
// иначе короткая последняя страница «дотягивает» хвост от предыдущей
clearIkarPageLocalsGestori () {
    ikarGuidGestori(INTEGER i) <- NULL;
    ikarNameGestori(INTEGER i) <- NULL;
    ikarViewGestori(INTEGER i) <- NULL;
}

clearIkarLocalsGestori () {
    clearIkarPageLocalsGestori();
    ikarAccGuidGestori(INTEGER p, INTEGER i2) <- NULL;
    ikarAccNameGestori(INTEGER p, INTEGER i2) <- NULL;
    ikarAccViewGestori(INTEGER p, INTEGER i2) <- NULL;
    ikarPageSizeGestori() <- NULL;
}

// --- Фактический адрес: автоформирование из компонент ---

// адрес собирается из полных наименований адресных объектов (как их отдаёт Икар)
calcAddressViewGestori (Enterprise e) = CONCAT ', ',
    postIndexGestori(e), countryNameGestori(e), regionNameGestori(e), districtNameGestori(e),
    localityNameGestori(e), subLocalityNameGestori(e), streetNameGestori(e),
    ('д. ' + houseGestori(e)), ('стр. ' + buildingGestori(e)), ('кв. ' + roomGestori(e)),
    ('а/я ' + postBoxGestori(e)), additionalInfoGestori(e);

updateAddressViewGestori (Enterprise e) {
    IF createdManuallyGestori(e) THEN addressView(e) <- ISTRING(calcAddressViewGestori(e));
}

// --- Выбор адресных объектов на карточке площадки ---

checkIkarUrlGestori () = TRUE IF urlIkarGestori();

// очистка адресных полей: вместе с полем очищаются все зависящие от него (3.13.14)

clearStreetIkarGestori 'Очистить' (Enterprise e) {
    streetGuidGestori(e) <- NULL; streetNameGestori(e) <- NULL;
    updateAddressViewGestori(e);
}

clearSubLocalityIkarGestori 'Очистить' (Enterprise e) {
    subLocalityGuidGestori(e) <- NULL; subLocalityNameGestori(e) <- NULL;
    clearStreetIkarGestori(e);
}

clearLocalityIkarGestori 'Очистить' (Enterprise e) {
    localityGuidGestori(e) <- NULL; localityNameGestori(e) <- NULL;
    clearSubLocalityIkarGestori(e);
}

clearDistrictIkarGestori 'Очистить' (Enterprise e) {
    districtGuidGestori(e) <- NULL; districtNameGestori(e) <- NULL;
    clearLocalityIkarGestori(e);
}

clearRegionIkarGestori 'Очистить' (Enterprise e) {
    regionGuidGestori(e) <- NULL; regionNameGestori(e) <- NULL;
    clearDistrictIkarGestori(e);
}

clearCountryIkarGestori 'Очистить' (Enterprise e) {
    countryGuidGestori(e) <- NULL; countryNameGestori(e) <- NULL;
    clearRegionIkarGestori(e);
}

changeCountryIkarGestori (Enterprise e) {
    IF NOT checkIkarUrlGestori() THEN { MESSAGE 'Не задан Url к стенду Ikar (Администрирование - Приложение - Интеграция - Ветис)' NOWAIT; RETURN; }
    clearIkarLocalsGestori();
    count() <- 1000; offset() <- 0;
    LOCAL f = FILE ();
    EXPORT ikarCountryListRequestGestori XML TO f;
    postIkarGestori(f());
    IF ikarRequestErrorGestori() THEN RETURN;
    IMPORT ikarCountryListResponseGestori XML FROM ikarResponseFileGestori();
    appendIkarPageGestori(0);
    DIALOG dialogIkarSelectGestori OBJECTS pg INPUT, i INPUT DO {
        clearCountryIkarGestori(e);
        countryGuidGestori(e) <- ikarAccGuidGestori(pg, i);
        countryNameGestori(e) <- OVERRIDE ikarAccViewGestori(pg, i), ikarAccNameGestori(pg, i);
        updateAddressViewGestori(e);
    }
}

changeRegionIkarGestori (Enterprise e) {
    IF NOT checkIkarUrlGestori() THEN { MESSAGE 'Не задан Url к стенду Ikar (Администрирование - Приложение - Интеграция - Ветис)' NOWAIT; RETURN; }
    IF NOT countryGuidGestori(e) THEN { MESSAGE 'Сначала выберите страну' NOWAIT; RETURN; }
    clearIkarLocalsGestori();
    count() <- 1000; offset() <- 0;
    ikarParentGuidGestori() <- countryGuidGestori(e);
    LOCAL f = FILE ();
    EXPORT ikarRegionListRequestGestori XML TO f;
    postIkarGestori(f());
    IF ikarRequestErrorGestori() THEN RETURN;
    IMPORT ikarRegionListResponseGestori XML FROM ikarResponseFileGestori();
    appendIkarPageGestori(0);
    DIALOG dialogIkarSelectGestori OBJECTS pg INPUT, i INPUT DO {
        clearRegionIkarGestori(e);
        regionGuidGestori(e) <- ikarAccGuidGestori(pg, i);
        regionNameGestori(e) <- OVERRIDE ikarAccViewGestori(pg, i), ikarAccNameGestori(pg, i);
        updateAddressViewGestori(e);
    }
}

changeDistrictIkarGestori (Enterprise e) {
    IF NOT checkIkarUrlGestori() THEN { MESSAGE 'Не задан Url к стенду Ikar (Администрирование - Приложение - Интеграция - Ветис)' NOWAIT; RETURN; }
    IF NOT regionGuidGestori(e) THEN { MESSAGE 'Сначала выберите регион' NOWAIT; RETURN; }
    clearIkarLocalsGestori();
    count() <- 1000; offset() <- 0;
    ikarParentGuidGestori() <- regionGuidGestori(e);
    LOCAL f = FILE ();
    EXPORT ikarDistrictListRequestGestori XML TO f;
    postIkarGestori(f());
    IF ikarRequestErrorGestori() THEN RETURN;
    IMPORT ikarDistrictListResponseGestori XML FROM ikarResponseFileGestori();
    appendIkarPageGestori(0);
    DIALOG dialogIkarSelectGestori OBJECTS pg INPUT, i INPUT DO {
        clearDistrictIkarGestori(e);
        districtGuidGestori(e) <- ikarAccGuidGestori(pg, i);
        districtNameGestori(e) <- OVERRIDE ikarAccViewGestori(pg, i), ikarAccNameGestori(pg, i);
        updateAddressViewGestori(e);
    }
}

changeLocalityIkarGestori (Enterprise e) {
    IF NOT checkIkarUrlGestori() THEN { MESSAGE 'Не задан Url к стенду Ikar (Администрирование - Приложение - Интеграция - Ветис)' NOWAIT; RETURN; }
    IF NOT regionGuidGestori(e) THEN { MESSAGE 'Сначала выберите регион' NOWAIT; RETURN; }
    clearIkarLocalsGestori();
    LOCAL f = FILE ();
    // населённых пунктов в регионе может быть больше страницы сервиса — читаем постранично
    LOCAL pgLoc = INTEGER ();
    LOCAL moreLoc = BOOLEAN ();
    pgLoc() <- 0;
    moreLoc() <- TRUE;
    ikarParentGuidGestori() <- OVERRIDE districtGuidGestori(e), regionGuidGestori(e);
    WHILE moreLoc() AND pgLoc() < maxIkarPagesGestori() DO {
        count() <- 1000; offset() <- pgLoc() * 1000;
        clearIkarPageLocalsGestori();
        IF districtGuidGestori(e) THEN {
            EXPORT ikarLocalityListByDistrictRequestGestori XML TO f;
            postIkarGestori(f());
            IF NOT ikarRequestErrorGestori() THEN IMPORT ikarLocalityListByDistrictResponseGestori XML FROM ikarResponseFileGestori();
        } ELSE {
            EXPORT ikarLocalityListByRegionRequestGestori XML TO f;
            postIkarGestori(f());
            IF NOT ikarRequestErrorGestori() THEN IMPORT ikarLocalityListByRegionResponseGestori XML FROM ikarResponseFileGestori();
        }
        IF ikarRequestErrorGestori() THEN moreLoc() <- NULL;
        ELSE {
            appendIkarPageGestori(pgLoc());
            IF ikarPageSizeGestori() < 1000 THEN moreLoc() <- NULL;
            ELSE pgLoc() <- pgLoc() + 1;
        }
    }
    IF ikarRequestErrorGestori() THEN RETURN;
    DIALOG dialogIkarSelectGestori OBJECTS pg INPUT, i INPUT DO {
        clearLocalityIkarGestori(e);
        localityGuidGestori(e) <- ikarAccGuidGestori(pg, i);
        localityNameGestori(e) <- OVERRIDE ikarAccViewGestori(pg, i), ikarAccNameGestori(pg, i);
        updateAddressViewGestori(e);
    }
}

changeSubLocalityIkarGestori (Enterprise e) {
    IF NOT checkIkarUrlGestori() THEN { MESSAGE 'Не задан Url к стенду Ikar (Администрирование - Приложение - Интеграция - Ветис)' NOWAIT; RETURN; }
    IF NOT localityGuidGestori(e) THEN { MESSAGE 'Сначала выберите населённый пункт' NOWAIT; RETURN; }
    clearIkarLocalsGestori();
    count() <- 1000; offset() <- 0;
    ikarParentGuidGestori() <- localityGuidGestori(e);
    LOCAL f = FILE ();
    EXPORT ikarLocalityListByLocalityRequestGestori XML TO f;
    postIkarGestori(f());
    IF ikarRequestErrorGestori() THEN RETURN;
    IMPORT ikarLocalityListByLocalityResponseGestori XML FROM ikarResponseFileGestori();
    appendIkarPageGestori(0);
    DIALOG dialogIkarSelectGestori OBJECTS pg INPUT, i INPUT DO {
        clearSubLocalityIkarGestori(e);
        subLocalityGuidGestori(e) <- ikarAccGuidGestori(pg, i);
        subLocalityNameGestori(e) <- OVERRIDE ikarAccViewGestori(pg, i), ikarAccNameGestori(pg, i);
        updateAddressViewGestori(e);
    }
}

changeStreetIkarGestori (Enterprise e) {
    IF NOT checkIkarUrlGestori() THEN { MESSAGE 'Не задан Url к стенду Ikar (Администрирование - Приложение - Интеграция - Ветис)' NOWAIT; RETURN; }
    IF NOT localityGuidGestori(e) THEN { MESSAGE 'Сначала выберите населённый пункт' NOWAIT; RETURN; }
    clearIkarLocalsGestori();
    // улицы ищутся в подчинённом населённом пункте, если он выбран, иначе в основном
    ikarParentGuidGestori() <- OVERRIDE subLocalityGuidGestori(e), localityGuidGestori(e);
    LOCAL f = FILE ();
    // улиц может быть больше страницы сервиса (1000) — читаем постранично;
    // следующая страница запрашивается, только если предыдущая пришла полной: запрос с offset
    // больше общего количества записей сервис отклоняет ошибкой «Count out of range»
    LOCAL pgStr = INTEGER ();
    LOCAL moreStr = BOOLEAN ();
    pgStr() <- 0;
    moreStr() <- TRUE;
    WHILE moreStr() AND pgStr() < maxIkarPagesGestori() DO {
        count() <- 1000; offset() <- pgStr() * 1000;
        clearIkarPageLocalsGestori();
        EXPORT ikarStreetListRequestGestori XML TO f;
        postIkarGestori(f());
        IF ikarRequestErrorGestori() THEN moreStr() <- NULL;
        ELSE {
            IMPORT ikarStreetListResponseGestori XML FROM ikarResponseFileGestori();
            appendIkarPageGestori(pgStr());
            IF ikarPageSizeGestori() < 1000 THEN moreStr() <- NULL;
            ELSE pgStr() <- pgStr() + 1;
        }
    }
    IF ikarRequestErrorGestori() THEN RETURN;
    DIALOG dialogIkarSelectGestori OBJECTS pg INPUT, i INPUT DO {
        clearStreetIkarGestori(e);
        streetGuidGestori(e) <- ikarAccGuidGestori(pg, i);
        streetNameGestori(e) <- OVERRIDE ikarAccViewGestori(pg, i), ikarAccNameGestori(pg, i);
        updateAddressViewGestori(e);
    }
}

// адрес пересобирается и при ручном вводе номеров дома/строения/квартиры/индекса/а-я/доп.информации
// (адресные объекты Икара обновляют адрес сразу при выборе или очистке)
WHEN (CHANGED(postIndexGestori(Enterprise e)) OR CHANGED(houseGestori(e)) OR CHANGED(buildingGestori(e)) OR
      CHANGED(roomGestori(e)) OR CHANGED(postBoxGestori(e)) OR CHANGED(additionalInfoGestori(e)))
     AND createdManuallyGestori(e) AND NOT DROPPED(e IS Enterprise) DO
    addressView(e) <- ISTRING(calcAddressViewGestori(e));

// --- Связь «ХС ведёт деятельность на площадке» ---
// владелец площадки (dt:owner) может быть другим ХС — площадки деятельности иначе не видны во вкладке «Площадки»

inActivity 'Ведёт деятельность' = DATA BOOLEAN (BusinessEntity, Enterprise);

afterImportActivityLocation(BusinessEntity b, Enterprise e) + { inActivity(b, e) <- TRUE; }

showActivityEnterprise(BusinessEntity b, Enterprise e) += inActivity(b, e);

// колонка вкладки: для собственных площадок (владелец) отметку не показываем
inActivityNotOwner 'Ведёт деятельность' (BusinessEntity b, Enterprise e) = inActivity(b, e) AND NOT owner(e) = b;

// список ХС, ведущих деятельность на площадке
nameActivityBEs 'Ведёт деятельность' (Enterprise e) = GROUP CONCAT name(BusinessEntity b) IF inActivity(b, e), ', ' ORDER b CHARWIDTH 30;

// --- «Ведет деятельность»: для добавляемой площадки — хозяйствующий субъект из поля «GUID ХС» ---

overNameActivityBEsGestori 'Ведет деятельность' (Enterprise e) =
    OVERRIDE (name(owner(e)) IF createdManuallyGestori(e)), nameActivityBEs(e) CHARWIDTH 30;


// --- Форма карточки площадки: READONLY + вкладки ---

EXTEND FORM enterprise
    PROPERTIES guidOwnerEditGestori 'GUID ХС' = guidOwner(o) ON CHANGE changeOwnerOwnGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES nameEditGestori 'Наименование' = name(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES kppEditGestori 'КПП' = kpp(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES addressViewEditGestori 'Фактический адрес' = addressView(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES(o) READONLY guidViewGestori, uuid, typeDescription, registryStatus, status, overNameActivityBEsGestori
    PROPERTIES countryIkarGestori 'Страна (GUID)' = countryGuidGestori(o) ON CHANGE changeCountryIkarGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES regionIkarGestori 'Регион (GUID)' = regionGuidGestori(o) ON CHANGE changeRegionIkarGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES districtIkarGestori 'Район региона (GUID)' = districtGuidGestori(o) ON CHANGE changeDistrictIkarGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES localityIkarGestori 'Населённый пункт (GUID)' = localityGuidGestori(o) ON CHANGE changeLocalityIkarGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES subLocalityIkarGestori 'Подчиненный населенный пункт (GUID)' = subLocalityGuidGestori(o) ON CHANGE changeSubLocalityIkarGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES streetIkarGestori 'Улица (GUID)' = streetGuidGestori(o) ON CHANGE changeStreetIkarGestori(o) READONLYIF NOT createdManuallyGestori(o)
    PROPERTIES(o) READONLY countryNameGestori, regionNameGestori, districtNameGestori,
        localityNameGestori, subLocalityNameGestori, streetNameGestori
    // адрес пересобирается сразу после ввода — не полагаемся на срабатывание события в сессии формы
    PROPERTIES houseEditGestori 'Номер дома' = houseGestori(o) READONLYIF NOT createdManuallyGestori(o)
        ON CHANGE { INPUT s = STRING[20] DO { houseGestori(o) <- s; updateAddressViewGestori(o); } }
    PROPERTIES buildingEditGestori 'Номер строения' = buildingGestori(o) READONLYIF NOT createdManuallyGestori(o)
        ON CHANGE { INPUT s = STRING[20] DO { buildingGestori(o) <- s; updateAddressViewGestori(o); } }
    PROPERTIES roomEditGestori 'Номер квартиры (офиса)' = roomGestori(o) READONLYIF NOT createdManuallyGestori(o)
        ON CHANGE { INPUT s = STRING[20] DO { roomGestori(o) <- s; updateAddressViewGestori(o); } }
    PROPERTIES postIndexEditGestori 'Почтовый индекс' = postIndexGestori(o) READONLYIF NOT createdManuallyGestori(o)
        ON CHANGE { INPUT s = STRING[10] DO { postIndexGestori(o) <- s; updateAddressViewGestori(o); } }
    PROPERTIES postBoxEditGestori 'Абонентский ящик' = postBoxGestori(o) READONLYIF NOT createdManuallyGestori(o)
        ON CHANGE { INPUT s = STRING[20] DO { postBoxGestori(o) <- s; updateAddressViewGestori(o); } }
    PROPERTIES additionalInfoEditGestori 'Доп.информация' = additionalInfoGestori(o) READONLYIF NOT createdManuallyGestori(o)
        ON CHANGE { INPUT s = ISTRING DO { additionalInfoGestori(o) <- s; updateAddressViewGestori(o); } }
    PROPERTIES(o) READONLYIF NOT createdManuallyGestori(o) activityGestori
    // основание указывается только при добавлении новой площадки
    PROPERTIES(o) reasonGestori SHOWIF createdManuallyGestori(o)
    // очистка адресных объектов (вместе с зависящими от них)
    PROPERTIES(o) SHOWIF createdManuallyGestori(o)
        clearCountryIkarGestori, clearRegionIkarGestori, clearDistrictIkarGestori,
        clearLocalityIkarGestori, clearSubLocalityIkarGestori, clearStreetIkarGestori
;

DESIGN enterprise {
    BOX(o) {
        NEW tabPane {
            tabbed = TRUE;
            fill = 1;
            NEW tabProperties {
                caption = 'Реквизиты';
                MOVE PROPERTY(guidOwnerEditGestori);
                MOVE PROPERTY(nameOwner(o));
                MOVE PROPERTY(typeDescription(o));
                MOVE PROPERTY(guidViewGestori(o));
                MOVE PROPERTY(uuid(o));
                MOVE PROPERTY(nameEditGestori);
                MOVE PROPERTY(kppEditGestori);
                MOVE PROPERTY(addressViewEditGestori);
                MOVE PROPERTY(registryStatus(o));
                MOVE PROPERTY(status(o));
                MOVE PROPERTY(overNameActivityBEsGestori(o));
                MOVE PROPERTY(activityGestori(o));
                NEW addEnterpriseDataGestori {
                    caption = 'Адрес площадки';
                    showIf = createdManuallyGestori(o);
                    NEW countryRowGestori { horizontal = TRUE;
                        MOVE PROPERTY(countryIkarGestori); MOVE PROPERTY(countryNameGestori(o));
                        MOVE PROPERTY(clearCountryIkarGestori(o)); }
                    NEW regionRowGestori { horizontal = TRUE;
                        MOVE PROPERTY(regionIkarGestori); MOVE PROPERTY(regionNameGestori(o));
                        MOVE PROPERTY(clearRegionIkarGestori(o)); }
                    NEW districtRowGestori { horizontal = TRUE;
                        MOVE PROPERTY(districtIkarGestori); MOVE PROPERTY(districtNameGestori(o));
                        MOVE PROPERTY(clearDistrictIkarGestori(o)); }
                    NEW localityRowGestori { horizontal = TRUE;
                        MOVE PROPERTY(localityIkarGestori); MOVE PROPERTY(localityNameGestori(o));
                        MOVE PROPERTY(clearLocalityIkarGestori(o)); }
                    NEW subLocalityRowGestori { horizontal = TRUE;
                        MOVE PROPERTY(subLocalityIkarGestori); MOVE PROPERTY(subLocalityNameGestori(o));
                        MOVE PROPERTY(clearSubLocalityIkarGestori(o)); }
                    NEW streetRowGestori { horizontal = TRUE;
                        MOVE PROPERTY(streetIkarGestori); MOVE PROPERTY(streetNameGestori(o));
                        MOVE PROPERTY(clearStreetIkarGestori(o)); }
                    NEW addressNumbersGestori {
                        horizontal = TRUE;
                        MOVE PROPERTY(houseEditGestori);
                        MOVE PROPERTY(buildingEditGestori);
                        MOVE PROPERTY(roomEditGestori);
                        MOVE PROPERTY(postIndexEditGestori);
                        MOVE PROPERTY(postBoxEditGestori);
                    }
                    MOVE PROPERTY(additionalInfoEditGestori);
                }
                MOVE PROPERTY(reasonGestori(o));
            }
            NEW tabStocks {
                caption = 'Склады';
                fill = 1;
            }
        }
    }
    PROPERTY(guid(o)) { hide = TRUE; }
    PROPERTY(name(o)) { hide = TRUE; }
    PROPERTY(nameOwner(o)) { caption = 'Наименование ХС'; }
}

// --- Вкладка Склады ---

EXTEND FORM enterprise
    OBJECTS s = Stock
    PROPERTIES(s) READONLY name, nameEnterprise, kppLegalEntity
    FILTERS enterprise(s) = o
;

DESIGN enterprise {
    tabStocks {
        fill = 1;
        MOVE BOX(s);
    }
}

// --- importEnterprise: расширение для type / kpp / addressView / registryStatus ---

GROUP importEnterpriseOfficialRegistration EXTID 'dt:officialRegistration';
GROUP importEnterpriseAddress EXTID 'dt:address';
GROUP importEnterpriseActivityList EXTID 'dt:activityList';

// виды деятельности площадки (dt:activityList/dt:activity/dt:name) — на карточке одной строкой через запятую
eActivityName = DATA LOCAL ISTRING (INTEGER);
activityListStringGestori () = GROUP CONCAT eActivityName(INTEGER i), ', ' ORDER i;

eType = DATA LOCAL STRING();
eKpp = DATA LOCAL STRING();
eAddressView = DATA LOCAL STRING();
eStatus = DATA LOCAL STRING();
eStatusVetis = DATA LOCAL STRING();
eUuidVetis = DATA LOCAL STRING();

FORM importEnterpriseDetails FORMEXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:enterprise'
    PROPERTIES() eType EXTID 'dt:type'
    PROPERTIES() eStatus EXTID 'dt:registryStatus'
    PROPERTIES() eStatusVetis EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:status'
    PROPERTIES() eUuidVetis EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:uuid'
    PROPERTIES() IN importEnterpriseOfficialRegistration eKpp EXTID 'dt:kpp'
    PROPERTIES() IN importEnterpriseAddress eAddressView EXTID 'dt:addressView'
    OBJECTS act = INTEGER EXTID 'dt:activity' IN importEnterpriseActivityList
    PROPERTIES(act) eActivityName EXTID 'dt:name'
;

afterImportEnterprise(Enterprise e, TEXT xml) + {
    eActivityName(INTEGER i) <- NULL;
    stringToFile('<dt:enterprise xmlns:dt="http://api.vetrf.ru/schema/cdm/dictionary/v2" xmlns:bs="http://api.vetrf.ru/schema/cdm/base">' +
                  xml +
                  '</dt:enterprise>');
    IMPORT importEnterpriseDetails XML FROM resultFile();
    IF eType() THEN type(e) <- eType();
    IF eKpp() THEN kpp(e) <- STRING[9](eKpp());
    IF eAddressView() THEN addressView(e) <- ISTRING(eAddressView());
    IF eStatus() THEN registryStatus(e) <- eStatus();
    IF eStatusVetis() THEN status(e) <- STRING[5](eStatusVetis());
    IF eUuidVetis() THEN uuid(e) <- eUuidVetis();
    IF activityListStringGestori() THEN activityGestori(e) <- ISTRING(activityListStringGestori());
}

// --- GetEnterpriseByGuid: загрузка полей вручную ---

GROUP getEnterpriseByGuidResponseEnterprise EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:enterprise' : getEnterpriseByGuidResponse;
GROUP getEnterpriseByGuidResponseOfficialReg EXTID 'dt:officialRegistration' : getEnterpriseByGuidResponseEnterprise;
GROUP getEnterpriseByGuidResponseAddress EXTID 'dt:address' : getEnterpriseByGuidResponseEnterprise;
GROUP getEnterpriseByGuidResponseOwner EXTID 'dt:owner' : getEnterpriseByGuidResponseEnterprise;
GROUP getEnterpriseByGuidResponseActivityList EXTID 'dt:activityList' : getEnterpriseByGuidResponseEnterprise;

eOwnerGuid = DATA LOCAL STRING();

FORM getEnterpriseDetailResponse FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES() IN getEnterpriseByGuidResponseEnterprise eType EXTID 'dt:type', eStatus EXTID 'dt:registryStatus',
                 eStatusVetis EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:status',
                 eUuidVetis EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:uuid'
    PROPERTIES() IN getEnterpriseByGuidResponseOfficialReg eKpp EXTID 'dt:kpp'
    PROPERTIES() IN getEnterpriseByGuidResponseAddress eAddressView EXTID 'dt:addressView'
    PROPERTIES() IN getEnterpriseByGuidResponseOwner eOwnerGuid EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid'
    OBJECTS actd = INTEGER EXTID 'dt:activity' IN getEnterpriseByGuidResponseActivityList
    PROPERTIES(actd) eActivityName EXTID 'dt:name'
;

EXTEND FORM enterprises
    PROPERTIES(o) READONLY nameActivityBEs
;

// --- Проверка связи площадки с ХС после загрузки данных ---

checkEnterpriseOwnerGestori (Enterprise e, STRING ownerGuid) {
    // связь с ХС есть в данных Ветис, но ссылка отсутствует или указывает на другой ХС
    IF ownerGuid AND NOT guid(owner(e)) = ownerGuid THEN {
        IF NOT businessEntity(ownerGuid) THEN {
            // экземпляр ХС не найден — создать и выполнить запрос ХС по GUID
            NEWSESSION {
                NEW b = BusinessEntity {
                    guid(b) <- ownerGuid;
                }
                APPLY;
            }
            // запрос площадок ХС при успешной загрузке — внутри getBusinessEntityByGUID 
            getBusinessEntityByGUID(businessEntity(ownerGuid));
        }
        // обновить у площадки ссылку на экземпляр ХС
        IF businessEntity(ownerGuid) THEN NEWSESSION {
            owner(e) <- businessEntity(ownerGuid);
            APPLY;
        }
    }
}

loadEnterpriseDetails 'Загрузить реквизиты' (Enterprise b) {
    NEWSESSION {
        eActivityName(INTEGER i) <- NULL;
        LOCAL requestFile = FILE();
        EXPORT getEnterpriseByGuidRequest OBJECTS e = b XML TO requestFile;
        LOCAL response = FILE();
        TRY {
            EXTERNAL HTTP urlCerberus() HEADERS httpHeaders PARAMS requestFile() TO response;
        } CATCH {
            fileToString(response());
            MESSAGE CONCAT ' ', 'Ошибка при запросе к службе:', resultString();
            RETURN;
        }
        IMPORT getEnterpriseDetailResponse XML FROM response();
        IF eType() THEN type(b) <- eType();
        IF eKpp() THEN kpp(b) <- STRING[9](eKpp());
        IF eAddressView() THEN addressView(b) <- ISTRING(eAddressView());
        IF eStatus() THEN registryStatus(b) <- eStatus();
        IF eStatusVetis() THEN status(b) <- STRING[5](eStatusVetis());
        IF eUuidVetis() THEN uuid(b) <- eUuidVetis();
        IF activityListStringGestori() THEN activityGestori(b) <- ISTRING(activityListStringGestori());
        APPLY NESTED LOCAL; // eOwnerGuid нужен после применения
        checkEnterpriseOwnerGestori(b, eOwnerGuid());
    }
}

// --- GetRussianEnterpriseList_v2: поиск по GUID ---

searchEnterpriseGuid 'GUID' = DATA LOCAL STRING() CHARWIDTH 50;

GROUP getRussianEnterpriseListRequest EXTID 'v2=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getRussianEnterpriseListRequest' : body;
GROUP getRussianEnterpriseListRequestListOptions EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : getRussianEnterpriseListRequest;
GROUP getRussianEnterpriseListRequestEnterprise EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:enterprise' : getRussianEnterpriseListRequest;

FORM getRussianEnterpriseListRequest FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN getRussianEnterpriseListRequestListOptions count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() IN getRussianEnterpriseListRequestEnterprise
        searchEnterpriseGuid EXTID 'base=http://api.vetrf.ru/schema/cdm/base:guid'
;

GROUP getRussianEnterpriseListResponse EXTID 'v2=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getRussianEnterpriseListResponse' : body;
GROUP getRussianEnterpriseListResponseList EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:enterpriseList' : getRussianEnterpriseListResponse;
GROUP russianEnterpriseOwner EXTID 'dt:owner';
GROUP russianEnterpriseAddress EXTID 'dt:address';

entGuid = DATA LOCAL STRING(INTEGER);
entUuid = DATA LOCAL STRING(INTEGER);
entAddressView = DATA LOCAL STRING(INTEGER);
entName = DATA LOCAL STRING(INTEGER);
entType = DATA LOCAL STRING(INTEGER);
entStatus = DATA LOCAL STRING(INTEGER);
entStatusVetis = DATA LOCAL STRING(INTEGER);
entOwnerGuid = DATA LOCAL STRING(INTEGER);
entLast = DATA LOCAL STRING(INTEGER);

FORM getRussianEnterpriseListResponse FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES() IN getRussianEnterpriseListResponseList total EXTID 'dt:total' ATTR
    OBJECTS ent = INTEGER EXTID 'dt:enterprise' IN getRussianEnterpriseListResponseList
    PROPERTIES(ent) entGuid EXTID 'base=http://api.vetrf.ru/schema/cdm/base:guid',
                    entUuid EXTID 'base=http://api.vetrf.ru/schema/cdm/base:uuid',
                    entStatusVetis EXTID 'base=http://api.vetrf.ru/schema/cdm/base:status',
                    entName EXTID 'dt:name',
                    entType EXTID 'dt:type',
                    entStatus EXTID 'dt:registryStatus',
                    entLast EXTID 'base=http://api.vetrf.ru/schema/cdm/base:last'
    PROPERTIES(ent) IN russianEnterpriseOwner entOwnerGuid EXTID 'base=http://api.vetrf.ru/schema/cdm/base:guid'
    PROPERTIES(ent) IN russianEnterpriseAddress entAddressView EXTID 'dt:addressView'
;

// --- GetBusinessMemberByGLN_v2: поиск по GLN ---

searchGlnEnterprise 'GLN' = DATA LOCAL STRING();

GROUP getBusinessMemberByGLNRequest EXTID 'v2=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getBusinessMemberByGLNRequest' : body;

FORM getBusinessMemberByGLNRequest FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN getBusinessMemberByGLNRequest
        searchGlnEnterprise EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:globalID'
;

GROUP getBusinessMemberByGLNResponse EXTID 'v2=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getBusinessMemberByGLNResponse' : body;
GROUP getBusinessMemberByGLNResponseMember EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:businessMember' : getBusinessMemberByGLNResponse;
GROUP getBusinessMemberByGLNResponseEnt EXTID 'dt:enterprise' : getBusinessMemberByGLNResponseMember;
GROUP getBusinessMemberByGLNResponseEntOwner EXTID 'dt:owner' : getBusinessMemberByGLNResponseEnt;

glnEntGuid = DATA LOCAL STRING();
glnEntName = DATA LOCAL STRING();
glnEntType = DATA LOCAL STRING();
glnEntStatus = DATA LOCAL STRING();
glnEntOwnerGuid = DATA LOCAL STRING();

FORM getBusinessMemberByGLNResponse FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES() IN getBusinessMemberByGLNResponseEnt
        glnEntGuid EXTID 'base=http://api.vetrf.ru/schema/cdm/base:guid',
        glnEntStatus EXTID 'base=http://api.vetrf.ru/schema/cdm/base:status',
        glnEntName EXTID 'dt:name',
        glnEntType EXTID 'dt:type'
    PROPERTIES() IN getBusinessMemberByGLNResponseEntOwner glnEntOwnerGuid EXTID 'base=http://api.vetrf.ru/schema/cdm/base:guid'
;

FORM inputGlnEnterprise 'Загрузить площадку по GLN'
    PROPERTIES() searchGlnEnterprise
;

loadEnterpriseByGLN 'Загрузить площадку по GLN' () {
    DIALOG inputGlnEnterprise DO {
        IF NOT searchGlnEnterprise() THEN {
            MESSAGE 'Укажите GLN';
            RETURN;
        }
        searchGlnEnterprise() <- trim(searchGlnEnterprise());
        IF NOT isGlnGestori(searchGlnEnterprise()) THEN {
            MESSAGE 'Некорректный GLN: должно быть ровно 13 цифр';
            RETURN;
        }
        NEWSESSION NESTED LOCAL {
            LOCAL requestFile = FILE();
            EXPORT getBusinessMemberByGLNRequest XML TO requestFile;
            LOCAL response = FILE();
            TRY {
                EXTERNAL HTTP urlCerberus() HEADERS httpHeaders PARAMS requestFile() TO response;
            } CATCH {
                fileToString(response());
                MESSAGE CONCAT ' ', 'Ошибка при запросе к службе:', resultString();
                RETURN;
            }
            IMPORT getBusinessMemberByGLNResponse XML FROM response();
            IF glnEntGuid() THEN {
                IF NOT enterprise(glnEntGuid()) THEN NEW e = Enterprise {
                    guid(e) <- glnEntGuid();
                }
                FOR Enterprise e = enterprise(glnEntGuid()) DO {
                    IF glnEntName() THEN name(e) <- ISTRING(glnEntName());
                    IF glnEntType() THEN type(e) <- glnEntType();
                    IF glnEntStatus() THEN status(e) <- STRING[5](glnEntStatus());
                    gln(e) <- searchGlnEnterprise();
                    // для существующего ХС ссылку ставим сразу; новый ХС создаст и дозагрузит checkEnterpriseOwnerGestori после APPLY
                    IF businessEntity(glnEntOwnerGuid()) THEN owner(e) <- businessEntity(glnEntOwnerGuid());
                }
            }
            APPLY NESTED LOCAL; // glnEntGuid/glnEntOwnerGuid нужны проверке связи ниже
            // проверка связи площадки с ХС
            checkEnterpriseOwnerGestori(enterprise(glnEntGuid()), glnEntOwnerGuid());
        }
    }
}

FORM inputEnterpriseGuid 'Загрузить площадку'
    PROPERTIES() searchEnterpriseGuid
;

loadEnterpriseFromVetis 'Загрузить площадку' () {
    DIALOG inputEnterpriseGuid DO {
        IF NOT searchEnterpriseGuid() THEN {
            MESSAGE 'Укажите GUID площадки';
            RETURN;
        }
        NEWSESSION NESTED LOCAL {
            LOCAL requestFile = FILE();
            offset() <- 0;
            count() <- 100;
            EXPORT getRussianEnterpriseListRequest XML TO requestFile;
            LOCAL response = FILE();
            TRY {
                EXTERNAL HTTP urlCerberus() HEADERS httpHeaders PARAMS requestFile() TO response;
            } CATCH {
                fileToString(response());
                MESSAGE CONCAT ' ', 'Ошибка при запросе к службе:', resultString();
                RETURN;
            }
            IMPORT getRussianEnterpriseListResponse XML FROM response();
            FOR entGuid(INTEGER i) AND entLast(i) = 'true' AND NOT enterprise(entGuid(i)) NEW e = Enterprise DO {
                guid(e) <- entGuid(i);
            }
            FOR Enterprise e = enterprise(entGuid(INTEGER i)) AND entLast(i) = 'true' DO {
                name(e) <- ISTRING(entName(i));
                IF entType(i) THEN type(e) <- entType(i);
                IF entStatus(i) THEN registryStatus(e) <- entStatus(i);
                IF entStatusVetis(i) THEN status(e) <- STRING[5](entStatusVetis(i));
                IF entAddressView(i) THEN addressView(e) <- ISTRING(entAddressView(i));
                IF businessEntity(entOwnerGuid(i)) THEN owner(e) <- businessEntity(entOwnerGuid(i));
            }
            IF (GROUP SUM 1 IF entGuid(INTEGER i) AND entLast(i) = 'true') THEN
                MESSAGE 'Найдено: ' + (GROUP SUM 1 IF entGuid(INTEGER i) AND entLast(i) = 'true') + ' площадок';
            ELSE
                MESSAGE 'Площадки не найдены';
            APPLY NESTED LOCAL; // значения ответа нужны циклам дозагрузки/проверки ниже
            // UUID не задан или отличается — выполнить запрос данных по площадке в Ветис
            FOR Enterprise e = enterprise(entGuid(INTEGER i)) AND entLast(i) = 'true' AND NOT uuid(e) = entUuid(i) DO
                loadEnterpriseDetails(e);
            // проверка связи загруженных площадок с ХС
            FOR Enterprise e = enterprise(entGuid(INTEGER i)) AND entLast(i) = 'true' DO
                checkEnterpriseOwnerGestori(e, STRING(entOwnerGuid(i)));
        }
    }
}

// --- Заявка «Добавление площадки» (ModifyEnterpriseOperation, type CREATE) ---

CLASS ModifyEnterpriseRequestGestori 'Добавление площадки' : ApplicationRequest;
enterpriseGestori = DATA Enterprise (ModifyEnterpriseRequestGestori) INDEXED;
localTransactionId (ModifyEnterpriseRequestGestori r) = LONG(r AS ModifyEnterpriseRequestGestori);

lastModifyRequestGestori (Enterprise e) = GROUP LAST ModifyEnterpriseRequestGestori r ORDER r WHERE enterpriseGestori(r) = e;

GROUP initiatorModEntGestori EXTID 'merc:initiator';
GROUP modificationOperationGestori EXTID 'merc:modificationOperation';
GROUP resultingListModGestori EXTID 'vd:resultingList' : modificationOperationGestori;
GROUP enterpriseModGestori EXTID 'dt:enterprise' : resultingListModGestori;
GROUP addressModGestori EXTID 'dt:address' : enterpriseModGestori;
GROUP countryModGestori EXTID 'dt:country' : addressModGestori;
GROUP regionModGestori EXTID 'dt:region' : addressModGestori;
GROUP districtModGestori EXTID 'dt:district' : addressModGestori;
GROUP localityModGestori EXTID 'dt:locality' : addressModGestori;
GROUP subLocalityModGestori EXTID 'dt:subLocality' : addressModGestori;
GROUP streetModGestori EXTID 'dt:street' : addressModGestori;
GROUP activityListModGestori EXTID 'dt:activityList' : enterpriseModGestori;
GROUP activityModGestori EXTID 'dt:activity' : activityListModGestori;
GROUP ownerModGestori EXTID 'dt:owner' : enterpriseModGestori;
GROUP officialRegModGestori EXTID 'dt:officialRegistration' : enterpriseModGestori;
GROUP officialRegBEModGestori EXTID 'dt:businessEntity' : officialRegModGestori;

FORM modifyEnterpriseRequestGestori FORMEXTID 'merc=http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2:modifyEnterpriseRequest'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2' EXTID 'xmlns:merc',
        ='http://api.vetrf.ru/schema/cdm/mercury/vet-document/v2' EXTID 'xmlns:vd'
    OBJECTS r = ModifyEnterpriseRequestGestori PANEL
    PROPERTIES(r) localTransactionId EXTID 'merc:localTransactionId'
    PROPERTIES(r) IN initiatorModEntGestori loginMercury EXTID 'vd:login'
    PROPERTIES typeModGestori = 'CREATE' IF r IS ModifyEnterpriseRequestGestori EXTID 'vd:type' IN modificationOperationGestori
    PROPERTIES IN enterpriseModGestori
        nameModGestori = name(enterpriseGestori(r)) EXTID 'dt:name',
        typeEnterpriseModGestori = (OVERRIDE type(enterpriseGestori(r)), '1' IF r IS ModifyEnterpriseRequestGestori) EXTID 'dt:type'
    PROPERTIES countryGuidModGestori = countryGuidGestori(enterpriseGestori(r)) EXTID 'bs:guid' IN countryModGestori
    PROPERTIES regionGuidModGestori = regionGuidGestori(enterpriseGestori(r)) EXTID 'bs:guid' IN regionModGestori
    PROPERTIES districtGuidModGestori = districtGuidGestori(enterpriseGestori(r)) EXTID 'bs:guid' IN districtModGestori
    PROPERTIES localityGuidModGestori = localityGuidGestori(enterpriseGestori(r)) EXTID 'bs:guid' IN localityModGestori
    PROPERTIES subLocalityGuidModGestori = subLocalityGuidGestori(enterpriseGestori(r)) EXTID 'bs:guid' IN subLocalityModGestori
    PROPERTIES streetGuidModGestori = streetGuidGestori(enterpriseGestori(r)) EXTID 'bs:guid' IN streetModGestori
    PROPERTIES IN addressModGestori
        houseModGestori = houseGestori(enterpriseGestori(r)) EXTID 'dt:house',
        buildingModGestori = buildingGestori(enterpriseGestori(r)) EXTID 'dt:building',
        roomModGestori = roomGestori(enterpriseGestori(r)) EXTID 'dt:room',
        postIndexModGestori = postIndexGestori(enterpriseGestori(r)) EXTID 'dt:postIndex',
        postBoxModGestori = postBoxGestori(enterpriseGestori(r)) EXTID 'dt:postBox',
        additionalInfoModGestori = additionalInfoGestori(enterpriseGestori(r)) EXTID 'dt:additionalInfo',
        addressViewModGestori = addressView(enterpriseGestori(r)) EXTID 'dt:addressView'
    PROPERTIES activityNameModGestori = activityGestori(enterpriseGestori(r)) EXTID 'dt:name' IN activityModGestori
    PROPERTIES ownerGuidModGestori = guid(owner(enterpriseGestori(r))) EXTID 'bs:guid' IN ownerModGestori
    PROPERTIES innModGestori = inn(owner(enterpriseGestori(r))) EXTID 'dt:inn' IN officialRegBEModGestori
    PROPERTIES kppModGestori = kpp(enterpriseGestori(r)) EXTID 'dt:kpp' IN officialRegModGestori
    PROPERTIES reasonModGestori = reasonGestori(enterpriseGestori(r)) EXTID 'vd:reason' IN modificationOperationGestori
;

isDigitsGestori = FORMULA NULL BOOLEAN 'CASE WHEN $1 ~ \'^[0-9]+$\' THEN 1 ELSE NULL END';

// признак того, что заявка ушла (проверки не отсекли и submit отработал)
sentModifyRequestGestori = DATA LOCAL BOOLEAN ();

sendModifyEnterpriseGestori 'Отправить в Ветис' (Enterprise e) {
    sentModifyRequestGestori() <- NULL;
    IF NOT owner(e) THEN { MESSAGE 'Не заполнено обязательное поле "GUID ХС"' NOWAIT; RETURN; }
    IF NOT own(owner(e)) THEN { MESSAGE 'Владелец площадки должен быть собственным хозяйствующим субъектом' NOWAIT; RETURN; }
    IF NOT inn(owner(e)) THEN { MESSAGE 'У выбранного хозяйствующего субъекта не заполнен ИНН' NOWAIT; RETURN; }
    IF NOT name(e) THEN { MESSAGE 'Не заполнено обязательное поле "Наименование"' NOWAIT; RETURN; }
    IF NOT kpp(e) THEN { MESSAGE 'Не заполнено обязательное поле "КПП"' NOWAIT; RETURN; }
    IF NOT isDigitsGestori(kpp(e)) THEN { MESSAGE 'Поле "КПП" должно содержать только цифры' NOWAIT; RETURN; }
    IF NOT addressView(e) THEN { MESSAGE 'Не заполнено обязательное поле "Фактический адрес"' NOWAIT; RETURN; }
    IF NOT countryGuidGestori(e) THEN { MESSAGE 'Не заполнено обязательное поле "Страна"' NOWAIT; RETURN; }
    IF NOT regionGuidGestori(e) THEN { MESSAGE 'Не заполнено обязательное поле "Регион"' NOWAIT; RETURN; }
    IF NOT localityGuidGestori(e) THEN { MESSAGE 'Не заполнено обязательное поле "Населённый пункт"' NOWAIT; RETURN; }
    IF NOT reasonGestori(e) THEN { MESSAGE 'Не заполнено обязательное поле "Основание добавления записи в реестр"' NOWAIT; RETURN; }
    IF notCompleted(lastModifyRequestGestori(e)) THEN { MESSAGE 'По площадке уже отправлена заявка, дождитесь её обработки («Обмен с Ветис»)' NOWAIT; RETURN; }

    NEWSESSION {
        NEW r = ModifyEnterpriseRequestGestori {
            enterpriseGestori(r) <- e;
            businessEntity(r) <- owner(e);
            EXPORT modifyEnterpriseRequestGestori OBJECTS r = r XML;
            submit(r, exportFile());
            APPLY;
        }
    }
    sentModifyRequestGestori() <- TRUE;
}

// --- Обработка ответа: GUID/UUID/статус созданной площадки (merc:enterprise) ---

respUuidModGestori = DATA LOCAL STRING ();
respGuidModGestori = DATA LOCAL STRING ();
respStatusModGestori = DATA LOCAL STRING ();

GROUP enterpriseRespModGestori EXTID 'merc=http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2:enterprise';

FORM modifyEnterpriseResponseGestori FORMEXTID 'merc=http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2:modifyEnterpriseResponse'
    PROPERTIES() IN enterpriseRespModGestori
        respUuidModGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:uuid',
        respGuidModGestori EXTID 'bs:guid',
        respStatusModGestori EXTID 'bs:status'
;

process (ModifyEnterpriseRequestGestori r) + {
    NEWSESSION {
        respUuidModGestori() <- NULL;
        respGuidModGestori() <- NULL;
        respStatusModGestori() <- NULL;
        stringToFile(response(r));
        IMPORT modifyEnterpriseResponseGestori XML FROM resultFile();

        FOR Enterprise e = enterpriseGestori(r) DO {
            IF respUuidModGestori() THEN uuid(e) <- respUuidModGestori();
            IF respGuidModGestori() THEN {
                guid(e) <- respGuidModGestori();
                createdManuallyGestori(e) <- NULL; // площадка получила GUID — далее ведёт себя как загруженная
            }
            IF respStatusModGestori() THEN status(e) <- STRING[5](respStatusModGestori());
        }
        processed(r) <- TRUE;
        APPLY;
    }
}

// --- Расширение форм ---

EXTEND FORM enterprise
    PROPERTIES(o) SHOWIF NOT createdManuallyGestori(o) loadEnterpriseDetails
;

DESIGN enterprise {
    tabProperties {
        MOVE PROPERTY(loadEnterpriseDetails(o));
    }
    PROPERTY(loadEnterpriseDetails(o)) { caption = 'Обновить площадку'; }
}

// обновление площадок — с подтверждением выполнения
getEnterpriseListConfirmGestori 'Обновить площадки' () { getEnterpriseList(); } CONFIRM;
getEnterpriseListConfirmGestori 'Обновить площадки' (Enterprise e) { getEnterpriseList(e); } CONFIRM;

// submit делает внешний HTTP-вызов, недопустимый в транзакции apply: сохранение карточки только помечает
// площадку, а заявка отправляется после закрытия формы. Пометка — в данных (не LOCAL): значение,
// присвоенное внутри NEWSESSION карточки, наружу не передаётся
needModifyRequestGestori 'Требуется отправка заявки' = DATA BOOLEAN (Enterprise);

// отправка накопленных заявок — вызывается после сохранения карточки, вне транзакции apply
sendPendingEnterpriseRequestsGestori () {
    FOR needModifyRequestGestori(Enterprise e) DO {
        IF createdManuallyGestori(e) AND NOT notCompleted(lastModifyRequestGestori(e)) THEN
            sendModifyEnterpriseGestori(e);
        // пометка снимается только при успешной отправке: иначе заявку можно дослать из «Изменить»
        IF sentModifyRequestGestori() THEN NEWSESSION { needModifyRequestGestori(e) <- NULL; APPLY; }
    }
}

// добавление площадки собственного ХС: карточка с временным кодом (GUID заполнится из ответа Ветис);
// заявка в Ветис уходит после сохранения карточки (кнопки «Сохранить»/«ОК») — аналогично отправке номенклатуры
addEnterpriseGestori 'Добавить' () {
    NEWSESSION {
        NEW e = Enterprise {
            guid(e) <- 'tmp-' + LONG(e AS Enterprise);
            createdManuallyGestori(e) <- TRUE;
            needModifyRequestGestori(e) <- TRUE;    // заявка уйдёт после сохранения карточки
            type(e) <- '1'; // Тип 1 - Предприятие
            SHOW enterprise OBJECTS o = e DOCKED WAIT MANAGESESSION;
        }
    }
    sendPendingEnterpriseRequestsGestori();
}

// изменение добавляемой площадки с отправкой заявки после сохранения
editEnterpriseGestori 'Изменить' (Enterprise e) {
    NEWSESSION {
        SHOW enterprise OBJECTS o = e DOCKED WAIT MANAGESESSION;
    }
    sendPendingEnterpriseRequestsGestori();
}

EXTEND FORM enterprises
    PROPERTIES() DRAW o TOOLBAR loadEnterpriseFromVetis, loadEnterpriseByGLN, addEnterpriseGestori, getEnterpriseListConfirmGestori
    PROPERTIES(o) TOOLBAR editEnterpriseGestori
    PROPERTIES(o) getEnterpriseListConfirmGestori GRID
    PROPERTIES(o) READONLY guidOwner AFTER nameOwner(o), registryStatus, status, typeDescription, kpp, addressView, gln
;

DESIGN enterprises {
    PROPERTY(getEnterpriseList()) { hide = TRUE; }
    PROPERTY(getEnterpriseList(o)) { hide = TRUE; }
    PROPERTY(newEnterprise) { hide = TRUE; }
    PROPERTY(editEnterprise) { hide = TRUE; }
    PROPERTY(guid(o)) { caption = 'GUID площадки'; }
    PROPERTY(nameOwner(o)) { caption = 'Наименование ХС'; }
    PROPERTY(delete) { hide = TRUE; }
}

// --- Дозагрузка ХС-владельцев площадок при загрузке площадок ХС ---

getActivityLocationListGestori 'Загрузить площадки' (BusinessEntity b) {
    getActivityLocationList(b);
    // владелец площадки отличается от запрошенного ХС и ещё не загружен — запросить данные ХС
    FOR BusinessEntity ow IS BusinessEntity AND (GROUP SUM 1 IF inActivity(b, Enterprise e) AND owner(e) = ow) AND NOT ow = b AND NOT name[BusinessEntity](ow) DO
        getBusinessEntityByGUID(ow);
}

// --- Склад/магазин, связанный с площадкой / организацией ---

idStocksGestori 'Код склада/магазина' (Enterprise e) = GROUP CONCAT Stock.id(Stock st) IF enterprise(st) = e, ', ' ORDER st CHARWIDTH 10;
nameStocksGestori 'Наименование склада/магазина' (Enterprise e) = GROUP CONCAT Stock.name(Stock st) IF enterprise(st) = e, ', ' ORDER st CHARWIDTH 30;

idLEGestori 'Код организации' (LegalEntity l) = LegalEntity.id(l) CHARWIDTH 10;

EXTEND FORM businessEntity
    PROPERTIES(e) READONLY kpp, nameOwner
    PROPERTIES READONLY inActivityNotOwner(o, e)
    PROPERTIES(e) READONLY idStocksGestori, nameStocksGestori
    PROPERTIES(l) READONLY idLEGestori BEFORE name(l)
    PROPERTIES(o) getActivityLocationListGestori DRAW e TOOLBAR
;

DESIGN businessEntity {
    PROPERTY(nameOwner(e)) { caption = 'Владелец'; }
    PROPERTY(name(l)) { caption = 'Наименование организации'; }
}

DESIGN businessEntity {
    tabEnterprises {
        MOVE BOX(e);
    }
    PROPERTY(getActivityLocationList(o)) { hide = TRUE; }        // заменена на getActivityLocationListGestori
    PROPERTY(guid(e)) { caption = 'GUID площадки'; }
    PROPERTY(name(e)) { caption = 'Наименование площадки'; }
}

// --- Карточка ХС, вкладка «Организации»: добавление и удаление связи организации с ХС ---

filterFitLEForBEGestori 'Подходящие организации' = DATA LOCAL BOOLEAN ();
// подходящей считается организация с совпадающим ИНН, КПП или ОГРН
fitLEForBEGestori (LegalEntity l, BusinessEntity b) = inn(l) == inn(b) OR kpp(l) == kpp(b) OR ogrn(l) == ogrn(b);

FORM dialogLEForBusinessEntityGestori 'Организации'
    OBJECTS bo = BusinessEntity PANEL
    OBJECTS l = LegalEntity
    PROPERTIES() filterFitLEForBEGestori
    PROPERTIES(l) READONLY idLEGestori, name, inn, kpp, ogrn, nameBusinessEntity
    FILTERS NOT filterFitLEForBEGestori() OR fitLEForBEGestori(l, bo)
;

DESIGN dialogLEForBusinessEntityGestori {
    PROPERTY(name(l)) { caption = 'Наименование организации'; }
}

addLEBusinessEntityGestori 'Добавить' (BusinessEntity b) {
    filterFitLEForBEGestori() <- TRUE;
    DIALOG dialogLEForBusinessEntityGestori OBJECTS bo = b, l INPUT DO businessEntity(l) <- b;
}

deleteLEBusinessEntityGestori 'Удалить' (LegalEntity l) {
    businessEntity(l) <- NULL;
}

// --- Карточка ХС, вкладка «Площадки»: связь площадки со складом/магазином ---

kppStock 'КПП' = ABSTRACT STRING[9] (Stock);    // КПП склада/магазина — реализуется в проектных модулях

filterFitStockForEntGestori 'Подходящие склады' = DATA LOCAL BOOLEAN ();
// подходящим считается склад с совпадающим КПП или GLN площадки
fitStockForEntGestori (Stock st, Enterprise e) = kppStock(st) == kpp(e) OR GLN(st) == gln(e);

FORM dialogStockForEnterpriseGestori 'Склады организаций ХС'
    OBJECTS bo = BusinessEntity PANEL
    OBJECTS eo = Enterprise PANEL
    OBJECTS st = Stock
    PROPERTIES() filterFitStockForEntGestori
    PROPERTIES READONLY idSt 'Код' = Stock.id(st), nameSt 'Наименование склада' = Stock.name(st)
    PROPERTIES(st) READONLY kppStock
    PROPERTIES READONLY glnSt 'GLN' = GLN(st), nameLESt 'Наименование организации' = name(legalEntity(st))
    FILTERS businessEntity(legalEntity(st)) == bo,
            NOT filterFitStockForEntGestori() OR fitStockForEntGestori(st, eo)
;

addStockEnterpriseGestori 'Добавить связь' (BusinessEntity b, Enterprise e) {
    filterFitStockForEntGestori() <- TRUE;
    DIALOG dialogStockForEnterpriseGestori OBJECTS bo = b, eo = e, st INPUT DO enterprise(st) <- e;
}

FORM dialogStocksOfEnterpriseGestori 'Склады площадки'
    OBJECTS eo = Enterprise PANEL
    OBJECTS st = Stock
    PROPERTIES READONLY idSt 'Код' = Stock.id(st), nameSt 'Наименование склада' = Stock.name(st)
    PROPERTIES(st) READONLY kppStock
    PROPERTIES READONLY glnSt 'GLN' = GLN(st), nameLESt 'Наименование организации' = name(legalEntity(st))
    FILTERS enterprise(st) == eo
;

deleteStockEnterpriseGestori 'Удалить связь' (Enterprise e) {
    DIALOG dialogStocksOfEnterpriseGestori OBJECTS eo = e, st INPUT DO enterprise(st) <- NULL;
}

EXTEND FORM businessEntity
    PROPERTIES(o) addLEBusinessEntityGestori DRAW l TOOLBAR
    PROPERTIES deleteLEBusinessEntityGestori(l) TOOLBAR
    PROPERTIES addStockEnterpriseGestori(o, e) DRAW e TOOLBAR
    PROPERTIES deleteStockEnterpriseGestori(e) TOOLBAR
;
