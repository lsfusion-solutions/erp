MODULE VetisEnterpriseGestori;

REQUIRE VetisEnterpriseImport, VetisStock, EGAISStockGestori, VetisBusinessEntityGestori, VetisAMSSubmitRequest, VetisAMSReceiveResponse, VetisBusinessEntityOwn, EDIGLN;

NAMESPACE Vetis;

// --- Новые свойства площадки ---

type 'Тип площадки' = DATA STRING (Enterprise) CHARWIDTH 20;
kpp 'КПП' = DATA STRING[9] (Enterprise) CHARWIDTH 9;
addressView 'Фактический адрес' = DATA ISTRING (Enterprise) CHARWIDTH 60;
gln 'GLN' = DATA STRING (Enterprise) CHARWIDTH 13;
registryStatus 'Статус' = DATA STRING (Enterprise) CHARWIDTH 20;
status 'Статус Ветис' = DATA STRING[5] (Enterprise) CHARWIDTH 5;
uuid 'UUID площадки' = DATA STRING (Enterprise) CHARWIDTH 36;

guidOwner 'GUID ХС' (Enterprise e) = guid(owner(e));

// --- Добавление площадки собственного ХС ---

createdManuallyGestori 'Добавлена вручную' = DATA BOOLEAN (Enterprise);

// GUID площадки: для добавленной вручную временный код не показывается (заполнится из ответа Ветис)
guidViewGestori 'GUID площадки' (Enterprise e) = guid(e) IF NOT createdManuallyGestori(e);

// адрес площадки для заявки на добавление (GUID-ы адресных объектов Ветис)
countryGuidGestori 'Страна (GUID)' = DATA STRING (Enterprise) CHARWIDTH 36;
regionGuidGestori 'Регион (GUID)' = DATA STRING (Enterprise) CHARWIDTH 36;
districtGuidGestori 'Район региона (GUID)' = DATA STRING (Enterprise) CHARWIDTH 36;
localityGuidGestori 'Населённый пункт (GUID)' = DATA STRING (Enterprise) CHARWIDTH 36;
subLocalityGuidGestori 'Подчиненный населенный пункт (GUID)' = DATA STRING (Enterprise) CHARWIDTH 36;
streetGuidGestori 'Улица (GUID)' = DATA STRING (Enterprise) CHARWIDTH 36;
houseGestori 'Номер дома' = DATA STRING[20] (Enterprise);
buildingGestori 'Номер строения' = DATA STRING[20] (Enterprise);
roomGestori 'Номер квартиры (офиса)' = DATA STRING[20] (Enterprise);
postIndexGestori 'Почтовый индекс' = DATA STRING[10] (Enterprise);
postBoxGestori 'Абонентский ящик' = DATA STRING[20] (Enterprise);
additionalInfoGestori 'Доп.информация' = DATA ISTRING (Enterprise) CHARWIDTH 40;

activityGestori 'Вид деятельности предприятия' = DATA ISTRING (Enterprise) CHARWIDTH 40;
reasonGestori 'Основание добавления записи в реестр' = DATA ISTRING (Enterprise) CHARWIDTH 50;

// выбор владельца — только собственные хозяйствующие субъекты
FORM dialogOwnBusinessEntitiesGestori 'Хозяйствующие субъекты (собственные)'
    OBJECTS b = BusinessEntity
    PROPERTIES(b) READONLY guid, name, inn
    FILTERS own(b)
;

changeOwnerOwnGestori (Enterprise e) {
    DIALOG dialogOwnBusinessEntitiesGestori OBJECTS b INPUT DO owner(e) <- b;
}

typeDescription 'Тип площадки' (Enterprise e) = CASE
    WHEN type(e) = '1' THEN 'Предприятие'
    WHEN type(e) = '2' THEN 'Рынок'
    WHEN type(e) = '3' THEN 'СББЖ'
    WHEN type(e) = '4' THEN 'Судно'
    ELSE type(e);

// --- Сервис «Икар»: справочники адресных объектов Ветис ---

urlIkarGestori 'Url к стенду Ikar' = DATA STRING ();
fillDefaultIkarProdGestori 'Заполнить по-умолчанию (Продуктивный контур)' () {
    urlIkarGestori() <- 'https://api.vetrf.ru/platform/services/2.1/IkarService';
}
fillDefaultIkarTestGestori 'Заполнить по-умолчанию (Тестовый контур)' () {
    urlIkarGestori() <- 'https://api2.vetrf.ru:8002/platform/services/2.1/IkarService';
}

EXTEND FORM integrationData
    PROPERTIES urlIkarGestori(), fillDefaultIkarProdGestori(), fillDefaultIkarTestGestori()
;
DESIGN integrationData {
    vetis {
        MOVE PROPERTY(urlIkarGestori());
        NEW ikarDefaultsGestori {
            horizontal = TRUE;
            MOVE PROPERTY(fillDefaultIkarProdGestori());
            MOVE PROPERTY(fillDefaultIkarTestGestori());
        }
    }
}

// названия выбранных адресных объектов (показываются справа от GUID-полей, участвуют в фактическом адресе)
countryNameGestori 'Страна' = DATA ISTRING (Enterprise) CHARWIDTH 25;
regionNameGestori 'Регион' = DATA ISTRING (Enterprise) CHARWIDTH 25;
districtNameGestori 'Район региона' = DATA ISTRING (Enterprise) CHARWIDTH 25;
localityNameGestori 'Населённый пункт' = DATA ISTRING (Enterprise) CHARWIDTH 25;
subLocalityNameGestori 'Подчиненный населенный пункт' = DATA ISTRING (Enterprise) CHARWIDTH 25;
streetNameGestori 'Улица' = DATA ISTRING (Enterprise) CHARWIDTH 25;

// --- Запросы к Икару (однотипные: listOptions + GUID родителя) ---

ikarGuidGestori = DATA LOCAL STRING (INTEGER);
ikarNameGestori = DATA LOCAL ISTRING (INTEGER);
ikarViewGestori = DATA LOCAL ISTRING (INTEGER);
ikarParentGuidGestori = DATA LOCAL STRING ();

// аккумулятор загруженных страниц (страница, запись): сервис отдаёт не более 1000 записей за запрос
ikarAccGuidGestori = DATA LOCAL STRING (INTEGER, INTEGER);
ikarAccNameGestori = DATA LOCAL ISTRING (INTEGER, INTEGER);
ikarAccViewGestori = DATA LOCAL ISTRING (INTEGER, INTEGER);
ikarPageSizeGestori = DATA LOCAL INTEGER ();
maxIkarPagesGestori () = 20;    // страховка от бесконечного чтения страниц справочника

appendIkarPageGestori (INTEGER pg) {
    ikarPageSizeGestori() <- (OVERRIDE (GROUP SUM 1 IF ikarGuidGestori(INTEGER i)), 0);
    ikarAccGuidGestori(pg, INTEGER i) <- ikarGuidGestori(i) WHERE ikarGuidGestori(i);
    ikarAccNameGestori(pg, INTEGER i) <- ikarNameGestori(i) WHERE ikarGuidGestori(i);
    ikarAccViewGestori(pg, INTEGER i) <- ikarViewGestori(i) WHERE ikarGuidGestori(i);
}

GROUP ikarCountryReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getAllCountryListRequest' : body;
GROUP ikarCountryReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarCountryReqGestori;
FORM ikarCountryListRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarCountryReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
;

GROUP ikarRegionReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getRegionListByCountryRequest' : body;
GROUP ikarRegionReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarRegionReqGestori;
FORM ikarRegionListRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarRegionReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() ikarParentGuidGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:countryGuid' IN ikarRegionReqGestori
;

GROUP ikarDistrictReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getDistrictListByRegionRequest' : body;
GROUP ikarDistrictReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarDistrictReqGestori;
FORM ikarDistrictListRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarDistrictReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() ikarParentGuidGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:regionGuid' IN ikarDistrictReqGestori
;

GROUP ikarLocalityRegionReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getLocalityListByRegionRequest' : body;
GROUP ikarLocalityRegionReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarLocalityRegionReqGestori;
FORM ikarLocalityListByRegionRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarLocalityRegionReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() ikarParentGuidGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:regionGuid' IN ikarLocalityRegionReqGestori
;

GROUP ikarLocalityDistrictReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getLocalityListByDistrictRequest' : body;
GROUP ikarLocalityDistrictReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarLocalityDistrictReqGestori;
FORM ikarLocalityListByDistrictRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarLocalityDistrictReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() ikarParentGuidGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:districtGuid' IN ikarLocalityDistrictReqGestori
;

GROUP ikarLocalityLocalityReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getLocalityListByLocalityRequest' : body;
GROUP ikarLocalityLocalityReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarLocalityLocalityReqGestori;
FORM ikarLocalityListByLocalityRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarLocalityLocalityReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() ikarParentGuidGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:localityGuid' IN ikarLocalityLocalityReqGestori
;

GROUP ikarStreetReqGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getStreetListByLocalityRequest' : body;
GROUP ikarStreetReqOptGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:listOptions' : ikarStreetReqGestori;
FORM ikarStreetListRequestGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    PROPERTIES ATTR
        ='http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2' EXTID 'xmlns:ws',
        ='http://api.vetrf.ru/schema/cdm/base' EXTID 'xmlns:bs',
        ='http://api.vetrf.ru/schema/cdm/dictionary/v2' EXTID 'xmlns:dt'
    PROPERTIES() header EXTID 'soapenv:Header'
    PROPERTIES() IN ikarStreetReqOptGestori count EXTID 'bs:count', offset EXTID 'bs:offset'
    PROPERTIES() ikarParentGuidGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:localityGuid' IN ikarStreetReqGestori
;

// --- Разбор ответов ---

GROUP ikarCountryRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getAllCountryListResponse' : body;
GROUP ikarCountryListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:countryList' : ikarCountryRespGestori;
FORM ikarCountryListResponseGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    OBJECTS c = INTEGER EXTID 'dt:country' IN ikarCountryListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
                  ikarViewGestori EXTID 'dt:fullName'
;

GROUP ikarRegionRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getRegionListByCountryResponse' : body;
GROUP ikarRegionListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:regionList' : ikarRegionRespGestori;
FORM ikarRegionListResponseGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    OBJECTS c = INTEGER EXTID 'dt:region' IN ikarRegionListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
                  ikarViewGestori EXTID 'dt:view'
;

GROUP ikarDistrictRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getDistrictListByRegionResponse' : body;
GROUP ikarDistrictListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:districtList' : ikarDistrictRespGestori;
FORM ikarDistrictListResponseGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    OBJECTS c = INTEGER EXTID 'dt:district' IN ikarDistrictListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
                  ikarViewGestori EXTID 'dt:view'
;

GROUP ikarLocalityRegionRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getLocalityListByRegionResponse' : body;
GROUP ikarLocalityRegionListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:localityList' : ikarLocalityRegionRespGestori;
FORM ikarLocalityListByRegionResponseGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    OBJECTS c = INTEGER EXTID 'dt:locality' IN ikarLocalityRegionListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
