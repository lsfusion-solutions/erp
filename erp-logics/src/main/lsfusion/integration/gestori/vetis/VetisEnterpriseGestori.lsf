;

GROUP ikarLocalityDistrictRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getLocalityListByDistrictResponse' : body;
GROUP ikarLocalityDistrictListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:localityList' : ikarLocalityDistrictRespGestori;
FORM ikarLocalityListByDistrictResponseGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    OBJECTS c = INTEGER EXTID 'dt:locality' IN ikarLocalityDistrictListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
                  ikarViewGestori EXTID 'dt:view'
;

GROUP ikarLocalityLocalityRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getLocalityListByLocalityResponse' : body;
GROUP ikarLocalityLocalityListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:localityList' : ikarLocalityLocalityRespGestori;
FORM ikarLocalityListByLocalityResponseGestori FORMEXTID 'soapenv=http://schemas.xmlsoap.org/soap/envelope/:Envelope'
    OBJECTS c = INTEGER EXTID 'dt:locality' IN ikarLocalityLocalityListGestori
    PROPERTIES(c) ikarGuidGestori EXTID 'bs=http://api.vetrf.ru/schema/cdm/base:guid',
                  ikarNameGestori EXTID 'dt:name',
                  ikarViewGestori EXTID 'dt:view'
;

GROUP ikarStreetRespGestori EXTID 'ws=http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2:getStreetListByLocalityResponse' : body;
GROUP ikarStreetListGestori EXTID 'dt=http://api.vetrf.ru/schema/cdm/dictionary/v2:streetList' : ikarStreetRespGestori;
