MODULE VetisItemPackingTypeGestori;

REQUIRE VetisPackingTypeGestori, VetisProductItemGestori;

NAMESPACE Vetis;

packingTypeItemGestori 'Тип упаковки Ветис' = DATA PackingTypeGestori (Item);
namePackingTypeItemGestori 'Тип упаковки Ветис' (Item i) = nameGestori(packingTypeItemGestori(i));

changePackingTypeItemGestori (Item i) {
    DIALOG dialogPackingTypeSelectGestori OBJECTS o = packingTypeItemGestori(i) INPUT NULL DO
        packingTypeItemGestori(i) <- o;
}

EXTEND FORM item
    PROPERTIES(i) namePackingTypeItemGestori ON CHANGE changePackingTypeItemGestori(i)
;

DESIGN item {
    BOX(pi) {
        MOVE PROPERTY(namePackingTypeItemGestori(i)) AFTER PROPERTY(controlledProductGestori(i));
    }
}
