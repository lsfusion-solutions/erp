MODULE VetisItemPackingTypeGestori;

REQUIRE VetisPackingTypeGestori, VetisProductItemGestori;

NAMESPACE Vetis;

// тип упаковки Ветис у товара; в подкарточке GESTORI (параметр 96) хранится буквенный код типа упаковки
packingTypeItemGestori 'Тип упаковки Ветис' = DATA PackingTypeGestori (Item);
namePackingTypeItemGestori 'Тип упаковки Ветис' (Item i) = name(packingTypeItemGestori(i));

EXTEND FORM item
    PROPERTIES(i) packingTypeItemGestori
;

DESIGN item {
    BOX(pi) {
        MOVE PROPERTY(packingTypeItemGestori(i)) AFTER PROPERTY(controlledProductGestori(i));
    }
}
