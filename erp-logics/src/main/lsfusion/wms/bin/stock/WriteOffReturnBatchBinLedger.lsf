MODULE WriteOffReturnBatchBinLedger;

REQUIRE WriteOffReturnBinLedger, BatchBinLedger;

NAMESPACE WriteOffReturn;

@implementAggregationBatchBinLedger(writeOffDetail, writeOff, WriteOff, batch, quantity, stock);

skip[BinLedger] (WriteOffBinLedger ledger) += TRUE IF inBin(ledger) AND NOT costed(writeOffDetail(ledger));