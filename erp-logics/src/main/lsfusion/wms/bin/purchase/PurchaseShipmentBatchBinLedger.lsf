MODULE PurchaseShipmentBatchBinLedger;

REQUIRE PurchaseShipmentBinLedger, BatchBinLedger;

NAMESPACE Purchase;

batch[BinLedger] (ShipmentBinLedger ledger) += ledgerBatch(shipmentDetail(ledger));

skip[BinLedger] (ShipmentBinLedger ledger) += TRUE IF inBin(ledger) AND shipmentSkuLedger(shipmentDetail(ledger))
    AND NOT costed(shipmentSkuLedger(shipmentDetail(ledger)));