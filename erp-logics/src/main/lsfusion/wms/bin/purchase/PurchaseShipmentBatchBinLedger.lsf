MODULE PurchaseShipmentBatchBinLedger;

REQUIRE PurchaseShipmentBinLedger, BatchBinLedger;

NAMESPACE Purchase;

batch[BinLedger] (ShipmentBinLedger ledger) += ledgerBatch(shipmentDetail(ledger));

skip[BinLedger] (ShipmentBinLedger ledger) += TRUE IF inBin(ledger) AND batch(ledger) AND shipmentSkuLedger(shipmentDetail(ledger))
    AND NOT cost(shipmentSkuLedger(shipmentDetail(ledger)), batch(ledger)) >= quantity(ledger);