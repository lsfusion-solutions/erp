MODULE SaleReturnShipmentBatchBinLedger;

REQUIRE SaleReturnShipmentBinLedger, BatchBinLedger;

NAMESPACE SaleReturn;

@implementAggregationBatchBinLedger(shipmentDetail, shipment, Shipment, batch, quantity, supplierStock);

skip[BinLedger] (ShipmentBinLedger ledger) += TRUE IF inBin(ledger) AND NOT costed(shipmentDetail(ledger));