MODULE PurchaseShipmentFuelBy;

REQUIRE PurchaseShipmentFuel, PurchaseInvoiceFuelLtr, Store;

NAMESPACE Purchase;

skipShowVolumeFuel(Invoice i) += customerStock(i) IS DepartmentStore;
showWeightFuel(Invoice i) += customerStock(i) IS DepartmentStore;

@defineItemFuelConstraint (orderDetail, customerStock, );

@defineItemFuelConstraint (invoiceDetail, customerStock, );