MODULE SaleShipmentFuelBy;

REQUIRE SaleShipmentFuel, SaleInvoiceFuelLtr, Store;

NAMESPACE Sale;

skipShowVolumeFuel(Invoice i) += supplierStock(i) IS DepartmentStore;
showWeightFuel(Invoice i) += supplierStock(i) IS DepartmentStore;

@defineItemFuelConstraint (orderDetail, supplierStock, );

@defineItemFuelConstraint (invoiceDetail, supplierStock, );