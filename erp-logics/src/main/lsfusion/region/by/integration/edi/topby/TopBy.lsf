MODULE TopBy;

REQUIRE TopByApi;

NAMESPACE EDI;

EXTEND CLASS EDIProvider {
    topBy 'СТТ'
}
prefix(EDIProvider e) += WHEN e == EDIProvider.topBy THEN '001-';
name(EDIProvider e) += WHEN e == EDIProvider.topBy THEN 'ООО "Современные технологии торговли"';
gln(EDIProvider e) += WHEN e == EDIProvider.topBy THEN '4814920900007';
EDIProvider(STRING[100] p) += WHEN p == 'TopBy' THEN EDIProvider.topBy;

CLASS TopByProfile 'Профиль СТТ' : SoapProfile;
host 'Хост' = DATA STRING[100] (TopByProfile);
port 'Порт' = DATA INTEGER (TopByProfile);
url(TopByProfile p) += 'http://' + host(p) + ':' + port(p) + '/DmcService';

profileTopBy = DATA TopByProfile (LegalEntity);
loginProfileTopBy 'Профиль СТТ' (LegalEntity l) = login(profileTopBy(l));
passwordProfileTopBy (LegalEntity l) = password(profileTopBy(l));
urlProfileTopBy (LegalEntity l) = url(profileTopBy(l));
topByProfile (STRING[100] login) = GROUP MIN TopByProfile p IF p IS TopByProfile BY login(p);

FORM topByProfile 'Профиль СТТ'
    OBJECTS p = TopByProfile PANEL
    PROPERTIES (p) login, password, host, port, url READONLY

    EDIT TopByProfile OBJECT p
;

FORM topByProfiles 'Профили СТТ'
    OBJECTS p = TopByProfile
    PROPERTIES (p) READONLY login, host, port, url
    PROPERTIES (p) NEWSESSION NEW, EDIT, DELETE

    LIST TopByProfile OBJECT p
;

//параметры подключения до перехода на профили, используются только миграцией
loginTopBy 'Имя пользователя' = DATA STRING[100] (LegalEntity);
passwordTopBy 'Пароль' = DATA STRING[100] (LegalEntity) ECHO;
hostTopBy 'Хост' = DATA STRING[100] (LegalEntity);
portTopBy 'Порт' = DATA INTEGER (LegalEntity);

migrateProfileTopBy() {
    FOR LegalEntity le == [GROUP MIN LegalEntity l BY loginTopBy(l)](STRING[100] lg) NEW p = TopByProfile DO {
        login(p) <- lg;
        password(p) <- passwordTopBy(le);
        host(p) <- hostTopBy(le);
        port(p) <- portTopBy(le);
    }
    profileTopBy(LegalEntity le) <- topByProfile(loginTopBy(le)) WHERE loginTopBy(le);
}
@defOnStartMigrate(migrateProfileTopBy, 'Профили СТТ');

archiveDirTopBy 'Папка принятых сообщений' = DATA STRING[100] ();
outputDirTopBy 'Папка отправленных сообщений' = DATA STRING[100] ();
disableConfirmationTopBy 'Отключить подтверждение сообщений' = DATA BOOLEAN ();
receiveSupplierMessagesTopBy 'Получать сообщения для поставщика' = DATA BOOLEAN ();

lockedTopBy = DATA User (STRING) TABLE stringEDI;
lockResultTopBy = DATA LOCAL NESTED BOOLEAN ();

lockTopBy(STRING object)  { 
    NEWSESSION {    
        lockResultTopBy() <- NULL;
        APPLY SERIALIZABLE {
            IF NOT object THEN
                RETURN;
            IF lockedTopBy(object) THEN {
                cancel();
            } ELSE {
                lockedTopBy(object) <- currentUser();
                lockResultTopBy() <- TRUE;
            }
        }
    }
}

unlockTopBy(STRING object)  { 
    NEWSESSION { 
        APPLY lockedTopBy(object) <- NULL;
    }
}

onStarted()+ { 
    NEWSESSION {
        lockedTopBy(STRING l) <- NULL WHERE lockedTopBy(l);
        APPLY;      
    }
}

receiveMessagesTopBy () {
    FOR TopByProfile p IS TopByProfile AND login(p) AND password(p) DO {
        NEWSESSION {
            lockTopBy(login(p));
            IF lockResultTopBy() THEN {
                TRY {
                    newNS() <- TRUE;
                    receiveMessages(login(p), password(p), url(p), archiveDirTopBy(), disableConfirmationTopBy(), 'TopBy');
                } FINALLY {
                    unlockTopBy(login(p));
                }
            } ELSE {
                MESSAGE 'Уже выполняется получение сообщений TopBy для ' + login(p) + '. Подождите...' NOWAIT;
            }
        }
    }
}

receiveTopBy 'Получить сообщения' {
    checkIsServer();
    IF isServer() THEN {receiveMessagesTopBy(); };
}

listMessagesTopBy 'Просмотр очереди' (LegalEntity le) {
    listMessages(loginProfileTopBy(le), passwordProfileTopBy(le), urlProfileTopBy(le), archiveDirTopBy(), disableConfirmationTopBy(), 'TopBy');
} TOOLBAR;

EXTEND FORM integrationData
    PROPERTIES() archiveDirTopBy, outputDirTopBy, disableConfirmationTopBy, receiveTopBy
    
    OBJECTS let = LegalEntity
    FILTERS isCompany(let)
    PROPERTIES(let) name READONLY, loginProfileTopBy, listMessagesTopBy
;
    
DESIGN integrationData {
    edi {
        NEW vs {
            caption = 'СТТ';
            horizontal = TRUE;
            NEW col1TopBy {
                NEW params {
                    caption = 'Общие';
                    MOVE PROPERTY(archiveDirTopBy());
                    MOVE PROPERTY(outputDirTopBy());
                    MOVE PROPERTY(disableConfirmationTopBy());
                    MOVE PROPERTY(receiveTopBy());
                }
            }
            NEW col2TopBy {
                fill = 1;
                MOVE BOX(let);
            }
        }
    }
}
