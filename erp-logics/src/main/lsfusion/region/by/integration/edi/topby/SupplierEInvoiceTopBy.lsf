MODULE SupplierEInvoiceTopBy;

REQUIRE EInvoiceTopBy, SupplierEInvoiceTopByApi, EInvoiceEDSTopBy;

signAndSendSupplierEInvoiceV2 ABSTRACT LIST (EInvoice, LegalEntity, STRING[100], STRING[100]);
signAndSendSupplier(EInvoice e) + {
    IF EDIProviderInvoice(customer(e), supplier(e)) == EDIProvider.topBy AND NOT skipSendSupplier(e) THEN {
        newNS() <- TRUE;
        IF exportedSupplier(e) THEN
            MESSAGE 'Накладная (поставщик) уже отправлена';
        ELSE {
            IF useV2EDI() THEN {
                signAndSendSupplierEInvoiceV2(e, supplier(e), (OVERRIDE overInvoiceOutputDirTopBy(e), outputDirTopBy()), 'TopBy');
            } ELSE {
                IF isTN2(e) THEN {
                    signAndSendSupplierEInvoiceTN2(e, loginProfileTopBy(supplier(e)), passwordProfileTopBy(supplier(e)), urlProfileTopBy(supplier(e)), (OVERRIDE overInvoiceOutputDirTopBy(e), outputDirTopBy()), 'TopBy');
                } ELSE {
                    signAndSendSupplierEInvoice(e, loginProfileTopBy(supplier(e)), passwordProfileTopBy(supplier(e)), urlProfileTopBy(supplier(e)), (OVERRIDE overInvoiceOutputDirTopBy(e), outputDirTopBy()), 'TopBy');
                }
            }
        }
    }
}

signAndSendBlrapnSupplierEInvoiceV2 ABSTRACT LIST (EInvoice, LegalEntity, STRING[100]);
signAndSendBlrapnSupplier(EInvoice e) + {
    IF EDIProviderInvoice(customer(e), supplier(e)) == EDIProvider.topBy AND NOT skipSendSupplier(e) THEN {
        newNS() <- TRUE;
        IF exportedBlrapnSupplier(e) THEN
            MESSAGE 'Извещение о прочтении (поставщик) уже отправлено';
        ELSE {
            IF useV2EDI() THEN {
                signAndSendBlrapnSupplierEInvoiceV2(e, supplier(e), 'TopBy');
            } ELSE signAndSendBlrapnSupplierEInvoice(e, loginProfileTopBy(supplier(e)), passwordProfileTopBy(supplier(e)), urlProfileTopBy(supplier(e)), (OVERRIDE overInvoiceOutputDirTopBy(e), outputDirTopBy()), 'TopBy', TRUE);
        }
    }
}

signAndSendSupplier(ECreditNote c) + {
    IF EDIProvider(customer(c)) == EDIProvider.topBy THEN {
        newNS() <- TRUE;
        IF exportedSupplier(c) THEN MESSAGE 'Акт приемки (поставщик) уже отправлен';
        ELSE MESSAGE 'Отправка ответа на акт приемки не поддерживается'; 
            //signAndSendSupplierECreditNote(c,loginProfileTopBy(supplier(c)), passwordProfileTopBy(supplier(c)), urlProfileTopBy(supplier(c)), outputDirTopBy(), 'TopBy');
    }
}

signAndSendConfirmSupplierV2 ABSTRACT LIST (EInvoice, LegalEntity, STRING[100]);
signAndSendConfirmSupplier (EInvoice e) + {
    IF EDIProviderInvoice(customer(e), supplier(e)) == EDIProvider.topBy THEN {
        newNS() <- TRUE;

        IF useV2EDI() THEN {
            signAndSendConfirmSupplierV2(e, supplier(e), 'TopBy');
        }
    }
}

//V2

signAndSendSupplierEInvoiceV2 (EInvoice ei, LegalEntity le, STRING[100] outputDir, STRING[100] provider) + {
    LOCAL result = FILE ();
    LOCAL ewaybill = FILE ();
    TRY {
        IF NOT profile(le) THEN {
            logToFile('edi', provider + 'SendEInvoice V2: не задан профиль организации получателя');
            MESSAGE provider + 'Накладная не выгружена: не задан профиль организации получателя' NOWAIT;
            RETURN;
        }
        IF NOT EDSServiceSupplier(provider, ei) THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoice V2: не заданы параметры EDSService');
            MESSAGE provider + ' (' + loginProfile(le) + ') Накладная не выгружена: не заданы параметры EDSService' NOWAIT;
            RETURN;
        }
        authV2(le);
        IF NOT token() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoice V2: ошибка при аутентификации');
            MESSAGE provider + ' (' + loginProfile(le) + ') Накладная не выгружена: ошибка при аутентификации' NOWAIT;
            RETURN;
        }

        exportDateTime() <- currentDateTimeMillis();
        toMilliseconds(exportDateTime());

        fillPartnerIdV2(supplier(ei), customer(ei), glnSupplier(ei), unpSupplier(ei), le, provider);
        fillPartnerIdV2(customer(ei), supplier(ei), glnCustomer(ei), unpCustomer(ei), le, provider);

        createExportEInvoice(ei);
        EXPORT exportEInvoice JSON;
        ewaybill() <- exportFile();

        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'EWAYBILL/draft/createWithValidation?base64=true\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/draft/createWithValidation?base64=true' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendEInvoice V2 ' + deliveryNoteNumber(ei), le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        IMPORT importSignDoc JSON FROM result();
        IF id() THEN documentId(ei) <- id();

        IF errorDescription() != '' THEN {
            MESSAGE errorDescription();
        } ELSE {
            getSignedDocumentSupplierV2(provider, ei, xmlBase64(), TRUE);
            IF signError() THEN {
                logToFile('edi', provider + ' (' + loginProfile(le) + ') SignEInvoice V2 error: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError());
                MESSAGE provider + ' (' + loginProfile(le) + ') Документ не подписан: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError() NOWAIT;
            } ELSE IF base64Signature() THEN {
                EXPORT JSON FROM id = documentId(ei), signatureBase64 = base64Signature();
                logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'EWAYBILL/draft/saveSigned request:\n' + exportFile());
                EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/draft/saveSigned' HEADERS headersV2 PARAMS exportFile() TO result;
                logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

                checkResponseV2(result(), 'SendEInvoice V2 ' + deliveryNoteNumber(ei) + ' (saveSigned)', le, provider);
                IF requestSucceededV2() THEN {
                    logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'activemq/send/' + (IF isTN2(ei) THEN 'BLRDLN' ELSE 'BLRWBL') + '/' + documentId(ei));
                    EXTERNAL HTTP GET url(profile(le)) + 'activemq/send/' + (IF isTN2(ei) THEN 'BLRDLN' ELSE 'BLRWBL') + '/' + documentId(ei) HEADERS headersV2 TO result;
                    logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

                    checkResponseV2(result(), 'SendEInvoice V2 ' + deliveryNoteNumber(ei) + ' (activemq/send)', le, provider);
                    IF requestSucceededV2() THEN {
                        //updateDocumentIdV2(ei, le, provider);

                        logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoice V2 ' + deliveryNoteNumber(ei) + ' request succeeded');
                        MESSAGE provider + ' (' + loginProfile(le) + ') Накладная ' + deliveryNoteNumber(ei) + (IF isCancel(ei) THEN ' (отмена)' ELSE '') + ' выгружена' NOWAIT;
                        exportedSupplier(ei) <- TRUE;
                        numberSupplier(ei) <- STRING[35](resultMilliseconds());
                        dateSupplier(ei) <- exportDateTime();

                        NEW em = EInvoiceMessage {
                            number(em) <- STRING[35](resultMilliseconds());
                            eInvoice(em) <- ei;
                            dateTime(em) <- toDateTimeFormat(toChar(exportDateTime(), 'yyyy-MM-ddThh24:mi:ss'), 'yyyy-MM-ddThh24:mi:ss');
                            code(em) <- '9';
                            kind(em) <- EInvoiceMessageKind.out;
                            type(em) <- IF isTN2(ei) THEN EInvoiceMessageType.blrdln ELSE EInvoiceMessageType.blrwbl;
                            JSONPath(em) <- sentPathV2(outputDir, exportDateTime());
                        }

                        IF outputDir THEN {
                            TRY { mkdir(sentDirV2(outputDir)); }
                            WRITE ewaybill() TO sentPathV2(outputDir, exportDateTime());
                        }
                    }
                }
            }
        }

        APPLY NESTED LOCAL;
        IF canceled() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoice V2: apply canceled ' + applyMessage());
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + loginProfile(le) + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
        importRequestResult(result(), statusHttp());
        MESSAGE 'Накладная не выгружена:\n' + requestError() NOWAIT;
    }
}

signAndSendSupplierCancelEDIV2 (EInvoice ei, LegalEntity le, STRING[100] outputDir, STRING[100] provider) {
    LOCAL result = FILE ();
    LOCAL ewaybill = FILE ();

    IF NOT documentId(ei) THEN {
        logToFile('edi', provider + ' SendEInvoiceCancel V2 ' + deliveryNoteNumber(ei) + ': не заполнен documentId');
        MESSAGE provider + ' Отмена накладной ' + deliveryNoteNumber(ei) + ' не выгружена: накладная не отправлялась через API V2' NOWAIT;
        RETURN;
    }
    TRY {
        IF NOT profile(le) THEN {
            logToFile('edi', provider + 'SendEInvoiceCancel V2: не задан профиль организации получателя');
            MESSAGE provider + 'Накладная не выгружена: не задан профиль организации получателя' NOWAIT;
            RETURN;
        }
        IF NOT EDSServiceSupplier(provider, ei) THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoiceCancel V2: не заданы параметры EDSService');
            MESSAGE provider + ' (' + loginProfile(le) + ') Накладная не выгружена: не заданы параметры EDSService' NOWAIT;
            RETURN;
        }
        authV2(le);
        IF NOT token() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoiceCancel V2: ошибка при аутентификации');
            MESSAGE provider + ' (' + loginProfile(le) + ') Накладная не выгружена: ошибка при аутентификации' NOWAIT;
            RETURN;
        }

        exportDateTime() <- currentDateTimeMillis();
        toMilliseconds(exportDateTime());

        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'EWAYBILL/' + documentId(ei) + '/cancel?base64=true');
        EXTERNAL HTTP GET url(profile(le)) + 'EWAYBILL/' + documentId(ei) + '/cancel?base64=true' HEADERS headersV2 TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendEInvoiceCancel V2 ' + deliveryNoteNumber(ei), le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        IMPORT importSignDoc JSON FROM result();

        isCancel(ei) <- TRUE;

        IF errorDescription() != '' THEN {
            MESSAGE errorDescription();
        } ELSE {
            getSignedDocumentSupplierV2(provider, ei, xmlBase64(), TRUE);
            IF signError() THEN {
                logToFile('edi', provider + ' (' + loginProfile(le) + ') SignEInvoiceCancel V2 error: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError());
                MESSAGE provider + ' (' + loginProfile(le) + ') Документ не подписан: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError() NOWAIT;
            } ELSE IF base64Signature() THEN {
                EXPORT JSON FROM id = LONG(documentId(ei)), signatureBase64 = base64Signature(), xmlBody = xmlBody();
                logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'EWAYBILL/draft/saveSignedCancel request:\n' + exportFile());
                EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/draft/saveSignedCancel' HEADERS headersV2 PARAMS exportFile() TO result;
                logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

                checkResponseV2(result(), 'SendEInvoiceCancel V2 ' + deliveryNoteNumber(ei) + ' (saveSignedCancel)', le, provider);
                IF requestSucceededV2() THEN {
                    logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoiceCancel V2 ' + deliveryNoteNumber(ei) + ' request succeeded');
                    MESSAGE provider + ' (' + loginProfile(le) + ') Накладная ' + deliveryNoteNumber(ei) + (IF isCancel(ei) THEN ' (отмена)' ELSE '') + ' выгружена' NOWAIT;
                    exportedSupplier(ei) <- TRUE;
                    numberSupplierCancel(ei) <- STRING[35](resultMilliseconds());
                    dateSupplierCancel(ei) <- exportDateTime();

                    NEW em = EInvoiceMessage {
                        number(em) <- STRING[35](resultMilliseconds());
                        eInvoice(em) <- ei;
                        dateTime(em) <- toDateTimeFormat(toChar(exportDateTime(), 'yyyy-MM-ddThh24:mi:ss'), 'yyyy-MM-ddThh24:mi:ss');
                        code(em) <- '1';
                        kind(em) <- EInvoiceMessageKind.out;
                        type(em) <- IF isTN2(ei) THEN EInvoiceMessageType.blrdln ELSE EInvoiceMessageType.blrwbl;
                        JSONPath(em) <- sentPathV2(outputDir, exportDateTime());
                    }

                    IF outputDir THEN {
                        TRY { mkdir(sentDirV2(outputDir)); }
                        WRITE ewaybill() TO sentPathV2(outputDir, exportDateTime());
                    }
                }
            }
        }

        APPLY NESTED LOCAL;
        IF canceled() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendEInvoiceCancel V2: apply canceled ' + applyMessage());
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + loginProfile(le) + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
        importRequestResult(result(), statusHttp());
        MESSAGE 'Накладная не выгружена:\n' + requestError() NOWAIT;
    }
}

signAndSendSupplierCancelV2 (EInvoice e) + {
    IF EDIProviderInvoice(customer(e), supplier(e)) == EDIProvider.topBy AND NOT skipSendSupplier(e) THEN {
        signAndSendSupplierCancelEDIV2(e, supplier(e), (OVERRIDE overInvoiceOutputDirTopBy(e), outputDirTopBy()), 'TopBy');
    }
}

signAndSendBlrapnSupplierEInvoiceV2(EInvoice ei, LegalEntity le, STRING[100] provider) + {
    LOCAL result = FILE ();

    IF NOT documentId(ei) THEN {
        logToFile('edi', provider + ' SendBlrapnEInvoice V2 ' + deliveryNoteNumber(ei) + ': не заполнен documentId');
        MESSAGE provider + ' Извещение о прочтении накладной ' + deliveryNoteNumber(ei) + ' не выгружено: накладная не отправлялась через API V2' NOWAIT;
        RETURN;
    }
    TRY {
        IF NOT profile(le) THEN {
            logToFile('edi', provider + 'SendBlrapnEInvoice V2: не задан профиль организации получателя');
            MESSAGE provider + 'Извещение о прочтении не выгружено: не задан профиль организации получателя' NOWAIT;
            RETURN;
        }
        authV2(le);
        IF NOT token() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendBlrapnEInvoice V2: ошибка при аутентификации');
            MESSAGE provider + ' (' + loginProfile(le) + ') Извещение о прочтении не выгружено: ошибка при аутентификации' NOWAIT;
            RETURN;
        }

        exportDateTime() <- currentDateTimeMillis();
        toMilliseconds(exportDateTime());

        EXPORT JSON FROM value = '[' + documentId(ei) + ']';
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'POST EWAYBILL/markAsRead\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/markAsRead' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendBlrapnEInvoice V2 ' + deliveryNoteNumber(ei), le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        logToFile('edi', provider + ' (' + loginProfile(le) + ') SendBlrapnEInvoice V2 ' + deliveryNoteNumber(ei) + ' request succeeded');
        exportedBlrapnSupplier(ei) <- TRUE;
        NEW em = EInvoiceMessage {
            number(em) <- STRING[35](resultMilliseconds());
            eInvoice(em) <- ei;
            dateTime(em) <- toDateTimeFormat(toChar(exportDateTime(), 'yyyy-MM-ddThh24:mi:ss'), 'yyyy-MM-ddThh24:mi:ss');
            code(em) <- IF importedNoticeSupplier(ei) THEN '2651' ELSE '2650';
            kind(em) <- EInvoiceMessageKind.out;
            type(em) <- IF isTN2(ei) THEN EInvoiceMessageType.blrapn_blrdln ELSE EInvoiceMessageType.blrapn_blrwbl;
        }

        APPLY NESTED LOCAL;
        IF canceled() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendBlrapnEInvoice V2: apply canceled ' + applyMessage());
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + loginProfile(le) + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
        importRequestResult(result(), statusHttp());
        MESSAGE 'Извещение о прочтении не выгружено\n:' + requestError() NOWAIT;
    }
}

signAndSendConfirmSupplierV2 (EInvoice ei, LegalEntity le, STRING[100] provider) + {
    LOCAL result = FILE ();

    IF NOT documentId(ei) THEN {
        logToFile('edi', provider + ' SendConfirmEInvoiceNotice V2 ' + deliveryNoteNumber(ei) + ': не заполнен documentId');
        MESSAGE provider + ' Уведомление о подтверждении по накладной ' + deliveryNoteNumber(ei) + ' не выгружено: накладная не отправлялась через API V2' NOWAIT;
        RETURN;
    }
    TRY {
        IF NOT profile(le) THEN {
            logToFile('edi', provider + 'SendConfirmEInvoiceNotice V2: не задан профиль организации получателя');
            MESSAGE provider + 'Уведомление о подтверждении не выгружено: не задан профиль организации получателя' NOWAIT;
            RETURN;
        }
        IF NOT EDSServiceSupplier(provider, ei) THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoiceNotice V2: не заданы параметры EDSService');
            MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении не выгружено: не заданы параметры EDSService' NOWAIT;
            RETURN;
        }
        authV2(le);
        IF NOT token() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoiceNotice V2: ошибка при аутентификации');
            MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении не выгружено: ошибка при аутентификации' NOWAIT;
            RETURN;
        }

        exportDateTime() <- currentDateTimeMillis();
        toMilliseconds(exportDateTime());

        EXPORT JSON FROM documentId = INTEGER(changeRequestId(ei));
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'POST draft/blrapn/EWAYBILL/create2651OnBlrapn2750?base64=true request:\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'draft/blrapn/EWAYBILL/create2651OnBlrapn2750?base64=true' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendConfirmEInvoiceNotice V2 ' + deliveryNoteNumber(ei), le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        IMPORT importSignDoc JSON FROM result();
        IF errorDescription() != '' THEN {
            MESSAGE errorDescription();
            RETURN;
        }

        getSignedDocumentSupplierV2(provider, ei, xmlBase64(), TRUE);
        IF signError() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SignConfirmEInvoiceNoticeV2 error: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError());
            MESSAGE provider + ' (' + loginProfile(le) + ') Документ не подписан: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError() NOWAIT;
            RETURN;
        }
        IF NOT base64Signature() THEN RETURN;

        EXPORT JSON FROM id(), signatureBase64 = base64Signature();
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'draft/blrapn/EWAYBILL/saveSigned2651OnBlrapn2750AndSendByActiveMq request:\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'draft/blrapn/EWAYBILL/saveSigned2651OnBlrapn2750AndSendByActiveMq' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendConfirmEInvoiceNotice V2 ' + deliveryNoteNumber(ei) + ' (saveSigned2651)', le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoiceNotice V2 ' + deliveryNoteNumber(ei) + ' request succeeded');
        MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении ' + deliveryNoteNumber(ei) + ' выгружено' NOWAIT;

        APPLY NESTED LOCAL;
        IF canceled() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoiceNotice V2: apply canceled ' + applyMessage());
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + loginProfile(le) + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
        importRequestResult(result(), statusHttp());
        MESSAGE 'Уведомление о подтверждении не выгружено:\n' + requestError() NOWAIT;
    }
}