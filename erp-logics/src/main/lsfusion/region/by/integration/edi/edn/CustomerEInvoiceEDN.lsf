MODULE CustomerEInvoiceEDN;

REQUIRE EInvoiceEDN, CustomerEInvoiceTopByApi, EInvoiceEDSEDN;

NAMESPACE EDI;

signAndSendBlrapnCustomer(EInvoice e) + {
    IF EDIProviderInvoice(e) == EDIProvider.edn  THEN
        IF exportedBlrapnCustomer(e) THEN
            MESSAGE 'Извещение о прочтении (покупатель) уже отправлено';
            ELSE {
                hideMessageHeaderBlrapn() <- extractProfileEDN(customer(e));
                signAndSendBlrapnCustomerEInvoice(e, loginProfileEDN(customer(e)), passwordProfileEDN(customer(e)), urlProfileEDN(customer(e)), outputDirEDN(), 'EDN', TRUE);
            }
}

signAndSendCustomer(EInvoice e) + {
    IF EDIProviderInvoice(e) == EDIProvider.edn  THEN
        IF (exportedCustomer(e) OR exportedNoticeCustomer(e)) THEN MESSAGE 'Накладная (покупатель) или уведомление об изменении уже отправлены';
        ELSE IF isTN2(e) THEN {
            hideMessageHeaderBlrdnr() <- extractProfileEDN(customer(e));
            signAndSendCustomerEInvoiceTN2(e, loginProfileEDN(customer(e)), passwordProfileEDN(customer(e)), urlProfileEDN(customer(e)), outputDirEDN(), 'EDN');
        } ELSE {
            hideMessageHeaderBlrwbr() <- extractProfileEDN(customer(e));
            signAndSendCustomerEInvoice(e, loginProfileEDN(customer(e)), passwordProfileEDN(customer(e)), urlProfileEDN(customer(e)), outputDirEDN(), 'EDN');
        }
}

signAndSendNoticeCustomer(EInvoice e, STRING[1000] d) + {
    IF EDIProviderInvoice(e) == EDIProvider.edn  THEN
        IF (exportedCustomer(e) OR exportedNoticeCustomer(e)) THEN MESSAGE 'Накладная (покупатель) или уведомление об изменении уже отправлены';
        ELSE IF isTN2(e) THEN {
            hideMessageHeaderBlrapn() <- extractProfileEDN(customer(e));
            signAndSendNoticeCustomerEInvoiceTN2(e, d, loginProfileEDN(customer(e)), passwordProfileEDN(customer(e)), urlProfileEDN(customer(e)), outputDirEDN(), 'EDN');
        } ELSE {
            hideMessageHeaderBlrapn() <- extractProfileEDN(customer(e));
            signAndSendNoticeCustomerEInvoice(e, d, loginProfileEDN(customer(e)), passwordProfileEDN(customer(e)), urlProfileEDN(customer(e)), outputDirEDN(), 'EDN');
        }
}

signAndSendCustomer(ECreditNote c) + {
    IF EDIProviderInvoice(c) == EDIProvider.edn  THEN {
        IF exportedCustomer(c) THEN
            MESSAGE 'Акт приемки (покупатель) уже отправлен';
        ELSE {
            hideMessageHeaderBlradf() <- extractProfileEDN(customer(c));
            signAndSendCustomerECreditNote(c, loginProfileEDN(customer(c)), passwordProfileEDN(customer(c)), urlProfileEDN(customer(c)), outputDirEDN(), 'EDN');
        }
    }
}

signAndSendBlrapnCustomer(ECreditNote c) + {
    IF EDIProviderInvoice(c) == EDIProvider.edn THEN {
        IF exportedBlrapnCustomer(c) THEN
            MESSAGE 'Извещение о прочтении (покупатель) уже отправлено';
        ELSE {
            hideMessageHeaderBlradf() <- extractProfileEDN(customer(c));
            signAndSendBlrapnCustomerECreditNote(c, loginProfileEDN(customer(c)), passwordProfileEDN(customer(c)), urlProfileEDN(customer(c)), outputDirEDN(), 'EDN');
        }
    }
}