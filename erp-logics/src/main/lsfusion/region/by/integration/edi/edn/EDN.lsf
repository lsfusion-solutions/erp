MODULE EDN;

REQUIRE EDI, TopByApi;

NAMESPACE EDI;

EXTEND CLASS EDIProvider {
    edn 'ЭДиН'
}
prefix(EDIProvider e) += WHEN e == EDIProvider.edn THEN '002-';
name(EDIProvider e) += WHEN e == EDIProvider.edn THEN 'ООО "Электронные документы и накладные"';
gln(EDIProvider e) += WHEN e == EDIProvider.edn THEN '4819001510007';
EDIProvider(STRING[100] p) += WHEN p == 'EDN' THEN EDIProvider.edn;

CLASS EDNProfile 'Профиль ЭДиН' : SoapProfile;
isTest 'Тестовый контур' = DATA BOOLEAN (EDNProfile);
extract 'Формат docudrive' = DATA BOOLEAN (EDNProfile); //тут даже не то что распаковывать а вообще обмен в формате docurive
skipUnzip 'Сообщения не упакованы' = DATA BOOLEAN (EDNProfile);
url(EDNProfile p) += IF isTest(p) THEN 'https://soap-test.edn.by/topby/DmcService?wsdl' ELSE 'https://soap.edn.by/topby/DmcService?wsdl';
urlApi 'Адрес REST API' (EDNProfile p) = IF isTest(p) THEN 'https://api-test.edn.by' ELSE 'https://api.edn.by';

profileEDN = DATA EDNProfile (LegalEntity);
loginProfileEDN 'Профиль ЭДиН' (LegalEntity l) = login(profileEDN(l));
passwordProfileEDN (LegalEntity l) = password(profileEDN(l));
urlProfileEDN (LegalEntity l) = url(profileEDN(l));
urlApiProfileEDN (LegalEntity l) = urlApi(profileEDN(l));
extractProfileEDN (LegalEntity l) = extract(profileEDN(l));
ednProfile (STRING[100] login) = GROUP MIN EDNProfile p IF p IS EDNProfile BY login(p);

FORM ednProfile 'Профиль ЭДиН'
    OBJECTS p = EDNProfile PANEL
    PROPERTIES (p) login, password, isTest, extract, skipUnzip, url READONLY, urlApi READONLY

    EDIT EDNProfile OBJECT p
;

FORM ednProfiles 'Профили ЭДиН'
    OBJECTS p = EDNProfile
    PROPERTIES (p) READONLY login, isTest, url, extract
    PROPERTIES (p) NEWSESSION NEW, EDIT, DELETE

    LIST EDNProfile OBJECT p
;

//параметры подключения до перехода на профили, используются только миграцией
loginEDN 'Имя пользователя' = DATA STRING[100] (LegalEntity);
passwordEDN 'Пароль' = DATA STRING[100] (LegalEntity) ECHO;
hostEDN 'Хост SOAP' = DATA STRING[100] (LegalEntity);
portEDN 'Порт' = DATA INTEGER (LegalEntity);
urlApiEDN 'Адрес REST API' = DATA STRING[100] (LegalEntity);
extractEDN 'Формат docudrive' = DATA BOOLEAN (LegalEntity);
skipUnzip 'Сообщения не упакованы' = DATA BOOLEAN (LegalEntity);

migrateProfileEDN() {
    FOR LegalEntity le == [GROUP MIN LegalEntity l BY loginEDN(l)](STRING[100] lg) NEW p = EDNProfile DO {
        login(p) <- lg;
        password(p) <- passwordEDN(le);
        //адреса сервисов теперь фиксированные, из старых настроек берём только признак тестового контура
        isTest(p) <- TRUE IF isSubstring(hostEDN(le), 'test');
        extract(p) <- extractEDN(le);
        skipUnzip(p) <- skipUnzip(le);
    }
    profileEDN(LegalEntity le) <- ednProfile(loginEDN(le)) WHERE loginEDN(le);
}
@defOnStartMigrate(migrateProfileEDN, 'Профили ЭДиН');

archiveDirEDN 'Папка принятых сообщений' = DATA STRING[100] ();
outputDirEDN 'Папка отправленных сообщений' = DATA STRING[100] ();
disableConfirmationEDN 'Отключить подтверждение сообщений' = DATA BOOLEAN ();
enableJavaStackEDN 'Включить логирование Java stack trace' = DATA BOOLEAN ();

provider(EDNProfile p) += 'EDN' IF p IS EDNProfile;
archiveDir(EDNProfile p) += archiveDirEDN() IF p IS EDNProfile;
disableConfirmation(EDNProfile p) += disableConfirmationEDN() IF p IS EDNProfile;

document = DATA LOCAL RAWFILE();
FORM edocument
    PROPERTIES() document;

beforeOverReceiveMessages(INTEGER i, STRING[100] login, STRING[100] archiveDir) + {
    IF extract(ednProfile(login)) AND NOT skipUnzip(ednProfile(login)) THEN {
        unzipped(STRING[100] s) <- NULL;
        IMPORT edocument FROM data(i);
        unzipping() <- file(document(), 'zip');
        makeUnzipFile();
        FOR unzipped(STRING[100] s) DO {
            data(i) <- XMLFILE(unzipped(s));
        }
        receivedFileName(i) <- id(i) + '_extracted';
        IF archiveDir THEN {
            TRY { mkdir((OVERRIDE receivedDir(ediFile(id(i))), receivedDir(archiveDir))); }
            WRITE data(i) TO receivedPath(archiveDir, i);
        }
    }
}

lockedEDN = DATA User (STRING) TABLE stringEDI;
lockResultEDN = DATA LOCAL NESTED BOOLEAN ();

lockEDN(STRING object) {
    NEWSESSION {
        lockResultEDN() <- NULL;
        APPLY SERIALIZABLE {
            IF NOT object THEN
                RETURN;
            IF lockedEDN(object) THEN {
                cancel();
            } ELSE {
                lockedEDN(object) <- currentUser();
                lockResultEDN() <- TRUE;
            }
        }
    }
}

unlockEDN(STRING object) {
    NEWSESSION {
        APPLY lockedEDN(object) <- NULL;
    }
}

onStarted() + {
    NEWSESSION {
        lockedEDN(STRING l) <- NULL WHERE lockedEDN(l);
        APPLY;
    }
}

overReceiveMessagesEDN ABSTRACT LIST(EDNProfile);
receiveMessagesEDN () {
    FOR EDNProfile p IS EDNProfile AND login(p) AND password(p) DO {
        NEWSESSION {
            lockEDN(login(p));
            IF lockResultEDN() THEN {
                TRY {
                    overReceiveMessagesEDN(p);
                    receiveMessages(login(p), password(p), url(p), archiveDirEDN(), disableConfirmationEDN(), 'EDN');
                } FINALLY {
                    unlockEDN(login(p));
                }
            } ELSE {
                MESSAGE 'Уже выполняется получение сообщений EDN для ' + login(p) + '. Подождите...' NOWAIT;
            }
        }
    }
}

//-----------------------------------------------------------REST API-------------------------------------------------//
useDocuway 'Не использовать формат СТТ для заказов' = DATA BOOLEAN();

importRequestResult() {
    IF sendRequestEDIStatus() == 200 OR sendRequestEDIStatus() == 202 THEN {
        requestError() <- NULL;
    } ELSE {
        requestError() <- CONCAT ' ', 'Неизвестная ошибка: статус ', STRING[3](sendRequestEDIStatus());
    }
}
// /documents
fileName = DATA LOCAL STRING();

FORM documentsEDN
    PROPERTIES() fileName, documentType, document;

// /documents/new
GROUP headers;

//заголовки исходящих запросов: системное headers в действии, вызванном по HTTP (внешняя система,
//eval), уже содержит заголовки входящего запроса, и они целиком уходят в исходящий вызов
headersEDN = DATA LOCAL NESTED TEXT (TEXT);

downloadFileName = DATA LOCAL STRING(INTEGER);
processedDateTime = DATA LOCAL ZDATETIME(INTEGER);

FORM getDocumentsEDN
    OBJECTS data = INTEGER
    PROPERTIES(data) IN headers
        id EXTID 'documentId', downloadFileName, documentType EXTID 'type', processedDateTime;

overReceiveMessagesEDN ABSTRACT LIST (INTEGER, STRING[100], STRING[100], TEXT, STRING[100], BOOLEAN, STRING[100]);

//содержимое сообщения формата docuway провайдер отдаёт отдельным запросом; при приёме оно складывается
//в очередь, поэтому обработка (в том числе повторная из журнала) к провайдеру не обращается
fillContentEDN (INTEGER i, TEXT url) {
    IF NOT data(i) THEN {
        EXTERNAL HTTP GET url + '/documents/' + id(i) + '/content' HEADERS headersEDN TO xmlFile;
        data(i) <- xmlFile();
        receivedFileName(i) <- OVERRIDE receivedFileName(i), downloadFileName(i);
    }
}

receiveMessagesEDN (STRING[100] login, STRING[100] password, TEXT url, STRING[100] archiveDir, BOOLEAN disableConfirmation, STRING[100] provider) {
    TRY {
        IF login AND password THEN {

            headersEDN('Authorization') <- 'Basic ' + encodeText(login + ':' + password, 'base64');
            EXTERNAL HTTP GET url +'/documents/new' HEADERS headersEDN TO sendRequestEDIResponse;
            logToFile('edi', provider + ' (' + login + ') ReceiveMessages request sent' + url +'/documents/new');
            
            sendRequestEDIStatus() <- statusHttp();
            importRequestResult();
            
            IF requestError() THEN {
                logToFile('edi', provider + ' (' + login + ') ReceiveMessages: ' + requestError());
                MESSAGE  provider + ' (' + login + ') Сообщения не получены: ' + requestError() NOWAIT;
            } ELSE {
                IMPORT getDocumentsEDN JSON FROM sendRequestEDIResponse();

                fillStartParams();
                IF (GROUP SUM 1 IF documentType(INTEGER i)) > 0 THEN textMessage() <- CONCAT '\n', textMessage(), provider + '(' + login + ') Сообщений в очереди: ' + (GROUP SUM 1 IF documentType(INTEGER i));
                logToFile('edi', provider + ' (' + login + ') ReceiveMessages count: ' + (GROUP SUM 1 IF documentType(INTEGER i)));

                FOR documentType(INTEGER i) DO {
                    receivedFileName(i) <- downloadFileName(i);
                    IF data(ediFile(id(i))) THEN {
                        data(i) <- XMLFILE(data(ediFile(id(i))));
                    } ELSE {
                        TRY {
                            fillContentEDN(i, url);
                        } CATCH {
                            logToFile('edi', CONCAT '\n', provider + ' (' + login + ') Download content ' + id(i) + ' error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException() IF enableJavaStackEDN(), lsfStackTraceCaughtException());
                        }
                    }
                }

                registerEDIFiles(login, archiveDir, provider);

                FOR documentType(INTEGER i) ORDER processedDateTime(i) DO {
                    logToFile('edi', provider + ' (' + login + ') Check Message type:' + documentType(i) + ' id:' + id(i));
                    overReceiveMessagesEDN(i, login, password, url, archiveDir, disableConfirmation, provider);
                }

                fillEndParams();
                IF sendRecipientErrorFailed() == 0 THEN {
                    MESSAGE (OVERRIDE textMessage(), provider + '(' + login + ') Не найдено новых сообщений') NOWAIT;
                }
            }

        } ELSE {
            logToFile('edi', provider + ' (' + login + ') ReceiveMessages: не заданы имя пользователя / пароль / хост');
            MESSAGE  provider + ' (' + login + ') Сообщения не получены: не заданы имя пользователя / пароль / хост' NOWAIT;
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + login + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException() IF enableJavaStackEDN(), lsfStackTraceCaughtException());
        MESSAGE provider + '(' + login + ') Сообщения не получены. Обратитесь к администратору' NOWAIT;
    }
}

receiveMessagesEDNApi () {
    FOR EDNProfile p IS EDNProfile AND login(p) AND password(p) DO {
        NEWSESSION {
            lockEDN(login(p));
            IF lockResultEDN() THEN {
                TRY {
                    receiveMessagesEDN(login(p), password(p), urlApi(p), archiveDirEDN(), disableConfirmationEDN(), 'EDN');
                } FINALLY {
                    unlockEDN(login(p));
                }
            } ELSE {
                MESSAGE 'Уже выполняется получение сообщений EDN для ' + login(p) + '. Подождите...' NOWAIT;
            }
        }
    }
}

// APERAK
GROUP systemMessage_Header EXTID 'SystemMessage-Header';
GROUP systemMessageReference EXTID 'SystemMessageReference' : systemMessage_Header;

FORM aperack FORMEXTID 'Document-ApplicationMessage'
    PROPERTIES() IN systemMessageReference
        documentType EXTID 'DocumentType',
        documentNumber EXTID 'DocumentNumber'
    PROPERTIES() IN systemMessage_Header
        messageDocumentNumber EXTID 'SystemMessageNumber',
        messageDocumentDate EXTID 'SystemMessageDate', 
        code EXTID 'SystemMessageCode', 
        description EXTID 'SystemMessageText'
;

overImportAperak ABSTRACT LIST FIRST(INTEGER, STRING[100], STRING[100], TEXT, STRING[100], BOOLEAN, STRING[100] );
overImportAperak(INTEGER i, STRING[100] login, STRING[100] password, TEXT url, STRING[100] archiveDir, BOOLEAN disableConfirmation, STRING[100] provider) + {
    logToFile('edi', provider + ' (' + login + ') Parse Aperack ' + id(i) + ' warning: unsupported Reference documentType ' + (OVERRIDE documentType(), 'NULL'));
}

overReceiveMessagesEDN(INTEGER i, STRING[100] login, STRING[100] password, TEXT url, STRING[100] archiveDir, BOOLEAN disableConfirmation, STRING[100] provider) + {
    IF documentType(i) == 'APERAK' THEN {
        processedEDIFile() <- TRUE;
        TRY {
            fillContentEDN(i, url);

            IMPORT aperack XML FROM data(i);
            
            overImportAperak(i, login, password, url, archiveDir, disableConfirmation, provider);
            
        } CATCH {
            logToFile('edi', CONCAT '\n', provider + ' (' + login + ') Parse Aperack ' + id(i) + ' error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException() IF enableJavaStackEDN(), lsfStackTraceCaughtException());
            MESSAGE 'Ошибка при импорте сообщения ' + id(i) +'. Обратитесь к администратору' NOWAIT;
            responsesFailed() <- responsesFailed() + 1;
        }
    }
}

confirmDocument(INTEGER i, STRING[100] login, STRING[100] password, TEXT url) {
    headersEDN('Authorization') <- 'Basic ' + encodeText(login + ':' + password, 'base64');
    EXTERNAL HTTP url +'/documents/'+id(i)+ '/mark-downloaded' HEADERS headersEDN;
    logToFile('edi', 'EDN (' + login + ') ConfirmDocumentReceived document ' + id(i) + ': request sent');

    importRequestResult();
    IF requestError() THEN {
        logToFile('edi', 'EDN (' + login + ') ConfirmDocumentReceived document ' + id(i) + ': ' + requestError());
        MESSAGE 'EDN (' + login + ') Документ ' + id(i) + ' не помечен как обработанный: ' + requestError() NOWAIT;
    } ELSE {
        logToFile('edi', 'EDN (' + login + ') ConfirmDocumentReceived document ' + id(i) + ': request succeeded');
        confirmEDIFile(id(i));
    }
}

//порядок как в receiveEDN: сначала ветки ЭДиН (заказы в формате docuway), остальное разбирают ветки СТТ
overProcessEDIFile(EDIFile f, INTEGER i) + {
    IF useDocuway() THEN {
        FOR EDNProfile p == profile(f) DO {
            headersEDN('Authorization') <- 'Basic ' + encodeText(login(p) + ':' + password(p), 'base64');
            overReceiveMessagesEDN(i, login(p), password(p), urlApi(p), archiveDir(p), disableConfirmation(p), provider(p));
        }
    }
}

//-----------------------------------------------------------REST API-------------------------------------------------//


receiveEDN 'Получить сообщения' () {
    checkIsServer();
    IF isServer() THEN {
        IF useDocuway() THEN {
            receiveMessagesEDNApi();
            skipImportOrders() <- TRUE;
        }
        receiveMessagesEDN();
    }
}

EXTEND FORM integrationData
    PROPERTIES() receiveEDN, archiveDirEDN, outputDirEDN, disableConfirmationEDN, useDocuway

    OBJECTS lete = LegalEntity
    FILTERS isCompany(lete)
    PROPERTIES(lete) name READONLY, loginProfileEDN
;

DESIGN integrationData {
    edi {
        NEW vsEDN {
            caption = 'ЭДиН';
            horizontal = TRUE;
            NEW col1EDN {
                NEW params {
                    caption = 'Общие';
                    MOVE PROPERTY(archiveDirEDN());
                    MOVE PROPERTY(outputDirEDN());
                    MOVE PROPERTY(disableConfirmationEDN());
                    MOVE PROPERTY(useDocuway());
                    MOVE PROPERTY(receiveEDN());
                }
            }
            NEW col2EDN {
                fill = 1;
                MOVE BOX(lete);
            }
        }
    }
}