    col1TopBy {
        NEW ivs {
            caption = 'Электронные накладные';
        }
    }
}

//V2

@openJSON(EInvoice, e, eInvoices);

@openJSON(EInvoiceMessage, m, eInvoices);

GROUP shipFrom;
GROUP formSettings;
GROUP uom;
GROUP fieldCostControlDto;
GROUP productTraceabilityDataDto;
GROUP receiptDocumentDto;
GROUP currency;
GROUP shipToV2 EXTID 'shipTo';

functionCode2 = DATA LOCAL NUMERIC();
deliveryNoteType = DATA LOCAL STRING();
msgType = DATA LOCAL STRING();
blockForm = DATA LOCAL BOOLEAN();
processingStatus = DATA LOCAL STRING();
creationDateTime2 = DATA LOCAL ZDATETIME ();
deliveryNoteNumber = DATA LOCAL STRING();
deliveryNoteDate = DATA LOCAL DATE();
contractNumber = DATA LOCAL STRING();
contractDate = DATA LOCAL DATE();
contractName = DATA LOCAL STRING();
shipperGln = DATA LOCAL STRING();
shipperId = DATA LOCAL STRING();
msgSenderGln = DATA LOCAL STRING();
msgSenderId = DATA LOCAL STRING();
shipperName = DATA LOCAL STRING();
shipperAddress = DATA LOCAL STRING();
shipperUnp = DATA LOCAL STRING();
receiverGln = DATA LOCAL STRING();
receiverId = DATA LOCAL STRING();
msgReceiverGln = DATA LOCAL STRING();
msgReceiverId = DATA LOCAL STRING();
receiverName = DATA LOCAL STRING();
receiverAddress = DATA LOCAL STRING();
receiverUnp = DATA LOCAL STRING();

transporterGln = DATA LOCAL STRING();
totalGrossWeight = DATA LOCAL NUMERIC[12,6]();
deliveryContact = DATA LOCAL STRING();
address = DATA LOCAL STRING();
contact = DATA LOCAL STRING();
isAutoSum = DATA LOCAL BOOLEAN();
productsPositionWithAutoSum = DATA LOCAL BOOLEAN (INTEGER);
formSettingsProductsPositionWithAutoSum = DATA LOCAL INTEGER(INTEGER);
productsWhereMarksSelectedFromList = DATA LOCAL STRING(INTEGER);
formSettingsProductsWhereMarksSelectedFromList = DATA LOCAL INTEGER(INTEGER);
formType = DATA LOCAL NUMERIC();
totalQuantityLu = DATA LOCAL STRING();
version = DATA LOCAL NUMERIC();
quantityTrip = DATA LOCAL STRING();
shipperCountryName = DATA LOCAL STRING();
totalAmountWithoutVat = DATA LOCAL NUMERIC[18,2] ();
totalAmountVat = DATA LOCAL NUMERIC[18,2] ();
totalAmountWithVat = DATA LOCAL NUMERIC[18,2] ();
totalLine = DATA LOCAL NUMERIC();
totalQuantity = DATA LOCAL NUMERIC[16,5] ();
totalAmountExcise = DATA LOCAL NUMERIC[12,5] ();
transporterUnp = DATA LOCAL STRING();
discountRate = DATA LOCAL STRING(INTEGER);
itemType = DATA LOCAL STRING(INTEGER);
quantityDespatch = DATA LOCAL NUMERIC(INTEGER);
vatRate = DATA LOCAL STRING(INTEGER);
amountExcise = DATA LOCAL STRING(INTEGER);
aggregationCodeList = DATA LOCAL STRING(INTEGER);
msgEwaybillProductListAggregationCodeList = DATA LOCAL INTEGER(INTEGER);
priceNet = DATA LOCAL NUMERIC (INTEGER);
markCodeSetJSON = DATA LOCAL JSONTEXT (INTEGER);
code = DATA LOCAL STRING(INTEGER);
customCodeOther = DATA LOCAL STRING(INTEGER);
manufacturerOutputPrice = DATA LOCAL STRING(INTEGER);
typeDiscount = DATA LOCAL STRING(INTEGER);
bulkMarginRate = DATA LOCAL STRING(INTEGER);
additionalInformation = DATA LOCAL STRING(INTEGER);
outputPricePackingCoast = DATA LOCAL STRING(INTEGER);
additionalInformationPrice = DATA LOCAL STRING(INTEGER);
outputPriceShippingCoast = DATA LOCAL STRING(INTEGER);
cutRate = DATA LOCAL STRING(INTEGER);
bulkDiscountRate = DATA LOCAL STRING(INTEGER);
outputPriceIncludingShippingCoast = DATA LOCAL STRING(INTEGER);
priceManufacturer = DATA LOCAL STRING(INTEGER);
codeBySupplier = DATA LOCAL STRING(INTEGER);
gtin = DATA LOCAL STRING(INTEGER);
amountWithoutVat = DATA LOCAL NUMERIC (INTEGER);
autoSum = DATA LOCAL BOOLEAN(INTEGER);
codeByBuyer = DATA LOCAL STRING(INTEGER);
quantityDespatchLu = DATA LOCAL STRING(INTEGER);
fullName = DATA LOCAL STRING(INTEGER);
addInfo = DATA LOCAL STRING(INTEGER);
quantitySPT = DATA LOCAL STRING(INTEGER);
inputMode = DATA LOCAL STRING(INTEGER);
priceSPT = DATA LOCAL STRING(INTEGER);
quantityDespatchedSPT = DATA LOCAL STRING(INTEGER);
customCode = DATA LOCAL STRING(INTEGER);
markCodeList = DATA LOCAL STRING(INTEGER);
msgEwaybillProductListMarkCodeList = DATA LOCAL INTEGER(INTEGER);
marksType = DATA LOCAL STRING(INTEGER);
grossWeight = DATA LOCAL NUMERIC[12,6](INTEGER);
discountBulkRate = DATA LOCAL STRING(INTEGER);
documentLineNumber = DATA LOCAL STRING(INTEGER);
documentNumber1 = DATA LOCAL STRING(INTEGER);
amountWithVat = DATA LOCAL NUMERIC (INTEGER);
position = DATA LOCAL NUMERIC (INTEGER);
countryOfOrigin = DATA LOCAL STRING(INTEGER);
partyNumber = DATA LOCAL STRING(INTEGER);
amountVat = DATA LOCAL NUMERIC (INTEGER);
receiverCountryName = DATA LOCAL STRING();
baseShippingDocumentDate = DATA LOCAL STRING();
transporterName = DATA LOCAL STRING();
transportNumber = DATA LOCAL STRING();
code1 = DATA LOCAL STRING();
name4 = DATA LOCAL STRING();
id12 = DATA LOCAL NUMERIC();
shipperContact = DATA LOCAL STRING();
cancelDeliveryNoteID = DATA LOCAL STRING();
autoSum1 = DATA LOCAL BOOLEAN();
baseShippingDocumentNumber = DATA LOCAL STRING();
baseShippingDocumentName = DATA LOCAL STRING();
transportContact = DATA LOCAL STRING();
address1 = DATA LOCAL STRING();
name10 = DATA LOCAL STRING();
msgEwaybillDocList = DATA LOCAL STRING(INTEGER);
msgEwaybillExtraFieldList = DATA LOCAL STRING(INTEGER);

FORM exportEInvoice
    PROPERTIES() functionCode2 EXTID 'functionCode', deliveryNoteType, msgType, blockForm, testIndicator, processingStatus, creationDateTime2 EXTID 'creationDateTime',
        documentNumber, deliveryNoteNumber, deliveryNoteDate, contractNumber, contractDate, contractName
    PROPERTIES () shipperGln, shipperId, msgSenderGln, msgSenderId, shipperName, shipperAddress, shipperUnp,
        receiverGln, receiverId, msgReceiverGln, msgReceiverId, receiverName, receiverAddress, receiverUnp
    PROPERTIES() IN shipFrom address, gln, name, contact
    PROPERTIES() IN shipToV2 address1 EXTID 'address', gln1 EXTID 'gln', name10 EXTID 'name'

    PROPERTIES () totalAmountWithoutVat, totalAmountVat, totalAmountWithVat, totalLine, totalQuantity, totalAmountExcise,
        totalGrossWeight, totalQuantityLu, autoSum1 EXTID 'autoSum', formType, version, receiverCountryName, shipperCountryName,
        transporterName, transporterGln, transporterUnp, cancelDeliveryNoteID

    PROPERTIES () transportNumber, quantityTrip, transportContact, shipperContact, deliveryContact, baseShippingDocumentName, baseShippingDocumentNumber,
        baseShippingDocumentDate

    OBJECTS msgEwaybillDocList = INTEGER
    PROPERTIES(msgEwaybillDocList) msgEwaybillDocList EXTID 'value'
    FILTERS msgEwaybillDocList(msgEwaybillDocList)

    OBJECTS msgEwaybillExtraFieldList = INTEGER
    PROPERTIES(msgEwaybillExtraFieldList) msgEwaybillExtraFieldList EXTID 'value'
    FILTERS msgEwaybillExtraFieldList(msgEwaybillExtraFieldList)

    OBJECTS msgEwaybillProductList = INTEGER
    PROPERTIES(msgEwaybillProductList) position, gtin, codeByBuyer, codeBySupplier, customCodeOther, fullName
    PROPERTIES(msgEwaybillProductList) IN uom code
    PROPERTIES(msgEwaybillProductList) quantityDespatch, priceNet, priceManufacturer, discountBulkRate, discountRate, vatRate, amountExcise,
        quantityDespatchLu, countryOfOrigin, addInfo, amountVat, amountWithVat, amountWithoutVat, autoSum, itemType
    PROPERTIES(msgEwaybillProductList) IN productTraceabilityDataDto customCode, priceSPT, quantityDespatchedSPT, quantitySPT, inputMode
    PROPERTIES(msgEwaybillProductList) IN receiptDocumentDto documentDate, documentLineNumber, documentNumber1 EXTID 'documentNumber', documentType
    PROPERTIES(msgEwaybillProductList) IN fieldCostControlDto manufacturerOutputPrice, typeDiscount, bulkDiscountRate, outputPriceIncludingShippingCoast,
        outputPriceShippingCoast, outputPricePackingCoast, bulkMarginRate, cutRate, additionalInformationPrice, additionalInformation
    PROPERTIES(msgEwaybillProductList) marksType, grossWeight, partyNumber, markCodeSetJSON EXTID 'markCodeSet'
    FILTERS position(msgEwaybillProductList)

    OBJECTS markCodeList = INTEGER
    PROPERTIES(markCodeList) markCodeList EXTID 'value'
    FILTERS msgEwaybillProductListMarkCodeList(markCodeList) == msgEwaybillProductList

    OBJECTS aggregationCodeList = INTEGER
    PROPERTIES(aggregationCodeList) aggregationCodeList EXTID 'value'
    FILTERS msgEwaybillProductListAggregationCodeList(aggregationCodeList) == msgEwaybillProductList

    PROPERTIES() IN formSettings isAutoSum

    OBJECTS productsPositionWithAutoSum = INTEGER IN formSettings
    PROPERTIES(productsPositionWithAutoSum) productsPositionWithAutoSum EXTID 'value'
    FILTERS productsPositionWithAutoSum(productsPositionWithAutoSum)

    OBJECTS productsWhereMarksSelectedFromList = INTEGER IN formSettings
    PROPERTIES(productsWhereMarksSelectedFromList) productsWhereMarksSelectedFromList EXTID 'value'
    FILTERS productsWhereMarksSelectedFromList(productsWhereMarksSelectedFromList)

    PROPERTIES() IN currency code1 EXTID 'code', name4 EXTID 'name', id12 EXTID 'id'
;

levelMark (EInvoiceLotDetail child, EInvoiceLotDetail anc) = RECURSION 1 IF child IS EInvoiceLotDetail AND anc == child
    STEP 1 IF anc == parent($anc);
markDepth (EInvoiceLotDetail d) = GROUP SUM levelMark(d, EInvoiceLotDetail a);
addMarkCodeType (JSONTEXT j) = FORMULA JSONTEXT '($1)::jsonb || \'{"markCodeType":null}\'::jsonb';

createExportEInvoice(EInvoice e) {
    position(INTEGER i) <- NULL;
    marksType(INTEGER i) <- NULL;
    markCodeSetJSON(INTEGER i) <- NULL;
    productsPositionWithAutoSum(INTEGER i) <- NULL;

    //importedCustomer(e) <- TRUE ;
    IF isCancel(e) THEN {
        functionCode2() <- 1;
    } ELSE {
        functionCode2() <- 9;
    }
    deliveryNoteType() <- IF isTN2(e) THEN '270' ELSE '700';
    msgType() <- IF isTN2(e) THEN 'BLRDLN' ELSE 'BLRWBL';
    //documentId(e) <- STRING(e);
    testIndicator() <- IF isTestDocument(e) THEN 'true' ELSE 'false';
    creationDateTime2() <- currentZDateTime();
    documentNumber() <- deliveryNoteNumber(e);
    deliveryNoteNumber() <- deliveryNoteNumber(e);
    deliveryNoteDate() <- deliveryNoteDate(e);
    contractNumber() <- contractId(e);
    contractDate() <- contractDate(e);
    contractName() <- contractName(e);
    code1() <- currency(e);
    name4() <- GROUP MIN name(Currency c) IF shortName(c) = currency(e);
    shipperGln() <- glnSupplier(e);
    shipperId() <- id(supplier(e), customer(e));
    msgSenderGln() <- shipperGln();
    msgSenderId() <- id(supplier(e), customer(e));
    shipperName() <- nameSupplier(e);
    shipperAddress() <- addressSupplier(e);
    shipperUnp() <- unpSupplier(e);
    receiverGln() <- glnCustomer(e);
    receiverId() <- id(customer(e), supplier(e));
    msgReceiverGln() <- receiverGln();
    msgReceiverId() <- id(customer(e), supplier(e));
    receiverName() <- nameCustomer(e);
    receiverAddress() <- addressCustomer(e);
    receiverUnp() <- unpCustomer(e);

    address() <- addressSupplierStock(e);
    gln() <- shipperGln();
    name() <- nameSupplierStock(e);
    contact() <- contactSupplierStock(e);

    address1() <- addressCustomerStock(e);
    gln1() <- receiverGln();
    name10() <- nameCustomerStock(e);

    transportNumber() <- transportID(e);
    quantityTrip() <- quantityTrip(e);
    transportContact() <- transportContact(e);
    shipperContact() <- contactSupplier(e);
    deliveryContact() <- deliveryContact(e);

    FOR eInvoice(EInvoiceDetail d) = e AND lineItemNumber(d) = INTEGER i ORDER lineItemNumber(d) DO {
        position(i) <- lineItemNumber(d);
        gtin(i) <- lineItemID(d);
        codeBySupplier(i) <- lineItemSupplierID(d);
        fullName(i) <- lineItemName(d);
        code(i) <- mapToNewUOM(lineItemQuantityUOM(d));
        quantityDespatch(i) <- quantityDespatched(d);
        priceNet(i) <- lineItemPrice(d);
        vatRate(i) <- valueVAT(d);
        amountVat(i) <- lineItemAmountCharges(d);
        amountWithVat(i) <- lineItemAmount(d);
        amountWithoutVat(i) <- lineItemAmountWithoutCharges(d);
        autoSum(i) <- TRUE;
        itemType(i) <- lineItemSign(d);
        grossWeight(i) <- grossWeightValue(d);
    }

    totalAmountWithoutVat() <- totalAmountWithoutCharges(e);
    totalAmountVat() <- totalAmountCharges(e);
    totalAmountWithVat() <- totalAmount(e);
    totalLine() <- totalLineItem(e);
    totalQuantity() <- totalLineItemQuantity(e);
    totalAmountExcise() <- totalAmountExcise(e);
    totalGrossWeight() <- totalGrossWeight(e);

    LOCAL nodeJSON = JSONTEXT (EInvoiceLotDetail);
    LOCAL maxMarkDepth = INTEGER ();
    maxMarkDepth() <- GROUP MAX markDepth(EInvoiceLotDetail d) IF eInvoice(d) = e;
    FOR iterate(INTEGER j, 1, maxMarkDepth()) DO {
        nodeJSON(EInvoiceLotDetail d) <- addMarkCodeType(JSONTEXT(JSONTEXT FROM markCodeValue = id(d), mode = 'manualInput',
        markCodeSet = (OVERRIDE (JSONTEXT FROM value = nodeJSON(EInvoiceLotDetail c) WHERE parent(c) = d ORDER id(c)), JSONTEXT('[]'))))
            WHERE eInvoice(d) = e AND markDepth(d) = maxMarkDepth() - j + 1;
    }

    FOR eInvoice(EInvoiceDetail ed) = e AND lineItemNumber(ed) = INTEGER i AND (GROUP SUM 1 IF eInvoiceDetail(EInvoiceLotDetail d) = ed) DO {
        marksType(i) <- 'manualInput';
        markCodeSetJSON(i) <- JSONTEXT(JSONTEXT FROM value = nodeJSON(EInvoiceLotDetail d) WHERE eInvoiceDetail(d) = ed AND NOT parent(d) ORDER id(d));
    }

    autoSum1() <- TRUE;
    isAutoSum() <- TRUE;
    productsPositionWithAutoSum(0) <- TRUE;
}

changeReason = DATA LOCAL STRING(INTEGER);
id6 = DATA LOCAL STRING(INTEGER);
signatureDate = DATA LOCAL DATE (INTEGER);
signatureTime = DATA LOCAL TIME (INTEGER);

FORM importEwaybill
    PROPERTIES() id

    OBJECTS changeRequestList = INTEGER
    PROPERTIES(changeRequestList) changeReason, id6 EXTID 'id', signatureDate, signatureTime
    FILTERS imported(changeRequestList)
;

overImportEInvoices(LegalEntity le, STRING provider) + {
    NEWSESSION NESTED LOCAL {
        LOCAL result = FILE ();

        FOR eInvoiceDeliveryNoteNumber(documentNumber(INTEGER i)) = EInvoice ei DO {
            documentId(ei) <- id(i);
            IF id1(i) != 'DRAFT' THEN {
                logToFile('edi', provider + ' (' + loginProfile(le) + ') GET /api/v1/EWAYBILL/' + id(i));
                EXTERNAL HTTP GET url(profile(le)) + 'EWAYBILL/' + id(i) HEADERS headersV2 TO result;
                IMPORT importEwaybill JSON FROM result();
                changeRequestId(ei) <- GROUP LAST id6(INTEGER ii) ORDER signatureDate(ii), signatureTime(ii);
            }
        }
        APPLY NESTED LOCAL;
    }
}

sentDirV2 (STRING[100] outputDir) = outputDir + '/sent/invoices/' + toChar(currentDate(), 'yyyyMMdd');
sentPathV2 (STRING[100] outputDir, DATETIME dateTime) = sentDirV2(outputDir) + '/' + 'blrwbr-' + toChar(dateTime, 'YYYY-MM-DD-HH24-MI-SS-MS');

updateDocumentIdV2 (EInvoice ei, LegalEntity le, STRING provider) {
    LOCAL result = FILE ();
    LOCAL NESTED page = INTEGER ();
    WHILE TRUE DO {
        timeoutHttp() <- 300000;
        page() <- page() (+) 1;

        EXPORT JSON FROM documentDateStart = ZDATETIME(dateTimeToDateTime(currentDate(), 00:00)), documentDateEnd = ZDATETIME(dateTimeToDateTime(currentDate(), 23:59));
        logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages request sent. POST /api/v1/EWAYBILL/' + (OVERRIDE id(filterPageStatus()), id(FilterPageStatus.ALL_)) + '/filteredPage?page=' + page());
        EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/' + (OVERRIDE id(filterPageStatus()), id(FilterPageStatus.ALL_)) + '/filteredPage?page=' + page() HEADERS headersV2 PARAMS exportFile() TO result;

        IF NOT statusHttp() == 200 THEN BREAK;
        IMPORT importEInvoices JSON FROM result();
        IF NOT (GROUP SUM 1 IF id(INTEGER i)) THEN BREAK;

        FOR eInvoiceDeliveryNoteNumber(documentNumber(INTEGER i)) = ei DO documentId(ei) <- id(i);

        IF totalPages() == page() OR last() THEN BREAK;
    }
}

DESIGN eInvoice {
    PROPERTY (addressCustomerStock(e)) { notNull = TRUE; };
    PROPERTY (addressSupplierStock(e)) { notNull = TRUE; };
    PROPERTY (contractName(e)) { notNull = TRUE; };
    PROPERTY (deliveryNoteDate(e)) { notNull = TRUE; };
}