        importRequestResult(result(), statusHttp());
        MESSAGE 'Уведомление о подтверждении не выгружено:\n' + requestError() NOWAIT;
    }
}

signAndSendConfirmCancelCustomerV2 (EInvoice ei, LegalEntity le, STRING[100] provider) + {
    LOCAL result = FILE ();

    IF NOT documentId(ei) THEN {
        logToFile('edi', provider + ' SendConfirmCancelEInvoice V2 ' + deliveryNoteNumber(ei) + ': не заполнен documentId');
        MESSAGE provider + ' Уведомление о подтверждении по накладной ' + deliveryNoteNumber(ei) + ' не выгружено: накладная не отправлялась через API V2' NOWAIT;
        RETURN;
    }
    TRY {
        IF NOT profile(le) THEN {
            logToFile('edi', provider + 'SendConfirmCancelEInvoice V2: не задан профиль организации получателя');
            MESSAGE provider + 'Уведомление о подтверждении не выгружено: не задан профиль организации получателя' NOWAIT;
            RETURN;
        }
        IF NOT EDSServiceCustomer(provider, ei) THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmCancelEInvoice V2: не заданы параметры EDSService');
            MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении не выгружено: не заданы параметры EDSService' NOWAIT;
            RETURN;
        }
        authV2(le);
        IF NOT token() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmCancelEInvoice V2: ошибка при аутентификации');
            MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении не выгружено: ошибка при аутентификации' NOWAIT;
            RETURN;
        }

        exportDateTime() <- currentDateTimeMillis();
        toMilliseconds(exportDateTime());

        EXPORT JSON FROM documentId = INTEGER(documentId(ei));
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'POST draft/blrapn/EWAYBILL/create2650OnEwaybillCancel?base64=true request:\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'draft/blrapn/EWAYBILL/create2650OnEwaybillCancel?base64=true' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendConfirmCancelEInvoice V2 ' + deliveryNoteNumber(ei), le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        IMPORT importSignDoc JSON FROM result();
        IF errorDescription() != '' THEN {
            MESSAGE errorDescription();
            RETURN;
        }

        getSignedDocumentCustomerV2(provider, ei, xmlBase64(), TRUE);
        IF signError() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmCancelEInvoice V2 error: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError());
            MESSAGE provider + ' (' + loginProfile(le) + ') Документ не подписан: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError() NOWAIT;
            RETURN;
        }
        IF NOT base64Signature() THEN RETURN;

        EXPORT JSON FROM id(), signatureBase64 = base64Signature();
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'draft/blrapn/EWAYBILL/saveSigned2650OnEwaybillCancelAndSendByActiveMq request:\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'draft/blrapn/EWAYBILL/saveSigned2650OnEwaybillCancelAndSendByActiveMq' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendConfirmCancelEInvoice V2 ' + deliveryNoteNumber(ei) + ' (saveSigned2650)', le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmCancelEInvoice V2 ' + deliveryNoteNumber(ei) + ' request succeeded');
        MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении ' + deliveryNoteNumber(ei) + ' выгружено' NOWAIT;

        APPLY NESTED LOCAL;
        IF canceled() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmCancelEInvoice V2: apply canceled ' + applyMessage());
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + loginProfile(le) + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
        importRequestResult(result(), statusHttp());
        MESSAGE 'Уведомление о подтверждении не выгружено:\n' + requestError() NOWAIT;
    }
}