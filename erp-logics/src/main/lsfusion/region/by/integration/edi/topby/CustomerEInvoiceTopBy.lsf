            RETURN;
        }

        exportDateTime() <- currentDateTimeMillis();
        toMilliseconds(exportDateTime());

        EXPORT JSON FROM documentId = INTEGER(documentId(ei));
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'POST draft/blrapn/EWAYBILL/create2650OnEwaybill?base64=true request:\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'draft/blrapn/EWAYBILL/create2650OnEwaybill?base64=true' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendConfirmEInvoice V2 ' + deliveryNoteNumber(ei), le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        IMPORT importSignDoc JSON FROM result();
        IF errorDescription() != '' THEN {
            MESSAGE errorDescription();
            RETURN;
        }

        getSignedDocumentCustomerV2(provider, ei, xmlBase64(), TRUE);
        IF signError() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoice V2 error: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError());
            MESSAGE provider + ' (' + loginProfile(le) + ') Документ не подписан: EWAYBILL ' + (OVERRIDE deliveryNoteNumber(ei), documentId(ei), STRING[35](resultMilliseconds())) + ' не подписан. Ошибка: ' + signError() NOWAIT;
            RETURN;
        }
        IF NOT base64Signature() THEN RETURN;

        EXPORT JSON FROM id(), signatureBase64 = base64Signature();
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'draft/blrapn/EWAYBILL/saveSigned2650OnEwaybillAndSendByActiveMq request:\n' + exportFile());
        EXTERNAL HTTP POST url(profile(le)) + 'draft/blrapn/EWAYBILL/saveSigned2650OnEwaybillAndSendByActiveMq' HEADERS headersV2 PARAMS exportFile() TO result;
        logToFile('edi', provider + ' (' + loginProfile(le) + '): ' + 'response:\n' + result());

        checkResponseV2(result(), 'SendConfirmEInvoice V2 ' + deliveryNoteNumber(ei) + ' (saveSigned2650)', le, provider);
        IF NOT requestSucceededV2() THEN RETURN;

        logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoice V2 ' + deliveryNoteNumber(ei) + ' request succeeded');
        MESSAGE provider + ' (' + loginProfile(le) + ') Уведомление о подтверждении ' + deliveryNoteNumber(ei) + ' выгружено' NOWAIT;

        APPLY NESTED LOCAL;
        IF canceled() THEN {
            logToFile('edi', provider + ' (' + loginProfile(le) + ') SendConfirmEInvoice V2: apply canceled ' + applyMessage());
        }
    } CATCH {
