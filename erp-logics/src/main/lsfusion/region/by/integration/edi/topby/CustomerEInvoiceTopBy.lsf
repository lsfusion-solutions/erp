MODULE CustomerEInvoiceTopBy;

REQUIRE EInvoiceTopBy, CustomerEInvoiceTopByApi, EInvoiceEDSTopBy;


signAndSendBlrapnCustomer(EInvoice e) + {
    IF EDIProviderInvoice(e) == EDIProvider.topBy THEN {
        newNS() <- TRUE;
        IF exportedBlrapnCustomer(e) THEN
            MESSAGE 'Извещение о прочтении (покупатель) уже отправлено';
        ELSE {
            signAndSendBlrapnCustomerEInvoice(e, loginProfileTopBy(customer(e)), passwordProfileTopBy(customer(e)), urlProfileTopBy(customer(e)), outputDirTopBy(), 'TopBy', TRUE);
        }
    }
}

signAndSendCustomer(EInvoice e) + {
    IF EDIProviderInvoice(e) == EDIProvider.topBy THEN {
        newNS() <- TRUE;
        IF (exportedCustomer(e) OR exportedNoticeCustomer(e)) THEN 
            MESSAGE 'Накладная (покупатель) или уведомление об изменении уже отправлены';
        ELSE IF isTN2(e) THEN {
            signAndSendCustomerEInvoiceTN2(e, loginProfileTopBy(customer(e)), passwordProfileTopBy(customer(e)), urlProfileTopBy(customer(e)), outputDirTopBy(), 'TopBy');
        } ELSE {
            signAndSendCustomerEInvoice(e, loginProfileTopBy(customer(e)), passwordProfileTopBy(customer(e)), urlProfileTopBy(customer(e)), outputDirTopBy(), 'TopBy');
        }
    }
}

signAndSendNoticeCustomer(EInvoice e, STRING[1000] d) + {
    IF EDIProviderInvoice(e) == EDIProvider.topBy THEN {
        newNS() <- TRUE;
        IF (exportedCustomer(e) OR exportedNoticeCustomer(e)) THEN 
            MESSAGE 'Накладная (покупатель) или уведомление об изменении уже отправлены';
        ELSE IF isTN2(e) THEN {
            signAndSendNoticeCustomerEInvoiceTN2(e, d, loginProfileTopBy(customer(e)), passwordProfileTopBy(customer(e)), urlProfileTopBy(customer(e)), outputDirTopBy(), 'TopBy');
        } ELSE {
            signAndSendNoticeCustomerEInvoice(e, d, loginProfileTopBy(customer(e)), passwordProfileTopBy(customer(e)), urlProfileTopBy(customer(e)), outputDirTopBy(), 'TopBy');
        }
    }
}

signAndSendCustomer(ECreditNote c) + {
    IF EDIProviderInvoice(c) == EDIProvider.topBy THEN {
        newNS() <- TRUE;
        IF exportedCustomer(c) THEN 
            MESSAGE 'Акт приемки (покупатель) уже отправлен';
        ELSE signAndSendCustomerECreditNote(c, loginProfileTopBy(customer(c)), passwordProfileTopBy(customer(c)), urlProfileTopBy(customer(c)), outputDirTopBy(), 'TopBy');
    }
}

signAndSendBlrapnCustomer(ECreditNote c) + {
    IF EDIProviderInvoice(c) == EDIProvider.topBy THEN {
        newNS() <- TRUE;
        IF exportedBlrapnCustomer(c) THEN
            MESSAGE 'Извещение о прочтении (покупатель) уже отправлено';
        ELSE 
            signAndSendBlrapnCustomerECreditNote(c, loginProfileTopBy(customer(c)), passwordProfileTopBy(customer(c)), urlProfileTopBy(customer(c)), outputDirTopBy(), 'TopBy');
    }
}