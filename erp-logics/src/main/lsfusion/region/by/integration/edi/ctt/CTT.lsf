MODULE CTT;

REQUIRE TopBy;

NAMESPACE EDI;

CLASS Profile 'Профиль';
TABLE profile(Profile);

login 'Логин' = DATA STRING[100] (Profile);
password 'Пароль СТТ' = DATA STRING[100] (Profile) ECHO;
isTest 'Тестовый контур' = DATA BOOLEAN (Profile);
useProfileKey 'Использовать ключ профиля для подписания' = DATA BOOLEAN (Profile);

url(Profile p) = IF isTest(p) THEN 'https://edi-pub.ctt.by/api/v1/' ELSE 'https://edi.ctt.by/api/v1/';

authenticate 'Авторизация' (Profile p) {
    TRY {
        EXPORT JSON FROM username = login(p), password(p);
        token() <- NULL;
        sendRequestEDI(url(p) + 'authentication/authenticate', exportFile());

        IMPORT JSON FROM sendRequestEDIResponse() TO () token = uuid;
    } CATCH {
        LOCAL error = STRING ();
        IMPORT JSON FROM sendRequestEDIResponse() TO () error;

        logToFile('edi', CONCAT '\n', 'CTT' + ' (' + login(p) + ') Authenticate error:', error(), messageCaughtException(), lsfStackTraceCaughtException());
        MESSAGE 'Ошибка авторизации' + (OVERRIDE '(' + error() + ')', '') + '. Проверьте логин и пароль.'NOWAIT;
    }
}

FORM profile 'Профиль пользователя СТТ'
    OBJECTS p = Profile PANEL
    PROPERTIES (p) login, password, isTest, url, useProfileKey

    EDIT Profile OBJECT p
;

DESIGN profile {
    GROUP (, p) {
        lines = 1;
        horizontal = TRUE;
    }
}

FORM profiles 'Профили пользователей СТТ'
    OBJECTS p = Profile
    PROPERTIES (p) READONLY login, url, useProfileKey
    PROPERTIES (p) NEWSESSION NEW, EDIT, DELETE

    LIST Profile OBJECT p
;

profile = DATA Profile (LegalEntity);
loginProfile 'Логин API СТТ'(LegalEntity l) = login(profile(l));

EXTEND FORM integrationData
    PROPERTIES (let) loginProfile
;

CLASS FilterPageStatus {
    ALL_ 'Все',
    AT_PARTNER 'У контрагента',
    COMPLETED 'Завершённые',
    WAITING_FOR_PROCESSING 'Ждёт обработки'
}

id (FilterPageStatus s) = CASE
    WHEN s == FilterPageStatus.ALL_ THEN 'ALL'
    WHEN s == FilterPageStatus.AT_PARTNER THEN 'AT_PARTNER'
    WHEN s == FilterPageStatus.COMPLETED THEN 'COMPLETED'
    WHEN s == FilterPageStatus.WAITING_FOR_PROCESSING THEN 'WAITING_FOR_PROCESSING'
;

filterPageStatus = DATA LOCAL NESTED FilterPageStatus ();
filterPageStatusName 'Статус документов' () = caption(filterPageStatus()) CHARWIDTH 30;

importRequestResult (FILE json, INTEGER status) {
    IF NOT status == 200 THEN {
        IMPORT JSON FROM json TO() requestError = error;
        IF status = 401 THEN requestError() <- 'Не пройдена авторизация';
    } ELSE {
        requestError() <- NULL;
    }
}

errorV2 () = OVERRIDE requestError(), 'неожиданный ответ ' + statusHttp();

headersV2 = DATA LOCAL NESTED STRING (STRING);
currentProfileV2 = DATA LOCAL NESTED Profile ();
authV2 'Авторизация V2' (LegalEntity le) {
    authenticate(profile(le));
    headersV2(STRING k) <- NULL;
    currentProfileV2() <- profile(le) IF token();
    IF token() THEN headersV2('Authorization') <- token();
}

ensureAuthV2 (LegalEntity le) {
    IF NOT (token() AND headersV2('Authorization') AND currentProfileV2() == profile(le)) THEN authV2(le);
}

requestSucceededV2 = DATA LOCAL BOOLEAN ();
checkResponseV2 (FILE response, STRING stage, LegalEntity le, STRING provider) {
    importRequestResult(response, statusHttp());
    requestSucceededV2() <- TRUE IF statusHttp() == 200 OR statusHttp() == 201;
    IF NOT requestSucceededV2() THEN
        logToFile('edi', provider + ' (' + loginProfile(le) + ') ' + stage + ': ' + errorV2());
}

fillPartnerIdV2 (LegalEntity a, LegalEntity b, STRING glnA, STRING unpA, LegalEntity le, STRING provider) {
    IF NOT id(a, b) THEN {
        LOCAL response = FILE ();
        EXPORT JSON FROM gln = glnA, unp = unpA;
        EXTERNAL HTTP POST url(profile(le)) + 'organization/partners/list' HEADERS headersV2 PARAMS exportFile() TO response;
        checkResponseV2(response(), 'organization/partners/list', le, provider);
        IF requestSucceededV2() THEN {
            IMPORT JSON FROM response() TO id = id;
            id(a, b) <- id(0);
        }

        IF NOT id(a, b) AND glnA AND unpA THEN {
            EXPORT JSON FROM gln = glnA;
            EXTERNAL HTTP POST url(profile(le)) + 'organization/partners/list' HEADERS headersV2 PARAMS exportFile() TO response;
            checkResponseV2(response(), 'organization/partners/list', le, provider);
            IF requestSucceededV2() THEN {
                IMPORT JSON FROM response() TO id = id;
                id(a, b) <- id(0);
            }
        }
    }
}

id = DATA LOCAL STRING ();
subject = DATA LOCAL STRING();
xmlBody = DATA LOCAL STRING();
xmlByteDate = DATA LOCAL STRING(INTEGER);
errorDescription = DATA LOCAL STRING();
xmlBase64 = DATA LOCAL STRING();
documentId = DATA LOCAL STRING();
publicId = DATA LOCAL STRING();
successful = DATA LOCAL BOOLEAN();

FORM importSignDoc
    PROPERTIES() xmlBody, errorDescription, documentType, xmlBase64, documentId, id, publicId, subject EXTID 'subjectName', successful

    OBJECTS xmlByteDate = INTEGER
    PROPERTIES(xmlByteDate) xmlByteDate EXTID 'value'
    FILTERS imported(xmlByteDate)
;

documentDateStart 'Дата с' = DATA LOCAL NESTED DATETIME ();
documentDateEnd 'Дата по' = DATA LOCAL NESTED DATETIME ();

countDaysReceiveV2 'За сколько дней получать документы (пусто - 7)' = DATA INTEGER ();
receiveDateStartV2 () = OVERRIDE documentDateStart(), dateTimeToDateTime(subtract(currentDate(), (OVERRIDE countDaysReceiveV2(), 7)), 00:00);
receiveDateEndV2 () = OVERRIDE documentDateEnd(), currentDateTime();
idContent = DATA LOCAL STRING(INTEGER);
name1 = DATA LOCAL STRING();
gln = DATA LOCAL STRING();
gln1 = DATA LOCAL STRING();
id1 = DATA LOCAL STRING();

last = DATA LOCAL NESTED BOOLEAN();
totalPages = DATA LOCAL NESTED INTEGER();
dateTime = DATA LOCAL STRING(INTEGER);
dateTimeUpdate = DATA LOCAL STRING(INTEGER);
documentNumber = DATA LOCAL STRING(INTEGER);
name1 = DATA LOCAL STRING(INTEGER);
id1 = DATA LOCAL STRING(INTEGER);

GROUP processingStatus;

FORM importEInvoices
    PROPERTIES() last, totalPages

    OBJECTS content = INTEGER
    PROPERTIES(content) id, dateTime, dateTimeUpdate, documentNumber
    PROPERTIES(content) IN processingStatus name1 EXTID 'name', id1 EXTID 'id'
    FILTERS imported(content)
;

messageID = DATA LOCAL STRING();
msgDateTime = DATA LOCAL DATETIME();
messageType = DATA LOCAL STRING();
msgSenderID = DATA LOCAL STRING();
msgReceiverID = DATA LOCAL STRING();
testIndicator = DATA LOCAL STRING();
//eorders
GROUP UNB;
e0026 = DATA LOCAL STRING();

FORM message
    PROPERTIES() IN messageHeader messageType EXTID 'MessageType', msgSenderID EXTID 'MsgSenderID', msgReceiverID EXTID 'MsgReceiverID'

    PROPERTIES() IN UNB e0026 EXTID 'E0026'
;

currentDocId = DATA LOCAL NESTED STRING();

overIsProfileGLN = ABSTRACT CASE BOOLEAN (Profile, STRING);
isProfileGLN (Profile p, STRING gln) =
    (GROUP MAX TRUE IF profile(LegalEntity le) == p AND (GLN(le) == gln OR extraGLN(le) == gln))
    OR (GROUP MAX TRUE IF profile(legalEntity(Stock st)) == p AND GLN(st) == gln)
    OR overIsProfileGLN(p, gln);

//последняя успешно обработанная или штатно пропущенная версия документа V2 ('EWAYBILL/<id>' / 'ORDERS/<id>')
processedVersionV2 = DATA STRING[100] (STRING[100]);
ewaybillKeyV2 (INTEGER i) = STRING[100]('EWAYBILL/' + id(i));
ewaybillVersionV2 (INTEGER i) = STRING[100](CONCAT '|', id1(i), dateTimeUpdate(i));
ewaybillVersionChangedV2 (INTEGER i) = id(i) AND NOT id1(i) == 'DRAFT' AND NOT processedVersionV2(ewaybillKeyV2(i)) = ewaybillVersionV2(i);

parseDocumentDateV2 (INTEGER i) {
    documentDate(i) <- NULL;
    IF dateTime(i) THEN {
        TRY { documentDate(i) <- DATETIME(dateTime(i)); }
        IF NOT documentDate(i) THEN TRY { documentDate(i) <- DATETIME(ZDATETIME(dateTime(i))); }
    }
}

orderArchiveFileV2 (STRING[100] s) = CASE
    WHEN isSubstring(s, 'BLRAPN') THEN 4
    WHEN isSubstring(s, 'CBLR') THEN 3
    WHEN isSubstring(s, 'RBLR') THEN 2
    ELSE 1;

//V2-запись журнала: профиль СТТ и id документа (на документ несколько файлов, ключ записи — id_doc + '_' + имя)
profileV2 'Профиль V2' = DATA Profile (EDIFile);
documentIdV2 'Id документа V2' = DATA STRING (EDIFile);
profileLogin(EDIFile f) += login(profileV2(f));

//V2: каждый файл архива — отдельная запись журнала (на один документ их несколько);
//ключ — id документа + '_' + имя файла. id(i) к моменту вызова подменён на ключ файла,
//исходный id документа сохраняется в currentDocId
registerEDIFileV2 (INTEGER i, Profile p, STRING[100] archiveDir, STRING[100] provider) {
    TRY {
        NEWSESSION NESTED LOCAL {
            FOR EDIFile f = ediFile(id(i)) DO {
                lastReceivedDateTime(f) <- currentDateTime();
                IF NOT documentDate(f) AND documentDate(i) THEN documentDate(f) <- documentDate(i);
                IF data(i) AND NOT data(f) AND NOT processedDateTime(f) AND NOT outdated(f) THEN
                    fillEDIFile(f, i, archiveDir);
            }
            IF NOT ediFile(id(i)) THEN {
                NEW f = EDIFile {
                    id(f) <- id(i);
                    profileV2(f) <- p;
                    documentIdV2(f) <- currentDocId();
                    documentType(f) <- documentType(i);
                    documentDate(f) <- documentDate(i);
                    receivedDateTime(f) <- currentDateTime();
                    fillEDIFile(f, i, archiveDir);
                }
            }
            APPLY NESTED LOCAL;
        }
    } CATCH {
        logToFile('edi', CONCAT '\n', provider + ' (' + login(p) + ') Register V2 file ' + id(i) + ' error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
        //прерывание пользователем должно останавливать весь приём, а не только регистрацию
        IF isSubstring(messageCaughtException(), 'interrupted') THEN throwException(messageCaughtException());
    }
}

//обработка V2-записи из журнала: тело из записи, id документа — из documentIdV2;
//подтверждение не отправляется (V2 — REST, SOAP-подтверждение не нужно)
processEDIFileV2 (EDIFile f) + {
    IF profileV2(f) THEN {
        readReceivedFile(f);
        data(0) <- XMLFILE(receivedFile());
        id(0) <- id(f);
        documentType(0) <- documentType(f);
        documentDate(0) <- documentDate(f);
        receivedFileName(0) <- receivedFileName(f);
        currentDocId() <- documentIdV2(f);
        newNS() <- TRUE;
        skipImportOrders() <- NULL;
        fillStartParams();
        startReceiveResult();
        logToFile('edi', 'TopBy (' + login(profileV2(f)) + ') Process V2 file ' + id(f));
        IF NOT data(0) THEN {
            MESSAGE 'Не найдено тело сообщения ' + id(f) + (OVERRIDE ' в файле ' + receivedPath(f), '') NOWAIT;
            RETURN;
        }
        TRY {
            overReceiveMessages(0, login(profileV2(f)), password(profileV2(f)), url(profileV2(f)), STRING[100](OVERRIDE receivedDir(f), archiveDirTopBy()), TRUE, 'TopBy');
        } FINALLY {
            currentDocId() <- NULL;
        }
        checkReceiveResult(0, login(profileV2(f)), 'TopBy');
        fillEndParams();
        MESSAGE (OVERRIDE textMessage(), 'Сообщение ' + id(f) + ' обработано') NOWAIT;
    } ELSE {
        MESSAGE 'Не задан профиль подключения у сообщения ' + id(f) NOWAIT;
    }
}

overImportEInvoices ABSTRACT LIST (LegalEntity, STRING);
receiveMessagesV2 (LegalEntity le, STRING[100] archiveDir, BOOLEAN disableConfirmation, STRING[100] provider) {
    IF loginProfile(le) AND password(profile(le)) AND url(profile(le)) THEN {
        LOCAL response = FILE ();
        TRY {
            authV2(le);
            IF token() THEN {
                LOCAL NESTED page = INTEGER ();
                fillStartParams();
                WHILE TRUE DO {
                    timeoutHttp() <- 300000;
                    page() <- page() (+) 1;

                    EXPORT JSON FROM documentDateStart = ZDATETIME(receiveDateStartV2()), documentDateEnd = ZDATETIME(receiveDateEndV2());
                    logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2 request sent. POST /api/v1/EWAYBILL/' + (OVERRIDE id(filterPageStatus()), id(FilterPageStatus.ALL_)) + '/filteredPage?page=' + page());
                    EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/' + (OVERRIDE id(filterPageStatus()), id(FilterPageStatus.ALL_)) + '/filteredPage?page=' + page() HEADERS headersV2 PARAMS exportFile() TO response;

                    IF NOT statusHttp() == 200 THEN {
                        logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2: неожиданный ответ ' + statusHttp());
                        BREAK;
                    }

                    id(INTEGER i) <- NULL;
                    dateTime(INTEGER i) <- NULL;
                    dateTimeUpdate(INTEGER i) <- NULL;
                    documentNumber(INTEGER i) <- NULL;
                    name1(INTEGER i) <- NULL;
                    id1(INTEGER i) <- NULL;
                    IMPORT importEInvoices JSON FROM response();
                    IF NOT (GROUP SUM 1 IF id(INTEGER i)) THEN BREAK;
                    overImportEInvoices(le, provider);

                    FOR id(INTEGER i) DO {
                        IF NOT id1(i) THEN
                            logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2 warning: не заполнен статус документа ' + id(i));
                        IF id1(i) == 'DRAFT' THEN {
                            logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2: документ ' + id(i) + ' пропущен (черновик)');
                        } ELSE IF NOT processedVersionV2(ewaybillKeyV2(i)) = ewaybillVersionV2(i) THEN {
                            EXPORT JSON FROM value = '[' + id(i) + ']';
                            logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2 request sent. POST /api/v1/EWAYBILL/downloadArchive/XML\n' + exportFile());

                            unzipped(STRING[100] s) <- NULL;
                            EXTERNAL HTTP POST url(profile(le)) + 'EWAYBILL/downloadArchive/XML' HEADERS headersV2 PARAMS exportFile() TO unzipping;
                            IF statusHttp() == 200 THEN {
                                TRY { makeUnzipFile(); }
                                IF NOT (GROUP SUM 1 IF unzipped(STRING[100] s)) THEN {
                                    logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2: пустой архив для документа ' + id(i));
                                } ELSE {
                                    LOCAL docHasFailed = BOOLEAN ();
                                    LOCAL docInvoiceSkipped = BOOLEAN ();
                                    FOR FILE f = unzipped(STRING[100] s) ORDER orderArchiveFileV2(s), s DO {
                                        currentDocId() <- id(i);
                                        messageType() <- NULL;
                                        msgSenderID() <- NULL;
                                        msgReceiverID() <- NULL;
                                        TRY { IMPORT message XML FROM f; } CATCH {
                                            logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2 parse header ' + id(i) + '/' + s + ' error: ' + messageCaughtException());
                                        }
                                        IF msgReceiverID() AND NOT isProfileGLN(profile(le), msgReceiverID()) THEN {
                                            logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2 ' + id(i) + '/' + s + ' skipped: MsgReceiverID ' + msgReceiverID() + ' does not belong to profile');
                                        } ELSE {
                                            data(i) <- XMLFILE(f);
                                            documentType(i) <- messageType();

                                            receivedFileName(i) <- id(i) + '_' + regexpReplace(s, '\\.[^.]*$', '', 'g');
                                            //файл архива — отдельное сообщение журнала: ключ id_doc + '_' + имя файла;
                                            //ветки получают ключ файла через id(i), id документа остаётся в currentDocId
                                            id(i) <- receivedFileName(i);
                                            parseDocumentDateV2(i);
                                            registerEDIFileV2(i, profile(le), archiveDir, provider);
                                            //повторный приём окна V2 не обрабатывает уже обработанные файлы:
                                            //иначе сбрасываются exported* и уходят парные извещения
                                            IF NOT ediFile(id(i)) OR NOT processedDateTime(ediFile(id(i))) THEN {
                                                IF docInvoiceSkipped() AND lower(documentType(i)) == 'blrapn' THEN {
                                                    logToFile('edi', provider + ' (' + loginProfile(le) + ') Import EInvoiceMessage ' + id(i) + ' skipped: invoice skipped');
                                                    messagesSkipped() <- messagesSkipped() + 1;
                                                } ELSE {
                                                    startReceiveResult();
                                                    overReceiveMessages(i, loginProfile(le), password(profile(le)), url(profile(le)), archiveDir, disableConfirmation, provider);
                                                    IF (OVERRIDE messagesSkipped(), 0) > (OVERRIDE receiveSkippedBefore(), 0) THEN {
                                                        IF lower(documentType(i)) == 'blrwbl' OR lower(documentType(i)) == 'blrdln' THEN docInvoiceSkipped() <- TRUE;
                                                    } ELSE IF NOT processedDateTime(ediFile(id(i))) OR (OVERRIDE countReceiveResults(), 0) = (OVERRIDE receiveResultsBefore(), 0) THEN {
                                                        docHasFailed() <- TRUE;
                                                    }
                                                    checkReceiveResult(i, loginProfile(le), provider);
                                                }
                                            }
                                            id(i) <- currentDocId();
                                        }
                                        currentDocId() <- NULL;
                                    }
                                    IF NOT docHasFailed() THEN processedVersionV2(ewaybillKeyV2(i)) <- ewaybillVersionV2(i);
                                }
                            } ELSE {
                                logToFile('edi', provider + ' (' + loginProfile(le) + ') ReceiveMessages V2: downloadArchive ' + id(i) + ': неожиданный ответ ' + statusHttp());
                            }
                            receivedFileName(i) <- NULL;
                        }
                    }
                    APPLY;
                    IF totalPages() == page() OR last() THEN BREAK;
                }
                fillEndParams();
                IF sendRecipientErrorFailed() == 0 THEN {
                    MESSAGE (OVERRIDE textMessage(), provider + ' (' + loginProfile(le) + ') Не найдено новых сообщений (EInvoice V2)') NOWAIT;
                }
            }
        } CATCH {
            logToFile('edi', CONCAT '\n', provider + ' (' + loginProfile(le) + ') error:', messageCaughtException(), javaStackTraceCaughtException() IF logStackForException(), lsfStackTraceCaughtException());
            MESSAGE 'Запрос на получение накладных не отправлен. Обратитесь к администратору' NOWAIT;
            CANCEL;
        }
    }
}

receiveMessagesV2(STRING[100] archiveDir, BOOLEAN disableConfirmation, STRING[100] provider) + {
    FOR LegalEntity le == [GROUP MIN LegalEntity l BY profile(l)](Profile p) AND login(p) AND password(p) DO {
        NEWSESSION {
            lockTopBy(login(p));
            IF lockResultTopBy() THEN {
                TRY {
                    receiveMessagesV2(le, archiveDir, disableConfirmation, provider);
                } FINALLY {
                    unlockTopBy(login(p));
                }
            } ELSE {
                MESSAGE provider + ' (' + login(p) + ') Уже выполняется получение сообщений. Подождите...' NOWAIT;
            }
        }
    }
}

legalEntityCTT = DATA LegalEntity ();
nameLegalEntityCTT 'Организация' = name(legalEntityCTT());
signer = DATA CustomUser (LegalEntity);
nameSigner 'Подписант' (LegalEntity l) = name(signer(l));

EXTEND FORM integrationData
    PROPERTIES () nameLegalEntityCTT, countDaysReceiveV2, documentDateStart, documentDateEnd
    PROPERTIES (let) nameSigner
;
DESIGN integrationData {
    col1TopBy {
        NEW v2 {
            caption = 'V2';
            MOVE PROPERTY (nameLegalEntityCTT());
            MOVE PROPERTY (countDaysReceiveV2());
            NEW dates {
                caption = 'Период';
                horizontal = TRUE;
                MOVE PROPERTY (documentDateStart());
                MOVE PROPERTY (documentDateEnd());
            }
        }
    }
}