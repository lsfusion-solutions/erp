MODULE VetisProductionOrder;

REQUIRE ProductionOrder, VetisItem, VetisStock, VetisStockEntry;

PRIORITY Production;

NAMESPACE VetisSale;

volume 'Объем в документе' = DATA NUMERIC[16,5] (ComponentDetail, StockEntry);

// единица измерения записи журнала может быть не заполнена — тогда она доопределяется (ВСД, номенклатура),
// иначе пересчёт количества в объём шёл бы с коэффициентом 1 и давал завышенный объём
overUnitStockEntry = ABSTRACT Unit (StockEntry);
unitEntry (StockEntry s) = OVERRIDE unit(s), overUnitStockEntry(s) MATERIALIZED; // материализация: OVERRIDE-каскад с GROUP LAST иначе инлайнится в каждый пересчёт объёма и раздувает запрос (SQLTooLongQuery)
factorEntry (ComponentDetail vd, StockEntry s) = OVERRIDE factor(sku(vd), unitEntry(s)), 1.0;

volumeDetail 'Объем в документе' (ComponentDetail vd, StockEntry s) = NUMERIC[16,5](bruttoQuantity(vd) * factorEntry(vd, s));
// объём при ручном выборе: не больше непокрытого остатка строки (поставлено − связанное с записями)
// и не больше свободного остатка записи (объём продукции − распределённое строками);
// по уже связанной записи не выполняется, при расчётном объёме <= 0 связь не создаётся
fillVolume 'Выбрать' (ComponentDetail d, StockEntry s) {
    IF NOT volume(d, s) THEN {
        LOCAL calc = NUMERIC[16,5] ();
        calc() <- min(volumeDetail(d, s) (-) (GROUP SUM volume(d, StockEntry ss)),
                      volume(s) (-) (GROUP SUM volume(ComponentDetail vd, s)));
        IF calc() > 0 THEN
            volume(d, s) <- calc();
    }
}

bruttoQuantity (ComponentDetail vd, StockEntry s) = volume(s) / factorEntry(vd, s);

matches (ComponentDetail vd, StockEntry s) = in(componentsStock(vd), enterprise(s)) AND in(s, GROUP MIN ProductItem pi IF in(sku(vd), pi)) AND active(s);

// подбор с учётом свободного остатка записи журнала: объём продукции минус уже распределённое строками документов
usedVolumeOtherLocal = DATA LOCAL NUMERIC[16,5] (StockEntry);
remainderVolumeLocal = DATA LOCAL NUMERIC[16,5] (StockEntry);
assignedVolumeLocal = DATA LOCAL NUMERIC[16,5] (ComponentDetail, StockEntry);
calcVolumeLocal = DATA LOCAL NUMERIC[16,5] (ComponentDetail, StockEntry);

freeQuantity (ComponentDetail vd, StockEntry s) = (volume(s) (-) usedVolumeOtherLocal(s)) / factorEntry(vd, s);

// распределяется только непокрытый остаток по строке: количество минус уже связанное с записями журнала;
// существующие связи (в т.ч. по строкам с отправленными заявками) не перезаписываются
assignedQuantity (ComponentDetail vd) = GROUP SUM volume(vd, StockEntry s) / factorEntry(vd, s);
restQuantity (ComponentDetail vd) = NUMERIC[16,5](bruttoQuantity(vd) (-) assignedQuantity(vd));

calcQuantity(ComponentDetail vd, StockEntry s) =
    PARTITION UNGROUP restQuantity LIMIT freeQuantity(vd, s) IF matches(vd, s) AND NOT volume(vd, s) AND restQuantity(vd) > 0
        AND NOT expiryDate(s) < currentDate() ORDER expiryDate(s), s BY vd;

fillVolume 'Заполнить' (Order d) {
    usedVolumeOtherLocal(StockEntry s) <- GROUP SUM volume(ComponentDetail vd, s);
    // расчёт фиксируется до записи: calcQuantity зависит от текущих volume
    calcVolumeLocal(ComponentDetail vd, StockEntry s) <- NUMERIC[16,5](calcQuantity(vd, s) * factorEntry(vd, s)) WHERE order(vd) = d;
    volume(ComponentDetail vd, StockEntry s) <- calcVolumeLocal(vd, s) WHERE order(vd) = d AND calcVolumeLocal(vd, s);
    // суммарно по записи журнала не больше свободного остатка: излишек снимается с последних подобранных строк
    assignedVolumeLocal(ComponentDetail vd, StockEntry s) <- calcVolumeLocal(vd, s) WHERE calcVolumeLocal(vd, s) > 0;
    remainderVolumeLocal(StockEntry s) <- NUMERIC[16,5](volume(s) (-) usedVolumeOtherLocal(s));
    // без STRICT: остаток свободного объёма записи не доливается последней строке сверх подобранного
    volume(ComponentDetail vd, StockEntry s) <-
        PARTITION UNGROUP remainderVolumeLocal LIMIT (assignedVolumeLocal(vd, s)) ORDER index(vd), vd BY s
        WHERE order(vd) == d AND assignedVolumeLocal(vd, s);
}

numberStockEntry 'Номер складского журнала' (ComponentDetail d) =
    GROUP CONCAT number(StockEntry s) IF volume(d, s), ',' ORDER s;

volumeStockEntry 'Объем в документе' (ComponentDetail d) = GROUP SUM volume(d, StockEntry s) MATERIALIZED;

// связывать строки с записями журнала с истёкшим сроком годности запрещено (существующие связи не трогаются)
CONSTRAINT CHANGED(volume(ComponentDetail d, StockEntry s)) AND volume(d, s) AND expiryDate(s) < currentDate()
    MESSAGE 'Запрещено связывать строку производственного заказа с записью журнала с истёкшим сроком годности';

// изменять количество по строке можно только после удаления связи с записями складского журнала
CONSTRAINT CHANGED(Production.quantity(ComponentDetail d)) AND (GROUP SUM 1 IF volume(d, StockEntry s))
    MESSAGE 'Запрещено изменять количество по строке производственного заказа: строка связана с записями складского журнала, сначала удалите связь';

EXTEND FORM order
    OBJECTS vd = ComponentDetail
    PROPERTIES(vd) READONLY index, idBarcodeSku, idSku, nameSku, shortNameUOMSku, bruttoQuantity,
                            numberStockEntry, volumeStockEntry
    ORDERS index(vd)
    FILTERS order(vd) = o,
        [GROUP SUM 1 IF in(sku(ComponentDetail vd1), ProductItem pi) BY vd1](vd) OR volumeStockEntry(vd)
    
    PROPERTIES(o) fillVolume DRAW vd TOOLBAR
    
    OBJECTS se = StockEntry
    PROPERTIES(se) READONLY guid, number, nameProductItem, volume, expiryDate
    PROPERTIES(vd, se)      volume, fillVolume GRID
    FILTERS matches(vd, se)

    FILTERGROUP active
        FILTER 'Активные' active(se) OR volume(vd, se) DEFAULT 
;

DESIGN order {
    tabContainerComponent{
        NEW vetis {
            caption = 'ВСД';
            NEW vetisHeader {
                horizontal = TRUE;
            }
            NEW vetisDetail {
                fill = 1;
                horizontal = TRUE;
                MOVE BOX(vd);
                MOVE BOX(se);
            }
        }
    }
}

// invoice detail
//volume 'Объем в документе' = ABSTRACT NUMERIC[16,5] (ComponentDetail, StockEntry);
//volume(ComponentDetail d, StockEntry s) += volume(d, s);

