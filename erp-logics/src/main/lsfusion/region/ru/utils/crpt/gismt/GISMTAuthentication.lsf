MODULE GISMTAuthentication;

REQUIRE System, Utils, Time,
        CryptoProLegalEntity, LegalEntityRu;

NAMESPACE GISMT;

url 'Url к стенду ГИС МТ' = DATA STRING ();
urlTrueApi 'Url к стенду ГИС МТ(True API)' = DATA STRING ();
unitedToken 'Единый токен UUID (вместо JWT)' = DATA BOOLEAN ();
countMinutesTokenData 'К-во минут жизни токена'  = DATA INTEGER ();
countMinutesToken 'К-во минут жизни токена'() = OVERRIDE countMinutesTokenData(), 480;

EXTEND FORM integrationData
    PROPERTIES() gismtUrl = url, urlTrueApi, unitedToken, countMinutesToken
;

DESIGN integrationData {
    pane {
        NEW GISMT {
            caption = 'ГИС МТ';
            MOVE PROPERTY(gismtUrl);
            MOVE PROPERTY(urlTrueApi());
            MOVE PROPERTY(unitedToken());
            MOVE PROPERTY(countMinutesToken());
        }
    }
}

token = DATA LOCAL STRING();
token = DATA STRING (STRING);
tokenDateTime = DATA DATETIME(STRING);

getToken (STRING keyAlias, STRING keyPassword, LegalEntity l) {
    IF (NOT keyAlias IS STRING) OR trim(keyAlias) = '' THEN {
        MESSAGE 'Не задано имя ключа УКЭП';
        RETURN;
    }
    
    IF NOT tokenDateTime(keyAlias) > sumMinutes(currentDateTime(), - countMinutesToken())  THEN { 
        NEWSESSION {
            
            LOCAL result = JSONFILE ();
            EXTERNAL HTTP GET urlTrueApi() + '/auth/key' TO result;
            
            LOCAL uuid = STRING();
            LOCAL data = STRING();
            IMPORT JSON FROM result() TO() uuid, data;
            
            stringToFile(data());
            IF signCustom(l) THEN signCustom(resultFile(), l);
            ELSE sign(RAWFILE(resultFile()), NULL, keyAlias, keyPassword);
        
            IF unitedToken() THEN {
                // inn обязателен, когда подпись ставит физлицо с МЧД
                EXPORT JSON FROM uuid = uuid(), data = encodedSignature(), inn = trim(LegalEntity.inn(l)), unitedToken = TRUE;
            } ELSE {
                EXPORT JSON FROM uuid = uuid(), data = encodedSignature();
            }
            
            EXTERNAL HTTP POST urlTrueApi() + '/auth/simpleSignIn' PARAMS exportFile() TO result;
            LOCAL token = STRING ();
            LOCAL uuidToken = STRING();
            IMPORT JSON FROM result() TO() uuidToken, token;
            
            token(keyAlias) <- OVERRIDE uuidToken(), token();
            tokenDateTime(keyAlias) <- currentDateTime() WHERE OVERRIDE uuidToken(), token();
            
            APPLY;
        }
    }
    
    token() <- token(keyAlias);
}
