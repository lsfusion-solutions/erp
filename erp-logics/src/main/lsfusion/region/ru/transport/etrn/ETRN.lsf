MODULE ETRN;

REQUIRE Document, Numerator, Currency, LegalEntity, Stock, Employee, Transport, TransportRu, Cargo;

NAMESPACE ETRN;

// ------------------------- Этапы движения ЭТрН ------------------------- //

CLASS ETRNStage 'Этап ЭТрН' {
    registration 'Оформление',   // Т1 - титул грузоотправителя
    loading 'Погрузка',          // Т2 - титул перевозчика о приеме
    acceptance 'Приемка',        // Т3 - титул грузополучателя
    unloading 'Разгрузка'        // Т4 - титул перевозчика о выдаче
}
TABLE ETRNStage (ETRNStage);

name 'Наименование' (ETRNStage s) = staticCaption(s) IF s IS ETRNStage CHARWIDTH 12;
id 'Код' (ETRNStage s) = CASE EXCLUSIVE
    WHEN s == ETRNStage.registration THEN 1
    WHEN s == ETRNStage.loading THEN 2
    WHEN s == ETRNStage.acceptance THEN 3
    WHEN s == ETRNStage.unloading THEN 4 MATERIALIZED ;

FORM etrnStages 'Этапы ЭТрН'
    OBJECTS s = ETRNStage
    PROPERTIES(s) READONLY name
    
    LIST ETRNStage OBJECT s
;

// ------------------------- Методы определения массы груза ------------------------- //

CLASS ETRNWeightMethod 'Метод определения массы груза' {
    total 'Взвешивание по общей массе',
    axial 'Взвешивание поосно',
    calculated 'Расчетная масса груза'
}
TABLE ETRNWeightMethod (ETRNWeightMethod);
name 'Наименование' (ETRNWeightMethod m) = staticCaption(m) IF m IS ETRNWeightMethod CHARWIDTH 15;
id 'Код' (ETRNWeightMethod m) = CASE
    WHEN m == ETRNWeightMethod.total THEN '01'
    WHEN m == ETRNWeightMethod.axial THEN '02'
    WHEN m == ETRNWeightMethod.calculated THEN '03' MATERIALIZED;
// однозначное имя для доступа из других namespace (id перегружен в namespace ETRN)
idWeightMethod 'Код метода массы' (ETRNWeightMethod m) = id(m);

FORM etrnWeightMethods 'Методы определения массы груза'
    OBJECTS m = ETRNWeightMethod
    PROPERTIES(m) READONLY id, name

    LIST ETRNWeightMethod OBJECT m
;

// ------------------------- Лицо, дающее указание на переадресовку ------------------------- //

CLASS ETRNRedirectPerson 'Лицо, по указанию которого может осуществляться переадресовка' {
    shipper 'Грузоотправитель',
    consignee 'Грузополучатель'
}

name 'Наименование' (ETRNRedirectPerson p) = staticCaption(p) IF p IS ETRNRedirectPerson CHARWIDTH 15;

FORM etrnRedirectPersons 'Лицо, по указанию которого может осуществляться переадресовка'
    OBJECTS p = ETRNRedirectPerson
    PROPERTIES(p) READONLY name

    LIST ETRNRedirectPerson OBJECT p
;

// ------------------------- Документ ЭТрН ------------------------- //

// ЭТрН - абстрактный документ с двумя конкретными видами:
//   исходящая (мы - грузоотправитель): создаётся у нас, реквизиты перевозчика, водителя
//     и транспорта - ссылки на справочники;
//   входящая (мы - грузополучатель): создаётся приёмом из ЭПД, стороны чужие -
//     реквизиты первичными строковыми полями (заполняются разбором титула Т1)
CLASS ABSTRACT ETRN 'Электронная транспортная накладная';
TABLE etrn(ETRN);   // MATERIALIZED-свойства уровня ETRN и служебные поля провайдеров

// Нумерация и дата: хранение - в конкретных классах (у исходящей нумератор - модуль
// ETRNOutgoing, у входящей номер и дата приходят из титула Т1 - модуль ETRNIncoming)
number '{numerator.number.numerator}' = ABSTRACT STRING[48] (ETRN) IN numbered CHARWIDTH 8;
series '{numerator.series.numerator}' = ABSTRACT BPSTRING[2] (ETRN) IN numbered CHARWIDTH 3 NOFLEX;
seriesNumber '{numerator.series.number.numerator}' (ETRN o) =
    CONCAT '', series(o), number(o)
    CHARWIDTH 7 INDEXED MATERIALIZED;

date '{document.date.of} {document.of.document}' = ABSTRACT DATE (ETRN) IN documentHeader;
time '{document.time.of} {document.of.document}' = ABSTRACT TIME (ETRN) IN documentHeader;
dateTime '{document.date.time.of} {document.of.document}' (ETRN o) = dateTimeToDateTime(date(o), time(o)) MATERIALIZED INDEXED;

WHEN LOCAL SET(ETRN o IS ETRN) INLINE DO {
    IF o IS ETRN AND NOT date(o) THEN date(o) <- currentDate();
    IF o IS ETRN AND NOT time(o) THEN time(o) <- currentTime();
};
WHEN LOCAL CHANGED(date(ETRN o)) AND NOT CHANGED(time(o)) DO {
    time(o) <- IF date(o) > currentDate() THEN 00:00 ELSE currentTime();
}

is (ETRN e) = e IS ETRN;

// вид документа - Входящий/Исходящий (реализации в модулях конкретных классов)
direction 'Вид' = ABSTRACT ISTRING[10](ETRN) CHARWIDTH 10;

// -- Параметры документа

stage 'Этап' = ABSTRACT ETRNStage (ETRN);
nameStage 'Этап' (ETRN e) = name(stage(e)) CHARWIDTH 15;

isClosed 'Закрыт' = ABSTRACT BOOLEAN (ETRN);
isOpened 'Открыт' (ETRN e) = e IS ETRN AND NOT isClosed(e);

close 'Закрыть' (ETRN e)  {
    NEWSESSION { isClosed(e) <- TRUE; apply(); }
} TOOLBAR CONFIRM;

open 'Открыть' (ETRN e)  {
    NEWSESSION { isClosed(e) <- NULL; apply(); }
} TOOLBAR CONFIRM;

// доступность данных титулов для редактирования по этапам:
// данные титула можно менять, пока документ не ушел дальше соответствующего этапа.
// при выключенном контроле этапов (настройка) все данные редактируемы на любой стадии
controlStageEditETRN 'Контролировать этап при редактировании ЭТрН' = DATA BOOLEAN ();

readonlyT1 (ETRN e) = (isClosed(e) OR id(stage(e)) > 1) AND controlStageEditETRN();
readonlyT2 (ETRN e) = (isClosed(e) OR id(stage(e)) > 2) AND controlStageEditETRN();
readonlyT3 (ETRN e) = (isClosed(e) OR id(stage(e)) > 3) AND controlStageEditETRN();
readonlyT4 (ETRN e) = isClosed(e) AND controlStageEditETRN();

// подсветка незаполненных обязательных полей; цвет перегружается через overBackgroundMandatory
overBackgroundMandatory = ABSTRACT CASE COLOR (ETRN);
backgroundMandatory (ETRN e) = OVERRIDE overBackgroundMandatory(e), (RGB(255, 236, 240) IF e IS ETRN);

// способ упаковки по умолчанию - подставляется в строки груза ЭТрН, если у груза он не задан
defaultPackageWay 'Способ упаковки (ЭТрН)' = DATA PackageWay ();
nameDefaultPackageWay 'Способ упаковки (ЭТрН)' = name(defaultPackageWay());

defaultTareType 'Вид тары (ЭТрН)' = DATA TareType ();
nameDefaultTareType 'Вид тары (ЭТрН)' = name(defaultTareType());

EXTEND FORM options
    PROPERTIES() controlStageEditETRN, nameConditionIntact, nameDefaultPackageWay, nameDefaultTareType
;

DESIGN options {
    transport {
        MOVE PROPERTY(controlStageEditETRN());
        MOVE PROPERTY(nameConditionIntact());
        MOVE PROPERTY(nameDefaultPackageWay());
        MOVE PROPERTY(nameDefaultTareType());
    }
}

orderNumber 'Номер заказа (заявки)' = ABSTRACT STRING[100](ETRN) CHARWIDTH 10;
orderDate 'Дата заказа (заявки)' = ABSTRACT DATE (ETRN);
WHEN LOCAL CHANGED(date(ETRN e)) DO orderDate(e) <- date(e);

note 'Примечание' = ABSTRACT ISTRING[250](ETRN) CHARWIDTH 15;

currency 'Валюта стоимости' = ABSTRACT Currency (ETRN);
nameCurrency 'Валюта стоимости' (ETRN e) = name(currency(e)) CHARWIDTH 10;

// дефолты - только если создающий код не задал своё значение (INLINE-событие выполняется
// после присваиваний создающего блока и иначе перетирало бы их: входящие создаются
// сразу с этапом "Погрузка"/"Приемка")
WHEN LOCAL SET(ETRN e IS ETRN) INLINE DO {
    stage(e) <- ETRNStage.registration WHERE NOT stage(e);
    currency(e) <- defaultCurrency() WHERE NOT currency(e);
}


// -- Грузоотправитель

shipper = ABSTRACT LegalEntity (ETRN);
nameShipper 'Грузоотправитель' (ETRN e) = name(shipper(e)) CHARWIDTH 15;

//CONSTRAINT shipper(ETRN e) AND NOT isSupplier(shipper(e))
//    CHECKED BY shipper[ETRN] MESSAGE 'Грузоотправитель ЭТрН должен быть с признаком "Явл. поставщиком"';

forwarder 'Является экспедитором' = ABSTRACT BOOLEAN (ETRN); // признак ГОЭксп

// -- Грузополучатель

consignee = ABSTRACT LegalEntity (ETRN);
nameConsignee 'Грузополучатель' (ETRN e) = name(consignee(e)) CHARWIDTH 15;

//CONSTRAINT consignee(ETRN e) = LegalEntity l AND NOT isBuyer(l)
//    CHECKED BY consignee[ETRN]
//    MESSAGE 'Грузополучатель ЭТрН должен быть покупателем или компанией';

customerStock 'Склад грузополучателя' = ABSTRACT Stock (ETRN);
nameCustomerStock 'Склад грузополучателя' (ETRN e) = name(customerStock(e)) CHARWIDTH 15;

deliveryAddress 'Адрес места доставки груза' = ABSTRACT ISTRING[350](ETRN) CHARWIDTH 15;

// структурный адрес места доставки (RussianAddress: Region+ZipCode обязательны по UserDataXsd)
deliveryRegion 'Код региона (доставка)' = ABSTRACT STRING[2](ETRN) CHARWIDTH 4;
deliveryZipCode 'Индекс (доставка)' = ABSTRACT STRING[6](ETRN) CHARWIDTH 6;
deliveryCity 'Город (доставка)' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
deliveryStreet 'Улица (доставка)' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
deliveryBuilding 'Дом (доставка)' = ABSTRACT ISTRING[20](ETRN) CHARWIDTH 6;
hasDeliveryAddress (ETRN e) = deliveryRegion(e) AND deliveryZipCode(e);

WHEN LOCAL CHANGED(customerStock(ETRN e)) AND NOT CHANGED(deliveryAddress(e)) DO
    deliveryAddress(e) <- address(customerStock(e));

// -- Указания грузоотправителя

banReload 'Запрещение перегрузки' = ABSTRACT BOOLEAN (ETRN);
transportInstructions 'Указания в отношении выполнения норм перевозки' = ABSTRACT ISTRING[2000](ETRN) CHARWIDTH 15;
deliveryDateTime 'Дата и время доставки' = ABSTRACT DATETIME (ETRN);
deliveryPeriod 'Срок доставки груза' = ABSTRACT ISTRING[100](ETRN) CHARWIDTH 15;
seals 'Сведения о запорно-пломбировочных устройствах' = ABSTRACT ISTRING[2000](ETRN) CHARWIDTH 15;
speedLimits 'Указания об ограничениях скорости движения' = ABSTRACT ISTRING[2000](ETRN) CHARWIDTH 15;
route 'Сведения о маршруте перевозки' = ABSTRACT ISTRING[2000](ETRN) CHARWIDTH 15;

// климатический режим перевозки
temperatureFrom 'Нижний предел температуры, °C' = ABSTRACT NUMERIC[7,2](ETRN);
temperatureTo 'Верхний предел температуры, °C' = ABSTRACT NUMERIC[7,2](ETRN);
humidityFrom 'Нижний предел влажности, %' = ABSTRACT NUMERIC[5,2](ETRN);
humidityTo 'Верхний предел влажности, %' = ABSTRACT NUMERIC[5,2](ETRN);

// -- Сведения о процедуре переадресовки

redirectPerson 'Лицо, по указанию которого может осуществляться переадресовка' = ABSTRACT ETRNRedirectPerson (ETRN);
nameRedirectPerson 'Лицо, по указанию которого может осуществляться переадресовка' (ETRN e) = name(redirectPerson(e)) CHARWIDTH 15;

// по умолчанию переадресовка - по указанию грузоотправителя (типовой случай)
WHEN LOCAL SET(ETRN e IS ETRN) AND NOT CHANGED(redirectPerson(e)) INLINE DO
    redirectPerson(e) <- ETRNRedirectPerson.shipper;

redirectMethod 'Способ передачи указания на переадресовку' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;

WHEN LOCAL SET(ETRN e IS ETRN) AND NOT CHANGED(redirectMethod(e)) INLINE DO
    redirectMethod(e) <- 'Электронное уведомление перевозчика о переадресовке';

// контакты лица, по указанию которого может осуществляться переадресовка
redirectPhone 'Номер контактного телефона/факс' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;

// телефон по умолчанию - из карточки выбранного лица (грузоотправитель/грузополучатель)
WHEN LOCAL (CHANGED(redirectPerson(ETRN e)) OR CHANGED(shipper(e)) OR CHANGED(consignee(e))) AND NOT CHANGED(redirectPhone(e)) DO
    redirectPhone(e) <- ISTRING[255](IF redirectPerson(e) == ETRNRedirectPerson.consignee
                                     THEN phone(consignee(e))
                                     ELSE phone(shipper(e)));
redirectEmail 'Адрес электронной почты' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
redirectContacts 'Иные контактные данные' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;

// реквизиты документа, подтверждающего передачу полномочий по переадресовке грузополучателю
redirectDocName 'Наименование документа' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
redirectDocNumber 'Номер документа' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
redirectDocDate 'Дата документа' = ABSTRACT DATE (ETRN);
redirectDocFileId 'Идентификатор файла документа' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
redirectDocInfo 'Дополнительные сведения' = ABSTRACT ISTRING[1000](ETRN) CHARWIDTH 15;

// идентифицирующие реквизиты сторон, составивших документ передачи полномочий
CLASS ETRNRedirectDocParty 'Сторона документа передачи полномочий';
TABLE etrnRedirectDocParty(ETRNRedirectDocParty);

etrn = DATA ETRN (ETRNRedirectDocParty) NONULL DELETE INDEXED;

innLegal 'ИНН юридического лица' = DATA STRING[10](ETRNRedirectDocParty);
innPhysical 'ИНН физического лица' = DATA STRING[12](ETRNRedirectDocParty);
authority 'Краткое наименование органа исполнительной власти, выдавшего документ' = DATA ISTRING[255](ETRNRedirectDocParty) CHARWIDTH 15;

// -- Перевозчик (хранение реквизитов - в конкретных классах: у исходящей выбирается
// из справочника, у входящей карточка создаётся автоматически по данным Диадока)

carrier = ABSTRACT LegalEntity (ETRN);

// роли нашей организации в перевозке - определяются тем, кто из участников является
// нашей компанией. Перевозчиком мы не выступаем: ЭПД оформляется только при
// заказном транспорте (доставка собственным транспортом обходится без ЭТрН)
roleShipper 'Мы - грузоотправитель' (ETRN e) = isCompany(shipper(e));
roleConsignee 'Мы - грузополучатель' (ETRN e) = isCompany(consignee(e));

roles 'Наши роли' (ETRN e) = CONCAT ', ', 'Грузоотправитель' IF roleShipper(e),
                                          'Грузополучатель' IF roleConsignee(e) CHARWIDTH 15;

// подсветка обязательных полей титула Т1 - только для исходящих (мы - грузоотправитель):
// на входящих перевозках эти поля приходят из чужого титула и нами не заполняются
backgroundMandatoryT1 (ETRN e) = backgroundMandatory(e) IF roleShipper(e);

// ------------------------- Реквизиты перевозчика/водителя/транспорта ------------------------- //
// Исходящая: ссылки на справочники. Входящая: первичные строковые поля.
// Отображаемые свойства - ABSTRACT на базовом классе, реализация по виду документа;
// имена сохранены, общие формы (списки) работают с обоими видами.



// отображаемые реквизиты: реализация по виду документа
nameCarrier 'Перевозчик' = ABSTRACT ISTRING[150](ETRN) CHARWIDTH 15;

carrierPhone 'Телефон' = ABSTRACT ISTRING[100](ETRN) CHARWIDTH 15;

shortNameDriver 'Водитель' = ABSTRACT ISTRING[150](ETRN) CHARWIDTH 15;

driverPhone 'Телефон' = ABSTRACT ISTRING[100](ETRN) CHARWIDTH 15;

driverLicenseSeries 'ВУ: серия' = ABSTRACT STRING[20](ETRN) CHARWIDTH 8;

driverLicenseNumber 'ВУ: номер' = ABSTRACT STRING[20](ETRN) CHARWIDTH 10;

driverLicenseDate 'ВУ: дата' = ABSTRACT DATE (ETRN);

driverInn 'ИНН' = ABSTRACT STRING[12](ETRN) CHARWIDTH 12;


nameTruck 'Транспортное средство' = ABSTRACT ISTRING[150](ETRN) CHARWIDTH 15;

truckSid 'Рег. номер' = ABSTRACT ISTRING[20](ETRN) CHARWIDTH 10;

truckType 'Тип' = ABSTRACT ISTRING[100](ETRN) CHARWIDTH 12;

truckModelName 'Марка' = ABSTRACT ISTRING[50](ETRN) CHARWIDTH 15;

truckWeight 'Грузоподъёмность, кг' = ABSTRACT NUMERIC[16,4](ETRN);

truckCapacity 'Вместимость, м3' = ABSTRACT NUMERIC[16,5](ETRN);

truckOwnership 'Тип владения' = ABSTRACT ISTRING[50](ETRN) CHARWIDTH 15;

nameTrailer 'Прицеп' = ABSTRACT ISTRING[150](ETRN) CHARWIDTH 15;

trailerSid 'Рег. номер' = ABSTRACT ISTRING[20](ETRN) CHARWIDTH 10;

trailerType 'Тип' = ABSTRACT ISTRING[100](ETRN) CHARWIDTH 12;

trailerModelName 'Марка' = ABSTRACT ISTRING[50](ETRN) CHARWIDTH 15;

trailerWeight 'Грузоподъёмность, кг' = ABSTRACT NUMERIC[16,4](ETRN);

trailerCapacity 'Вместимость, м3' = ABSTRACT NUMERIC[16,5](ETRN);

trailerOwnership 'Тип владения' = ABSTRACT ISTRING[50](ETRN) CHARWIDTH 15;

// телефоны участников (Phones обязательны в титуле у всех трёх организаций);
// грузоотправитель и грузополучатель - всегда наши справочные организации
shipperPhone 'Телефон' (ETRN e) = phone(shipper(e)) CHARWIDTH 15;
consigneePhone 'Телефон' (ETRN e) = phone(consignee(e)) CHARWIDTH 15;



// сведения о путевом листе
CLASS ETRNWaybill 'Путевой лист';
TABLE etrnWaybill(ETRNWaybill);

etrn = DATA ETRN (ETRNWaybill) NONULL DELETE INDEXED;

docName 'Наименование документа' = DATA ISTRING[255](ETRNWaybill) CHARWIDTH 15;
number 'Номер документа' = DATA ISTRING[255](ETRNWaybill) CHARWIDTH 15;
date 'Дата документа' = DATA DATE (ETRNWaybill);
fileId 'Идентификатор файла документа' = DATA ISTRING[255](ETRNWaybill) CHARWIDTH 15;
info 'Дополнительные сведения' = DATA ISTRING[1000](ETRNWaybill) CHARWIDTH 15;

// идентифицирующие реквизиты стороны, составившей документ (ИдРекСост, обязателен по формату)
innLegal 'ИНН юридического лица' = DATA STRING[10](ETRNWaybill);
innPhysical 'ИНН физического лица' = DATA STRING[12](ETRNWaybill);
authority 'Орган исполнительной власти, выдавший документ' = DATA ISTRING[255](ETRNWaybill) CHARWIDTH 15;

// -- Сведения о приеме груза перевозчиком

declaredSupplyDateTime 'Заявленные дата и время подачи' = ABSTRACT DATETIME (ETRN);
arrivalDateTime 'Фактические дата и время прибытия' = ABSTRACT DATETIME (ETRN);
departureDateTime 'Фактические дата и время убытия' = ABSTRACT DATETIME (ETRN);

// предзаполнение дат подачи: заявленная - при создании (из заявки-основания перекрывается),
// фактическое прибытие - по заявленной, убытие - по прибытию; ручной ввод не затирается
WHEN LOCAL SET(ETRN e IS ETRN) AND NOT CHANGED(declaredSupplyDateTime(e)) INLINE DO
    declaredSupplyDateTime(e) <- currentDateTime();
WHEN LOCAL CHANGED(declaredSupplyDateTime(ETRN e)) AND NOT CHANGED(arrivalDateTime(e)) DO
    arrivalDateTime(e) <- declaredSupplyDateTime(e);
WHEN LOCAL CHANGED(arrivalDateTime(ETRN e)) AND NOT CHANGED(departureDateTime(e)) DO
    departureDateTime(e) <- arrivalDateTime(e);

supplierStock 'Склад погрузки' = ABSTRACT Stock (ETRN);
nameSupplierStock 'Склад погрузки' (ETRN e) = name(supplierStock(e)) CHARWIDTH 15;

loadingAddress 'Адрес места погрузки' = ABSTRACT ISTRING[350](ETRN) CHARWIDTH 15;

// структурный адрес места погрузки (RussianAddress: Region+ZipCode обязательны по UserDataXsd)

region 'Код региона' = ABSTRACT CASE STRING[2](Stock.Stock) CHARWIDTH 4;
zipCode 'Индекс' = ABSTRACT CASE STRING[6](Stock.Stock) CHARWIDTH 6;
city 'Город' = ABSTRACT CASE ISTRING[255](Stock.Stock) CHARWIDTH 15;
street 'Улица' = ABSTRACT CASE ISTRING[255](Stock.Stock) CHARWIDTH 15;
building 'Дом' = ABSTRACT CASE ISTRING[20](Stock.Stock) CHARWIDTH 6;

loadingRegion 'Код региона (погрузка)' = ABSTRACT STRING[2](ETRN) CHARWIDTH 4;
loadingZipCode 'Индекс (погрузка)' = ABSTRACT STRING[6](ETRN) CHARWIDTH 6;
loadingCity 'Город (погрузка)' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
loadingStreet 'Улица (погрузка)' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
loadingBuilding 'Дом (погрузка)' = ABSTRACT ISTRING[20](ETRN) CHARWIDTH 6;
hasLoadingAddress (ETRN e) = loadingRegion(e) AND loadingZipCode(e);

WHEN LOCAL CHANGED(supplierStock(ETRN e)) AND NOT CHANGED(loadingAddress(e)) DO
    loadingAddress(e) <- address(supplierStock(e));


fillLoadingDiadocAddress (ETRN e) {
    loadingRegion(e) <- region(supplierStock(e));
    loadingZipCode(e) <- zipCode(supplierStock(e)) ;
    loadingCity(e) <- city(supplierStock(e));
    loadingStreet(e) <- street(supplierStock(e));
    loadingBuilding(e) <- building(supplierStock(e));
}

// место доставки - из подразделения Диадока склада грузополучателя
fillDeliveryDiadocAddress (ETRN e) {
    deliveryRegion(e) <- region(customerStock(e));
    deliveryZipCode(e) <- zipCode(customerStock(e));
    deliveryCity(e) <- city(customerStock(e));
    deliveryStreet(e) <- street(customerStock(e));
    deliveryBuilding(e) <- building(customerStock(e));
}

WHEN LOCAL CHANGED(supplierStock(ETRN e)) DO
    fillLoadingDiadocAddress(e);

WHEN LOCAL CHANGED(customerStock(ETRN e)) DO
    fillDeliveryDiadocAddress(e);

acceptGrossWeight 'Масса брутто груза, кг' = ABSTRACT NUMERIC[17,3](ETRN);

weightMethod 'Метод определения массы груза' = ABSTRACT ETRNWeightMethod (ETRN);
nameWeightMethod 'Метод определения массы груза' (ETRN e) = name(weightMethod(e)) CHARWIDTH 15;

// по умолчанию - расчетная масса груза
WHEN LOCAL SET(ETRN e IS ETRN) AND NOT CHANGED(weightMethod(e)) INLINE DO
    weightMethod(e) <- ETRNWeightMethod.calculated;

acceptQuantityPlaces 'Количество грузовых мест' = ABSTRACT INTEGER (ETRN);

containerCondition 'Фактическое состояние тары' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
packageCondition 'Фактическое состояние упаковки' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;
bodyCondition 'Фактическое состояние кузова' = ABSTRACT ISTRING[255](ETRN) CHARWIDTH 15;

// лицо, осуществляющее погрузку груза (СвЛицПогрГр): признак СовпГОП -
// совпадает с грузоотправителем (типовой случай) либо реквизиты отдельного лица
loaderIsShipper 'Погрузку осуществляет грузоотправитель' = ABSTRACT BOOLEAN (ETRN);
loader 'Лицо, осуществляющее погрузку груза' = ABSTRACT LegalEntity (ETRN);
nameLoader 'Лицо, осуществляющее погрузку груза' (ETRN e) = name(loader(e)) CHARWIDTH 15;
loaderInfo 'Сведения о лице, осуществляющем погрузку' = ABSTRACT ISTRING[500](ETRN) CHARWIDTH 15;

// владелец объекта инфраструктуры пункта погрузки (ВладИнфр): признак СовпГОВ -
// совпадает с грузоотправителем / отдельное лицо / неизвестен
infrastructureOwnerIsShipper 'Владелец инфраструктуры - грузоотправитель' = ABSTRACT BOOLEAN (ETRN);
infrastructureOwnerUnknown 'Владелец инфраструктуры неизвестен' = ABSTRACT BOOLEAN (ETRN);
infrastructureOwner 'Владелец объекта инфраструктуры пункта погрузки' = ABSTRACT LegalEntity (ETRN);
nameInfrastructureOwner 'Владелец объекта инфраструктуры пункта погрузки' (ETRN e) = name(infrastructureOwner(e)) CHARWIDTH 15;
infrastructureOwnerInfo 'Сведения о владельце объекта инфраструктуры' = ABSTRACT ISTRING[500](ETRN) CHARWIDTH 15;
infrastructureOwnerNoInfo 'Обстоятельства отсутствия информации о владельце' = ABSTRACT ISTRING[1000](ETRN) CHARWIDTH 15;

CONSTRAINT infrastructureOwnerIsShipper(ETRN e) AND infrastructureOwnerUnknown(e)
    MESSAGE 'Признаки владельца инфраструктуры «грузоотправитель» и «неизвестен» не могут быть установлены одновременно';

WHEN LOCAL SET(ETRN e IS ETRN) INLINE DO {
    loaderIsShipper(e) <- TRUE;
    infrastructureOwnerIsShipper(e) <- TRUE;
}

// ------------------------- Строки ЭТрН (сведения о грузе) ------------------------- //

CLASS ETRNDetail 'Строка ЭТрН';
TABLE etrnDetail(ETRNDetail);

etrn = DATA ETRN (ETRNDetail) NONULL DELETE INDEXED;
dataIndex '{document.data.index.detail.class}' = DATA INTEGER (ETRNDetail);
defaultIndex '№' (ETRNDetail d) = PARTITION SUM 1 IF d IS ETRNDetail ORDER d BY etrn(d) CHARWIDTH 3;
index 'N' (ETRNDetail d) = OVERRIDE dataIndex(d), defaultIndex(d) IN id;

cargo = DATA Cargo (ETRNDetail);
nameCargo 'Груз' (ETRNDetail d) = name(cargo(d)) CHARWIDTH 15;

isContainer (ETRNDetail d) = container(cargo(d));

packageWay = DATA PackageWay (ETRNDetail);
namePackageWay 'Способ упаковки' (ETRNDetail d) = name(packageWay(d)) CHARWIDTH 15;
tareType 'Вид тары' = DATA TareType (ETRNDetail);
nameTareType 'Вид тары' (ETRNDetail d) = name(tareType(d)) CHARWIDTH 15;

// способ упаковки строки: от груза, иначе - значение по умолчанию из настроек
WHEN LOCAL CHANGED(cargo(ETRNDetail d))  AND NOT CHANGED(packageWay(d)) DO
    packageWay(d) <- OVERRIDE packageWay(cargo(d)), defaultPackageWay();
WHEN LOCAL CHANGED(cargo(ETRNDetail d)) AND NOT CHANGED(tareType(d)) DO
    tareType(d) <- OVERRIDE tareType(cargo(d)), defaultTareType();

density 'Плотность груза, кг/м3' = DATA NUMERIC[5,2](ETRNDetail);
condition = DATA CargoCondition (ETRNDetail);
nameCondition 'Состояние груза' (ETRNDetail d) = name(condition(d)) CHARWIDTH 15;

// по умолчанию - «Целый»
WHEN LOCAL SET(ETRNDetail d IS ETRNDetail) AND NOT CHANGED(condition(d)) DO
    condition(d) <- conditionIntact();
volume 'Объем груза, м3' = DATA NUMERIC[17,3](ETRNDetail);
quantityPlaces 'Количество грузовых мест' = DATA INTEGER (ETRNDetail);
height 'Высота, м' = DATA NUMERIC[17,3](ETRNDetail);
length 'Длина, м' = DATA NUMERIC[17,3](ETRNDetail);
width 'Ширина, м' = DATA NUMERIC[17,3](ETRNDetail);
netWeight 'Масса нетто, кг' = DATA NUMERIC[17,3](ETRNDetail);
grossWeight 'Масса брутто, кг' = DATA NUMERIC[17,3](ETRNDetail);
quantityPallets 'Количество паллет' = DATA INTEGER (ETRNDetail);
cost 'Стоимость груза (с НДС)' = DATA NUMERIC[19,2](ETRNDetail);
marking = DATA CargoMarking (ETRNDetail);
nameMarking 'Маркировка' (ETRNDetail d) = name(marking(d)) CHARWIDTH 15;

// по умолчанию - «Отсутствует» (Марк обязателен по формату)
WHEN LOCAL SET(ETRNDetail d IS ETRNDetail) AND NOT CHANGED(marking(d)) DO
    marking(d) <- markingAbsent();
otherInfo 'Другая информация' = DATA ISTRING[1000](ETRNDetail) CHARWIDTH 15;

cost 'Стоимость груза (с НДС)' (ETRN e) = GROUP SUM cost(ETRNDetail d) BY etrn(d);

// суммы по строкам груза - для предзаполнения приема груза перевозчиком (вкладка «Погрузка»)
detailGrossWeight (ETRN e) = GROUP SUM grossWeight(ETRNDetail d) BY etrn(d);
detailQuantityPlaces (ETRN e) = GROUP SUM quantityPlaces(ETRNDetail d) BY etrn(d);

// масса брутто и количество мест при приеме - по умолчанию из строк груза (пока не введены вручную)
WHEN LOCAL CHANGED(detailGrossWeight(ETRN e)) AND NOT CHANGED(acceptGrossWeight(e)) DO
    acceptGrossWeight(e) <- detailGrossWeight(e);
WHEN LOCAL CHANGED(detailQuantityPlaces(ETRN e)) AND NOT CHANGED(acceptQuantityPlaces(e)) DO
    acceptQuantityPlaces(e) <- detailQuantityPlaces(e);

// однозначные имена для доступа к свойствам строки из других namespace
// (packageWay/tareType/etrn перегружены между ETRNDetail, Cargo и namespace ETRN)
detailPackageWay (ETRNDetail d) = name(packageWay(d));
detailTareCode (ETRNDetail d) = idTareType(tareType(d));
detailETRN (ETRNDetail d) = etrn(d);

// сведения о контейнерах
CLASS ETRNDetailContainer 'Сведения о контейнере';
TABLE etrnDetailContainer(ETRNDetailContainer);

detail = DATA ETRNDetail (ETRNDetailContainer) NONULL DELETE INDEXED;

quantity 'Количество контейнеров' = DATA INTEGER (ETRNDetailContainer);
number 'Идентификационный номер контейнера' = DATA ISTRING[255](ETRNDetailContainer) CHARWIDTH 15;

countContainers (ETRNDetail d) = GROUP SUM 1 IF detail(ETRNDetailContainer c) = d;

CONSTRAINT isContainer(ETRNDetail d) AND NOT countContainers(d)
    MESSAGE 'Для груза «Контейнер» должны быть заполнены сведения о контейнерах';

// ------------------------- Форма документа ------------------------- //




// ------------------------- Форма списка ------------------------- //

FORM etrns 'Электронные транспортные накладные'
    OBJECTS e = ETRN LAST
    PROPERTIES(e) READONLY direction, isClosed, series, number, date, time, nameStage, roles, orderNumber,
                           nameShipper, nameConsignee, nameCarrier, deliveryAddress, nameCustomerStock, cost, note
    PROPERTIES(e) close SHOWIF isOpened(e), open SHOWIF isClosed(e)
    PROPERTIES(e) NEWSESSION EDIT, DELETE
    //ORDERS date(e) DESC, time(e) DESC

    OBJECTS d = ETRNDetail
    PROPERTIES(d) READONLY index, nameCargo, namePackageWay, nameTareType, nameCondition,
                           quantityPlaces, volume, netWeight, grossWeight, cost, nameMarking
    ORDERS index(d)
    FILTERS etrn(d) = e

    FILTERGROUP active FILTER 'Открытые' isOpened(e) 'F6' DEFAULT

    LIST ETRN OBJECT e
;

DESIGN etrns {
    // нижняя панель закладок: «Спецификация» (строки груза) + вкладки других модулей («Действия» и др.)
    NEW detailPane BEFORE TOOLBARBOX {
        tabbed = TRUE;           
        fill = 1;
        MOVE BOX(d) {
            fill = 1;
            caption = 'Спецификация';
        }

    }
}

// ------------------------- Навигатор ------------------------- //

NAVIGATOR {
    transportNavigator {
        transportDocuments {
            NEW FOLDER epdNavigator 'ЭПД' {
                NEW etrns;
            }
        }
        transportMasterData {
            NEW cargos;
            NEW tareTypes;
            NEW packageWays;
            NEW cargoConditions;
            NEW cargoMarkings;
        }
    }
}
