MODULE WarehouseStructAddressETRN;

REQUIRE StockStructAddressETRN, Warehouse;

NAMESPACE ETRN;

// структурный адрес ЭТрН на карточке склада
EXTEND FORM warehouse
    PROPERTIES(w) structRegion, structZipCode, structCity, structStreet, structBuilding
;

DESIGN warehouse {
    headerLeft {
        NEW etrnStructAddress AFTER headerLocationParams {
            caption = 'Структурный адрес (ЭТрН)';
            lines = 3;
            MOVE PROPERTY(structRegion(w));
            MOVE PROPERTY(structZipCode(w));
            MOVE PROPERTY(structCity(w));
            MOVE PROPERTY(structStreet(w));
            MOVE PROPERTY(structBuilding(w));
        }
    }
}
