// 1. приём новых событий в журнал (без продвижения документов) - для планировщика
importETRNEvents 'Получить события ЭПД' () {
    FOR ETRNProvider p IS ETRNProvider DO
        importEvents(p);
}

// 2. обработка необработанных событий журнала: продвижение документов - для планировщика.
// Каждое событие обрабатывается в своей сессии: ошибка применения по одному документу
// (констрейнт и т.п.) не мешает обработке остальных; ошибка записывается в событие,
// отметка обработки не ставится - событие повторит попытку в следующий запуск
processedMessage 'Ошибка обработки' = DATA STRING[1000](ETRNEvent) CHARWIDTH 15;

// дозагрузка данных по документу события после его успешной обработки
// (например, ответ перевозчика Т2 по завершённой заявке - реализация у провайдера)
onProcessedEvent ABSTRACT LIST (ETRNEvent);

// защита от параллельного запуска (кнопка поверх планировщика и двойные клики):
// блокировка захватывается атомарно (APPLY SERIALIZABLE), сбрасывается в FINALLY
// и при старте сервера (onStarted - внутри метакода)
@lockedObjects(processEventsETRN, STRING);

processETRNEvents 'Обработать события ЭПД' () {
    lockProcessEventsETRN('Обработка событий ЭПД');
    IF lockResultProcessEventsETRN() THEN {
        TRY {
            LOCAL NESTED applyError = STRING[1000] ();
            FOR ETRNEvent ev IS ETRNEvent AND NOT processedDateTime(ev) ORDER dateTime(ev), ev DO {
                NEWSESSION {
                    // документ мог появиться (импорт входящей перевозки) уже после приёма события
                    etrn(ev) <- etrn(transportationId(ev)) WHERE NOT etrn(ev);
                    processEvent(ev);
                    processedDateTime(ev) <- currentDateTime();
                    processedMessage(ev) <- NULL;
                    APPLY;
                    applyError() <- STRING[1000](applyMessage()) IF canceled();
                }
                IF applyError() THEN NEWSESSION {
                    processedMessage(ev) <- applyError();
                    APPLY;
                }
                ELSE
                    onProcessedEvent(ev);
            }
        } FINALLY {
            unlockProcessEventsETRN('Обработка событий ЭПД');
        }
    } ELSE
        MESSAGE 'Обработка событий ЭПД уже выполняется. Дождитесь её завершения';
}

// обёртка для ручного запуска с кнопок: показывает итог (сколько обработано, сколько осталось),
// чтобы холостой проход был виден сразу; планировщик вызывает processETRNEvents напрямую (без сообщений)
countUnprocessedETRNEvents () = GROUP SUM 1 IF ETRNEvent ev IS ETRNEvent AND NOT processedDateTime(ev);

processETRNEventsInteractive 'Обработать события ЭПД' () {
    LOCAL before = INTEGER ();
    before() <- OVERRIDE countUnprocessedETRNEvents(), 0;
    processETRNEvents();
    MESSAGE CONCAT '', 'Обработано событий: ' + (before() (-) (OVERRIDE countUnprocessedETRNEvents(), 0)),
        ' из ' + before(),
        (', осталось необработанных: ' + countUnprocessedETRNEvents()) IF countUnprocessedETRNEvents();
}

// 1. приём входящих перевозок: создание документов с базовыми данными - для планировщика
importIncomingETRN 'Получить входящие перевозки ЭПД' () {
    FOR ETRNProvider p IS ETRNProvider DO
        importIncoming(p);
}

// 2. загрузка полного состава данных входящих ЭТрН из титула Т1 - запасное действие
// (реализация провайдера сама ставит titleImportedDateTime при успешной загрузке, чтобы неудача повторилась)
processIncomingETRN 'Загрузить данные входящих ЭТрН' () {
    FOR ETRN e IS ETRN AND transportationId(e) AND NOT roleShipper(e) AND NOT titleImportedDateTime(e) AND provider(e) DO
        importFullData(e);
}

// автозагрузка данных входящей перевозки сразу при обработке события: как только по событию
// создан (или найден) документ, где мы не грузоотправитель, - скачиваем титул Т1
// (участники, груз, адреса, указания), не дожидаясь отдельного запуска
onProcessedEvent (ETRNEvent ev) + {
    FOR ETRN e == etrn(ev) AND NOT roleShipper(e) AND NOT titleImportedDateTime(e) AND provider(e) DO
        importFullData(e);
}

// ------------------------- Формы ------------------------- //


EXTEND FORM etrns
    PROPERTIES(e) READONLY nameProvider, nameExchangeStatus, providerStatus,
                           nextAction BACKGROUND backgroundNextAction(e)
    PROPERTIES(e) showPrintForm
                  //, showQR, sendQRToDriver SHOWIF driver(e) - QR не запрашиваем: водитель получает его в своём приложении
    PROPERTIES importIncomingETRN() DRAW e, processIncomingETRN() DRAW e,
               importETRNEvents() DRAW e, processETRNEventsInteractive() DRAW e
;

DESIGN etrns {
    detailPane {   // нижняя панель закладок - в ETRN
        NEW actionsTab {
            caption = 'Действия';
            horizontal = TRUE;
            NEW actionsT1 {
                caption = 'Т1: Оформление (грузоотправитель)';   // кнопка отправки - в ETRNOutgoing
            }
            NEW actionsCommon {
                caption = 'Провайдер';
                MOVE PROPERTY(showPrintForm(e));
                //MOVE PROPERTY(showQR(e));
                //MOVE PROPERTY(sendQRToDriver(e));
                MOVE PROPERTY(importIncomingETRN());
                MOVE PROPERTY(processIncomingETRN());
                MOVE PROPERTY(importETRNEvents());
                MOVE PROPERTY(processETRNEventsInteractive());
            }
        }
    }
}


// карточка события: общие поля + контейнер providerData, куда модули провайдеров
// добавляют свои поля с SHOWIF по провайдеру события
FORM etrnEvent 'Событие ЭПД'
    OBJECTS ev = ETRNEvent PANEL
    PROPERTIES(ev) READONLY nameProvider, id, dateTime, type, status,
                            transportationId, mintransId, seriesNumberETRN, processedDateTime, processedMessage

    EDIT ETRNEvent OBJECT ev
;

DESIGN etrnEvent {
    OBJECTS {
        NEW eventMain {
            caption = 'Событие';
            MOVE PROPERTY(nameProvider(ev));
            MOVE PROPERTY(id(ev));
            MOVE PROPERTY(dateTime(ev));
            MOVE PROPERTY(type(ev));
            MOVE PROPERTY(status(ev));
        }
        NEW eventTransportation {
            caption = 'Перевозка';
            MOVE PROPERTY(transportationId(ev));
            MOVE PROPERTY(mintransId(ev));
            MOVE PROPERTY(seriesNumberETRN(ev));
            MOVE PROPERTY(processedDateTime(ev));
            MOVE PROPERTY(processedMessage(ev));
        }
        NEW providerData {
            caption = 'Данные провайдера';
        }
    }
}

// на списке провайдер-специфичные колонки показываются для провайдера по умолчанию (настройки),
// на карточке - по провайдеру самого события
FORM etrnEvents 'События ЭПД'
    OBJECTS ev = ETRNEvent
    PROPERTIES(ev) READONLY dateTime, nameProvider, type, status, mintransId, transportationId, seriesNumberETRN,
                            processedDateTime, processedMessage
    PROPERTIES(ev) NEWSESSION EDIT
    PROPERTIES TOOLBAR DRAW ev importETRNEvents(), processETRNEventsInteractive()
    ORDERS dateTime(ev) DESC
    FILTERGROUP processedFilter FILTER 'Необработанные' NOT processedDateTime(ev) 'F6'
;

NAVIGATOR {
    epdNavigator {
        NEW etrnEvents;
    }
}
