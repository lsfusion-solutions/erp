MODULE ETRNExchange;

REQUIRE ETRN;

NAMESPACE ETRN;

// ------------------------- Провайдеры ЭПД ------------------------- //
// Операторы (Контур.Логистика и др.) добавляются через EXTEND CLASS в своих модулях.

CLASS ETRNProvider 'Провайдер ЭПД' : StaticObject;

name 'Наименование' (ETRNProvider p) = staticCaption(p) IF p IS ETRNProvider CHARWIDTH 15;

defaultProvider = DATA ETRNProvider ();
nameDefaultProvider 'Провайдер ЭПД по умолчанию' = name(defaultProvider());

skipFieldCheckETRN 'Не проверять обязательные поля при отправке титулов ЭТрН' = DATA BOOLEAN ();

EXTEND FORM options
    PROPERTIES() nameDefaultProvider, skipFieldCheckETRN
;

DESIGN options {
    transport {
        MOVE PROPERTY(nameDefaultProvider());
        MOVE PROPERTY(skipFieldCheckETRN());
    }
}

// ------------------------- Провайдер и состояние обмена на документе ------------------------- //

provider 'Провайдер ЭПД' = ABSTRACT ETRNProvider (ETRN);
nameProvider 'Провайдер ЭПД' (ETRN e) = name(provider(e)) CHARWIDTH 15;

WHEN LOCAL SET(ETRN e IS ETRN) AND NOT CHANGED(provider(e)) INLINE DO
    provider(e) <- defaultProvider();

CLASS ETRNExchangeStatus 'Статус обмена ЭТрН' {
    draftSaved 'Черновик сохранен у провайдера',
    approvedForSignature 'Передан на подпись',
    driverApproval 'Передан водителю на согласование',
    signed 'Подписан',
    completed 'Документооборот завершен',
    rejected 'Отказ в подписи',
    invalid 'Ошибка в документообороте'
}

name 'Наименование' (ETRNExchangeStatus s) = staticCaption(s) IF s IS ETRNExchangeStatus CHARWIDTH 15;

FORM etrnExchangeStatuses 'Статус обмена ЭТрН'
    OBJECTS s = ETRNExchangeStatus
    PROPERTIES(s) READONLY name

    LIST ETRNExchangeStatus OBJECT s
;

exchangeStatus 'Статус обмена' = ABSTRACT ETRNExchangeStatus (ETRN);
nameExchangeStatus 'Статус обмена' (ETRN e) = name(exchangeStatus(e)) CHARWIDTH 15;

// ------------------------- Следующий шаг документооборота ------------------------- //
// перегружается модулями условных титулов (Т5/Т6 - ETRNConditionalTitles)

overNextAction = ABSTRACT CASE STRING[100] (ETRN);
overNextActionOur = ABSTRACT CASE BOOLEAN (ETRN);

nextActionFlow (ETRN e) = CASE
    WHEN isClosed(e) OR exchangeStatus(e) == ETRNExchangeStatus.completed OR id(stage(e)) == 4 THEN 'Завершено'
    WHEN exchangeStatus(e) == ETRNExchangeStatus.rejected THEN 'Отказ в подписи - разобраться (мы)'
    WHEN exchangeStatus(e) == ETRNExchangeStatus.invalid THEN 'Ошибка в документообороте - разобраться (мы)'
    WHEN id(stage(e)) == 3 THEN 'Ожидается Т4 (перевозчик)'
    WHEN id(stage(e)) == 2 AND roleConsignee(e) THEN 'Подписать и отправить Т3 (мы)'
    WHEN id(stage(e)) == 2 THEN 'Ожидается Т3 (грузополучатель)'
    WHEN id(stage(e)) == 1 AND roleShipper(e) AND NOT exchangeStatus(e) THEN 'Отправить Т1 (мы)'
    WHEN id(stage(e)) == 1 AND roleShipper(e) AND (exchangeStatus(e) == ETRNExchangeStatus.signed) THEN 'Ожидается Т2 (перевозчик)'
    WHEN id(stage(e)) == 1 AND roleShipper(e) THEN 'Ожидается подпись Т1 (мы)'
    WHEN id(stage(e)) == 1 THEN 'Ожидается Т2 (перевозчик)';

nextAction 'Следующий шаг' (ETRN e) = OVERRIDE overNextAction(e), nextActionFlow(e) CHARWIDTH 15;

// ход за нами - для подсветки в списке
nextActionOurFlow (ETRN e) = TRUE IF
    NOT (isClosed(e) OR exchangeStatus(e) == ETRNExchangeStatus.completed OR id(stage(e)) == 4) AND
    ((exchangeStatus(e) == ETRNExchangeStatus.rejected OR exchangeStatus(e) == ETRNExchangeStatus.invalid) OR
     (id(stage(e)) == 2 AND roleConsignee(e)) OR
     (id(stage(e)) == 1 AND roleShipper(e) AND NOT (exchangeStatus(e) == ETRNExchangeStatus.signed)));

nextActionOur (ETRN e) = OVERRIDE overNextActionOur(e), nextActionOurFlow(e);

backgroundNextAction (ETRN e) = RGB(255, 246, 205) IF nextActionOur(e);

// автозакрытие; при необходимости документ открывается кнопкой "Открыть"
WHEN SET(exchangeStatus(ETRN e) == ETRNExchangeStatus.completed OR id(stage(e)) == 4) DO
    isClosed(e) <- TRUE;

// подписант организации - источник по умолчанию для документов;
// ручные реквизиты приоритетнее данных выбранного сотрудника
signer 'Подписант ЭПД (сотрудник)' = DATA Employee (LegalEntity);
nameSigner 'Подписант ЭПД (сотрудник)' (LegalEntity l) = shortName(signer(l)) CHARWIDTH 15;

signerLastName 'Подписант: фамилия' = DATA ISTRING[60](LegalEntity) CHARWIDTH 15;
signerFirstName 'Подписант: имя' = DATA ISTRING[60](LegalEntity) CHARWIDTH 15;
signerMiddleName 'Подписант: отчество' = DATA ISTRING[60](LegalEntity) CHARWIDTH 15;
signerPosition 'Подписант: должность' = DATA ISTRING[128](LegalEntity) CHARWIDTH 15;

// отчество - второе слово поля "Имя" сотрудника; лишние пробелы между словами схлопываются
normalizedFirstNameSigner (LegalEntity l) = regexpReplace(trim(firstName(signer(l))), ' +', ' ', 'g');

overSignerLastName 'Подписант: фамилия' (LegalEntity l) = OVERRIDE signerLastName(l), ISTRING[60](lastName(signer(l)));
overSignerFirstName 'Подписант: имя' (LegalEntity l) = OVERRIDE signerFirstName(l), ISTRING[60](getWord(normalizedFirstNameSigner(l), ' ', 1));
overSignerMiddleName 'Подписант: отчество' (LegalEntity l) = OVERRIDE signerMiddleName(l), ISTRING[60](getWord(normalizedFirstNameSigner(l), ' ', 2));
overSignerPosition 'Подписант: должность' (LegalEntity l) = OVERRIDE signerPosition(l), ISTRING[128](namePosition(signer(l)));

// подписант наших титулов (Т1/Т3/Т6), можно поправить на конкретной ЭТрН; заполняется
// от карточки нашей стороны - грузоотправителя на исходящих, грузополучателя на входящих
signerLastName 'Подписант: фамилия' = ABSTRACT ISTRING[60](ETRN) CHARWIDTH 15;
signerFirstName 'Подписант: имя' = ABSTRACT ISTRING[60](ETRN) CHARWIDTH 15;
signerMiddleName 'Подписант: отчество' = ABSTRACT ISTRING[60](ETRN) CHARWIDTH 15;
signerPosition 'Подписант: должность' = ABSTRACT ISTRING[128](ETRN) CHARWIDTH 15;

signerParty (ETRN e) = IF isCompany(shipper(e)) THEN shipper(e) ELSE (consignee(e) IF isCompany(consignee(e)));

WHEN LOCAL (CHANGED(shipper(ETRN e)) OR CHANGED(consignee(e))) DO {
    signerLastName(e) <- overSignerLastName(signerParty(e)) WHERE overSignerLastName(signerParty(e));
    signerFirstName(e) <- overSignerFirstName(signerParty(e)) WHERE overSignerFirstName(signerParty(e));
    signerMiddleName(e) <- overSignerMiddleName(signerParty(e)) WHERE overSignerMiddleName(signerParty(e));
    signerPosition(e) <- overSignerPosition(signerParty(e)) WHERE overSignerPosition(signerParty(e));
}

EXTEND FORM legalEntity
    PROPERTIES(l) nameSigner, overSignerLastName, overSignerFirstName, overSignerMiddleName, overSignerPosition
;

DESIGN legalEntity {
    extendContainer {
        NEW signerETRN {
            caption = 'ЭТрН';
            fill = 1;
            lines = 2;
            MOVE PROPERTY(nameSigner(l));
            MOVE PROPERTY(overSignerLastName(l));
            MOVE PROPERTY(overSignerFirstName(l));
            MOVE PROPERTY(overSignerMiddleName(l));
            MOVE PROPERTY(overSignerPosition(l));
        }
    }
}

transportationId 'ИД перевозки у провайдера' = ABSTRACT STRING[36](ETRN) CHARWIDTH 15;
etrn (STRING[36] transportationId) = GROUP MAX ETRN e BY transportationId(e);

mintransId 'УИД Минтранса (ГИС ЭПД)' = ABSTRACT STRING[255](ETRN) CHARWIDTH 15;
// трансляции титулов (fwd) приходят без ИД перевозки провайдера - там есть только УИД Минтранса
etrnMintrans (STRING[255] mintransId) = GROUP MAX ETRN e BY mintransId(e);
providerStatus 'Статус перевозки (провайдер)' = ABSTRACT STRING[100](ETRN) CHARWIDTH 15;
exchangeMessage 'Сообщение обмена' = ABSTRACT TEXT (ETRN);

titleFile 'Файл титула (XML)' = ABSTRACT FILE (ETRN);
hasTitleFile 'Есть титул XML' (ETRN e) = TRUE IF titleFile(e);

// файлы приказа - windows-1251, но веб-клиент отдаёт их браузеру с charset=UTF-8 в HTTP-заголовке
// (по стандарту важнее XML-декларации) - браузер падает с "Encoding error" на кириллице.
// Открываем UTF-8-копию; оригинал в базе не меняем - его байты подписаны КЭП
openTitleXml (FILE f) {
    fileToString(f, 'windows-1251');
    stringToFile('<?xml version="1.0" encoding="UTF-8"?>' +
        regexpReplace(resultString(), '^<\\?xml[^>]*\\?>', '', 'g'));
    open(file(RAWFILE(resultFile()), 'xml'));
}

openTitleFile 'Открыть файл титула' (ETRN e) { openTitleXml(titleFile(e)); } IMAGE 'open.png';

// для передачи файла (оператору, на проверку подписи) нужны исходные байты, а не копия для просмотра
downloadTitleFile 'Скачать оригинал' (ETRN e) {
    WRITE CLIENT DIALOG titleFile(e) TO 'Титул_' + (OVERRIDE seriesNumber(e), 'ЭТрН');
}
printForm 'Печатная форма (PDF)' = ABSTRACT FILE (ETRN);
// QR-код перевозки не запрашиваем: мы не перевозчик, водитель получает QR в своём приложении
//qrCode 'QR-код перевозки' = DATA FILE (ETRN); // GIF; обновляется провайдером после подписания Т7/Т8

// признак того, что по входящему документу загружен полный состав данных из титула Т1
titleImportedDateTime 'Дата/время загрузки данных титула' = ABSTRACT DATETIME (ETRN);

// ------------------------- Лента событий провайдера ------------------------- //

CLASS ETRNEvent 'Событие ЭПД';
TABLE etrnEvent(ETRNEvent);

provider = DATA ETRNProvider (ETRNEvent);
nameProvider 'Провайдер' (ETRNEvent ev) = name(provider(ev)) CHARWIDTH 15;

id 'ИД события' = DATA STRING[100](ETRNEvent) IN id CHARWIDTH 15;
event = GROUP AGGR ETRNEvent ev WHERE ev IS ETRNEvent BY provider(ev), id(ev);

dateTime 'Дата/время (UTC)' = DATA DATETIME (ETRNEvent);
type 'Тип события' = DATA STRING[100](ETRNEvent) CHARWIDTH 15;
status 'Новый статус перевозки' = DATA STRING[100](ETRNEvent) CHARWIDTH 15;
transportationId 'ИД перевозки' = DATA STRING[36](ETRNEvent) CHARWIDTH 15;

mintransId 'УИД Минтранса (из события)' = DATA STRING[255](ETRNEvent) CHARWIDTH 15;

etrn = DATA ETRN (ETRNEvent) INDEXED;
seriesNumberETRN 'ЭТрН' (ETRNEvent ev) = seriesNumber(etrn(ev));

processedDateTime 'Дата/время обработки' = DATA DATETIME (ETRNEvent);

lastEventId 'ИД последнего полученного события' = DATA STRING[100](ETRNProvider) CHARWIDTH 15;

// ------------------------- Абстракции обмена (реализуются модулями провайдеров) ------------------------- //

// черновики / передача на подпись / согласование водителем - специфика Контур.Логистики (модуль KonturLogistics)
sendSigned 'Подписать и отправить Т1' ABSTRACT CASE (ETRN);   // формирование XML Т1 + подпись КЭП + отправка (POST documents)
importPrintForm 'Получить печатную форму' ABSTRACT CASE (ETRN);
//importQR 'Получить QR-код' ABSTRACT CASE (ETRN);   // QR не запрашиваем - водитель получает его в своём приложении
importEvents 'Получить события' ABSTRACT CASE (ETRNProvider);   // приём новых событий в журнал (без продвижения документов)
processEvent 'Обработать событие' ABSTRACT CASE (ETRNEvent);   // продвижение документа по событию

// титул грузополучателя (Т3); черновик / на подпись Т3 - специфика Контур.Логистики (модуль KonturLogistics)
sendConsigneeSigned 'Подписать и отправить Т3' ABSTRACT CASE (ETRN);   // XML от consignee-delivery + подпись КЭП + POST documents


// входящие перевозки: 1. приём - создание документов с базовыми данными; 2. загрузка титула Т1
importIncoming 'Получить входящие перевозки' ABSTRACT CASE (ETRNProvider);
importFullData 'Загрузить данные титула' ABSTRACT CASE (ETRN);   // скачивание XML титула Т1 + полный разбор

checkProvider (ETRN e) {
    IF NOT provider(e) THEN {
        MESSAGE 'Для ЭТрН не задан провайдер ЭПД' NOWAIT;
        RETURN;
    }
}

// ------------------------- Проверка обязательных полей титула Т1 ------------------------- //
// Обязательность - по приказу ФНС N ЕД-7-26/1065@ (раздел II) и постановке задачи.
// Проверяется при отправке, а не констрейнтами - черновик документа можно сохранять частично заполненным.

missingDetailT1 (ETRNDetail d) = CONCAT ', ',
    'груз' IF NOT cargo(d),
    'состояние груза' IF NOT condition(d),
    'способ упаковки' IF NOT packageWay(d),
    'вид тары' IF NOT tareType(d),
    'количество грузовых мест' IF NOT quantityPlaces(d),
    'масса брутто' IF NOT grossWeight(d),
    'стоимость груза' IF NOT cost(d),
    'маркировка' IF NOT marking(d);

missingDetailsT1 (ETRN e) = GROUP CONCAT ('строка ' + index(ETRNDetail d) + ': ' + missingDetailT1(d)), '; ' ORDER d BY etrn(d);



showPrintForm 'Печатная форма' (ETRN e) {
    IF NOT printForm(e) AND provider(e) THEN importPrintForm(e);
    IF printForm(e) THEN open(printForm(e));
} IMAGE 'print.png';

