MODULE DiadocLogisticsT3;

REQUIRE DiadocLogistics, DiadocLogisticsT3Form, DiadocLogisticsEvents, DiadocLogisticsT1Import;

NAMESPACE Diadoc;

// ------------------------- Т3 через Диадок: генерация + подпись + отправка ------------------------- //
// Т3+Т4 - отдельный двухтитульный документ (delivery), Т4 - patch к нему; связь с
// reception-документом (Т1/Т2) - через letterId/documentId в GenerateTitleXml.

// для входящих перевозок своего объекта Document нет - координаты reception-документа
// берутся из ленты docflow-событий (receptionDoc*)

// ящик перевозчика: участник ЭДО из титула этой перевозки -> карточка контрагента (в ней первым идёт
// выбор организации) -> ИНН из титула. Титул важнее карточки: выбор в ней заполняется по первой
// перевозке, а в следующей перевозчик может работать через другой ящик - Т3 в чужой ящик отклоняется
carrierT3Box (ETRN.ETRN e) = OVERRIDE
    [GROUP LAST Box b IF organization(b) == organizationParticipantId(ETRN.incomingCarrierParticipantId(e)) ORDER b](),
    diadocBox(ETRN.carrier(e)),
    [GROUP LAST Box b IF organization(b) == organizationInn(ETRN.incomingCarrierInn(e)) ORDER b]();

diadocSendT3 (ETRN.ETRN e) {
    // каждый PostMessage создаёт в Диадоке новый документ, аннулировать его нельзя;
    // после отклонённого Диадоком титула не спрашиваем - тот Т3 в перевозку не попал
    IF diadocDeliveryDocument(e) AND NOT ETRN.exchangeStatus(e) == ETRN.ETRNExchangeStatus.invalid THEN
        ASK 'Т3 уже отправлен в Диадок (есть связанный delivery-документ). Отправить повторно (в Диадоке создастся ещё один документ)?' DO { } ELSE RETURN;
    IF NOT (receptionDocMessageId(e) AND receptionDocEntityId(e)) THEN {
        MESSAGE ETRN.captionMessage(e) + ': нет reception-документа перевозки (Т1) в Диадоке (события не получены)' NOWAIT;
        RETURN;
    }
    IF NOT diadocBox(ETRN.consignee(e)) THEN {
        MESSAGE ETRN.captionMessage(e) + ': не найден ящик Диадока грузополучателя' NOWAIT;
        RETURN;
    }
    IF NOT carrierT3Box(e) THEN {
        MESSAGE ETRN.captionMessage(e) + ': не найден ящик Диадока перевозчика (получатель титула Т3). Для входящей перевозки: проверьте ИНН перевозчика на документе и обновите его организацию в справочнике Диадока по ИНН' NOWAIT;
        RETURN;
    }
    // партнёрство с перевозчиком проверено раньше, до проверки полей (checkCounteragentT3)

    FOR User u == userDiadocETRN() DO NEWSESSION {
        fromBox() <- diadocBox(ETRN.consignee(e));
        toBox() <- carrierT3Box(e);

        getToken(u);

        // перевозчик попадает в документооборот только со своим Т2: до этого Диадок оставляет его
        // слот пустым и отбивает генерацию (400 Invalid generated title: Metadata errors)
        IF fwdOnlyETRN(e) AND NOT fwdT2EntityId(e) THEN diadocFindFwdTitles(e);
        // у перевозки, полученной копиями, Т2 виден по самой копии, у остальных - по этапу
        IF (fwdOnlyETRN(e) AND NOT fwdT2EntityId(e)) OR
           (NOT fwdOnlyETRN(e) AND ETRN.stage(e) == ETRN.ETRNStage.registration) THEN {
            ETRN.exchangeMessage(e) <- ETRN.captionMessage(e) + ': Т3 не отправлен - перевозчик еще не подписал титул Т2 (приём груза). Дождитесь получения Т2 и повторите';
            MESSAGE ETRN.exchangeMessage(e) NOWAIT;
            // ящики сбрасываем по той же причине, что и после postMessage: иначе APPLY может отмениться
            fromBox() <- NULL;
            toBox() <- NULL;
            APPLY;
            RETURN;
        }

        EXPORT diadocT3UserData OBJECTS e = e XML;

        LOCAL result = FILE ();
        TRY {
            EXTERNAL HTTP POST url() + '/GenerateTitleXml?boxId=' + fromBoxId() +
                '&documentTypeNamedId=' + logisticsTypeNamedId() +
                '&documentFunction=delivery&documentVersion=' + logisticsVersion() +
                '&titleIndex=2&letterId=' + receptionDocMessageId(e) + '&documentId=' + receptionDocEntityId(e)
                HEADERS httpHeadersToken PARAMS exportFile() TO result;

            typeNamedIdDocument(0) <- logisticsTypeNamedId();
            functionDocument(0) <- 'delivery';
            versionDocument(0) <- logisticsVersion();
            contentDocument(0) <- encode(RAWFILE(result()), 'base64');

            IF useTestSignature() THEN signWithTestSignature(0) <- TRUE;
            ELSE {
                sign(FILE(result()), TRUE, ETRN.consignee(e));
                signatureDocument(0) <- encodedSignature();
            }

            postMessage(u);
            // ограничение DiadocMessage на партнёрство считает по локальному кэшу, а для ЭПД оно проверено
            // вживую; без сброса ящиков APPLY отменяется и созданный в Диадоке документ в базу не попадает
            fromBox() <- NULL;
            toBox() <- NULL;
            // postMessage глотает HTTP-ошибки (MESSAGE внутри) - успех определяем по созданному документу
            IF createdDocument() THEN {
                // своей сессией: документ в Диадоке уже создан, и если APPLY ниже отменится, повторять нельзя
                NEWSESSION {
                    ETRN.postedT3DateTime(e) <- currentDateTime();
                    APPLY;
                }
                diadocDeliveryDocument(e) <- createdDocument();
                ETRN.exchangeStatus(e) <- ETRN.ETRNExchangeStatus.signed;
                ETRN.exchangeMessage(e) <- NULL;
                // этап продвигаем сразу по своей отправке, не дожидаясь события ленты
                ETRN.stage(e) <- ETRN.ETRNStage.acceptance WHERE NOT ETRN.id(ETRN.stage(e)) >= 3;
            } ELSE
                ETRN.exchangeMessage(e) <- ETRN.captionMessage(e) + ': Т3 не отправлен (Диадок) - ошибка PostMessage';
        } CATCH {
            fileToString(result(), 'UTF-8');
            ETRN.exchangeMessage(e) <- ETRN.captionMessage(e) + ': ошибка отправки Т3 (Диадок) - ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
            MESSAGE ETRN.exchangeMessage(e) NOWAIT;
        }
        APPLY;
    }
}

// без ящиков партнёрство проверять не с кем - об этом скажет сама отправка
ETRN.checkCounteragentT3 (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    IF NOT (diadocBox(ETRN.consignee(e)) AND carrierT3Box(e)) THEN RETURN;
    checkCounteragent(guidBoxId(diadocBoxId(ETRN.consignee(e))), carrierT3Box(e), 'Т3, ' + ETRN.captionMessage(e), 'перевозчик');
    IF NOT counteragentCheckPassed() THEN {
        ETRN.counteragentT3Failed() <- TRUE;
        ETRN.counteragentT3Message() <- counteragentCheckMessage();
    }
}

// кнопка "Пригласить перевозчика": то же приглашение, что уходит при отправке Т3,
// но отдельно - чтобы позвать перевозчика заранее и не ждать отказа отправки
ETRN.inviteCarrier (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    // nested-свойство живёт до закрытия формы: чистим, чтобы не показать причину от прошлого нажатия
    counteragentCheckMessage() <- NULL;
    IF NOT diadocBox(ETRN.consignee(e)) THEN {
        MESSAGE ETRN.captionMessage(e) + ': не найден ящик Диадока грузополучателя' NOWAIT;
        RETURN;
    }
    IF NOT carrierT3Box(e) THEN {
        MESSAGE ETRN.captionMessage(e) + ': не найден ящик Диадока перевозчика. Проверьте ИНН перевозчика на документе и обновите его организацию в справочнике Диадока по ИНН' NOWAIT;
        RETURN;
    }

    checkCounteragent(guidBoxId(diadocBoxId(ETRN.consignee(e))), carrierT3Box(e), 'Т3, ' + ETRN.captionMessage(e), 'перевозчик');

    // итог - в nested-свойство: counteragentCheckPassed в новую сессию не протягивается. Успех важнее
    // промежуточных ошибок: при встречном приглашении связь устанавливается сразу
    counteragentCheckMessage() <- OVERRIDE TEXT(ETRN.captionMessage(e) + ': партнёрство с перевозчиком подтверждено') IF counteragentCheckPassed(),
        counteragentCheckMessage();

    NEWSESSION {
        ETRN.exchangeMessage(e) <- counteragentCheckMessage();
        APPLY;
    }
    MESSAGE counteragentCheckMessage() NOWAIT;
}

ETRN.sendConsigneeSigned (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    diadocSendT3(e);
}
