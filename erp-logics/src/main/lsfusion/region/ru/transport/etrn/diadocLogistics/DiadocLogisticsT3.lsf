MODULE DiadocLogisticsT3;

REQUIRE DiadocLogistics, DiadocLogisticsT3Form, DiadocLogisticsEvents;

NAMESPACE Diadoc;

// ------------------------- Т3 через Диадок: генерация + подпись + отправка ------------------------- //
// Т3+Т4 - отдельный двухтитульный документ (delivery). Т3 создаёт этот delivery-документ
// (PostMessage), связь с reception-документом (Т1/Т2) - через letterId/documentId в GenerateTitleXml.
// Т4 затем отправляется как patch к созданному delivery-документу.

// координаты reception-документа - через receptionDoc* (для входящих перевозок своего
// объекта Document у нас нет, идентификаторы берутся из журнала docflow-событий)

// ящик перевозчика - получателя Т3: у исходящей - по карточке перевозчика из справочника
// контрагентов, у входящей - по ИНН перевозчика из титула через справочник организаций
// Диадока (перевозчик приглашается в контрагенты Диадока, в наш справочник не заводится)
carrierT3Box (ETRN.ETRN e) = OVERRIDE diadocBox(ETRN.carrier(e)),
    [GROUP LAST Box b IF organization(b) == organizationInn(ETRN.incomingCarrierInn(e)) ORDER b]();

diadocSendT3 (ETRN.ETRN e) {
    IF NOT (receptionDocMessageId(e) AND receptionDocEntityId(e)) THEN {
        MESSAGE 'Нет reception-документа перевозки (Т1) в Диадоке (события не получены)' NOWAIT;
        RETURN;
    }
    IF NOT diadocBox(ETRN.consignee(e)) THEN {
        MESSAGE 'Не найден ящик Диадока грузополучателя' NOWAIT;
        RETURN;
    }
    IF NOT carrierT3Box(e) THEN {
        MESSAGE 'Не найден ящик Диадока перевозчика (получатель титула Т3). Для входящей перевозки: проверьте ИНН перевозчика на документе и обновите его организацию в справочнике Диадока по ИНН' NOWAIT;
        RETURN;
    }

    // партнёрство ящиков с перевозчиком: без него Диадок не примет наш Т3.
    // InvitesMe (перевозчик пригласил нас первым) - встречное приглашение подтверждает связь
    // сразу; не контрагент - приглашение отправляется здесь же (настройка), Т3 повторяется
    // после подтверждения перевозчиком; сбой самой проверки отправку не блокирует
    diadocGetCounteragentStatus(guidBoxId(diadocBoxId(ETRN.consignee(e))), guidBoxId(boxId(carrierT3Box(e))));
    // проверка завершилась HTTP-ошибкой (сообщение уже показано) - отправка обречена, выходим
    IF counteragentCurrentStatus() == 'CheckFailed' THEN RETURN;
    IF counteragentCurrentStatus() == 'InvitesMe' THEN
        FOR Organization o == organization(carrierT3Box(e)) DO
            diadocAcquireOrganization(o, guidBoxId(diadocBoxId(ETRN.consignee(e))));
    IF counteragentCurrentStatus() AND NOT (counteragentCurrentStatus() == 'IsMyCounteragent' OR counteragentCurrentStatus() == 'InvitesMe') THEN {
        ASK 'Партнёрство с перевозчиком в Диадоке не установлено - без него Т3 не будет принят.
Отправить перевозчику приглашение в контрагенты?' DO {
            FOR Organization o == organization(carrierT3Box(e)) DO
                diadocAcquireOrganization(o, guidBoxId(diadocBoxId(ETRN.consignee(e))));
            MESSAGE 'Приглашение перевозчику отправлено. Повторите отправку Т3 после подтверждения партнёрства перевозчиком' NOWAIT;
        }
        RETURN;
    }

    FOR User u == userDiadocETRN() DO NEWSESSION {
        fromBox() <- diadocBox(ETRN.consignee(e));
        toBox() <- carrierT3Box(e);   // Т3 отправляется перевозчику (далее Т4)

        getToken(u);
        EXPORT diadocT3UserData OBJECTS e = e XML;

        LOCAL result = FILE ();
        TRY {
            EXTERNAL HTTP POST url() + '/GenerateTitleXml?boxId=' + fromBoxId() +
                '&documentTypeNamedId=' + logisticsTypeNamedId() +
                '&documentFunction=delivery&documentVersion=' + logisticsVersion() +
                '&titleIndex=2&letterId=' + receptionDocMessageId(e) + '&documentId=' + receptionDocEntityId(e)
                HEADERS httpHeadersToken PARAMS exportFile() TO result;

            typeNamedIdDocument(0) <- logisticsTypeNamedId();
            functionDocument(0) <- 'delivery';
            versionDocument(0) <- logisticsVersion();
            contentDocument(0) <- encode(RAWFILE(result()), 'base64');

            IF useTestSignature() THEN signWithTestSignature(0) <- TRUE;
            ELSE {
                sign(FILE(result()), TRUE, ETRN.consignee(e));
                signatureDocument(0) <- encodedSignature();
            }

            postMessage(u);
            // postMessage глотает HTTP-ошибки (MESSAGE внутри) - успех определяем по созданному документу
            IF createdDocument() THEN {
                // Т3 создаёт delivery-документ перевозки (Т4 - patch к нему)
                diadocDeliveryDocument(e) <- createdDocument();
                ETRN.exchangeStatus(e) <- ETRN.ETRNExchangeStatus.signed;
                ETRN.exchangeMessage(e) <- NULL;
                // наш титул оформлен - продвигаем этап сразу, не дожидаясь события ленты
                ETRN.stage(e) <- ETRN.ETRNStage.acceptance WHERE NOT ETRN.id(ETRN.stage(e)) >= 3;
            } ELSE
                ETRN.exchangeMessage(e) <- 'Т3 не отправлен (Диадок): ошибка PostMessage';
        } CATCH {
            fileToString(result(), 'UTF-8');
            ETRN.exchangeMessage(e) <- 'Ошибка отправки Т3 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
            MESSAGE ETRN.exchangeMessage(e) NOWAIT;
        }
        APPLY;
    }
}

ETRN.sendConsigneeSigned (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    diadocSendT3(e);
}
