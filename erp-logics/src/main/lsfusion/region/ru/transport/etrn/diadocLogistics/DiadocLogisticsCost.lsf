MODULE DiadocLogisticsCost;

REQUIRE DiadocLogisticsEvents, DiadocLogisticsCostForm, ETRNCostTitleXmlRu;

NAMESPACE Diadoc;

// ------------------------- Изменение стоимости перевозки (Т5/Т6) через Диадок ------------------------- //
// Т6 - GenerateTitleXml (cost, titleIndex=5, letterId/documentId от Т5) -> PostMessagePatch (RecipientTitles).
// Отказ - GenerateSignatureRejectionXml (V2) -> PostMessagePatch (XmlSignatureRejections):
// документооборот продолжается, перевозчик может прислать Т5 повторно.

checkCostDocument (ETRN.ETRN e) {
    IF NOT diadocCostDocument(e) THEN {
        MESSAGE 'Нет документа изменения стоимости (Т5) в Диадоке: выполните приём событий и сообщений' NOWAIT;
        RETURN;
    }
    IF NOT diadocBox(ETRN.shipper(e)) THEN {
        MESSAGE 'Не найден ящик Диадока грузоотправителя' NOWAIT;
        RETURN;
    }
}

// ------------------------- Т6: согласование изменения стоимости ------------------------- //

diadocSendT6 (ETRN.ETRN e) {
    checkCostDocument(e);
    IF NOT (diadocCostDocument(e) AND diadocBox(ETRN.shipper(e))) THEN RETURN;

    FOR User u == userDiadocETRN() DO NEWSESSION {
        box() <- diadocBox(ETRN.shipper(e));
        message() <- message(diadocCostDocument(e));
        parentEntity(0) <- entity(diadocCostDocument(e));
        isRecipientTitles(0) <- TRUE;

        getToken(u);
        EXPORT diadocT6UserData OBJECTS e = e XML;

        LOCAL result = FILE ();
        TRY {
            EXTERNAL HTTP POST url() + '/GenerateTitleXml?boxId=' + boxId() +
                '&documentTypeNamedId=' + logisticsTypeNamedId() +
                '&documentFunction=cost&documentVersion=' + logisticsVersion() +
                '&titleIndex=5&letterId=' + messageId() + '&documentId=' + parentEntityId(0)
                HEADERS httpHeadersToken PARAMS exportFile() TO result;

            contentDocument(0) <- encode(RAWFILE(result()), 'base64');

            IF useTestSignature() THEN signWithTestSignature(0) <- TRUE;
            ELSE {
                sign(FILE(result()), TRUE, ETRN.shipper(e));
                signatureDocument(0) <- encodedSignature();
            }

            postMessagePatch(u);
            // postMessagePatch глотает HTTP-ошибки (MESSAGE внутри) - успех определяем по созданному дополнению
            IF createdMessagePatch() THEN {
                ETRN.costConfirmedDateTime(e) <- currentDateTime();
                ETRN.exchangeMessage(e) <- NULL;
            } ELSE
                ETRN.exchangeMessage(e) <- 'Т6 не отправлен (Диадок): ошибка PostMessagePatch';
        } CATCH {
            fileToString(result(), 'UTF-8');
            ETRN.exchangeMessage(e) <- 'Ошибка отправки Т6 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
            MESSAGE ETRN.exchangeMessage(e) NOWAIT;
        }
        APPLY;
    }
}

ETRN.sendCostConfirmation (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    diadocSendT6(e);
}

// ------------------------- Отказ от подписания Т5 ------------------------- //

// тело запроса GenerateSignatureRejectionXml (V2)
rejMessageId = DATA LOCAL STRING ();
rejAttachmentId = DATA LOCAL STRING ();
rejErrorMessage = DATA LOCAL STRING ();
rejSignerContent = DATA LOCAL TEXT ();

FORM exportSignatureRejectionRequest
    PROPERTIES() rejMessageId EXTID 'MessageId',
                 rejAttachmentId EXTID 'AttachmentId',
                 rejErrorMessage EXTID 'ErrorMessage',
                 rejSignerContent EXTID 'SignerContent'
;

diadocRejectT5 (ETRN.ETRN e) {
    checkCostDocument(e);
    IF NOT (diadocCostDocument(e) AND diadocBox(ETRN.shipper(e))) THEN RETURN;

    FOR User u == userDiadocETRN() DO NEWSESSION {
        box() <- diadocBox(ETRN.shipper(e));
        message() <- message(diadocCostDocument(e));
        parentEntity(0) <- entity(diadocCostDocument(e));
        isXmlSignatureRejections(0) <- TRUE;

        getToken(u);

        // TODO: сверить ожидаемый формат SignerContent на тестовой площадке
        EXPORT diadocRejectionSigner OBJECTS e = e XML;
        rejSignerContent() <- encode(RAWFILE(exportFile()), 'base64');
        rejMessageId() <- messageId();
        rejAttachmentId() <- parentEntityId(0);
        rejErrorMessage() <- ETRN.costRejectionReason(e);

        LOCAL result = FILE ();
        EXPORT exportSignatureRejectionRequest JSON;
        TRY {
            EXTERNAL HTTP POST url() + '/V2/GenerateSignatureRejectionXml?boxId=' + boxId()
                HEADERS httpHeadersToken PARAMS exportFile() TO result;

            contentDocument(0) <- encode(RAWFILE(result()), 'base64');

            IF useTestSignature() THEN signWithTestSignature(0) <- TRUE;
            ELSE {
                sign(FILE(result()), TRUE, ETRN.shipper(e));
                signatureDocument(0) <- encodedSignature();
            }

            postMessagePatch(u);
            IF createdMessagePatch() THEN {
                FOR ETRN.OutgoingETRN oe == e DO
                    ETRN.costChangeDateTime(oe) <- NULL;   // документооборот продолжится: перевозчик отправит Т5 повторно
                ETRN.exchangeMessage(e) <- NULL;
            } ELSE
                ETRN.exchangeMessage(e) <- 'Отказ по Т5 не отправлен (Диадок): ошибка PostMessagePatch';
        } CATCH {
            fileToString(result(), 'UTF-8');
            ETRN.exchangeMessage(e) <- 'Ошибка отправки отказа по Т5 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
            MESSAGE ETRN.exchangeMessage(e) NOWAIT;
        }
        APPLY;
    }
}

ETRN.rejectCostChange (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    diadocRejectT5(e);
}

// ------------------------- Загрузка контента Т5 ------------------------- //
// Титулов Т5 может быть несколько: после отказа перевозчик присылает ПУД заново, плюс в схеме
// есть ИспрПУД. Поэтому идём по всем событиям cost, а титул перечитываем, если по нему пришло
// событие позже последнего разбора - это верно и когда исправление приходит новым документом,
// и когда обновляется прежний.

costTitleFileData = DATA LOCAL RAWFILE ();

// слот 0 - титул перевозчика (автор Т5)
costEntityId (ETRN.ETRNEvent ev) = OVERRIDE titleEntityId(ev, 0), entityId(ev);

loadCostTitle (ETRN.OutgoingETRN e, ETRN.ETRNEvent ev) {
    costTitleFileData() <- NULL;

    FOR User u == userDiadocETRN() DO {
        getToken(u);
        TRY {
            EXTERNAL HTTP GET url() + '/GetEntityContent?boxId=' + eventBoxId(ev) +
                '&messageId=' + messageId(ev) + '&entityId=' + costEntityId(ev)
                HEADERS httpHeadersToken TO costTitleFileData;
        } CATCH {
            costTitleFileData() <- NULL;
            fileToString(FILE(costTitleFileData()), 'UTF-8');
            ETRN.exchangeMessage(e) <- STRING('Ошибка получения контента титула Т5 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException()));
            MESSAGE ETRN.exchangeMessage(e) NOWAIT;
            APPLY;
        }
    }
}

diadocImportT5 (ETRN.OutgoingETRN e) {
    FOR ETRN.etrn(ETRN.ETRNEvent ev) == e AND docFunction(ev) == 'cost' AND
        messageId(ev) AND costEntityId(ev) AND eventBoxId(ev) AND
        NOT ETRN.titleEventDateTime(ETRN.etrnCostTitle(STRING[100](costEntityId(ev)))) >= ETRN.dateTime(ev)
        ORDER ETRN.dateTime(ev), ev DO {

        loadCostTitle(e, ev);
        IF costTitleFileData() THEN {
            IF NOT ETRN.etrnCostTitle(STRING[100](costEntityId(ev))) THEN
                NEW t = ETRN.ETRNCostTitle {
                    ETRN.etrn(t) <- e;
                    ETRN.titleEntityId(t) <- STRING[100](costEntityId(ev));
                }
            FOR ETRN.ETRNCostTitle t == ETRN.etrnCostTitle(STRING[100](costEntityId(ev))) DO {
                ETRN.titleMessageId(t) <- messageId(ev);
                ETRN.titleEventDateTime(t) <- ETRN.dateTime(ev);
                ETRN.titleFile(t) <- file(costTitleFileData(), 'xml');
                ETRN.parseETRNCostTitleXml(t);   // разбор применяет сессию сам
            }
        }
    }
}

ETRN.importCostTitle (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    FOR ETRN.OutgoingETRN oe == e DO diadocImportT5(oe);
}

// титул грузим сразу по приходу события: сумму надо видеть до ответа Т6
ETRN.onProcessedEvent (ETRN.ETRNEvent ev) + {
    FOR ETRN.OutgoingETRN e == ETRN.etrn(ev) AND ETRN.provider(ev) == ETRN.ETRNProvider.diadoc AND
        docFunction(ev) == 'cost' DO
        NEWSESSION { diadocImportT5(e); }
}
