MODULE DiadocOrderRequest;

REQUIRE DiadocLogistics, DiadocOrderRequestT1Form;

NAMESPACE Diadoc;

// ------------------------- Заказ-заявка через Диадок: генерация XML + подпись + отправка ------------------------- //
// Т1 (грузоотправитель): GenerateTitleXml titleIndex=0 -> подпись КЭП -> PostMessage (создаёт документ заказа-заявки).
// Форма UserDataXml - в модуле DiadocOrderRequestT1Form (namespace ETRN).
// Т2 (ответ перевозчика) мы не формируем - только принимаем (DiadocOrderRequestImport).

// связь заказа-заявки с документом Диадока (Т1 + Т2 - один двухтитульный документ)
diadocDocument = DATA Document (ETRN.OrderRequest);

// ------------------------- Т1: заявка грузоотправителя ------------------------- //

diadocSendOrderRequest (ETRN.OrderRequest o) {
    // защита от дублей: каждый PostMessage создаёт в Диадоке новый документ, даже если
    // предыдущая отправка не зафиксировалась у нас (обрыв на ответе, ошибка APPLY)
    IF diadocDocument(o) THEN
        ASK 'Заявка уже отправлена в Диадок (есть связанный документ). Отправить повторно (в Диадоке создастся ещё один документ)?' DO { } ELSE RETURN;
    IF NOT diadocBox(ETRN.shipper(o)) THEN {
        MESSAGE 'Не найден ящик Диадока грузоотправителя' NOWAIT;
        RETURN;
    }
    IF NOT diadocBox(ETRN.carrier(o)) THEN {
        MESSAGE 'Не найден ящик Диадока перевозчика (получатель заявки)' NOWAIT;
        RETURN;
    }

    // догрузить структурные реквизиты организаций-участников, если их нет
    //ensureDiadocOrgData(ETRN.shipper(o));
    //ensureDiadocOrgData(ETRN.carrier(o));

    // партнёрство ящиков с перевозчиком: совсем без него Диадок не примет заявку (как в Т3).
    // InvitesMe (перевозчик пригласил нас первым) - встречное приглашение подтверждает связь
    // сразу; IsInvitedByMe (наше приглашение ещё не принято) отправке не мешает - Диадок
    // доставляет документ вместе с приглашением; не контрагент - приглашение отправляется
    // здесь же (с подтверждением), заявка повторяется после; сбой самой проверки отправку не блокирует
    diadocGetCounteragentStatus(guidBoxId(diadocBoxId(ETRN.shipper(o))), guidBoxId(diadocBoxId(ETRN.carrier(o))));
    // проверка завершилась HTTP-ошибкой (сообщение уже показано) - отправка обречена, выходим
    IF counteragentCurrentStatus() == 'CheckFailed' THEN RETURN;
    IF counteragentCurrentStatus() == 'InvitesMe' THEN
        FOR Organization org == organization(diadocBox(ETRN.carrier(o))) DO
            diadocAcquireOrganization(org, guidBoxId(diadocBoxId(ETRN.shipper(o))));
    IF counteragentCurrentStatus() == 'IsInvitedByMe' THEN
        MESSAGE 'Приглашение в контрагенты у перевозчика и еще не принято: заявка Т1 будет доставлена и будет ожидать подтверждения партнёрства' NOWAIT;
    IF counteragentCurrentStatus() AND NOT (counteragentCurrentStatus() == 'IsMyCounteragent' OR
        counteragentCurrentStatus() == 'InvitesMe' OR counteragentCurrentStatus() == 'IsInvitedByMe') THEN {
        ASK 'Партнёрство с перевозчиком в Диадоке не установлено - без него заявка Т1 не будет принята.
Отправить перевозчику приглашение в контрагенты?' DO {
            FOR Organization org == organization(diadocBox(ETRN.carrier(o))) DO
                diadocAcquireOrganization(org, guidBoxId(diadocBoxId(ETRN.shipper(o))));
            MESSAGE 'Приглашение перевозчику отправлено. Повторите отправку заявки после подтверждения партнёрства перевозчиком' NOWAIT;
        }
        RETURN;
    }

    FOR User u == userDiadocETRN() DO NEWSESSION {
        fromBox() <- diadocBox(ETRN.shipper(o));
        toBox() <- diadocBox(ETRN.carrier(o));

        getToken(u);
        EXPORT diadocOrderRequestT1 OBJECTS o = o XML;

        LOCAL result = FILE ();
        TRY {
            EXTERNAL HTTP POST url() + '/GenerateTitleXml?boxId=' + fromBoxId() +
                '&documentTypeNamedId=' + orderRequestTypeNamedId() +
                '&documentFunction=' + orderRequestFunction() + '&documentVersion=' + orderRequestVersion() + '&titleIndex=0'
                HEADERS httpHeadersToken PARAMS exportFile() TO result;

            typeNamedIdDocument(0) <- orderRequestTypeNamedId();
            functionDocument(0) <- orderRequestFunction();
            versionDocument(0) <- orderRequestVersion();
            contentDocument(0) <- encode(RAWFILE(result()), 'base64');

            IF useTestSignature() THEN signWithTestSignature(0) <- TRUE;
            ELSE {
                sign(FILE(result()), TRUE, ETRN.shipper(o));
                signatureDocument(0) <- encodedSignature();
            }

            postMessage(u);
            // postMessage глотает HTTP-ошибки (MESSAGE внутри) - успех определяем по созданному документу
            IF createdDocument() THEN {
                diadocDocument(o) <- createdDocument();
                ETRN.exchangeStatus(o) <- ETRN.ETRNExchangeStatus.signed;
                ETRN.exchangeMessage(o) <- NULL;
            } ELSE
                ETRN.exchangeMessage(o) <- 'Заявка Т1 не отправлена (Диадок): ошибка PostMessage';
        } CATCH {
            fileToString(result(), 'UTF-8');
            ETRN.exchangeMessage(o) <- 'Ошибка отправки заявки Т1 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
            MESSAGE ETRN.exchangeMessage(o) NOWAIT;
        }
        APPLY;
    }
}

ETRN.sendOrderRequest (ETRN.OrderRequest o) + WHEN ETRN.provider(o) == ETRN.ETRNProvider.diadoc THEN {
    diadocSendOrderRequest(o);
}

// Обновление статусов заявок - через ленту docflow-событий V5
// (DiadocLogisticsEvents: importEvents / processEvent), общие действия ETRNExchange.
