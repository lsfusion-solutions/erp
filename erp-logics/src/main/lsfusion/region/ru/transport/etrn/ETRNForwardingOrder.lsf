MODULE ETRNForwardingOrder;

REQUIRE ETRNExchange, LegalEntity, LegalEntityRu, Cargo, Currency;

NAMESPACE ETRN;

// Электронное поручение экспедитору (приказ ФНС N ЕД-7-26/958@) - документ ЭПД.
// Мы всегда клиент (титул клиента), экспедитор отвечает своим титулом, отзыв - третий титул.
// Структура по схеме: поручение -> партии груза (CargoInfo, их может быть несколько) -> строки груза.

// ------------------------- Документ ------------------------- //

CLASS ForwardingOrder 'Поручение экспедитору';
TABLE forwardingOrder(ForwardingOrder);

number 'Номер' = DATA STRING[48] (ForwardingOrder) IN id CHARWIDTH 10;
series 'Серия' = DATA BPSTRING[2] (ForwardingOrder) CHARWIDTH 3 NOFLEX;
date 'Дата' = DATA DATE (ForwardingOrder) INDEXED;

WHEN LOCAL SET(ForwardingOrder f IS ForwardingOrder) AND NOT CHANGED(date(f)) DO date(f) <- currentDate();

// ------------------------- Нумерация (по аналогии с заявками) ------------------------- //

numerator '{numerator.id.numerator}' = DATA Numerator (ForwardingOrder);
nameNumerator '{numerator.numerator}' (ForwardingOrder f) = name(numerator(f)) CHARWIDTH 7;

generateSeriesNumber '{numerator.generate.number}' (ForwardingOrder f) {
    number(f) <- STRING[48](curStringValue(numerator(f)));
    series(f) <- series(numerator(f));
    incrementValueSession(numerator(f));
}

WHEN SETCHANGED(numerator(ForwardingOrder f)) AND
     NOT CHANGED(number(f)) AND
     NOT CHANGED(series(f))
     DO generateSeriesNumber(f);

defaultNumeratorForwardingOrder = DATA Numerator ();
nameDefaultNumeratorForwardingOrder 'Поручения экспедитору' = name(defaultNumeratorForwardingOrder()) IN defaultNumerator;

numerator(ForwardingOrder f) <- defaultNumeratorForwardingOrder() WHEN SET(f IS ForwardingOrder);

EXTEND FORM defaultNumerators
    PROPERTIES() nameDefaultNumeratorForwardingOrder = nameDefaultNumeratorForwardingOrder
;

createDefaultNumeratorForwardingOrder () {
    NEW n = Numerator {
        name(n) <- 'Поручения экспедитору';
        series(n) <- 'ПЭ';
        minValue(n) <- 1L;
        maxValue(n) <- 99999L;
        stringLength(n) <- 5;

        defaultNumeratorForwardingOrder() <- n;
    }
}

loadDefaultNumerators() + {
    createDefaultNumeratorForwardingOrder();
}

isClosed 'Закрыт' = DATA BOOLEAN (ForwardingOrder);
isOpened 'Открыт' (ForwardingOrder f) = f IS ForwardingOrder AND NOT isClosed(f);

close 'Закрыть' (ForwardingOrder f) {
    NEWSESSION { isClosed(f) <- TRUE; apply(); }
} TOOLBAR CONFIRM;

open 'Открыть' (ForwardingOrder f) {
    NEWSESSION { isClosed(f) <- NULL; apply(); }
} TOOLBAR CONFIRM;

// ------------------------- Участники и договор ------------------------- //

client = DATA LegalEntity (ForwardingOrder);
nameClient 'Клиент' (ForwardingOrder f) = name(client(f)) CHARWIDTH 15;
forwarder = DATA LegalEntity (ForwardingOrder);
nameForwarder 'Экспедитор' (ForwardingOrder f) = name(forwarder(f)) CHARWIDTH 15;
forwarderPhone 'Телефон экспедитора' (ForwardingOrder f) = phone(forwarder(f)) CHARWIDTH 15;

roleClient 'Мы - клиент' (ForwardingOrder f) = isCompany(client(f));

// договор транспортной экспедиции - основание поручения (обязателен в титуле)
contractName 'Договор ТЭ: наименование' = DATA ISTRING[255](ForwardingOrder) CHARWIDTH 15;
contractNumber 'Договор ТЭ: номер' = DATA ISTRING[255](ForwardingOrder) CHARWIDTH 12;
contractDate 'Договор ТЭ: дата' = DATA DATE (ForwardingOrder);

// ДокГруз - передача экспедитору документов, необходимых для перевозки
documentsAttached 'Передаются документы для перевозки' = DATA BOOLEAN (ForwardingOrder);

// подписант титула клиента - первичные поля документа, заполняются из карточки клиента
signerLastName 'Подписант: фамилия' = DATA ISTRING[60](ForwardingOrder) CHARWIDTH 15;
signerFirstName 'Подписант: имя' = DATA ISTRING[60](ForwardingOrder) CHARWIDTH 15;
signerMiddleName 'Подписант: отчество' = DATA ISTRING[60](ForwardingOrder) CHARWIDTH 15;
signerPosition 'Подписант: должность' = DATA ISTRING[128](ForwardingOrder) CHARWIDTH 15;

WHEN LOCAL CHANGED(client(ForwardingOrder f)) DO {
    signerLastName(f) <- overSignerLastName(client(f)) WHERE overSignerLastName(client(f)) AND NOT signerLastName(f);
    signerFirstName(f) <- overSignerFirstName(client(f)) WHERE overSignerFirstName(client(f)) AND NOT signerFirstName(f);
    signerMiddleName(f) <- overSignerMiddleName(client(f)) WHERE overSignerMiddleName(client(f)) AND NOT signerMiddleName(f);
    signerPosition(f) <- overSignerPosition(client(f)) WHERE overSignerPosition(client(f)) AND NOT signerPosition(f);
}

// ------------------------- Партия груза (CargoInfo) ------------------------- //
// CargoInfos/CargoInfo в схеме - maxOccurs="unbounded": у каждой партии свои стороны,
// адреса приема и выдачи, сроки, транспорт и строки груза.

CLASS ForwardingOrderBatch 'Маршрут / партия груза';
TABLE forwardingOrderBatch(ForwardingOrderBatch);

forwardingOrder = DATA ForwardingOrder (ForwardingOrderBatch) NONULL DELETE INDEXED;
dataIndex '{document.data.index.detail.class}' = DATA INTEGER (ForwardingOrderBatch);
defaultIndex '№' (ForwardingOrderBatch b) = PARTITION SUM 1 IF b IS ForwardingOrderBatch ORDER b BY forwardingOrder(b) CHARWIDTH 3;
index 'N' (ForwardingOrderBatch b) = OVERRIDE dataIndex(b), defaultIndex(b) IN id;

// ИдентПартГруз / НомПартГруз - атрибуты CargoInfo самого титула клиента
batchId 'Идентификатор партии груза' = DATA STRING[36](ForwardingOrderBatch) CHARWIDTH 15;
batchNumber 'Номер партии груза' = DATA STRING[255](ForwardingOrderBatch) CHARWIDTH 8;

shipper = DATA LegalEntity (ForwardingOrderBatch);
nameShipper 'Грузоотправитель' (ForwardingOrderBatch b) = name(shipper(b)) CHARWIDTH 15;
consignee = DATA LegalEntity (ForwardingOrderBatch);
nameConsignee 'Грузополучатель' (ForwardingOrderBatch b) = name(consignee(b)) CHARWIDTH 15;

WHEN LOCAL SET(ForwardingOrderBatch b IS ForwardingOrderBatch) AND NOT CHANGED(shipper(b)) DO
    shipper(b) <- client(forwardingOrder(b));

notifyParties 'Уведомить стороны о прибытии груза' = DATA BOOLEAN (ForwardingOrderBatch);   // ПрУведСторон
transferToForwarder 'Прием груза во владение экспедитором' = DATA BOOLEAN (ForwardingOrderBatch);   // ОтмПрием

// ПрзПрвз - признак перевозки, коды из схемы
CLASS ForwardingTransportationSign 'Признак перевозки' {
    noContainer 'Без контейнера',
    loadedContainer 'Контейнер груженый',
    emptyContainer 'Контейнер порожний как груз'
}
name 'Наименование' (ForwardingTransportationSign s) = staticCaption(s) IF s IS ForwardingTransportationSign CHARWIDTH 15;
id 'Код' (ForwardingTransportationSign s) = CASE EXCLUSIVE
    WHEN s == ForwardingTransportationSign.noContainer THEN '0'
    WHEN s == ForwardingTransportationSign.loadedContainer THEN '1'
    WHEN s == ForwardingTransportationSign.emptyContainer THEN '2';

FORM forwardingTransportationSigns 'Признак перевозки'
    OBJECTS s = ForwardingTransportationSign
    PROPERTIES(s) READONLY name

    LIST ForwardingTransportationSign OBJECT s
;

transportationSign 'Признак перевозки' = DATA ForwardingTransportationSign (ForwardingOrderBatch);
nameTransportationSign 'Признак перевозки' (ForwardingOrderBatch b) = staticCaption(transportationSign(b)) CHARWIDTH 15;
WHEN LOCAL SET(ForwardingOrderBatch b IS ForwardingOrderBatch) AND NOT CHANGED(transportationSign(b)) DO
    transportationSign(b) <- ForwardingTransportationSign.noContainer;

// вид транспорта - кодировка ВидТС приказа 958 (1..5)
CLASS ForwardingVehicleKind 'Вид транспорта' {
    automobile 'Автомобильный',
    railway 'Железнодорожный',
    air 'Воздушный',
    sea 'Морской',
    river 'Внутренний водный'
}
// нумерация ВидТС по схеме поручения: водный - 2, воздушный - 3, ж/д - 4, морской - 5
// (в ЭТрН порядок другой, поэтому коды здесь свои)
id 'Код' (ForwardingVehicleKind k) = CASE EXCLUSIVE
    WHEN k == ForwardingVehicleKind.automobile THEN '1'
    WHEN k == ForwardingVehicleKind.river THEN '2'
    WHEN k == ForwardingVehicleKind.air THEN '3'
    WHEN k == ForwardingVehicleKind.railway THEN '4'
    WHEN k == ForwardingVehicleKind.sea THEN '5';

name 'Наименование' (ForwardingVehicleKind k) = staticCaption(k) IF k IS ForwardingVehicleKind CHARWIDTH 15;

FORM forwardingVehicleKinds 'Вид транспорта'
    OBJECTS k = ForwardingVehicleKind
    PROPERTIES(k) READONLY name

    LIST ForwardingVehicleKind OBJECT k
;

vehicleKind 'Вид транспорта' = DATA ForwardingVehicleKind (ForwardingOrderBatch);
nameVehicleKind 'Вид транспорта' (ForwardingOrderBatch b) = staticCaption(vehicleKind(b)) CHARWIDTH 15;
WHEN LOCAL SET(ForwardingOrderBatch b IS ForwardingOrderBatch) AND NOT CHANGED(vehicleKind(b)) DO
    vehicleKind(b) <- ForwardingVehicleKind.automobile;
bodyType 'Требования к типу кузова' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;

shipmentDateFrom 'Готовность к отгрузке: с' = DATA DATE (ForwardingOrderBatch);
shipmentDateTo 'Готовность к отгрузке: по' = DATA DATE (ForwardingOrderBatch);
// время в титуле - интервал ЧЧ:ММ-ЧЧ:ММ со смещением UTC, поэтому время с/по
shipmentTime 'Время готовности: с' = DATA TIME (ForwardingOrderBatch);
shipmentTimeTo 'Время готовности: по' = DATA TIME (ForwardingOrderBatch);
deliveryDateFrom 'Доставка: с' = DATA DATE (ForwardingOrderBatch);
deliveryDateTo 'Доставка: по' = DATA DATE (ForwardingOrderBatch);
deliveryTime 'Время доставки: с' = DATA TIME (ForwardingOrderBatch);
deliveryTimeTo 'Время доставки: по' = DATA TIME (ForwardingOrderBatch);

// адреса приема и выдачи заполняются выбором склада (структурный адрес склада -
// от подразделения Диадока, как в ЭТрН)
pickupStock 'Склад погрузки' = DATA Stock (ForwardingOrderBatch);
namePickupStock 'Склад погрузки' (ForwardingOrderBatch b) = name(pickupStock(b)) CHARWIDTH 15;
pickupPlace 'Место приема груза' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;
// МстПрГр: 1 - на складе грузоотправителя, 2 - на складе экспедитора
pickupAtForwarder 'Прием на складе экспедитора' = DATA BOOLEAN (ForwardingOrderBatch);
pickupRegion 'Код региона (прием)' = DATA STRING[2](ForwardingOrderBatch) CHARWIDTH 4;
pickupZipCode 'Индекс (прием)' = DATA STRING[6](ForwardingOrderBatch) CHARWIDTH 6;
pickupCity 'Город (прием)' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;
pickupStreet 'Улица (прием)' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;
pickupBuilding 'Дом (прием)' = DATA ISTRING[20](ForwardingOrderBatch) CHARWIDTH 6;
hasPickupAddress (ForwardingOrderBatch b) = pickupRegion(b) AND pickupZipCode(b);

dropStock 'Склад разгрузки' = DATA Stock (ForwardingOrderBatch);
nameDropStock 'Склад разгрузки' (ForwardingOrderBatch b) = name(dropStock(b)) CHARWIDTH 15;
dropPlace 'Место выдачи груза' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;
// МстВыдГр: 1 - на складе грузополучателя, 2 - на складе экспедитора
dropAtForwarder 'Выдача на складе экспедитора' = DATA BOOLEAN (ForwardingOrderBatch);
dropRegion 'Код региона (выдача)' = DATA STRING[2](ForwardingOrderBatch) CHARWIDTH 4;
dropZipCode 'Индекс (выдача)' = DATA STRING[6](ForwardingOrderBatch) CHARWIDTH 6;
dropCity 'Город (выдача)' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;
dropStreet 'Улица (выдача)' = DATA ISTRING[255](ForwardingOrderBatch) CHARWIDTH 15;
dropBuilding 'Дом (выдача)' = DATA ISTRING[20](ForwardingOrderBatch) CHARWIDTH 6;
hasDropAddress (ForwardingOrderBatch b) = dropRegion(b) AND dropZipCode(b);

// склад подставляет адрес только в пустые поля: введённое вручную не затирается
// (у склада может не быть подразделения Диадока, и тогда затирание было бы потерей данных)
WHEN LOCAL CHANGED(pickupStock(ForwardingOrderBatch b)) DO {
    pickupPlace(b) <- ISTRING[255](name(pickupStock(b)));
    pickupRegion(b) <- region(pickupStock(b));
    pickupZipCode(b) <- zipCode(pickupStock(b));
    pickupCity(b) <- city(pickupStock(b));
    pickupStreet(b) <- street(pickupStock(b));
    pickupBuilding(b) <- building(pickupStock(b));
}
WHEN LOCAL CHANGED(dropStock(ForwardingOrderBatch b)) DO {
    dropPlace(b) <- ISTRING[255](name(dropStock(b)));
    dropRegion(b) <- region(dropStock(b));
    dropZipCode(b) <- zipCode(dropStock(b));
    dropCity(b) <- city(dropStock(b));
    dropStreet(b) <- street(dropStock(b));
    dropBuilding(b) <- building(dropStock(b));
}

route 'Маршрут следования груза' = DATA ISTRING[2000](ForwardingOrderBatch) CHARWIDTH 15;

// особые условия перевозки (УказКлнт)
transportInstructions 'Указания в отношении норм перевозки' = DATA ISTRING[1000](ForwardingOrderBatch) CHARWIDTH 15;
specialMarks 'Особые отметки' = DATA ISTRING[1000](ForwardingOrderBatch) CHARWIDTH 15;
speedLimits 'Ограничения скорости' = DATA ISTRING[1000](ForwardingOrderBatch) CHARWIDTH 15;
deliveryPeriodDays 'Срок доставки, суток' = DATA INTEGER (ForwardingOrderBatch);
temperatureFrom 'Температура, от °C' = DATA NUMERIC[7,2](ForwardingOrderBatch);
temperatureTo 'Температура, до °C' = DATA NUMERIC[7,2](ForwardingOrderBatch);
humidityFrom 'Влажность, от %' = DATA NUMERIC[5,2](ForwardingOrderBatch);
humidityTo 'Влажность, до %' = DATA NUMERIC[5,2](ForwardingOrderBatch);

currency 'Валюта' = DATA Currency (ForwardingOrderBatch);
nameCurrency 'Валюта' (ForwardingOrderBatch b) = name(currency(b)) CHARWIDTH 10;
declaredCost 'Объявленная стоимость груза' = DATA NUMERIC[18,2](ForwardingOrderBatch);
actualCost 'Действительная стоимость груза' = DATA NUMERIC[18,2](ForwardingOrderBatch);

WHEN LOCAL SET(ForwardingOrderBatch b IS ForwardingOrderBatch) INLINE DO {
    transportInstructions(b) <- 'Отсутствуют';
    specialMarks(b) <- 'Отсутствуют';
    currency(b) <- defaultCurrency();
}

// ------------------------- Строки груза ------------------------- //

CLASS ForwardingOrderDetail 'Груз';
TABLE forwardingOrderDetail(ForwardingOrderDetail);

batch = DATA ForwardingOrderBatch (ForwardingOrderDetail) NONULL DELETE INDEXED;
// документ строки - через партию (нужен форме списка и проверкам)
forwardingOrder (ForwardingOrderDetail d) = forwardingOrder(batch(d));
dataIndex '{document.data.index.detail.class}' = DATA INTEGER (ForwardingOrderDetail);
defaultIndex '№' (ForwardingOrderDetail d) = PARTITION SUM 1 IF d IS ForwardingOrderDetail ORDER d BY batch(d) CHARWIDTH 3;
index 'N' (ForwardingOrderDetail d) = OVERRIDE dataIndex(d), defaultIndex(d) IN id;

cargo = DATA Cargo (ForwardingOrderDetail);
nameCargo 'Груз' (ForwardingOrderDetail d) = name(cargo(d)) CHARWIDTH 15;
tnved 'Код ТН ВЭД' (ForwardingOrderDetail d) = tnved(cargo(d)) CHARWIDTH 6;
tareType = DATA TareType (ForwardingOrderDetail);
nameTareType 'Вид тары' (ForwardingOrderDetail d) = name(tareType(d)) CHARWIDTH 10;

WHEN LOCAL CHANGED(cargo(ForwardingOrderDetail d)) AND NOT CHANGED(tareType(d)) DO
    tareType(d) <- OVERRIDE tareType(cargo(d)), defaultTareType();

quantityPlaces 'Количество грузовых мест' = DATA INTEGER (ForwardingOrderDetail);
volume 'Объем, м3' = DATA NUMERIC[17,3](ForwardingOrderDetail);
netWeight 'Вес нетто, кг' = DATA NUMERIC[17,3](ForwardingOrderDetail);
grossWeight 'Вес брутто, кг' = DATA NUMERIC[17,3](ForwardingOrderDetail);
quantityPallets 'Количество паллет' = DATA INTEGER (ForwardingOrderDetail);

dangerous 'Опасный груз' = DATA BOOLEAN (ForwardingOrderDetail);          // ПрзОпаснГруз
seized 'Изъятые из оборота вещества' = DATA BOOLEAN (ForwardingOrderDetail);   // ПрзИзъятВещ
stateSystem 'Учет в гос. системе' = DATA BOOLEAN (ForwardingOrderDetail);  // УчГосСист
packaged 'Есть упаковка' = DATA BOOLEAN (ForwardingOrderDetail);           // НалУпак
banReload 'Запрет перегрузки' = DATA BOOLEAN (ForwardingOrderDetail);      // ЗапрПерегруз

// страна происхождения груза (СтрПроисх) - обязательна в титуле, код ОКСМ из справочника
country = DATA Country (ForwardingOrderDetail);
nameCountry 'Страна происхождения' (ForwardingOrderDetail d) = name(country(d)) CHARWIDTH 12;
sidCountry (ForwardingOrderDetail d) = sid(country(d));

WHEN LOCAL SET(ForwardingOrderDetail d IS ForwardingOrderDetail) AND NOT CHANGED(country(d)) DO
    country(d) <- defaultCountry();

// Марк обязателен по формату
marking = DATA CargoMarking (ForwardingOrderDetail);
nameMarking 'Маркировка' (ForwardingOrderDetail d) = name(marking(d)) CHARWIDTH 15;

WHEN LOCAL SET(ForwardingOrderDetail d IS ForwardingOrderDetail) AND NOT CHANGED(marking(d)) DO
    marking(d) <- markingAbsent();

// сведения об упаковке (СвУпак): в титуле обязательны при НалУпак = 1;
// вид упаковки - код вида тары груза (в титуле ровно 2 символа)
packagingType (ForwardingOrderDetail d) = idTareType(tareType(d));
packagingWeight 'Вес упаковки, кг' = DATA NUMERIC[17,3](ForwardingOrderDetail);
packagingCount 'Количество упаковок' = DATA INTEGER (ForwardingOrderDetail);
packagingHeight 'Высота упаковки, м' = DATA NUMERIC[17,3](ForwardingOrderDetail);
packagingLength 'Длина упаковки, м' = DATA NUMERIC[17,3](ForwardingOrderDetail);
packagingWidth 'Ширина упаковки, м' = DATA NUMERIC[17,3](ForwardingOrderDetail);

hasPackagingInfo (ForwardingOrderDetail d) = packaged(d) AND packagingType(d) AND packagingWeight(d) AND
    packagingHeight(d) AND packagingLength(d) AND packagingWidth(d);

// итоги партии (ВесГрузПарт / КолМестПарт) - выгружаются внутри CargoInfo
netWeightTotal 'Вес нетто партии, кг' (ForwardingOrderBatch b) = GROUP SUM netWeight(ForwardingOrderDetail d) BY batch(d);
grossWeightTotal 'Вес брутто партии, кг' (ForwardingOrderBatch b) = GROUP SUM grossWeight(ForwardingOrderDetail d) BY batch(d);
quantityPlacesTotal 'Мест в партии' (ForwardingOrderBatch b) = GROUP SUM quantityPlaces(ForwardingOrderDetail d) BY batch(d);
quantityPalletsTotal 'Паллет в партии' (ForwardingOrderBatch b) = GROUP SUM quantityPallets(ForwardingOrderDetail d) BY batch(d);

// ------------------------- Ответ экспедитора (титул экспедитора) ------------------------- //

registryNumber 'Номер в реестре экспедиторов' = DATA STRING[100](ForwardingOrder) CHARWIDTH 15;
registryDate 'Дата записи в реестре' = DATA DATE (ForwardingOrder);
forwarderThirdParties 'Привлеченные третьи лица' = DATA ISTRING[1000](ForwardingOrder) CHARWIDTH 15;
forwarderPaymentInfo 'Оплата услуг экспедиции' = DATA ISTRING[1000](ForwardingOrder) CHARWIDTH 15;
forwarderNotes 'Оговорки экспедитора' = DATA ISTRING[1000](ForwardingOrder) CHARWIDTH 15;

t2File 'Файл титула экспедитора (XML)' = DATA FILE (ForwardingOrder);
t2ImportedDateTime 'Дата/время загрузки ответа экспедитора' = DATA DATETIME (ForwardingOrder);
hasT2File 'Есть титул экспедитора XML' (ForwardingOrder f) = TRUE IF t2File(f);
openT2File 'Открыть файл титула экспедитора' (ForwardingOrder f) { openTitleXml(t2File(f)); } IMAGE 'open.png';
downloadT2File 'Скачать оригинал' (ForwardingOrder f) {
    WRITE CLIENT DIALOG t2File(f) TO (OVERRIDE 'Титул_экспедитора_' + number(f), 'Титул_экспедитора');
}

// ------------------------- Обмен с провайдером ЭПД ------------------------- //

provider 'Провайдер ЭПД' = DATA ETRNProvider (ForwardingOrder);
nameProvider 'Провайдер ЭПД' (ForwardingOrder f) = name(provider(f)) CHARWIDTH 15;

WHEN LOCAL SET(ForwardingOrder f IS ForwardingOrder) AND NOT CHANGED(provider(f)) INLINE DO
    provider(f) <- defaultProvider();

exchangeStatus 'Статус обмена' = DATA ETRNExchangeStatus (ForwardingOrder);
nameExchangeStatus 'Статус обмена' (ForwardingOrder f) = name(exchangeStatus(f)) CHARWIDTH 15;
providerStatus 'Статус документооборота (провайдер)' = DATA STRING[100](ForwardingOrder) CHARWIDTH 15;
exchangeMessage 'Сообщение обмена' = DATA TEXT (ForwardingOrder);

backgroundMandatory (ForwardingOrder f) = RGB(255, 236, 240) IF f IS ForwardingOrder;

// привязка события ленты провайдера к поручению (аналог etrn(ETRNEvent))
forwardingOrder = DATA ForwardingOrder (ETRNEvent) INDEXED;
seriesNumberForwardingOrder 'Поручение экспедитору' (ETRNEvent ev) =
    CONCAT '', series(forwardingOrder(ev)), number(forwardingOrder(ev)) CHARWIDTH 10;

EXTEND FORM etrnEvents
    PROPERTIES(ev) READONLY seriesNumberForwardingOrder AFTER seriesNumberETRN(ev)
;

// абстракции обмена (реализуются модулями провайдеров)
sendForwardingOrder 'Подписать и отправить поручение' ABSTRACT CASE (ForwardingOrder);       // титул клиента
importForwardingOrderT2Data 'Загрузить ответ экспедитора' ABSTRACT CASE (ForwardingOrder);   // скачивание титула экспедитора + разбор
recallForwardingOrder 'Отозвать поручение' ABSTRACT CASE (ForwardingOrder);                  // титул отзыва (реализация - позже)

processForwardingOrdersT2 'Загрузить ответы экспедиторов' () {
    FOR ForwardingOrder f IS ForwardingOrder AND roleClient(f) AND NOT t2ImportedDateTime(f) AND
        exchangeStatus(f) == ETRNExchangeStatus.completed AND provider(f) DO
        importForwardingOrderT2Data(f);
}

// ------------------------- Проверки перед отправкой ------------------------- //

missingForwardingOrderDetail (ForwardingOrderDetail d) = CONCAT ', ',
    'груз' IF NOT cargo(d),
    'количество мест' IF NOT quantityPlaces(d),
    'вес нетто' IF NOT netWeight(d),
    'вес брутто' IF NOT grossWeight(d),
    'страна происхождения' IF NOT sidCountry(d),
    'сведения об упаковке (вид тары груза, вес, габариты)' IF packaged(d) AND NOT hasPackagingInfo(d);

missingForwardingOrderDetails (ForwardingOrderBatch b) = GROUP CONCAT ('строка ' + index(ForwardingOrderDetail d) + ': ' + missingForwardingOrderDetail(d)), '; ' ORDER d BY batch(d);

missingForwardingOrderBatch (ForwardingOrderBatch b) = CONCAT ', ',
    'грузоотправитель' IF NOT shipper(b),
    'грузополучатель' IF NOT consignee(b),
    'даты готовности к отгрузке (с/по)' IF NOT (shipmentDateFrom(b) AND shipmentDateTo(b)),
    'структурный адрес приема груза: код региона и индекс' IF NOT hasPickupAddress(b),
    'структурный адрес выдачи груза: код региона и индекс' IF NOT hasDropAddress(b),
    'вид транспорта' IF NOT vehicleKind(b),
    'признак перевозки' IF NOT transportationSign(b),
    'указания в отношении норм перевозки' IF NOT transportInstructions(b),
    'особые отметки' IF NOT specialMarks(b),
    'строки груза' IF NOT (GROUP SUM 1 IF batch(ForwardingOrderDetail d) == b);

missingForwardingOrderBatches (ForwardingOrder f) = GROUP CONCAT
    ('партия ' + index(ForwardingOrderBatch b) + ': ' +
        (CONCAT '; ', missingForwardingOrderBatch(b), missingForwardingOrderDetails(b)))
    IF missingForwardingOrderBatch(b) OR missingForwardingOrderDetails(b), '; ' ORDER b BY forwardingOrder(b);

missingForwardingOrderT1 (ForwardingOrder f) = CONCAT ', ',
    'номер поручения' IF NOT number(f),
    'клиент' IF NOT client(f),
    'экспедитор' IF NOT forwarder(f),
    'договор ТЭ (наименование)' IF NOT contractName(f),
    'договор ТЭ (номер)' IF NOT contractNumber(f),
    'договор ТЭ (дата)' IF NOT contractDate(f),
    'партии груза' IF NOT (GROUP SUM 1 IF forwardingOrder(ForwardingOrderBatch b) == f),
    'подписант (ФИО)' IF NOT (signerLastName(f) AND signerFirstName(f)),
    'подписант (должность)' IF NOT signerPosition(f);

filledForwardingOrderT1 (ForwardingOrder f) = f IS ForwardingOrder AND
    NOT missingForwardingOrderT1(f) AND NOT missingForwardingOrderBatches(f);

checkForwardingOrderT1 (ForwardingOrder f) {
    IF NOT filledForwardingOrderT1(f) THEN
        MESSAGE CONCAT '
', 'Не заполнены обязательные поля поручения:',
                missingForwardingOrderT1(f), missingForwardingOrderBatches(f) NOWAIT;
}

sendForwardingOrderAction 'Отправить поручение' (ForwardingOrder f) {
    IF NOT provider(f) THEN { MESSAGE 'Для поручения не задан провайдер ЭПД' NOWAIT; RETURN; }
    // номер обязателен в титуле - подстраховка нумератором с немедленным сохранением
    // (реализация провайдера работает в своей сессии и несохранённый номер не увидит)
    IF NOT number(f) THEN NEWSESSION {
        IF NOT defaultNumeratorForwardingOrder() THEN createDefaultNumeratorForwardingOrder();
        numerator(f) <- defaultNumeratorForwardingOrder() WHERE NOT numerator(f);
        generateSeriesNumber(f);
        APPLY;
    }
    IF NOT skipFieldCheckETRN() THEN {
        checkForwardingOrderT1(f);
        IF NOT filledForwardingOrderT1(f) THEN RETURN;
    }
    sendForwardingOrder(f);
} IMAGE 'apply.png';

// ------------------------- Форма документа ------------------------- //

backgroundMandatory (ForwardingOrderBatch b) = RGB(255, 236, 240) IF b IS ForwardingOrderBatch;

FORM forwardingOrder 'Поручение экспедитору'
    OBJECTS f = ForwardingOrder PANEL
    PROPERTIES(f) nameProvider, nameExchangeStatus READONLY, providerStatus READONLY, exchangeMessage READONLY
    PROPERTIES(f) hasT2File READONLY, openT2File SHOWIF hasT2File(f), downloadT2File SHOWIF hasT2File(f)
    PROPERTIES(f) series, number BACKGROUND (backgroundMandatory(f) IF NOT number(f)), date,
                  nameClient BACKGROUND (backgroundMandatory(f) IF NOT client(f)),
                  nameForwarder BACKGROUND (backgroundMandatory(f) IF NOT forwarder(f)),
                  forwarderPhone,
                  signerLastName BACKGROUND (backgroundMandatory(f) IF NOT signerLastName(f)),
                  signerFirstName BACKGROUND (backgroundMandatory(f) IF NOT signerFirstName(f)),
                  signerMiddleName, signerPosition BACKGROUND (backgroundMandatory(f) IF NOT signerPosition(f)),
                  contractName BACKGROUND (backgroundMandatory(f) IF NOT contractName(f)),
                  contractNumber BACKGROUND (backgroundMandatory(f) IF NOT contractNumber(f)),
                  contractDate BACKGROUND (backgroundMandatory(f) IF NOT contractDate(f)),
                  documentsAttached

    OBJECTS b = ForwardingOrderBatch
    // в гриде - всё, что проверяется перед отправкой: маршрут целиком виден одной строкой
    PROPERTIES(b) index,
                  nameShipper BACKGROUND (backgroundMandatory(b) IF NOT shipper(b)),
                  nameConsignee BACKGROUND (backgroundMandatory(b) IF NOT consignee(b)),
                  shipmentDateFrom BACKGROUND (backgroundMandatory(b) IF NOT shipmentDateFrom(b)),
                  shipmentDateTo BACKGROUND (backgroundMandatory(b) IF NOT shipmentDateTo(b)),
                  namePickupStock,              
                  pickupRegion BACKGROUND (backgroundMandatory(b) IF NOT pickupRegion(b)),
                  pickupZipCode BACKGROUND (backgroundMandatory(b) IF NOT pickupZipCode(b)),
                  nameDropStock,
                  dropRegion BACKGROUND (backgroundMandatory(b) IF NOT dropRegion(b)),
                  dropZipCode BACKGROUND (backgroundMandatory(b) IF NOT dropZipCode(b)),
                  nameVehicleKind BACKGROUND (backgroundMandatory(b) IF NOT vehicleKind(b)),
                  nameTransportationSign BACKGROUND (backgroundMandatory(b) IF NOT transportationSign(b)),
                  transportInstructions BACKGROUND (backgroundMandatory(b) IF NOT transportInstructions(b)),
                  specialMarks BACKGROUND (backgroundMandatory(b) IF NOT specialMarks(b))
    // остальное - панельные реквизиты текущей партии, на вкладке «Дополнительно»
    PROPERTIES(b) PANEL batchNumber, batchId, notifyParties, transferToForwarder, bodyType,
                  pickupPlace, pickupAtForwarder, pickupCity, pickupStreet, pickupBuilding,
                  dropPlace, dropAtForwarder, dropCity, dropStreet, dropBuilding,
                  shipmentTime, shipmentTimeTo, deliveryDateFrom, deliveryDateTo, deliveryTime, deliveryTimeTo,
                  deliveryPeriodDays, route, speedLimits,
                  temperatureFrom, temperatureTo, humidityFrom, humidityTo,
                  nameCurrency, declaredCost, actualCost
    PROPERTIES(b) netWeightTotal, grossWeightTotal, quantityPlacesTotal, quantityPalletsTotal
    PROPERTIES(b) NEW, DELETE
    ORDERS index(b)
    FILTERS forwardingOrder(b) = f

    OBJECTS d = ForwardingOrderDetail
    PROPERTIES(d) index,
                  nameCargo BACKGROUND (backgroundMandatory(b) IF NOT cargo(d)),
                  nameTareType BACKGROUND (backgroundMandatory(b) IF packaged(d) AND NOT packagingType(d)), tnved,
                  quantityPlaces BACKGROUND (backgroundMandatory(b) IF NOT quantityPlaces(d)),
                  volume,
                  netWeight BACKGROUND (backgroundMandatory(b) IF NOT netWeight(d)),
                  grossWeight BACKGROUND (backgroundMandatory(b) IF NOT grossWeight(d)),
                  quantityPallets, nameCountry BACKGROUND (backgroundMandatory(b) IF NOT country(d)),
                  nameMarking, dangerous, seized, stateSystem, packaged, banReload
    // при признаке упаковки в титуле обязательны вид тары, вес и все габариты
    PROPERTIES(d) packagingWeight BACKGROUND (backgroundMandatory(b) IF packaged(d) AND NOT packagingWeight(d)),
                  packagingCount,
                  packagingHeight BACKGROUND (backgroundMandatory(b) IF packaged(d) AND NOT packagingHeight(d)),
                  packagingLength BACKGROUND (backgroundMandatory(b) IF packaged(d) AND NOT packagingLength(d)),
                  packagingWidth BACKGROUND (backgroundMandatory(b) IF packaged(d) AND NOT packagingWidth(d))
    PROPERTIES(d) NEW, DELETE
    ORDERS index(d)
    FILTERS batch(d) = b

    PROPERTIES(f) registryNumber READONLY, registryDate READONLY,
                  forwarderThirdParties READONLY,
                  forwarderPaymentInfo READONLY, forwarderNotes READONLY

    EDIT ForwardingOrder OBJECT f
;

DESIGN forwardingOrder {
    size = (1250, 800);
    OBJECTS {
        NEW header FIRST {
            alignment = STRETCH;
            NEW headerRow {
                horizontal = TRUE;
                MOVE PROPERTY(series(f));
                MOVE PROPERTY(number(f));
                MOVE PROPERTY(date(f));
            }
        }
        NEW pane {
            fill = 1;
            tabbed = TRUE;
            NEW mainTab {
                caption = 'Поручение';
                NEW partiesBox {
                    caption = 'Стороны';
                    horizontal = TRUE;
                    MOVE PROPERTY(nameClient(f));
                    MOVE PROPERTY(nameForwarder(f));
                    MOVE PROPERTY(forwarderPhone(f));
                }
                NEW signerBox {
                    caption = 'Подписант клиента';
                    horizontal = TRUE;
                    MOVE PROPERTY(signerLastName(f));
                    MOVE PROPERTY(signerFirstName(f));
                    MOVE PROPERTY(signerMiddleName(f));
                    MOVE PROPERTY(signerPosition(f));
                }
                NEW contractBox {
                    caption = 'Договор транспортной экспедиции';
                    horizontal = TRUE;
                    MOVE PROPERTY(contractName(f));
                    MOVE PROPERTY(contractNumber(f));
                    MOVE PROPERTY(contractDate(f));
                }
                NEW signsBox {
                    caption = 'Признаки';
                    horizontal = TRUE;
                    MOVE PROPERTY(documentsAttached(f));
                }
            }
            NEW batchesTab {
                caption = 'Маршруты / партии груза';
                fill = 1;
                MOVE BOX(b) { fill = 1; caption = 'Маршруты'; }
                NEW batchPane {
                    fill = 1;
                    tabbed = TRUE;
                    NEW batchCargoTab {
                        caption = 'Груз маршрута';
                        fill = 1;
                        MOVE BOX(d) { fill = 1; }
//                        NEW totalsBox {
//                            caption = 'Итоги партии';
//                            horizontal = TRUE;
//                            MOVE PROPERTY(netWeightTotal(b));
//                            MOVE PROPERTY(grossWeightTotal(b));
//                            MOVE PROPERTY(quantityPlacesTotal(b));
//                            MOVE PROPERTY(quantityPalletsTotal(b));
//                        }
                    }
                    NEW batchExtraTab {
                        caption = 'Дополнительно';
                        NEW extraRow1 {
                            horizontal = TRUE;
                            NEW batchIdBox {
                                caption = 'Партия';
                                MOVE PROPERTY(batchNumber(b));
                                MOVE PROPERTY(batchId(b));
                                MOVE PROPERTY(notifyParties(b));
                                MOVE PROPERTY(transferToForwarder(b));
                                MOVE PROPERTY(bodyType(b));
                            }
                            NEW timesBox {
                                caption = 'Время и сроки';
                                MOVE PROPERTY(shipmentTime(b));
                                MOVE PROPERTY(shipmentTimeTo(b));
                                MOVE PROPERTY(deliveryDateFrom(b));
                                MOVE PROPERTY(deliveryDateTo(b));
                                MOVE PROPERTY(deliveryTime(b));
                                MOVE PROPERTY(deliveryTimeTo(b));
                                MOVE PROPERTY(deliveryPeriodDays(b));
                            }
                            NEW costBox {
                                caption = 'Стоимость груза партии';
                                MOVE PROPERTY(nameCurrency(b));
                                MOVE PROPERTY(declaredCost(b));
                                MOVE PROPERTY(actualCost(b));
                            }
                        }
                        NEW extraRow2 {
                            horizontal = TRUE;
                            NEW pickupBox {
                                caption = 'Прием груза (погрузка)';
                                MOVE PROPERTY(pickupPlace(b));
                                MOVE PROPERTY(pickupAtForwarder(b));
                                MOVE PROPERTY(pickupCity(b));
                                MOVE PROPERTY(pickupStreet(b));
                                MOVE PROPERTY(pickupBuilding(b));
                            }
                            NEW dropBox {
                                caption = 'Выдача груза (пункт назначения)';
                                MOVE PROPERTY(dropPlace(b));
                                MOVE PROPERTY(dropAtForwarder(b));
                                MOVE PROPERTY(dropCity(b));
                                MOVE PROPERTY(dropStreet(b));
                                MOVE PROPERTY(dropBuilding(b));
                            }
                            NEW conditionsBox {
                                caption = 'Маршрут и особые условия';
                                MOVE PROPERTY(route(b));
                                MOVE PROPERTY(speedLimits(b));
                                MOVE PROPERTY(temperatureFrom(b));
                                MOVE PROPERTY(temperatureTo(b));
                                MOVE PROPERTY(humidityFrom(b));
                                MOVE PROPERTY(humidityTo(b));
                            }
                        }
                    }
                }
            }
            NEW answerTab {
                caption = 'Ответ экспедитора';
                NEW answerMain {
                    lines = 2;
                    MOVE PROPERTY(registryNumber(f));
                    MOVE PROPERTY(registryDate(f));
                    MOVE PROPERTY(forwarderThirdParties(f));
                    MOVE PROPERTY(forwarderPaymentInfo(f));
                    MOVE PROPERTY(forwarderNotes(f));
                }
            }
            NEW exchangeTab {
                caption = 'Обмен';
                NEW exchangeState {
                    lines = 3;
                    MOVE PROPERTY(nameProvider(f));
                    MOVE PROPERTY(nameExchangeStatus(f));
                    MOVE PROPERTY(providerStatus(f));
                    MOVE PROPERTY(hasT2File(f));
                    MOVE PROPERTY(openT2File(f));
                    MOVE PROPERTY(downloadT2File(f));
                }
                MOVE PROPERTY(exchangeMessage(f)) {
                    caption = 'Сообщение обмена';
                    panelCaptionVertical = TRUE;
                    fill = 1;
                    charWidth = 120;
                }
            }
        }
    }
}

// ------------------------- Форма списка ------------------------- //

FORM forwardingOrders 'Поручения экспедитору'
    OBJECTS f = ForwardingOrder LAST
    PROPERTIES(f) READONLY isClosed, series, number, date, nameClient, nameForwarder,
                           nameProvider, nameExchangeStatus, providerStatus, t2ImportedDateTime
    PROPERTIES(f) sendForwardingOrderAction SHOWIF roleClient(f),
                  importForwardingOrderT2Data SHOWIF roleClient(f),
                  close SHOWIF isOpened(f), open SHOWIF isClosed(f)
    PROPERTIES processForwardingOrdersT2() DRAW f
    PROPERTIES exchangeMessagePanel = exchangeMessage(f) READONLY PANEL
    PROPERTIES(f) NEWSESSION NEW, EDIT, DELETE

    // маршрут и его груз - одной группой объектов, то есть одним гридом:
    // реквизиты маршрута повторяются в каждой строке груза
    OBJECTS bd = (b = ForwardingOrderBatch, d = ForwardingOrderDetail)
    PROPERTIES READONLY batchNo 'Маршрут N' = index(b)
    PROPERTIES(b) READONLY nameShipper, nameConsignee, namePickupStock, nameDropStock,
                           shipmentDateFrom, shipmentDateTo
    PROPERTIES READONLY cargoNo 'Груз N' = index(d)
    PROPERTIES(d) READONLY nameCargo, quantityPlaces, volume, netWeight, grossWeight, quantityPallets
    // сортировка - по объявленным на форме алиасам, а не по самим свойствам
    ORDERS batchNo, cargoNo
    FILTERS forwardingOrder(b) = f, batch(d) = b

    FILTERGROUP openedFilter FILTER 'Открытые' isOpened(f) 'F10' DEFAULT
;

DESIGN forwardingOrders {
    NEW detailPane BEFORE TOOLBARBOX {
        tabbed = TRUE;
        fill = 1;
        MOVE BOX(bd) { fill = 1; caption = 'Маршруты и груз'; }
        NEW actionsTab {
            caption = 'Действия';
            horizontal = TRUE;
            NEW actionsButtons {
                MOVE PROPERTY(sendForwardingOrderAction(f));
                MOVE PROPERTY(importForwardingOrderT2Data(f));
                MOVE PROPERTY(processForwardingOrdersT2());
                MOVE PROPERTY(close(f));
                MOVE PROPERTY(open(f));
            }
            MOVE PROPERTY(exchangeMessagePanel) {
                caption = 'Сообщение обмена';
                fill = 1;
                panelCaptionVertical = TRUE;
            }
        }
    }
}

NAVIGATOR {
    epdNavigator {
        NEW forwardingOrders;
    }
}
