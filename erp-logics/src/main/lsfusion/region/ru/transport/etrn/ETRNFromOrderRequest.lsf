MODULE ETRNFromOrderRequest;

REQUIRE ETRNOrderRequest, ETRNOutgoing;

NAMESPACE ETRN;

// ------------------------- ЭТрН на основании заказа-заявки ------------------------- //
// Создание транспортных накладных из заказа-заявки. Заявка может содержать несколько
// пунктов выгрузки; на каждый пункт выгрузки формируется отдельная ЭТрН, в которую
// попадают только строки груза, привязанные к этому пункту (unloadingPoint(OrderDetail)).
// Погрузка предполагается из первого пункта погрузки маршрута.
// Связь заявка <- ЭТрН (многие ЭТрН к одной заявке): orderRequest(ETRN).

orderRequest = DATA OrderRequest (OutgoingETRN) INDEXED;
numberOrderRequestETRN 'Заказ-заявка (основание)' (ETRN e) = number(orderRequest(e)) CHARWIDTH 10;

countETRN 'ЭТрН заявки' (OrderRequest o) = GROUP SUM 1 BY orderRequest(ETRN e);
seriesNumbersETRN 'ЭТрН' (OrderRequest o) = GROUP CONCAT seriesNumber(ETRN e), ', ' ORDER e BY orderRequest(e) CHARWIDTH 15;

// адрес и структурный адрес первого пункта погрузки заявки (погрузка - общая для всех ЭТрН)
loadingPointAddress (OrderRequest o) = GROUP MAX address(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);
loadingPointDateTime (OrderRequest o) = GROUP MAX operationDateTime(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);
loadingPointRegion (OrderRequest o) = GROUP MAX region(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);
loadingPointZipCode (OrderRequest o) = GROUP MAX zipCode(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);
loadingPointCity (OrderRequest o) = GROUP MAX city(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);
loadingPointStreet (OrderRequest o) = GROUP MAX street(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);
loadingPointBuilding (OrderRequest o) = GROUP MAX building(OrderPoint p) IF operation(p) == OrderPointOperation.loading AND pointIndex(p) == firstLoadingPoint(orderRequest(p)) BY orderRequest(p);

// текстовое описание маршрута (все пункты) - чтобы не потерять промежуточные пункты в ЭТрН
routePointsText (OrderRequest o) = GROUP CONCAT (nameOperation(OrderPoint p) + ': ' + address(p)), '; ' ORDER pointIndex(p), p BY orderRequest(p);

// строки груза без указанного пункта выгрузки (при нескольких пунктах - препятствие созданию)
unassignedCargo (OrderRequest o) = GROUP SUM 1 IF NOT unloadingPoint(OrderDetail d) BY orderRequest(d);

// ------------------------- Перенос полей ------------------------- //

// общая часть шапки ЭТрН (одинакова для всех пунктов выгрузки заявки)
fillHeader (OrderRequest o, OutgoingETRN e) {
    orderRequest(e) <- o;

    provider(e) <- provider(o);
    currency(e) <- currency(o);
    orderNumber(e) <- number(o);
    orderDate(e) <- date(o);

    shipper(e) <- shipper(o);
    carrier(e) <- carrier(o);

    driver(e) <- driver(o);
    truck(e) <- truck(o);
    trailer(e) <- trailer(o);

    signerLastName(e) <- signerLastName(o);
    signerFirstName(e) <- signerFirstName(o);
    signerMiddleName(e) <- signerMiddleName(o);
    signerPosition(e) <- signerPosition(o);

    // подача / погрузка (первый пункт погрузки)
    declaredSupplyDateTime(e) <- supplyDateTime(o);
    weightMethod(e) <- weightMethod(o);
    supplierStock(e) <- stock(loadingPoint(o)) WHERE stock(loadingPoint(o));
    loadingAddress(e) <- loadingPointAddress(o);
    loadingRegion(e) <- loadingPointRegion(o);
    loadingZipCode(e) <- loadingPointZipCode(o);
    loadingCity(e) <- loadingPointCity(o);
    loadingStreet(e) <- loadingPointStreet(o);
    loadingBuilding(e) <- loadingPointBuilding(o);

    route(e) <- routePointsText(o);
}

// доставка - из конкретного пункта выгрузки
fillDelivery (ETRN e, OrderPoint up) {
    customerStock(e) <- stock(up) WHERE stock(up);
    deliveryAddress(e) <- address(up);
    deliveryDateTime(e) <- operationDateTime(up);
    deliveryRegion(e) <- region(up);
    deliveryZipCode(e) <- zipCode(up);
    deliveryCity(e) <- city(up);
    deliveryStreet(e) <- street(up);
    deliveryBuilding(e) <- building(up);
}

// создание ЭТрН по пункту выгрузки со своими строками груза
createETRNForPoint (OrderRequest o, OrderPoint up) {
    NEW e = OutgoingETRN {
        fillHeader(o, e);
        fillDelivery(e, up);
        FOR orderRequest(OrderDetail d) == o AND unloadingPoint(d) == up ORDER index(d), d DO NEW nd = ETRNDetail {
            etrn(nd) <- e;
            cargo(nd) <- cargo(d);
            condition(nd) <- condition(d);
            tareType(nd) <- tareType(d);
            quantityPlaces(nd) <- quantityPlaces(d);
            volume(nd) <- volume(d);
            grossWeight(nd) <- grossWeight(d);
            height(nd) <- height(d);
            length(nd) <- length(d);
            width(nd) <- width(d);
            cost(nd) <- cost(d);
        }
    }
}

// ------------------------- Действия ------------------------- //

createETRNFromOrder 'Создать ЭТрН' (OrderRequest o) {
    IF countETRN(o) THEN {
        MESSAGE CONCAT ' ', 'Для заявки уже созданы ЭТрН:', seriesNumbersETRN(o) NOWAIT;
        RETURN;
    }
    IF NOT firstLoadingPoint(o) THEN {
        MESSAGE 'В заявке нет пункта погрузки' NOWAIT;
        RETURN;
    }
    IF NOT countUnloadingPoints(o) THEN {
        MESSAGE 'В заявке нет пункта выгрузки' NOWAIT;
        RETURN;
    }
    IF unassignedCargo(o) THEN {
        MESSAGE 'Не для всех строк груза указан пункт выгрузки' NOWAIT;
        RETURN;
    }
    NEWSESSION {
        FOR operation(OrderPoint up) == OrderPointOperation.unloading AND orderRequest(up) == o DO
            createETRNForPoint(o, up);
        APPLY;
        MESSAGE CONCAT ' ', 'Создано ЭТрН по заявке:', countETRN(o) NOWAIT;
    }
} IMAGE 'add.png';

// список ЭТрН заявки (просмотр / редактирование)
FORM orderRequestETRNs 'ЭТрН заявки'
    OBJECTS o = OrderRequest PANEL
    OBJECTS e = ETRN
    PROPERTIES(e) READONLY seriesNumber, date, nameStage, roles, nameConsignee, deliveryAddress, cost
    PROPERTIES(e) NEWSESSION EDIT
    FILTERS orderRequest(e) == o
;

showETRNFromOrder 'ЭТрН заявки' (OrderRequest o) {
    SHOW orderRequestETRNs OBJECTS o = o;
}

// ------------------------- Формы ------------------------- //

EXTEND FORM orderRequests
    PROPERTIES(o) READONLY seriesNumbersETRN
    PROPERTIES(o) createETRNFromOrder TOOLBAR SHOWIF NOT countETRN(o),
                  showETRNFromOrder TOOLBAR SHOWIF countETRN(o)
;

// основание (заявка) и перечень ЭТрН на форме заявки
EXTEND FORM orderRequest
    PROPERTIES(o) READONLY seriesNumbersETRN
;

DESIGN orderRequest {
    headerRow {
        MOVE PROPERTY(seriesNumbersETRN(o));
    }
}

// основание (заявка) на форме ЭТрН
EXTEND FORM outgoingEtrn
    PROPERTIES(e) numberOrderRequestETRN READONLY
;

DESIGN outgoingEtrn {
    headerRow2 {
        MOVE PROPERTY(numberOrderRequestETRN(e));
    }
}

EXTEND FORM etrns
    PROPERTIES(e) READONLY numberOrderRequestETRN
;

DESIGN orderRequests {
    actionsButtons {
        MOVE PROPERTY (createETRNFromOrder(o));
        MOVE PROPERTY (showETRNFromOrder(o));        
    }
}
