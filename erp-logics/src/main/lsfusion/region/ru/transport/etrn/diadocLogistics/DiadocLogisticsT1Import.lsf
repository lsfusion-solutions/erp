MODULE DiadocLogisticsT1Import;

REQUIRE DiadocLogisticsEvents, ETRNTitleXmlRu;

NAMESPACE Diadoc;

// ------------------------- Загрузка полного состава входящих ЭТрН через Диадок ------------------------- //
// importIncoming: входящие перевозки создаются лентой docflow-событий (DiadocLogisticsEvents).
// importFullData: XML титула Т1 (GetEntityContent, контент в формате приказа ФНС N ЕД-7-26/1065@)
// разбирается общим parseETRNTitleXml; ParseTitleXml Диадока даёт упрощённый UserDataXml, не формат приказа.

// ------------------------- Входящие перевозки ------------------------- //

ETRN.importIncoming (ETRN.ETRNProvider p) + WHEN p == ETRN.ETRNProvider.diadoc THEN {
    ETRN.importEvents(p);
    ETRN.processETRNEvents();
}

// ------------------------- Титулы в fwd-сообщениях ------------------------- //
// Трансляция титулов грузополучателю (fwd): документооборот ведут грузоотправитель и перевозчик,
// нам приходят fwd-сообщения с копиями титулов - по одному сообщению на титул
// (Т1 - вложение ON_TRNACLGROT, Т2 - ON_TRNACLPPRIN); состав сообщения - V3/GetMessage.

fwdEntityId = DATA LOCAL STRING (INTEGER);
fwdEntityType = DATA LOCAL STRING (INTEGER);
fwdFileName = DATA LOCAL STRING (INTEGER);

FORM diadocFwdMessageEntities
    OBJECTS en = INTEGER EXTID 'Entities'
    PROPERTIES(en) fwdEntityId EXTID 'EntityId', fwdEntityType EXTID 'EntityType', fwdFileName EXTID 'FileName'
;

fwdResult = DATA LOCAL FILE ();

diadocFindFwdTitles (ETRN.ETRN e) {
    FOR [GROUP MAX TRUE IF docFunction(ETRN.ETRNEvent ev) == 'fwd' AND ETRN.etrn(ev) == e BY messageId(ev)](STRING[100] msg) DO {
        // уже опознанные сообщения не перезапрашиваем: оба титула ищутся в один проход,
        // так что второй раз в них ничего нового не найдётся
        IF NOT (fwdT1EntityId(e) AND fwdT2EntityId(e)) AND
           NOT (msg == fwdT1MessageId(e) OR msg == fwdT2MessageId(e)) THEN {
            // очистка хвоста прошлого импорта: при меньшем числе сущностей остались бы старые строки
            fwdEntityId(INTEGER i) <- NULL WHERE fwdEntityId(i);
            fwdEntityType(INTEGER i) <- NULL WHERE fwdEntityType(i);
            fwdFileName(INTEGER i) <- NULL WHERE fwdFileName(i);
            TRY {
                EXTERNAL HTTP GET url() + '/V3/GetMessage?boxId=' + receptionBoxId(e) + '&messageId=' + msg
                    HEADERS httpHeadersToken TO fwdResult;
                IMPORT diadocFwdMessageEntities JSON FROM fwdResult();
            } CATCH {
                fileToString(fwdResult(), 'UTF-8');
                MESSAGE 'Ошибка получения состава fwd-сообщения (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException()) NOWAIT;
                RETURN;
            }
            FOR STRING id == [GROUP LAST fwdEntityId(INTEGER en)
                    IF fwdEntityType(en) == 'Attachment' AND upper(fwdFileName(en)) LIKE 'ON_TRNACLGROT%' ORDER en]() DO {
                fwdT1MessageId(e) <- STRING[100](msg);
                fwdT1EntityId(e) <- STRING[100](id);
            }
            FOR STRING id == [GROUP LAST fwdEntityId(INTEGER en)
                    IF fwdEntityType(en) == 'Attachment' AND upper(fwdFileName(en)) LIKE 'ON_TRNACLPPRIN%' ORDER en]() DO {
                fwdT2MessageId(e) <- STRING[100](msg);
                fwdT2EntityId(e) <- STRING[100](id);
            }
            // Т2 = перевозчик принял груз, дальше наш Т3; этап только вперёд, как в processETRNEvent
            IF fwdT2EntityId(e) THEN
                ETRN.stage(e) <- ETRN.ETRNStage.loading WHERE NOT id(ETRN.stage(e)) >= 2;
        }
    }
}

// ------------------------- Карточка перевозчика входящей ------------------------- //
// Перевозчик - чужая организация: карточка создаётся по справочнику организаций Диадока
// (подтягивается по ИНН вместе с ящиками); констрейнты справочника не должны отменять создание -
// setNoCancelInTransaction. Приглашение в контрагенты (нужно для Т3) - при отправке Т3.

diadocEnsureCarrier (ETRN.IncomingETRN ie) {
    IF ETRN.carrier(ie) THEN RETURN;
    IF NOT ETRN.incomingCarrierInn(ie) THEN RETURN;

    IF NOT organizationInn(ETRN.incomingCarrierInn(ie)) THEN
        getOrganizationsByInn(userDiadocETRN(), ETRN.incomingCarrierInn(ie));

    FOR Organization o == organizationInn(ETRN.incomingCarrierInn(ie)) DO {
        LOCAL NESTED carrierCard = LegalEntity ();
        carrierCard() <- OVERRIDE legalEntity(o), legalEntityInn(ETRN.incomingCarrierInn(ie));
        IF NOT carrierCard() THEN NEWSESSION NESTED (carrierCard) {
            NEW l = LegalEntity {
                name(l) <- ISTRING[100](OVERRIDE shortName(o), fullName(o), ETRN.incomingCarrierName(ie));
                fullName(l) <- ISTRING[200](OVERRIDE fullName(o), shortName(o), ETRN.incomingCarrierName(ie));
                inn(l) <- ETRN.incomingCarrierInn(ie);
                dataKpp(l, currentDate()) <- kpp(o);   // КПП - историзируемое
                carrierCard() <- l;
            }
            setNoCancelInTransaction();
            apply();
        }
        legalEntity(o) <- carrierCard() WHERE NOT legalEntity(o);
        ETRN.carrier(ie) <- carrierCard() WHERE NOT ETRN.carrier(ie);
        // работает, пока живы локальные свойства разбора - вызов сразу после parseETRNTitleXml
        ETRN.fillCarrierCardFromT1(ie);
    }
}

// организация Диадока перевозчика - по идентификатору участника ЭДО из титула: при нескольких
// организациях с одним ИНН только он указывает, через какую идёт обмен. Записывается в карточку
// контрагента, чтобы дальше её использовали все отправки (diadocBox), а не только Т3
diadocFillCarrierOrganization (ETRN.IncomingETRN ie) {
    FOR Organization o == organizationParticipantId(ETRN.incomingCarrierParticipantId(ie)) AND
        LegalEntity l == ETRN.carrier(ie) DO {
        legalEntity(o) <- l WHERE NOT legalEntity(o);
        transportOrganization(l) <- o WHERE legalEntity(o) == l AND NOT transportOrganization(l);
    }
}

// ------------------------- Полный состав из титула Т1 ------------------------- //

diadocImportFullData (ETRN.ETRN e) {
    // у fwd-перевозок своего reception-документа нет - Т1 ищется по вложениям fwd-сообщений
    IF NOT (receptionDocMessageId(e) AND receptionDocEntityId(e)) THEN {
        FOR User u == userDiadocETRN() DO {
            getToken(u);
            diadocFindFwdTitles(e);
        }
    }
    // автозагрузка идёт фоном после каждого события, попытка до появления Т1 - штатный случай:
    // ошибки не в MESSAGE, а в «Сообщение обмена» документа (очищается при успехе)
    IF NOT (receptionDocMessageId(e) AND receptionDocEntityId(e)) THEN {
        ETRN.exchangeMessage(e) <- 'Автозагрузка: файл титула Т1 еще не получен от провайдера (загрузка повторится при следующей обработке событий)';
        APPLY;
        RETURN;
    }
    IF NOT receptionBoxId(e) THEN {
        ETRN.exchangeMessage(e) <- 'Автозагрузка: не найден ящик Диадока нашей организации-участника перевозки';
        APPLY;
        RETURN;
    }

    FOR User u == userDiadocETRN() DO {
        getToken(u);

        LOCAL data = RAWFILE ();
        TRY {
            EXTERNAL HTTP GET url() + '/GetEntityContent?boxId=' + receptionBoxId(e) +
                '&messageId=' + receptionDocMessageId(e) + '&entityId=' + receptionDocEntityId(e)
                HEADERS httpHeadersToken TO data;
        } CATCH {
            fileToString(FILE(data()), 'UTF-8');
            ETRN.exchangeMessage(e) <- STRING('Автозагрузка: ошибка получения контента титула Т1 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException()));
            APPLY;
            RETURN;
        }

        ETRN.titleFile(e) <- file(data(), 'xml');

        // parseETRNTitleXml выполняет свой APPLY
        ETRN.parseETRNTitleXml(e);

        FOR ETRN.IncomingETRN ie == e DO {
            diadocEnsureCarrier(ie);
            diadocFillCarrierOrganization(ie);
        }

        ETRN.titleImportedDateTime(e) <- currentDateTime();
        ETRN.exchangeMessage(e) <- NULL;
        APPLY;
    }
}

ETRN.importFullData (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    NEWSESSION {
        diadocImportFullData(e);
    }
}

// Т2 приходит отдельным fwd-сообщением уже после Т1, а автозагрузка титула к этому моменту
// отработала и больше не запускается - иначе этап так и остался бы на оформлении,
// и пользователь не увидел бы, что пора отправлять Т3
ETRN.onProcessedEvent (ETRN.ETRNEvent ev) + {
    FOR ETRN.ETRN e == ETRN.etrn(ev) AND ETRN.provider(ev) == ETRN.ETRNProvider.diadoc AND
        docFunction(ev) == 'fwd' AND fwdOnlyETRN(e) AND NOT fwdT2EntityId(e) AND hasUnknownFwdMessage(e) DO
        NEWSESSION {
            FOR User u == userDiadocETRN() DO {
                getToken(u);
                diadocFindFwdTitles(e);
            }
            APPLY;
        }
}
