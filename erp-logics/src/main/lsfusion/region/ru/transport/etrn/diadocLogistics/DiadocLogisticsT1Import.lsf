MODULE DiadocLogisticsT1Import;

REQUIRE DiadocLogisticsEvents, ETRNTitleXmlRu;

NAMESPACE Diadoc;

// ------------------------- Загрузка полного состава входящих ЭТрН через Диадок ------------------------- //
// importIncoming: входящие перевозки создаются лентой docflow-событий V5
// (DiadocLogisticsEvents.processETRNEvent) - здесь только приём + обработка событий.
// importFullData: скачивание XML титула Т1 (GetEntityContent - контент хранится в формате
// приказа ФНС N ЕД-7-26/1065@) и полный разбор общим parseETRNTitleXml (ETRNTitleXmlRu).
// ParseTitleXml Диадока не используется: он возвращает упрощённый UserDataXml,
// а общий парсер работает с исходным форматом приказа (единым для всех провайдеров).

// ------------------------- Входящие перевозки ------------------------- //
// создание документов с базовыми данными - через ленту событий и общий журнал

ETRN.importIncoming (ETRN.ETRNProvider p) + WHEN p == ETRN.ETRNProvider.diadoc THEN {
    ETRN.importEvents(p);        // 1. вычитать ленту docflow-событий в журнал
    ETRN.processETRNEvents();    // 2. обработать необработанные события (создаст входящие ЭТрН)
}

// ------------------------- Титул Т1 в fwd-сообщениях ------------------------- //
// Трансляция титулов грузополучателю (fwd): документооборот ведут грузоотправитель
// и перевозчик, нам приходят fwd-сообщения с копиями титулов - отдельное сообщение
// на каждый титул (Т1 - вложение ON_TRNACLGROT, Т2 - ON_TRNACLPPRIN) с подписями.
// Поиск: по каждому fwd-сообщению перевозки состав (V3/GetMessage), берётся вложение
// с именем файла титула Т1; координаты сохраняются в документ (fwdT1MessageId/EntityId)
// и используются общими receptionDoc*-координатами как запасной путь

fwdEntityId = DATA LOCAL STRING (INTEGER);
fwdEntityType = DATA LOCAL STRING (INTEGER);
fwdFileName = DATA LOCAL STRING (INTEGER);

FORM diadocFwdMessageEntities
    OBJECTS en = INTEGER EXTID 'Entities'
    PROPERTIES(en) fwdEntityId EXTID 'EntityId', fwdEntityType EXTID 'EntityType', fwdFileName EXTID 'FileName'
;

fwdResult = DATA LOCAL FILE ();

diadocFindFwdT1 (ETRN.ETRN e) {
    FOR [GROUP MAX TRUE IF docFunction(ETRN.ETRNEvent ev) == 'fwd' AND ETRN.etrn(ev) == e BY messageId(ev)](STRING[100] msg) DO {
        IF NOT fwdT1EntityId(e) THEN {
            // очистка результатов предыдущего импорта: если в этом сообщении сущностей меньше,
            // в "хвосте" локальных свойств остались бы строки прошлого сообщения
            fwdEntityId(INTEGER i) <- NULL WHERE fwdEntityId(i);
            fwdEntityType(INTEGER i) <- NULL WHERE fwdEntityType(i);
            fwdFileName(INTEGER i) <- NULL WHERE fwdFileName(i);
            TRY {
                EXTERNAL HTTP GET url() + '/V3/GetMessage?boxId=' + receptionBoxId(e) + '&messageId=' + msg
                    HEADERS httpHeadersToken TO fwdResult;
                IMPORT diadocFwdMessageEntities JSON FROM fwdResult();
            } CATCH {
                fileToString(fwdResult(), 'UTF-8');
                MESSAGE 'Ошибка получения состава fwd-сообщения (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
                RETURN;
            }
            FOR STRING id == [GROUP LAST fwdEntityId(INTEGER en)
                    IF fwdEntityType(en) == 'Attachment' AND upper(fwdFileName(en)) LIKE 'ON_TRNACLGROT%' ORDER en]() DO {
                fwdT1MessageId(e) <- STRING[100](msg);
                fwdT1EntityId(e) <- STRING[100](id);
            }
        }
    }
}

// ------------------------- Полный состав из титула Т1 ------------------------- //

diadocImportFullData (ETRN.ETRN e) {
    // основной путь - reception-документ; для fwd-перевозок (трансляция) Т1 ищется
    // по вложениям fwd-сообщений и попадает в те же координаты запасным значением
    IF NOT (receptionDocMessageId(e) AND receptionDocEntityId(e)) THEN {
        FOR User u == userDiadocETRN() DO {
            getToken(u);
            diadocFindFwdT1(e);
        }
    }
    IF NOT (receptionDocMessageId(e) AND receptionDocEntityId(e)) THEN {
        MESSAGE 'Нет reception-документа перевозки в Диадоке (события не получены)';
        RETURN;
    }
    IF NOT receptionBoxId(e) THEN {
        MESSAGE 'Не найден ящик Диадока нашей организации-участника перевозки';
        RETURN;
    }

    FOR User u == userDiadocETRN() DO {
        getToken(u);

        // XML титула Т1 (формат приказа ФНС)
        LOCAL data = RAWFILE ();
        TRY {
            EXTERNAL HTTP GET url() + '/GetEntityContent?boxId=' + receptionBoxId(e) +
                '&messageId=' + receptionDocMessageId(e) + '&entityId=' + receptionDocEntityId(e)
                HEADERS httpHeadersToken TO data;
        } CATCH {
            fileToString(FILE(data()), 'UTF-8');
            MESSAGE 'Ошибка получения контента титула Т1 (Диадок): ' + (OVERRIDE statusHttp() + ' ' + resultString(), messageCaughtException());
            RETURN;
        }

        ETRN.titleFile(e) <- file(data(), 'xml');

        // полный разбор титула в поля документа (parseETRNTitleXml выполняет свой APPLY)
        ETRN.parseETRNTitleXml(e);

        ETRN.titleImportedDateTime(e) <- currentDateTime();
        APPLY;
    }
}

ETRN.importFullData (ETRN.ETRN e) + WHEN ETRN.provider(e) == ETRN.ETRNProvider.diadoc THEN {
    NEWSESSION {
        diadocImportFullData(e);
    }
}
