MODULE DepartmentStoreStructAddressETRN;

REQUIRE StockStructAddressETRN, Store;

NAMESPACE ETRN;

// структурный адрес ЭТрН на карточке отдела магазина
EXTEND FORM departmentStore
    PROPERTIES(d) structRegion, structZipCode, structCity, structStreet, structBuilding
;

DESIGN departmentStore {
    OBJECTS {
        NEW etrnStructAddress {
            caption = 'Структурный адрес (ЭТрН)';
            lines = 3;
            MOVE PROPERTY(structRegion(d));
            MOVE PROPERTY(structZipCode(d));
            MOVE PROPERTY(structCity(d));
            MOVE PROPERTY(structStreet(d));
            MOVE PROPERTY(structBuilding(d));
        }
    }
}
