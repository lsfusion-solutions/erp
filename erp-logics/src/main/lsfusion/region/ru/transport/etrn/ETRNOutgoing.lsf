MODULE ETRNOutgoing;

REQUIRE ETRNConsignee;   // реализует хранение и полей обмена (ETRNExchange) и приемки Т3 (ETRNConsignee)

NAMESPACE ETRN;

// ------------------------- ЭТрН (исходящая) ------------------------- //
// Мы - грузоотправитель: документ создаётся у нас, реквизиты перевозчика, водителя
// и транспорта - ссылки на справочники

CLASS OutgoingETRN 'ЭТрН (исходящая)' : ETRN;
TABLE outgoingEtrn(OutgoingETRN);

direction(OutgoingETRN e) += ISTRING[10]('Исходящий') IF e IS OutgoingETRN;

// ------------------------- Нумерация ------------------------- //
// Номер присваивается нумератором (у входящих номер приходит из титула)

number '{numerator.number.numerator}' = DATA STRING[48] (OutgoingETRN) INDEXED;
number[ETRN](OutgoingETRN e) += number(e);
series '{numerator.series.numerator}' = DATA BPSTRING[2] (OutgoingETRN);
series[ETRN](OutgoingETRN e) += series(e);

WHEN useLoweredNumber() AND CHANGED(number(OutgoingETRN o))
     INLINE DO number(o) <- lower(number(o));

WHEN useUpperedSeries() AND CHANGED(series(OutgoingETRN o))
     INLINE DO series(o) <- upper(series(o));

WHEN CHANGED(number(OutgoingETRN o)) AND NOT keepNumberSpaces()
    INLINE DO number(o) <- replace(number(o), ' ', '');

numerator '{numerator.id.numerator}' = DATA Numerator (OutgoingETRN);
nameNumerator '{numerator.numerator}' (OutgoingETRN o) = name(numerator(o)) IN numbered CHARWIDTH 7;

generateSeriesNumber '{numerator.generate.number}' (OutgoingETRN o)  {
    number(o) <- curStringValue(numerator(o));
    series(o) <- series(numerator(o));
    incrementValueSession(numerator(o));
}

WHEN SETCHANGED(numerator(OutgoingETRN o)) AND
     NOT CHANGED(number(o)) AND
     NOT CHANGED(series(o))
     DO generateSeriesNumber(o);

defaultNumeratorETRN = DATA Numerator ();
nameDefaultNumeratorETRN 'Электронные транспортные накладные' = name(defaultNumeratorETRN()) IN defaultNumerator;

numerator(OutgoingETRN o) <- defaultNumeratorETRN() WHEN SET(o IS OutgoingETRN);

EXTEND FORM defaultNumerators
    PROPERTIES() nameDefaultNumeratorETRN = nameDefaultNumeratorETRN
;

loadDefaultNumerators() + {
    NEW n = Numerator {
        name(n) <- 'Электронные транспортные накладные';
        series(n) <- 'ЭТ';
        minValue(n) <- 1L;
        maxValue(n) <- 99999L;
        stringLength(n) <- 5;

        defaultNumeratorETRN() <- n;
    }
}

date '{document.date.of} {document.of.document}' = DATA DATE (OutgoingETRN) INDEXED;
date[ETRN](OutgoingETRN e) += date(e);
time '{document.time.of} {document.of.document}' = DATA TIME (OutgoingETRN);
time[ETRN](OutgoingETRN e) += time(e);

// ------------------------- Хранение общих реквизитов ------------------------- //

stage 'Этап' = DATA ETRNStage (OutgoingETRN);
stage[ETRN](OutgoingETRN e) += stage(e);
isClosed 'Закрыт' = DATA BOOLEAN (OutgoingETRN);
isClosed[ETRN](OutgoingETRN e) += isClosed(e);
orderNumber 'Номер заказа (заявки)' = DATA STRING[100](OutgoingETRN);
orderNumber[ETRN](OutgoingETRN e) += orderNumber(e);
orderDate 'Дата заказа (заявки)' = DATA DATE (OutgoingETRN);
orderDate[ETRN](OutgoingETRN e) += orderDate(e);
note 'Примечание' = DATA ISTRING[250](OutgoingETRN);
note[ETRN](OutgoingETRN e) += note(e);
currency 'Валюта стоимости' = DATA Currency (OutgoingETRN);
currency[ETRN](OutgoingETRN e) += currency(e);
shipper = DATA LegalEntity (OutgoingETRN);
shipper[ETRN](OutgoingETRN e) += shipper(e);
forwarder 'Является экспедитором' = DATA BOOLEAN (OutgoingETRN);
forwarder[ETRN](OutgoingETRN e) += forwarder(e);
consignee = DATA LegalEntity (OutgoingETRN);
consignee[ETRN](OutgoingETRN e) += consignee(e);
customerStock 'Склад грузополучателя' = DATA Stock (OutgoingETRN);
customerStock[ETRN](OutgoingETRN e) += customerStock(e);
deliveryAddress 'Адрес места доставки груза' = DATA ISTRING[350](OutgoingETRN);
deliveryAddress[ETRN](OutgoingETRN e) += deliveryAddress(e);
deliveryRegion 'Код региона (доставка)' = DATA STRING[2](OutgoingETRN);
deliveryRegion[ETRN](OutgoingETRN e) += deliveryRegion(e);
deliveryZipCode 'Индекс (доставка)' = DATA STRING[6](OutgoingETRN);
deliveryZipCode[ETRN](OutgoingETRN e) += deliveryZipCode(e);
deliveryCity 'Город (доставка)' = DATA ISTRING[255](OutgoingETRN);
deliveryCity[ETRN](OutgoingETRN e) += deliveryCity(e);
deliveryStreet 'Улица (доставка)' = DATA ISTRING[255](OutgoingETRN);
deliveryStreet[ETRN](OutgoingETRN e) += deliveryStreet(e);
deliveryBuilding 'Дом (доставка)' = DATA ISTRING[20](OutgoingETRN);
deliveryBuilding[ETRN](OutgoingETRN e) += deliveryBuilding(e);
banReload 'Запрещение перегрузки' = DATA BOOLEAN (OutgoingETRN);
banReload[ETRN](OutgoingETRN e) += banReload(e);
transportInstructions 'Указания в отношении выполнения норм перевозки' = DATA ISTRING[2000](OutgoingETRN);
transportInstructions[ETRN](OutgoingETRN e) += transportInstructions(e);
deliveryDateTime 'Дата и время доставки' = DATA DATETIME (OutgoingETRN);
deliveryDateTime[ETRN](OutgoingETRN e) += deliveryDateTime(e);
deliveryPeriod 'Срок доставки груза' = DATA ISTRING[100](OutgoingETRN);
deliveryPeriod[ETRN](OutgoingETRN e) += deliveryPeriod(e);
seals 'Сведения о запорно-пломбировочных устройствах' = DATA ISTRING[2000](OutgoingETRN);
seals[ETRN](OutgoingETRN e) += seals(e);
speedLimits 'Указания об ограничениях скорости движения' = DATA ISTRING[2000](OutgoingETRN);
speedLimits[ETRN](OutgoingETRN e) += speedLimits(e);
route 'Сведения о маршруте перевозки' = DATA ISTRING[2000](OutgoingETRN);
route[ETRN](OutgoingETRN e) += route(e);
temperatureFrom 'Нижний предел температуры, °C' = DATA NUMERIC[7,2](OutgoingETRN);
temperatureFrom[ETRN](OutgoingETRN e) += temperatureFrom(e);
temperatureTo 'Верхний предел температуры, °C' = DATA NUMERIC[7,2](OutgoingETRN);
temperatureTo[ETRN](OutgoingETRN e) += temperatureTo(e);
humidityFrom 'Нижний предел влажности, %' = DATA NUMERIC[5,2](OutgoingETRN);
humidityFrom[ETRN](OutgoingETRN e) += humidityFrom(e);
humidityTo 'Верхний предел влажности, %' = DATA NUMERIC[5,2](OutgoingETRN);
humidityTo[ETRN](OutgoingETRN e) += humidityTo(e);
redirectPerson 'Лицо, по указанию которого может осуществляться переадресовка' = DATA ETRNRedirectPerson (OutgoingETRN);
redirectPerson[ETRN](OutgoingETRN e) += redirectPerson(e);
redirectMethod 'Способ передачи указания на переадресовку' = DATA ISTRING[255](OutgoingETRN);
redirectMethod[ETRN](OutgoingETRN e) += redirectMethod(e);
redirectPhone 'Номер контактного телефона/факс' = DATA ISTRING[255](OutgoingETRN);
redirectPhone[ETRN](OutgoingETRN e) += redirectPhone(e);
redirectEmail 'Адрес электронной почты' = DATA ISTRING[255](OutgoingETRN);
redirectEmail[ETRN](OutgoingETRN e) += redirectEmail(e);
redirectContacts 'Иные контактные данные' = DATA ISTRING[255](OutgoingETRN);
redirectContacts[ETRN](OutgoingETRN e) += redirectContacts(e);
redirectDocName 'Наименование документа' = DATA ISTRING[255](OutgoingETRN);
redirectDocName[ETRN](OutgoingETRN e) += redirectDocName(e);
redirectDocNumber 'Номер документа' = DATA ISTRING[255](OutgoingETRN);
redirectDocNumber[ETRN](OutgoingETRN e) += redirectDocNumber(e);
redirectDocDate 'Дата документа' = DATA DATE (OutgoingETRN);
redirectDocDate[ETRN](OutgoingETRN e) += redirectDocDate(e);
redirectDocFileId 'Идентификатор файла документа' = DATA ISTRING[255](OutgoingETRN);
redirectDocFileId[ETRN](OutgoingETRN e) += redirectDocFileId(e);
redirectDocInfo 'Дополнительные сведения' = DATA ISTRING[1000](OutgoingETRN);
redirectDocInfo[ETRN](OutgoingETRN e) += redirectDocInfo(e);
declaredSupplyDateTime 'Заявленные дата и время подачи' = DATA DATETIME (OutgoingETRN);
declaredSupplyDateTime[ETRN](OutgoingETRN e) += declaredSupplyDateTime(e);
arrivalDateTime 'Фактические дата и время прибытия' = DATA DATETIME (OutgoingETRN);
arrivalDateTime[ETRN](OutgoingETRN e) += arrivalDateTime(e);
departureDateTime 'Фактические дата и время убытия' = DATA DATETIME (OutgoingETRN);
departureDateTime[ETRN](OutgoingETRN e) += departureDateTime(e);
supplierStock 'Склад погрузки' = DATA Stock (OutgoingETRN);
supplierStock[ETRN](OutgoingETRN e) += supplierStock(e);
loadingAddress 'Адрес места погрузки' = DATA ISTRING[350](OutgoingETRN);
loadingAddress[ETRN](OutgoingETRN e) += loadingAddress(e);
loadingRegion 'Код региона (погрузка)' = DATA STRING[2](OutgoingETRN);
loadingRegion[ETRN](OutgoingETRN e) += loadingRegion(e);
loadingZipCode 'Индекс (погрузка)' = DATA STRING[6](OutgoingETRN);
loadingZipCode[ETRN](OutgoingETRN e) += loadingZipCode(e);
loadingCity 'Город (погрузка)' = DATA ISTRING[255](OutgoingETRN);
loadingCity[ETRN](OutgoingETRN e) += loadingCity(e);
loadingStreet 'Улица (погрузка)' = DATA ISTRING[255](OutgoingETRN);
loadingStreet[ETRN](OutgoingETRN e) += loadingStreet(e);
loadingBuilding 'Дом (погрузка)' = DATA ISTRING[20](OutgoingETRN);
loadingBuilding[ETRN](OutgoingETRN e) += loadingBuilding(e);
acceptGrossWeight 'Масса брутто груза, кг' = DATA NUMERIC[17,3](OutgoingETRN);
acceptGrossWeight[ETRN](OutgoingETRN e) += acceptGrossWeight(e);
weightMethod 'Метод определения массы груза' = DATA ETRNWeightMethod (OutgoingETRN);
weightMethod[ETRN](OutgoingETRN e) += weightMethod(e);
acceptQuantityPlaces 'Количество грузовых мест' = DATA INTEGER (OutgoingETRN);
acceptQuantityPlaces[ETRN](OutgoingETRN e) += acceptQuantityPlaces(e);
containerCondition 'Фактическое состояние тары' = DATA ISTRING[255](OutgoingETRN);
containerCondition[ETRN](OutgoingETRN e) += containerCondition(e);
packageCondition 'Фактическое состояние упаковки' = DATA ISTRING[255](OutgoingETRN);
packageCondition[ETRN](OutgoingETRN e) += packageCondition(e);
bodyCondition 'Фактическое состояние кузова' = DATA ISTRING[255](OutgoingETRN);
bodyCondition[ETRN](OutgoingETRN e) += bodyCondition(e);
loaderIsShipper 'Погрузку осуществляет грузоотправитель' = DATA BOOLEAN (OutgoingETRN);
loaderIsShipper[ETRN](OutgoingETRN e) += loaderIsShipper(e);
loader 'Лицо, осуществляющее погрузку груза' = DATA LegalEntity (OutgoingETRN);
loader[ETRN](OutgoingETRN e) += loader(e);
loaderInfo 'Сведения о лице, осуществляющем погрузку' = DATA ISTRING[500](OutgoingETRN);
loaderInfo[ETRN](OutgoingETRN e) += loaderInfo(e);
infrastructureOwnerIsShipper 'Владелец инфраструктуры - грузоотправитель' = DATA BOOLEAN (OutgoingETRN);
infrastructureOwnerIsShipper[ETRN](OutgoingETRN e) += infrastructureOwnerIsShipper(e);
infrastructureOwnerUnknown 'Владелец инфраструктуры неизвестен' = DATA BOOLEAN (OutgoingETRN);
infrastructureOwnerUnknown[ETRN](OutgoingETRN e) += infrastructureOwnerUnknown(e);
infrastructureOwner 'Владелец объекта инфраструктуры пункта погрузки' = DATA LegalEntity (OutgoingETRN);
infrastructureOwner[ETRN](OutgoingETRN e) += infrastructureOwner(e);
infrastructureOwnerInfo 'Сведения о владельце объекта инфраструктуры' = DATA ISTRING[500](OutgoingETRN);
infrastructureOwnerInfo[ETRN](OutgoingETRN e) += infrastructureOwnerInfo(e);
infrastructureOwnerNoInfo 'Обстоятельства отсутствия информации о владельце' = DATA ISTRING[1000](OutgoingETRN);
infrastructureOwnerNoInfo[ETRN](OutgoingETRN e) += infrastructureOwnerNoInfo(e);

// ------------------------- Перевозчик, водитель, транспорт ------------------------- //

carrier = DATA LegalEntity (OutgoingETRN);
carrier[ETRN](OutgoingETRN e) += carrier(e);

driver 'Водитель' = DATA Driver (OutgoingETRN);
truck 'Транспортное средство' = DATA Truck (OutgoingETRN);
trailer 'Прицеп' = DATA Trailer (OutgoingETRN);

WHEN LOCAL CHANGED(truck(OutgoingETRN e)) AND NOT CHANGED(trailer(e)) DO
    trailer(e) <- defaultTrailer(truck(e));

// отображаемые реквизиты - реализации от справочников
nameCarrier(OutgoingETRN e) += ISTRING[150](name(carrier(e))) IF e IS OutgoingETRN;
carrierPhone(OutgoingETRN e) += ISTRING[100](phone(carrier(e))) IF e IS OutgoingETRN;
shortNameDriver(OutgoingETRN e) += ISTRING[150](shortName(driver(e))) IF e IS OutgoingETRN;
driverPhone(OutgoingETRN e) += ISTRING[100](phone(driver(e))) IF e IS OutgoingETRN;
driverLicenseSeries(OutgoingETRN e) += licenseSeries(driver(e)) IF e IS OutgoingETRN;
driverLicenseNumber(OutgoingETRN e) += licenseNumber(driver(e)) IF e IS OutgoingETRN;
driverLicenseDate(OutgoingETRN e) += licenseDate(driver(e)) IF e IS OutgoingETRN;
driverInn(OutgoingETRN e) += inn(driver(e)) IF e IS OutgoingETRN;
nameTruck(OutgoingETRN e) += ISTRING[150](name(truck(e))) IF e IS OutgoingETRN;
truckSid(OutgoingETRN e) += sid(truck(e)) IF e IS OutgoingETRN;
truckType(OutgoingETRN e) += type(truck(e)) IF e IS OutgoingETRN;
truckModelName(OutgoingETRN e) += ISTRING[50](nameTruckModel(truck(e))) IF e IS OutgoingETRN;
truckWeight(OutgoingETRN e) += weight(truck(e)) IF e IS OutgoingETRN;
truckCapacity(OutgoingETRN e) += capacity(truck(e)) IF e IS OutgoingETRN;
truckOwnership(OutgoingETRN e) += ISTRING[50](nameOwnershipType(truck(e))) IF e IS OutgoingETRN;
nameTrailer(OutgoingETRN e) += ISTRING[150](name(trailer(e))) IF e IS OutgoingETRN;
trailerSid(OutgoingETRN e) += ISTRING[20](sid(trailer(e))) IF e IS OutgoingETRN;
trailerType(OutgoingETRN e) += type(trailer(e)) IF e IS OutgoingETRN;
trailerModelName(OutgoingETRN e) += ISTRING[50](nameTruckModel(trailer(e))) IF e IS OutgoingETRN;
trailerWeight(OutgoingETRN e) += weight(trailer(e)) IF e IS OutgoingETRN;
trailerCapacity(OutgoingETRN e) += capacity(trailer(e)) IF e IS OutgoingETRN;
trailerOwnership(OutgoingETRN e) += ISTRING[50](nameOwnershipType(trailer(e))) IF e IS OutgoingETRN;

// формат титула требует у водителя либо ВУ (серия, номер, дата), либо ИНН
missingDriverId (OutgoingETRN e) = driver(e) AND NOT (licenseSeries(driver(e)) AND licenseNumber(driver(e)) AND licenseDate(driver(e))) AND NOT inn(driver(e));

// документ-основание владения при аренде/лизинге (обязателен в титуле при Ownership 3/4)
needRentGroundTruck (OutgoingETRN e) = needRentGround(truck(e));
truckRentDocName 'Основание владения: наименование' (OutgoingETRN e) = rentDocName(truck(e)) CHARWIDTH 15;
truckRentDocNumber 'Основание владения: номер' (OutgoingETRN e) = rentDocNumber(truck(e)) CHARWIDTH 12;
truckRentDocDate 'Основание владения: дата' (OutgoingETRN e) = rentDocDate(truck(e));
truckRentLessorInn 'ИНН арендодателя' (OutgoingETRN e) = rentLessorInn(truck(e)) CHARWIDTH 12;

needRentGroundTrailer (OutgoingETRN e) = needRentGround(trailer(e));
trailerRentDocName 'Основание владения: наименование' (OutgoingETRN e) = rentDocName(trailer(e)) CHARWIDTH 15;
trailerRentDocNumber 'Основание владения: номер' (OutgoingETRN e) = rentDocNumber(trailer(e)) CHARWIDTH 12;
trailerRentDocDate 'Основание владения: дата' (OutgoingETRN e) = rentDocDate(trailer(e));
trailerRentLessorInn 'ИНН арендодателя' (OutgoingETRN e) = rentLessorInn(trailer(e)) CHARWIDTH 12;


// ------------------------- Форма документа ------------------------- //

FORM outgoingEtrn 'Электронная транспортная накладная (исходящая)'
    OBJECTS e = OutgoingETRN PANEL
    PROPERTIES(e) nameStage, roles
    PROPERTIES(e) READONLYIF readonlyT1(e)
                  series, number BACKGROUND (backgroundMandatoryT1(e) IF NOT number(e)), date, time, orderNumber,
                  orderDate BACKGROUND (backgroundMandatoryT1(e) IF NOT orderDate(e)),
                  nameCurrency, note,
                  nameShipper BACKGROUND (backgroundMandatoryT1(e) IF NOT shipper(e)),
                  shipperPhone BACKGROUND (backgroundMandatoryT1(e) IF shipper(e) AND NOT shipperPhone(e)),
                  forwarder,
                  nameConsignee BACKGROUND (backgroundMandatoryT1(e) IF NOT consignee(e)),
                  consigneePhone BACKGROUND (backgroundMandatoryT1(e) IF consignee(e) AND NOT consigneePhone(e)),
                  nameCustomerStock,
                  deliveryAddress BACKGROUND (backgroundMandatoryT1(e) IF NOT deliveryAddress(e)),
                  deliveryRegion BACKGROUND (backgroundMandatoryT1(e) IF NOT deliveryRegion(e)),
                  deliveryZipCode BACKGROUND (backgroundMandatoryT1(e) IF NOT deliveryZipCode(e)),
                  deliveryCity, deliveryStreet, deliveryBuilding,
                  nameCarrier BACKGROUND (backgroundMandatoryT1(e) IF NOT carrier(e)),
                  carrierPhone BACKGROUND (backgroundMandatoryT1(e) IF carrier(e) AND NOT carrierPhone(e)),
                  shortNameDriver BACKGROUND (backgroundMandatoryT1(e) IF NOT driver(e)),
                  nameTruck BACKGROUND (backgroundMandatoryT1(e) IF NOT truck(e)),
                  nameTrailer,
                  driverPhone BACKGROUND (backgroundMandatoryT1(e) IF driver(e) AND NOT driverPhone(e)),
                  driverLicenseSeries BACKGROUND (backgroundMandatoryT1(e) IF missingDriverId(e)),
                  driverLicenseNumber BACKGROUND (backgroundMandatoryT1(e) IF missingDriverId(e)),
                  driverLicenseDate BACKGROUND (backgroundMandatoryT1(e) IF missingDriverId(e)),
                  driverInn BACKGROUND (backgroundMandatoryT1(e) IF missingDriverId(e)),
                  truckSid BACKGROUND (backgroundMandatoryT1(e) IF truck(e) AND NOT truckSid(e)),
                  truckType BACKGROUND (backgroundMandatoryT1(e) IF truck(e) AND NOT truckType(e)),
                  truckModelName BACKGROUND (backgroundMandatoryT1(e) IF truck(e) AND NOT truckModelName(e)),
                  truckWeight BACKGROUND (backgroundMandatoryT1(e) IF truck(e) AND NOT truckWeight(e)),
                  truckCapacity BACKGROUND (backgroundMandatoryT1(e) IF truck(e) AND NOT truckCapacity(e)),
                  truckOwnership BACKGROUND (backgroundMandatoryT1(e) IF truck(e) AND NOT truckOwnership(e)),
                  truckRentDocName SHOWIF needRentGroundTruck(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT truckRentDocName(e)),
                  truckRentDocNumber SHOWIF needRentGroundTruck(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT truckRentDocNumber(e)),
                  truckRentDocDate SHOWIF needRentGroundTruck(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT truckRentDocDate(e)),
                  truckRentLessorInn SHOWIF needRentGroundTruck(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT truckRentLessorInn(e)),
                  trailerSid BACKGROUND (backgroundMandatoryT1(e) IF trailer(e) AND NOT trailerSid(e)),
                  trailerType BACKGROUND (backgroundMandatoryT1(e) IF trailer(e) AND NOT trailerType(e)),
                  trailerModelName BACKGROUND (backgroundMandatoryT1(e) IF trailer(e) AND NOT trailerModelName(e)),
                  trailerWeight BACKGROUND (backgroundMandatoryT1(e) IF trailer(e) AND NOT trailerWeight(e)),
                  trailerCapacity BACKGROUND (backgroundMandatoryT1(e) IF trailer(e) AND NOT trailerCapacity(e)),
                  trailerOwnership BACKGROUND (backgroundMandatoryT1(e) IF trailer(e) AND NOT trailerOwnership(e)),
                  trailerRentDocName SHOWIF needRentGroundTrailer(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT trailerRentDocName(e)),
                  trailerRentDocNumber SHOWIF needRentGroundTrailer(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT trailerRentDocNumber(e)),
                  trailerRentDocDate SHOWIF needRentGroundTrailer(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT trailerRentDocDate(e)),
                  trailerRentLessorInn SHOWIF needRentGroundTrailer(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT trailerRentLessorInn(e)),
                  banReload, transportInstructions, deliveryDateTime, deliveryPeriod,
                  seals, speedLimits, route,
                  temperatureFrom, temperatureTo, humidityFrom, humidityTo,
                  nameRedirectPerson BACKGROUND (backgroundMandatoryT1(e) IF NOT redirectPerson(e)),
                  redirectMethod,
                  redirectPhone BACKGROUND (backgroundMandatoryT1(e) IF NOT redirectPhone(e)),
                  redirectEmail, redirectContacts,
                  redirectDocName, redirectDocNumber, redirectDocDate, redirectDocFileId, redirectDocInfo,
                  declaredSupplyDateTime BACKGROUND (backgroundMandatoryT1(e) IF NOT declaredSupplyDateTime(e)),
                  arrivalDateTime BACKGROUND (backgroundMandatoryT1(e) IF NOT arrivalDateTime(e)),
                  departureDateTime BACKGROUND (backgroundMandatoryT1(e) IF NOT departureDateTime(e)),
                  nameSupplierStock,
                  loadingAddress BACKGROUND (backgroundMandatoryT1(e) IF NOT loadingAddress(e)),
                  loadingRegion BACKGROUND (backgroundMandatoryT1(e) IF NOT loadingRegion(e)),
                  loadingZipCode BACKGROUND (backgroundMandatoryT1(e) IF NOT loadingZipCode(e)),
                  loadingCity, loadingStreet, loadingBuilding,
                  acceptGrossWeight BACKGROUND (backgroundMandatoryT1(e) IF NOT acceptGrossWeight(e)),
                  nameWeightMethod BACKGROUND (backgroundMandatoryT1(e) IF NOT weightMethod(e)),
                  acceptQuantityPlaces BACKGROUND (backgroundMandatoryT1(e) IF NOT acceptQuantityPlaces(e)),
                  containerCondition, packageCondition, bodyCondition,
                  loaderIsShipper
    PROPERTIES(e) nameLoader READONLYIF readonlyT1(e) SHOWIF NOT loaderIsShipper(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT loader(e)),
                  loaderInfo READONLYIF readonlyT1(e) SHOWIF NOT loaderIsShipper(e)
    PROPERTIES(e) READONLYIF readonlyT1(e) infrastructureOwnerIsShipper, infrastructureOwnerUnknown
    PROPERTIES(e) nameInfrastructureOwner READONLYIF readonlyT1(e) SHOWIF NOT (infrastructureOwnerIsShipper(e) OR infrastructureOwnerUnknown(e)) BACKGROUND (backgroundMandatoryT1(e) IF NOT infrastructureOwner(e)),
                  infrastructureOwnerInfo READONLYIF readonlyT1(e) SHOWIF NOT (infrastructureOwnerIsShipper(e) OR infrastructureOwnerUnknown(e)),
                  infrastructureOwnerNoInfo READONLYIF readonlyT1(e) SHOWIF infrastructureOwnerUnknown(e) BACKGROUND (backgroundMandatoryT1(e) IF NOT infrastructureOwnerNoInfo(e))

    OBJECTS d = ETRNDetail
    PROPERTIES(d) READONLYIF readonlyT1(e)
                  index,
                  nameCargo BACKGROUND (backgroundMandatoryT1(e) IF NOT cargo(d)),
                  namePackageWay BACKGROUND (backgroundMandatoryT1(e) IF NOT packageWay(d)),
                  nameTareType BACKGROUND (backgroundMandatoryT1(e) IF NOT tareType(d)),
                  density,
                  nameCondition BACKGROUND (backgroundMandatoryT1(e) IF NOT condition(d)),
                  volume,
                  quantityPlaces BACKGROUND (backgroundMandatoryT1(e) IF NOT quantityPlaces(d)),
                  height, length, width, netWeight,
                  grossWeight BACKGROUND (backgroundMandatoryT1(e) IF NOT grossWeight(d)),
                  quantityPallets,
                  cost BACKGROUND (backgroundMandatoryT1(e) IF NOT cost(d)),
                  nameMarking, otherInfo
    PROPERTIES(d) NEW SHOWIF NOT readonlyT1(e), DELETE SHOWIF NOT readonlyT1(e)
    ORDERS index(d)
    FILTERS etrn(d) = e

    OBJECTS ct = ETRNDetailContainer
    PROPERTIES(ct) READONLYIF readonlyT1(e) quantity, number
    PROPERTIES(ct) NEW SHOWIF NOT readonlyT1(e), DELETE SHOWIF NOT readonlyT1(e)
    FILTERS detail(ct) = d

    OBJECTS w = ETRNWaybill
    PROPERTIES(w) READONLYIF readonlyT1(e) docName, number, date, fileId, info, innLegal, innPhysical, authority
    PROPERTIES(w) NEW SHOWIF NOT readonlyT1(e), DELETE SHOWIF NOT readonlyT1(e)
    FILTERS etrn(w) = e

    OBJECTS rp = ETRNRedirectDocParty
    PROPERTIES(rp) READONLYIF readonlyT1(e) innLegal, innPhysical, authority
    PROPERTIES(rp) NEW SHOWIF NOT readonlyT1(e), DELETE SHOWIF NOT readonlyT1(e)
    FILTERS etrn(rp) = e

    EDIT OutgoingETRN OBJECT e
;

DESIGN outgoingEtrn {
    size = (1200, 800);
    OBJECTS {
        NEW header FIRST {
            alignment = STRETCH;
            NEW headerRow1 {
                horizontal = TRUE;
                MOVE PROPERTY(nameStage(e));
                MOVE PROPERTY(roles(e));
                MOVE PROPERTY(series(e));
                MOVE PROPERTY(number(e));
                MOVE PROPERTY(date(e));
                MOVE PROPERTY(time(e));
                MOVE PROPERTY(nameCurrency(e));
            }
            NEW headerRow2 {
                horizontal = TRUE;
                MOVE PROPERTY(orderNumber(e));
                MOVE PROPERTY(orderDate(e));
                MOVE PROPERTY(note(e));
            }
        }
        NEW pane {
            fill = 1;
            tabbed = TRUE;
            NEW t1Tab {
                caption = 'Т1: Оформление (грузоотправитель)';
                NEW t1Pane {
                    fill = 1;
                    tabbed = TRUE;
                    NEW parties {
                        caption = 'Стороны';
                        NEW shipperBox {
                            caption = 'Грузоотправитель';
                            horizontal = TRUE;
                            MOVE PROPERTY(nameShipper(e));
                            MOVE PROPERTY(shipperPhone(e));
                            MOVE PROPERTY(forwarder(e));
                        }
                        NEW consigneeBox {
                            caption = 'Грузополучатель';
                            MOVE PROPERTY(nameConsignee(e));
                            MOVE PROPERTY(consigneePhone(e));
                            MOVE PROPERTY(nameCustomerStock(e));
                            MOVE PROPERTY(deliveryAddress(e));
                            NEW deliveryStructAddress {
                                caption = 'Структурный адрес доставки';
                                horizontal = TRUE;
                                MOVE PROPERTY(deliveryRegion(e));
                                MOVE PROPERTY(deliveryZipCode(e));
                                MOVE PROPERTY(deliveryCity(e));
                                MOVE PROPERTY(deliveryStreet(e));
                                MOVE PROPERTY(deliveryBuilding(e));
                            }
                        }
                        NEW carrierBox {
                            caption = 'Перевозчик';
                            NEW carrierRow {
                                horizontal = TRUE;
                                MOVE PROPERTY(nameCarrier(e));
                                MOVE PROPERTY(carrierPhone(e));
                                MOVE PROPERTY(shortNameDriver(e));
                                MOVE PROPERTY(nameTruck(e));
                                MOVE PROPERTY(nameTrailer(e));
                            }
                            NEW driverReqBox {
                                caption = 'Водитель (обязательные реквизиты)';
                                horizontal = TRUE;
                                MOVE PROPERTY(driverPhone(e));
                                MOVE PROPERTY(driverLicenseSeries(e));
                                MOVE PROPERTY(driverLicenseNumber(e));
                                MOVE PROPERTY(driverLicenseDate(e));
                                MOVE PROPERTY(driverInn(e));
                            }
                            NEW truckReqBox {
                                caption = 'Транспортное средство (обязательные реквизиты)';
                                horizontal = TRUE;
                                MOVE PROPERTY(truckSid(e));
                                MOVE PROPERTY(truckType(e));
                                MOVE PROPERTY(truckModelName(e));
                                MOVE PROPERTY(truckWeight(e));
                                MOVE PROPERTY(truckCapacity(e));
                                MOVE PROPERTY(truckOwnership(e));
                            }
                            NEW truckRentBox {
                                caption = 'ТС: документ-основание владения (аренда/лизинг)';
                                horizontal = TRUE;
                                MOVE PROPERTY(truckRentDocName(e));
                                MOVE PROPERTY(truckRentDocNumber(e));
                                MOVE PROPERTY(truckRentDocDate(e));
                                MOVE PROPERTY(truckRentLessorInn(e));
                            }
                            NEW trailerReqBox {
                                caption = 'Прицеп (обязательные реквизиты, если указан)';
                                horizontal = TRUE;
                                MOVE PROPERTY(trailerSid(e));
                                MOVE PROPERTY(trailerType(e));
                                MOVE PROPERTY(trailerModelName(e));
                                MOVE PROPERTY(trailerWeight(e));
                                MOVE PROPERTY(trailerCapacity(e));
                                MOVE PROPERTY(trailerOwnership(e));
                            }
                            NEW trailerRentBox {
                                caption = 'Прицеп: документ-основание владения (аренда/лизинг)';
                                horizontal = TRUE;
                                MOVE PROPERTY(trailerRentDocName(e));
                                MOVE PROPERTY(trailerRentDocNumber(e));
                                MOVE PROPERTY(trailerRentDocDate(e));
                                MOVE PROPERTY(trailerRentLessorInn(e));
                            }
                        }
                        MOVE BOX(w) {
                            caption = 'Сведения о путевых листах';
                            fill = 1;
                        }
                    }
                    NEW cargoTab {
                        caption = 'Сведения о грузе';
                        MOVE BOX(d) {
                            fill = 2;
                        }
                        MOVE BOX(ct) {
                            caption = 'Сведения о контейнерах';
                            fill = 1;
                        }
                    }
                    NEW instructionsTab {
                        caption = 'Указания грузоотправителя';
                        lines = 2;
                        MOVE PROPERTY(banReload(e));
                        MOVE PROPERTY(transportInstructions(e));
                        MOVE PROPERTY(deliveryDateTime(e));
                        MOVE PROPERTY(deliveryPeriod(e));
                        MOVE PROPERTY(seals(e));
                        MOVE PROPERTY(speedLimits(e));
                        MOVE PROPERTY(route(e));
                        NEW climate {
                            caption = 'Климатический режим перевозки';
                            horizontal = TRUE;
                            MOVE PROPERTY(temperatureFrom(e));
                            MOVE PROPERTY(temperatureTo(e));
                            MOVE PROPERTY(humidityFrom(e));
                            MOVE PROPERTY(humidityTo(e));
                        }
                    }
                    NEW redirectTab {
                        caption = 'Переадресовка';
                        NEW redirectMain {
                            lines = 2;
                            MOVE PROPERTY(nameRedirectPerson(e));
                            MOVE PROPERTY(redirectMethod(e));
                        }
                        NEW redirectContactsBox {
                            caption = 'Контакты лица, по указанию которого может осуществляться переадресовка';
                            horizontal = TRUE;
                            MOVE PROPERTY(redirectPhone(e));
                            MOVE PROPERTY(redirectEmail(e));
                            MOVE PROPERTY(redirectContacts(e));
                        }
                        NEW redirectDocBox {
                            caption = 'Реквизиты документа, подтверждающего передачу полномочий по переадресовке';
                            lines = 3;
                            MOVE PROPERTY(redirectDocName(e));
                            MOVE PROPERTY(redirectDocNumber(e));
                            MOVE PROPERTY(redirectDocDate(e));
                            MOVE PROPERTY(redirectDocFileId(e));
                            MOVE PROPERTY(redirectDocInfo(e));
                        }
                        MOVE BOX(rp) {
                            caption = 'Идентифицирующие реквизиты сторон, составивших документ';
                            fill = 1;
                        }
                    }
                    NEW acceptTab {
                        caption = 'Погрузка (прием груза перевозчиком)';
                        NEW loadingPlace {
                            caption = 'Место погрузки';
                            MOVE PROPERTY(nameSupplierStock(e));
                            MOVE PROPERTY(loadingAddress(e));
                            NEW loadingStructAddress {
                                caption = 'Структурный адрес погрузки';
                                horizontal = TRUE;
                                MOVE PROPERTY(loadingRegion(e));
                                MOVE PROPERTY(loadingZipCode(e));
                                MOVE PROPERTY(loadingCity(e));
                                MOVE PROPERTY(loadingStreet(e));
                                MOVE PROPERTY(loadingBuilding(e));
                            }
                        }
                        NEW acceptDates {
                            caption = 'Подача транспортного средства';
                            horizontal = TRUE;
                            MOVE PROPERTY(declaredSupplyDateTime(e));
                            MOVE PROPERTY(arrivalDateTime(e));
                            MOVE PROPERTY(departureDateTime(e));
                        }
                        NEW acceptParams {
                            lines = 3;
                            MOVE PROPERTY(acceptGrossWeight(e));
                            MOVE PROPERTY(nameWeightMethod(e));
                            MOVE PROPERTY(acceptQuantityPlaces(e));
                            MOVE PROPERTY(containerCondition(e));
                            MOVE PROPERTY(packageCondition(e));
                            MOVE PROPERTY(bodyCondition(e));
                        }
                        NEW loaderBox {
                            caption = 'Лицо, осуществляющее погрузку груза';
                            horizontal = TRUE;
                            MOVE PROPERTY(loaderIsShipper(e));
                            MOVE PROPERTY(nameLoader(e));
                            MOVE PROPERTY(loaderInfo(e));
                        }
                        NEW infrastructureBox {
                            caption = 'Владелец объекта инфраструктуры пункта погрузки';
                            lines = 2;
                            MOVE PROPERTY(infrastructureOwnerIsShipper(e));
                            MOVE PROPERTY(infrastructureOwnerUnknown(e));
                            MOVE PROPERTY(nameInfrastructureOwner(e));
                            MOVE PROPERTY(infrastructureOwnerInfo(e));
                            MOVE PROPERTY(infrastructureOwnerNoInfo(e));
                        }
                    }
                }
            }
        }
    }
}


// вручную создаётся только исходящая: входящие появляются приёмом из ЭПД
addOutgoingETRN 'Добавить' () {
    NEWSESSION {
        NEW e = OutgoingETRN {
            SHOW outgoingEtrn OBJECTS e = e DOCKED;
        }
    }
} IMAGE 'add.png' CHANGEKEY 'INSERT';

EXTEND FORM etrns
    PROPERTIES addOutgoingETRN() DRAW e TOOLBAR
;

// ------------------------- Хранение полей обмена и приемки Т3 ------------------------- //
// (объявлены ABSTRACT в модулях ETRNExchange и ETRNConsignee)

provider 'Провайдер ЭПД' = DATA ETRNProvider (OutgoingETRN);
provider[ETRN](OutgoingETRN e) += provider(e);
exchangeStatus 'Статус обмена' = DATA ETRNExchangeStatus (OutgoingETRN);
exchangeStatus[ETRN](OutgoingETRN e) += exchangeStatus(e);
signerLastName 'Подписант: фамилия' = DATA ISTRING[60](OutgoingETRN);
signerLastName[ETRN](OutgoingETRN e) += signerLastName(e);
signerFirstName 'Подписант: имя' = DATA ISTRING[60](OutgoingETRN);
signerFirstName[ETRN](OutgoingETRN e) += signerFirstName(e);
signerMiddleName 'Подписант: отчество' = DATA ISTRING[60](OutgoingETRN);
signerMiddleName[ETRN](OutgoingETRN e) += signerMiddleName(e);
signerPosition 'Подписант: должность' = DATA ISTRING[128](OutgoingETRN);
signerPosition[ETRN](OutgoingETRN e) += signerPosition(e);
transportationId 'ИД перевозки у провайдера' = DATA STRING[36](OutgoingETRN) INDEXED;
transportationId[ETRN](OutgoingETRN e) += transportationId(e);
mintransId 'УИД Минтранса (ГИС ЭПД)' = DATA STRING[255](OutgoingETRN);
mintransId[ETRN](OutgoingETRN e) += mintransId(e);
providerStatus 'Статус перевозки (провайдер)' = DATA STRING[100](OutgoingETRN);
providerStatus[ETRN](OutgoingETRN e) += providerStatus(e);
exchangeMessage 'Сообщение обмена' = DATA TEXT (OutgoingETRN);
exchangeMessage[ETRN](OutgoingETRN e) += exchangeMessage(e);
titleFile 'Файл титула (XML)' = DATA FILE (OutgoingETRN);
titleFile[ETRN](OutgoingETRN e) += titleFile(e);
printForm 'Печатная форма (PDF)' = DATA FILE (OutgoingETRN);
printForm[ETRN](OutgoingETRN e) += printForm(e);
titleImportedDateTime 'Дата/время загрузки данных титула' = DATA DATETIME (OutgoingETRN);
titleImportedDateTime[ETRN](OutgoingETRN e) += titleImportedDateTime(e);
acceptResult 'Итог приемки' = DATA ETRNAcceptResult (OutgoingETRN);
acceptResult[ETRN](OutgoingETRN e) += acceptResult(e);
rejectReason 'Причина отказа в приеме груза' = DATA ISTRING[2000](OutgoingETRN);
rejectReason[ETRN](OutgoingETRN e) += rejectReason(e);
unloadingDeclaredDateTime 'Заявленные дата и время прибытия под выгрузку' = DATA DATETIME (OutgoingETRN);
unloadingDeclaredDateTime[ETRN](OutgoingETRN e) += unloadingDeclaredDateTime(e);
unloadingArrivalDateTime 'Фактические дата и время прибытия под выгрузку' = DATA DATETIME (OutgoingETRN);
unloadingArrivalDateTime[ETRN](OutgoingETRN e) += unloadingArrivalDateTime(e);
unloadingDepartureDateTime 'Фактические дата и время убытия' = DATA DATETIME (OutgoingETRN);
unloadingDepartureDateTime[ETRN](OutgoingETRN e) += unloadingDepartureDateTime(e);
unloadingWeightMethod 'Метод определения массы груза' = DATA ETRNWeightMethod (OutgoingETRN);
unloadingWeightMethod[ETRN](OutgoingETRN e) += unloadingWeightMethod(e);
acceptedQuantityPlaces 'Общее количество принятых грузовых мест' = DATA INTEGER (OutgoingETRN);
acceptedQuantityPlaces[ETRN](OutgoingETRN e) += acceptedQuantityPlaces(e);
acceptedCondition 'Общие сведения о фактическом состоянии груза, тары, упаковки, маркировки и опломбирования' = DATA STRING (OutgoingETRN);
acceptedCondition[ETRN](OutgoingETRN e) += acceptedCondition(e);
acceptedGrossWeight 'Масса брутто принятого груза, кг' = DATA NUMERIC[17,3](OutgoingETRN);
acceptedGrossWeight[ETRN](OutgoingETRN e) += acceptedGrossWeight(e);
acceptedNetWeight 'Масса нетто принятого груза, кг' = DATA NUMERIC[17,3](OutgoingETRN);
acceptedNetWeight[ETRN](OutgoingETRN e) += acceptedNetWeight(e);
acceptedVolume 'Объем грузовых мест, м3' = DATA NUMERIC[17,3](OutgoingETRN);
acceptedVolume[ETRN](OutgoingETRN e) += acceptedVolume(e);
unloadingAddress 'Адрес места выгрузки' = DATA ISTRING[350](OutgoingETRN);
unloadingAddress[ETRN](OutgoingETRN e) += unloadingAddress(e);

// ------------------------- Проверки и отправка титула Т1 ------------------------- //
// (перенесено из ETRNExchange: проверки читают реквизиты перевозчика/водителя/ТС исходящей)

missingT1 (OutgoingETRN e) = CONCAT ', ',
    'номер документа' IF NOT seriesNumber(e),
    'дата заказа (заявки)' IF NOT orderDate(e),
    'грузоотправитель' IF NOT shipper(e),
    'телефон грузоотправителя' IF shipper(e) AND NOT phone(shipper(e)),
    'подписант титулов (ФИО)' IF NOT (signerLastName(e) AND signerFirstName(e)),
    'подписант титулов (должность)' IF NOT signerPosition(e),
    'грузополучатель' IF NOT consignee(e),
    'телефон грузополучателя' IF consignee(e) AND NOT phone(consignee(e)),
    'адрес места доставки груза' IF NOT deliveryAddress(e),
    'код региона места доставки' IF NOT deliveryRegion(e),
    'почтовый индекс места доставки' IF NOT deliveryZipCode(e),
    'перевозчик' IF NOT carrier(e),
    'телефон перевозчика' IF carrier(e) AND NOT phone(carrier(e)),
    'водитель' IF NOT driver(e),
    'телефон водителя' IF driver(e) AND NOT phone(driver(e)),
    'ВУ (серия, номер, дата) или ИНН водителя' IF driver(e) AND NOT (licenseSeries(driver(e)) AND licenseNumber(driver(e)) AND licenseDate(driver(e))) AND NOT inn(driver(e)),
    'транспортное средство' IF NOT truck(e),
    'рег. номер ТС' IF truck(e) AND NOT sid(truck(e)),
    'тип ТС' IF truck(e) AND NOT type(truck(e)),
    'марка ТС' IF truck(e) AND NOT truckModel(truck(e)),
    'грузоподъемность ТС' IF truck(e) AND NOT weight(truck(e)),
    'вместимость ТС' IF truck(e) AND NOT capacity(truck(e)),
    'тип владения ТС' IF truck(e) AND NOT ownershipType(truck(e)),
    'документ-основание владения ТС (аренда/лизинг): наименование, номер, дата, ИНН арендодателя' IF needRentGround(truck(e)) AND NOT hasRentGround(truck(e)),
    'рег. номер прицепа' IF trailer(e) AND NOT sid(trailer(e)),
    'тип прицепа' IF trailer(e) AND NOT type(trailer(e)),
    'марка прицепа' IF trailer(e) AND NOT truckModel(trailer(e)),
    'грузоподъемность прицепа' IF trailer(e) AND NOT weight(trailer(e)),
    'вместимость прицепа' IF trailer(e) AND NOT capacity(trailer(e)),
    'тип владения прицепа' IF trailer(e) AND NOT ownershipType(trailer(e)),
    'документ-основание владения прицепом (аренда/лизинг): наименование, номер, дата, ИНН арендодателя' IF needRentGround(trailer(e)) AND NOT hasRentGround(trailer(e)),
    'лицо, по указанию которого может осуществляться переадресовка' IF NOT redirectPerson(e),
    'контактный телефон лица переадресовки' IF NOT redirectPhone(e),
    'заявленные дата и время подачи' IF NOT declaredSupplyDateTime(e),
    'фактические дата и время прибытия' IF NOT arrivalDateTime(e),
    'фактические дата и время убытия' IF NOT departureDateTime(e),
    'масса брутто груза (прием перевозчиком)' IF NOT acceptGrossWeight(e),
    'метод определения массы груза' IF NOT weightMethod(e),
    'количество грузовых мест (прием перевозчиком)' IF NOT acceptQuantityPlaces(e),
    'адрес места погрузки' IF NOT loadingAddress(e),
    'код региона места погрузки' IF NOT loadingRegion(e),
    'почтовый индекс места погрузки' IF NOT loadingZipCode(e),
    'лицо, осуществляющее погрузку' IF NOT loaderIsShipper(e) AND NOT loader(e),
    'владелец объекта инфраструктуры пункта погрузки' IF NOT infrastructureOwnerIsShipper(e) AND NOT infrastructureOwnerUnknown(e) AND NOT infrastructureOwner(e),
    'обстоятельства отсутствия информации о владельце инфраструктуры' IF infrastructureOwnerUnknown(e) AND NOT infrastructureOwnerNoInfo(e),
    'сведения о грузе (нет ни одной строки)' IF NOT [GROUP SUM 1 BY etrn(ETRNDetail d)](e);

checkT1 (OutgoingETRN e) {
    IF missingT1(e) OR missingDetailsT1(e) THEN {
        MESSAGE CONCAT '\n', 'Не заполнены обязательные поля титула Т1:', missingT1(e), missingDetailsT1(e) NOWAIT;
        RETURN;
    }
}

filledT1 (OutgoingETRN e) = e IS OutgoingETRN AND NOT missingT1(e) AND NOT missingDetailsT1(e);

sendSignedETRN 'Подписать и отправить Т1' (ETRN e) {
    checkProvider(e);
    IF NOT provider(e) THEN RETURN;
    FOR OutgoingETRN oe == e DO {
        // номер присваивается при отправке (до этого ЭТрН - черновик), но должен уйти в титул;
        // сохраняем сразу: реализация провайдера работает в своей сессии и несохранённого не увидит
        IF NOT number(oe) THEN NEWSESSION {
            numerator(oe) <- defaultNumeratorETRN() WHERE NOT numerator(oe);
            generateSeriesNumber(oe);
            APPLY;
        }
        IF NOT skipFieldCheckETRN() THEN {
            checkT1(oe);
            IF NOT filledT1(oe) THEN RETURN;
        }
        sendSigned(oe);
    }
} IMAGE 'apply.png';

EXTEND FORM etrns
    PROPERTIES(e) sendSignedETRN SHOWIF (roleShipper(e) AND NOT readonlyT1(e))
;

DESIGN etrns {
    actionsT1 {
        MOVE PROPERTY(sendSignedETRN(e));
    }
}

// ------------------------- Вкладка «Обмен» ------------------------- //

EXTEND FORM outgoingEtrn
    PROPERTIES(e) nameProvider, nameExchangeStatus READONLY, transportationId READONLY,
                  mintransId READONLY, providerStatus READONLY, exchangeMessage READONLY,
                  hasTitleFile READONLY, openTitleFile SHOWIF hasTitleFile(e), downloadTitleFile SHOWIF hasTitleFile(e)
    PROPERTIES(e) signerLastName BACKGROUND (backgroundMandatory(e) IF NOT signerLastName(e)),
                  signerFirstName BACKGROUND (backgroundMandatory(e) IF NOT signerFirstName(e)),
                  signerMiddleName,
                  signerPosition BACKGROUND (backgroundMandatory(e) IF NOT signerPosition(e))

    OBJECTS ev = ETRNEvent
    PROPERTIES(ev) READONLY dateTime, type, status
    ORDERS dateTime(ev) DESC
    FILTERS etrn(ev) = e
;

DESIGN outgoingEtrn {
    // подписант - на вкладке «Стороны» Т1, где он нужен впервые; те же данные идут в Т3 и Т6
    parties {
        NEW signerBox AFTER shipperBox {
            caption = 'Подписант титулов';
            horizontal = TRUE;
            MOVE PROPERTY(signerLastName(e));
            MOVE PROPERTY(signerFirstName(e));
            MOVE PROPERTY(signerMiddleName(e));
            MOVE PROPERTY(signerPosition(e));
        }
    }
    pane {
        NEW exchangeTab {
            caption = 'Обмен';
            NEW exchangeState {
                lines = 3;
                MOVE PROPERTY(nameProvider(e));
                MOVE PROPERTY(nameExchangeStatus(e));
                MOVE PROPERTY(providerStatus(e));
                MOVE PROPERTY(transportationId(e));
                MOVE PROPERTY(mintransId(e));
                MOVE PROPERTY(exchangeMessage(e));
                MOVE PROPERTY(hasTitleFile(e));
                MOVE PROPERTY(openTitleFile(e));
                MOVE PROPERTY(downloadTitleFile(e));
            }
            MOVE BOX(ev) {
                caption = 'События';
                fill = 1;
            }
        }
    }
}

// ------------------------- Вкладка «Т3: Приемка» ------------------------- //

EXTEND FORM outgoingEtrn
    PROPERTIES(e) READONLYIF readonlyT3(e)
                  nameAcceptResult BACKGROUND (backgroundMandatory(e) IF NOT acceptResult(e)),
                  rejectReason BACKGROUND (backgroundMandatory(e) IF acceptResult(e) = ETRNAcceptResult.rejected AND NOT rejectReason(e)),
                  unloadingDeclaredDateTime BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT unloadingDeclaredDateTime(e)),
                  unloadingArrivalDateTime BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT unloadingArrivalDateTime(e)),
                  unloadingDepartureDateTime BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT unloadingDepartureDateTime(e)),
                  nameUnloadingWeightMethod,
                  acceptedQuantityPlaces BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT acceptedQuantityPlaces(e)),
                  acceptedCondition BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT acceptedCondition(e)),
                  acceptedGrossWeight BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT acceptedGrossWeight(e)),
                  acceptedNetWeight, acceptedVolume,
                  unloadingAddress BACKGROUND (backgroundMandatory(e) IF accepted(e) AND NOT unloadingAddress(e))
    OBJECTS d3 = ETRNDetail
    PROPERTIES(d3) READONLY index, nameCargo
    PROPERTIES(d3) READONLYIF readonlyT3(e)
                   acceptedCondition, acceptedQuantityPlaces, acceptedVolume,
                   acceptedNetWeight, acceptedGrossWeight, acceptedQuantityPallets
    ORDERS index(d3)
    FILTERS etrn(d3) = e
;

DESIGN outgoingEtrn {
    pane {
        NEW consigneeTab BEFORE exchangeTab {
            caption = 'Т3: Приемка (грузополучатель)';
            NEW acceptResultBox {
                caption = 'Итог приемки';
                horizontal = TRUE;
                MOVE PROPERTY(nameAcceptResult(e));
                MOVE PROPERTY(rejectReason(e));
            }
            NEW unloadingDates {
                caption = 'Подача под выгрузку';
                horizontal = TRUE;
                MOVE PROPERTY(unloadingDeclaredDateTime(e));
                MOVE PROPERTY(unloadingArrivalDateTime(e));
                MOVE PROPERTY(unloadingDepartureDateTime(e));
            }
            NEW acceptParamsT3 {
                lines = 3;
                MOVE PROPERTY(nameUnloadingWeightMethod(e));
                MOVE PROPERTY(acceptedQuantityPlaces(e));
                MOVE PROPERTY(acceptedGrossWeight(e));
                MOVE PROPERTY(acceptedNetWeight(e));
                MOVE PROPERTY(acceptedVolume(e));
                MOVE PROPERTY(unloadingAddress(e));
            }
            MOVE PROPERTY(acceptedCondition(e));
            MOVE BOX(d3) {
                caption = 'Принятый груз по отгрузочным наименованиям';
                fill = 1;
            }
        }
    }
}
