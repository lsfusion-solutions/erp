MODULE DiadocForwardingOrderT1Form;

REQUIRE ETRNForwardingOrder, LegalEntityRu, DiadocLogistics;

NAMESPACE ETRN;

// Экспортная форма UserDataXml титула клиента поручения экспедитору для Диадок API:
// GenerateTitleXml строит по ней полный XML приказа ФНС N ЕД-7-26/958@ (ПорЭксп).
// Упрощение модели: одна партия груза (CargoInfo) на поручение.

digit1 (BOOLEAN b) = IF b THEN '1' ELSE '0';

// ------------------------- Структура UserDataXml ------------------------- //

// порядок групп и свойств = порядок элементов в XML, а схема требует строгой
// последовательности: CargoInfos -> ClientInfo -> ForwarderInfo -> ForwardingContractRequisites
GROUP foOrder EXTID 'ClientForwarderOrder';

GROUP foCargoInfos EXTID 'CargoInfos' : foOrder;
GROUP foCargo EXTID 'CargoInfo' : foCargoInfos;

GROUP foConsignee EXTID 'Consignee' : foCargo;
GROUP foConsigneeOrg EXTID 'OrganizationDetails' : foConsignee;
GROUP foShipper EXTID 'Shipper' : foCargo;
GROUP foShipperOrg EXTID 'OrganizationDetails' : foShipper;

GROUP foTransportInfos EXTID 'TransportInfos' : foCargo;
GROUP foTransportInfo EXTID 'TransportInfo' : foTransportInfos;

GROUP foDirectives EXTID 'ClientDirectives' : foCargo;
GROUP foClimate EXTID 'ClimateTransportRegime' : foDirectives;

GROUP foBatchWeight EXTID 'BatchWeight' : foCargo;
GROUP foDeclaredCost EXTID 'DeclaredShipmentCost' : foCargo;
GROUP foActualCost EXTID 'ActualShipmentCost' : foCargo;

GROUP foItems EXTID 'ItemDescriptions' : foCargo;
GROUP foItemMarks EXTID 'Marks';
GROUP foItemCountry EXTID 'CargoOriginCountryInfo';
GROUP foItemWeight EXTID 'CargoWeight';
GROUP foItemPackagings EXTID 'CargoPackagingInfos';
GROUP foItemPackaging EXTID 'CargoPackagingInfo' : foItemPackagings;
GROUP foItemPackagingSize EXTID 'PackagingDimensions' : foItemPackaging;

GROUP foPickup EXTID 'CargoLocationAddress' : foCargo;
GROUP foPickupAddr EXTID 'CargoDeliveryAddress' : foPickup;
GROUP foPickupAddrInfo EXTID 'Address' : foPickupAddr;
GROUP foPickupAddrRF EXTID 'RussianAddress' : foPickupAddrInfo;

GROUP foDrop EXTID 'DestinationAddress' : foCargo;
GROUP foDropAddr EXTID 'CargoDeliveryAddress' : foDrop;
GROUP foDropAddrInfo EXTID 'Address' : foDropAddr;
GROUP foDropAddrRF EXTID 'RussianAddress' : foDropAddrInfo;

GROUP foClient EXTID 'ClientInfo' : foOrder;
GROUP foClientOrg EXTID 'OrganizationDetails' : foClient;

GROUP foForwarder EXTID 'ForwarderInfo' : foOrder;
GROUP foForwarderOrg EXTID 'OrganizationDetails' : foForwarder;

GROUP foContract EXTID 'ForwardingContractRequisites' : foOrder;

GROUP foSigners EXTID 'Signers';
GROUP foSigner EXTID 'Signer' : foSigners;
GROUP foSignerFio EXTID 'Fio' : foSigner;

FORM diadocForwardingOrderT1 FORMEXTID 'LogisticsForwardingOrderClientTitle'
    OBJECTS f = ForwardingOrder PANEL
    PROPERTIES ATTR
        foNumber = (OVERRIDE number(f), 'Без номера') EXTID 'Number',
        foDate = diadocDate(date(f)) EXTID 'Date',
        foHasCargoDocs = digit1(documentsAttached(f)) EXTID 'HasCargoDocs'
    // DocumentCreator не выгружаем: при нём схема требует DocumentCreatorBase (основание,
    // по которому мы составитель), а составитель поручения - сам клиент

    PROPERTIES ATTR IN foCargo
        foNotifyReq = digit1(notifyParties(f)) EXTID 'NotifyReq',
        foReadyFrom = diadocDate(shipmentDateFrom(f)) EXTID 'ReadyFromDate',
        foReadyTo = diadocDate(shipmentDateTo(f)) EXTID 'ReadyToDate',
        foReadyTime = toChar(shipmentTime(f), 'HH24:MI:SS') EXTID 'ReadyTime',
        foDeliveryFrom = diadocDate(deliveryDateFrom(f)) EXTID 'DeliveryFromDate',
        foDeliveryTo = diadocDate(deliveryDateTo(f)) EXTID 'DeliveryToDate',
        foDeliveryTime = toChar(deliveryTime(f), 'HH24:MI:SS') EXTID 'DeliveryTime',
        foAcceptReq = ('1' IF transferToForwarder(f)) EXTID 'AcceptReq',
        foTranspInd = transportationSign(f) EXTID 'TransportationIndicator',
        foSpaceQuantity = quantityPlacesTotal(f) EXTID 'ShipmentCargoSpaceQuantity',
        foRoute = route(f) EXTID 'CargoRoute'

    PROPERTIES ATTR IN foConsigneeOrg
        foConsigneeName = name(consignee(f)) EXTID 'OrgName',
        foConsigneeInn = inn(consignee(f)) EXTID 'Inn',
        foConsigneeKpp = kpp(consignee(f)) EXTID 'Kpp',
        foConsigneeType = diadocOrgType(consignee(f)) EXTID 'OrgType'
    PROPERTIES ATTR IN foShipperOrg
        foShipperName = name(shipper(f)) EXTID 'OrgName',
        foShipperInn = inn(shipper(f)) EXTID 'Inn',
        foShipperKpp = kpp(shipper(f)) EXTID 'Kpp',
        foShipperType = diadocOrgType(shipper(f)) EXTID 'OrgType'

    PROPERTIES ATTR IN foTransportInfo
        foTransportType = id(vehicleKind(f)) EXTID 'TransportType',
        foBodyType = bodyType(f) EXTID 'BodyType'

    PROPERTIES ATTR IN foDirectives
        foDirectivesNorm = transportInstructions(f) EXTID 'TransportationDirectives',
        foSpecialInfo = specialMarks(f) EXTID 'SpecialInformation',
        foSpeedLimit = speedLimits(f) EXTID 'SpeedLimit',
        foDeliveryTerms = deliveryPeriodDays(f) EXTID 'DeliveryTerms'
    PROPERTIES ATTR IN foClimate
        foTempLower = temperatureFrom(f) EXTID 'TemperatureLowerLimit',
        foTempUpper = temperatureTo(f) EXTID 'TemperatureUpperLimit',
        foHumLower = humidityFrom(f) EXTID 'HumidityLowerLimit',
        foHumUpper = humidityTo(f) EXTID 'HumidityUpperLimit'

    PROPERTIES ATTR IN foBatchWeight
        foNetWeight = netWeightTotal(f) EXTID 'NetWeight',
        foGrossWeight = grossWeightTotal(f) EXTID 'GrossWeight',
        foPallets = quantityPalletsTotal(f) EXTID 'NumberOfPallets'

    // TODO: код валюты (ОКВ) - сопоставить со справочником валют; пока '643' (рубль)
    PROPERTIES ATTR IN foDeclaredCost
        foDeclaredCurrency = ('643' IF declaredCost(f)) EXTID 'Currency',
        foDeclaredCost = declaredCost(f) EXTID 'CargoCost'
    PROPERTIES ATTR IN foActualCost
        foActualCurrency = ('643' IF actualCost(f)) EXTID 'Currency',
        foActualCost = actualCost(f) EXTID 'CargoCost'

    OBJECTS d = ForwardingOrderDetail EXTID 'ItemDescription' IN foItems
    PROPERTIES ATTR
        itemName = nameCargo(d) EXTID 'Name',
        itemPlaces = quantityPlaces(d) EXTID 'CargoSpaceQuantity',
        itemDangerous = digit1(dangerous(d)) EXTID 'HasDangerous',
        itemRestricted = digit1(seized(d)) EXTID 'HasRestrictedItems',
        itemCanVolume = digit1(TRUE IF volume(d)) EXTID 'CanSpecifyVolume',
        itemVolume = volume(d) EXTID 'Volume',
        itemOverload = ('1' IF banReload(d)) EXTID 'OverloadProhibition',
        itemStateSystem = digit1(stateSystem(d)) EXTID 'IsForStateSystemRegistration',
        itemPackaging = digit1(packaged(d)) EXTID 'HasPackaging',
        itemHasTnved = digit1(TRUE IF tnved(d)) EXTID 'HasCommodityCode',
        itemTnved = tnved(d) EXTID 'NomenclatureCode'
    PROPERTIES IN foItemMarks itemMark = nameMarking(d) EXTID 'Mark'
    PROPERTIES IN foItemCountry itemCountry = sidCountry(d) EXTID 'Country'
    PROPERTIES ATTR IN foItemWeight
        itemNetWeight = netWeight(d) EXTID 'NetWeight',
        itemGrossWeight = grossWeight(d) EXTID 'GrossWeight',
        itemPallets = quantityPallets(d) EXTID 'NumberOfPallets'
    // упаковка обязательна при HasPackaging = 1
    PROPERTIES ATTR IN foItemPackaging
        itemPackType = (packagingType(d) IF packaged(d)) EXTID 'PackagingType',
        itemPackWeight = (packagingWeight(d) IF packaged(d)) EXTID 'PackagingWeight',
        itemPackCount = (packagingCount(d) IF packaged(d)) EXTID 'PackagingCount'
    PROPERTIES ATTR IN foItemPackagingSize
        itemPackHeight = (packagingHeight(d) IF packaged(d)) EXTID 'Height',
        itemPackLength = (packagingLength(d) IF packaged(d)) EXTID 'Length',
        itemPackWidth = (packagingWidth(d) IF packaged(d)) EXTID 'Width'
    FILTERS forwardingOrder(d) == f

    // адреса выгружаются только при полном (Region+ZipCode)
    PROPERTIES ATTR IN foPickup foPickupLocation = pickupPlace(f) EXTID 'CargoPickupLocation'
    PROPERTIES ATTR IN foPickupAddrRF
        foPickupRegion = (pickupRegion(f) IF hasPickupAddress(f)) EXTID 'Region',
        foPickupZip = (pickupZipCode(f) IF hasPickupAddress(f)) EXTID 'ZipCode',
        foPickupCity = (pickupCity(f) IF hasPickupAddress(f)) EXTID 'City',
        foPickupStreet = (pickupStreet(f) IF hasPickupAddress(f)) EXTID 'Street',
        foPickupBuilding = (pickupBuilding(f) IF hasPickupAddress(f)) EXTID 'Building'

    PROPERTIES ATTR IN foDrop foDropPoint = dropPlace(f) EXTID 'CargoDeliveryPoint'
    PROPERTIES ATTR IN foDropAddrRF
        foDropRegion = (dropRegion(f) IF hasDropAddress(f)) EXTID 'Region',
        foDropZip = (dropZipCode(f) IF hasDropAddress(f)) EXTID 'ZipCode',
        foDropCity = (dropCity(f) IF hasDropAddress(f)) EXTID 'City',
        foDropStreet = (dropStreet(f) IF hasDropAddress(f)) EXTID 'Street',
        foDropBuilding = (dropBuilding(f) IF hasDropAddress(f)) EXTID 'Building'


    // клиент (мы), экспедитор и договор ТЭ - после партии груза (порядок схемы)
    PROPERTIES ATTR IN foClientOrg
        foClientName = name(client(f)) EXTID 'OrgName',
        foClientInn = inn(client(f)) EXTID 'Inn',
        foClientKpp = kpp(client(f)) EXTID 'Kpp',
        foClientFns = diadocFnsParticipantId(client(f)) EXTID 'FnsParticipantId',
        foClientType = diadocOrgType(client(f)) EXTID 'OrgType'   // 1 - ИП, 2 - ЮЛ (по длине ИНН)

    PROPERTIES ATTR IN foForwarderOrg
        foForwarderName = name(forwarder(f)) EXTID 'OrgName',
        foForwarderInn = inn(forwarder(f)) EXTID 'Inn',
        foForwarderKpp = kpp(forwarder(f)) EXTID 'Kpp',
        foForwarderFns = diadocFnsParticipantId(forwarder(f)) EXTID 'FnsParticipantId',
        foForwarderType = diadocOrgType(forwarder(f)) EXTID 'OrgType'

    PROPERTIES ATTR IN foContract
        foContractName = contractName(f) EXTID 'DocumentName',
        foContractNumber = contractNumber(f) EXTID 'DocumentNumber',
        foContractDate = diadocDate(contractDate(f)) EXTID 'DocumentDate'

    // BoxId подписанта - чистый GUID (без @diadoc.ru)
    PROPERTIES ATTR IN foSigners foSignersBoxId = diadocBoxIdGuid(client(f)) EXTID 'BoxId'
    // 1 - полномочия по учредительным документам (руководитель); доверенности (2-4) не поддерживаем
    PROPERTIES ATTR IN foSigner
        foSignerPowers = ('1' IF f IS ForwardingOrder) EXTID 'SignerPowersConfirmationMethod'
    PROPERTIES ATTR IN foSignerFio
        foSignerLast = signerLastName(f) EXTID 'LastName',
        foSignerFirst = signerFirstName(f) EXTID 'FirstName',
        foSignerMiddle = signerMiddleName(f) EXTID 'MiddleName'
;
