MODULE LotTypeRu;

REQUIRE Lot;

NAMESPACE Stock;

EXTEND CLASS LotType {
    lp 'Одежда',
    perfumery 'Парфюмерия',
    milk 'Молочная продукция',
    shoes 'Обувь',
    medicine 'Лекарства',
    photos 'Фотоаппаратура',
    tyres 'Шины',
    tobaccoProduct 'Альтернативный табак',
    tobacco 'Табак',
    furs 'Меховые изделия',
    water 'Упакованная вода',
    beer 'Пиво',
    antiseptic 'Антисептики',
    medical 'Медицинские изделия',
    grocery 'Бакалея',
    softdrinks 'Соковая продукция и безалкогольные напитки' ,
    vegetableoil 'Растительные масла',
    seafood 'Морепродукты',
    chemistry 'Парфюмерные и косметические средства и бытовая химия',
    toys 'Игры и игрушки для детей',
    autofluids 'Моторные масла',
    petfood 'Корма для животных',
    bio 'Бады',
    nabeer 'Безалкогольное пиво',
    sweets 'Сладости и кондитерские изделия',
    bicycle 'Велосипеды и велосипедные рамы',
    ncp 'Никотиносодержащая продукция',
    meat 'Мясные изделия',
    vetpharma 'Ветеринарные препараты',
    radio 'Радиоэлектронная продукция',
    titan 'Титановая металлопродукция',
    conserve 'Консервированная продукция',
    opticfiber 'Оптоволокно и оптоволоконная продукция',
    books 'Печатная продукция',
    pharmaraw 'Фармацевтическое сырьё, лекарственные средства',
    construction 'Строительные материалы',
    fire 'Пиротехника и огнетушащее оборудование',
    heater 'Отопительные приборы',
    cableraw 'Кабельно-проводниковая продукция',
    polymer 'Полимерные трубы',
    carparts 'Автозапчасти и комплектующие транспортных средств',
    furslp 'Натуральный мех',
    nicotindev 'Электронные системы доставки никотина',
    gadgets 'Ноутбуки и смартфоны',
    frozen 'Полуфабрикаты и замороженные продукты',
    fertilizers 'Удобрения в потребительской упаковке',
    homeware 'Товары для дома и интерьера',
    pyrotechnics 'Пиротехнические изделия'
}

hidden 'Скрыть' = DATA BOOLEAN (LotType);

EXTEND FORM dialogLotTypes
    PROPERTIES(t) hidden
    FILTERGROUP used
        FILTER 'Используемые' NOT hidden(t) 'F9' DEFAULT
;

// Добавленные разом товарные группы ЧЗ скрываются из выбора, чтобы не раздувать список у тех, кто с ними не работает;
skipHideNewLotTypes = ABSTRACT BOOLEAN ();
hideNewLotTypesMigrated = DATA BOOLEAN ();
onStarted() + {
    IF NOT (hideNewLotTypesMigrated() OR skipHideNewLotTypes()) THEN NEWSESSION {

        hidden(LotType t) <- TRUE WHERE t = LotType.bicycle OR t = LotType.ncp OR t = LotType.meat OR t = LotType.vetpharma
            OR t = LotType.radio OR t = LotType.titan OR t = LotType.conserve OR t = LotType.opticfiber OR t = LotType.books
            OR t = LotType.pharmaraw OR t = LotType.construction OR t = LotType.fire OR t = LotType.heater OR t = LotType.cableraw
            OR t = LotType.polymer OR t = LotType.carparts OR t = LotType.nicotindev OR t = LotType.gadgets
            OR t = LotType.frozen OR t = LotType.fertilizers OR t = LotType.homeware OR t = LotType.pyrotechnics;
        hideNewLotTypesMigrated() <- TRUE;
        APPLY;
    }
}

showEnableExciseMarkPrice 'Цена табачной продукции в коде маркировки' = DATA BOOLEAN (LotType);
EXTEND FORM dialogLotTypes
    PROPERTIES READONLY showEnableExciseMarkPrice(t);
onStarted() + {
    showEnableExciseMarkPrice(LotType t) <- t == LotType.tobacco OR t == LotType.tobaccoProduct;
}

enableExciseMarkPrice 'Цена табачной продукции в коде маркировки' = DATA BOOLEAN (Item) IN itemBase;

EXTEND FORM item PROPERTIES(i) enableExciseMarkPrice AFTER nameLotType(i) SHOWIF showEnableExciseMarkPrice(lotType(i));
EXTEND FORM items PROPERTIES(i) READONLYIF isReadonly() AFTER nameLotType(i) enableExciseMarkPrice SHOWIF showEnableExciseMarkPrice(lotType(i));

@defineItemGroupValueGrid (containsSugar, 'Содержит сахар', BOOLEAN);

containsSugar 'Содержит сахар' (Item i) = containsSugar(itemGroup(i));