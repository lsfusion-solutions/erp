MODULE PurchaseDeclarationRegistrationNumber;

REQUIRE Declaration;

NAMESPACE EZ;

registrationNumber 'Регистрационный номер' = DATA STRING[100] (Declaration) IN numbered CHARWIDTH 20;

overNumber(Declaration d) += registrationNumber(d);

EXTEND FORM declaration
    PROPERTIES(d) registrationNumber
;

DESIGN declaration {
    header {
        MOVE PROPERTY(registrationNumber(d));
    }
}

EXTEND FORM declarations
    PROPERTIES(d) READONLY registrationNumber
;