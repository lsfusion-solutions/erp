				<textField isBlankWhenNull="true">
					<reportElement style="GroupCellStyle0" x="0" y="15" width="240" height="15" uuid="ff46394a-7d12-4a6e-8e17-f41c519164f5"/>
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="lsf.TimesNewRoman"/>
					</textElement>
					<textFieldExpression><![CDATA["К СВЕДЕНИЮ КЛИЕНТА"]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement style="GroupCellStyle0" x="0" y="32" width="240" height="228" uuid="e5ab2f1d-c035-489b-abd5-836de1b41d48"/>
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Justified" verticalAlignment="Top">
						<font fontName="lsf.TimesNewRoman"/>
						<paragraph firstLineIndent="20"/>
					</textElement>
					<textFieldExpression><![CDATA["Наличные денежные средства вкладываются в сумку (мешок) для сдачи в банк или кассово-инкассаторскую организацию.\nНаличные денежные средства подбираются по номиналам. Оттиск пломбира должен быть четким.\nПри сдаче сумки с наличными денежными средствами инкассатору требуйте от него:\nпредъявления удостоверения личности инкассатора, доверенности на инкассацию наличных денежных средств и явочной карточки, заверенной печатью;\nвыдачи порожней сумки, закрепленной за организацией (индивидуальным предпринимателем), взамен сумки с наличными денежными средствами;\nрасписки на копии препроводительной ведомости и наложения на нее четкого оттиска печати в получении опломбированной сумки.\n\nБережно обращайтесь с сумкой."]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement style="GroupCellStyle0" x="250" y="68" width="208" height="36" uuid="6c4f2e0d-9604-44b8-8619-dc6b97733618"/>
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Justified" verticalAlignment="Top">
						<font fontName="lsf.TimesNewRoman"/>
						<paragraph firstLineIndent="20"/>
					</textElement>
					<textFieldExpression><![CDATA["Данный экземпляр остается у организации (индивидуального предпринимателя) в качестве квитанции в приеме сумки."]]></textFieldExpression>
				</textField>
