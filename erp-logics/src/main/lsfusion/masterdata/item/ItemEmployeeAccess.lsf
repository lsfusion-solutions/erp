MODULE ItemEmployeeAccess;  // ограничивает только группы, а товары видны все. Чтобы ограничить товары - модуль Extra

REQUIRE Item, EmployeeSku; // модуль EmployeeSku попадает в логику при подключении Range 

NAMESPACE Item;

@extendFormFilterSkuGroupAccess(items, g);

@extendFormFilterSkuGroupAccess(itemGroups, g);

//----------------------- Переход на новый основной классификатор ---------------------------//
overReplaceToItemGroup(CustomGroup g, ItemGroup ng) + {
    IF ng IS ItemGroup THEN {
        dataAccess(ng, Employee e) <- access(e, itemGroup(g));
    }
}

// ----------------------------------------- Метакод по добавлению фильтра товаров на форму ----------------------- //

META extendFormFilterSkuAccess(form, concrete)
    EXTEND FORM form FILTERS (concrete IS Sku AND NOT limitAccessSkuGroup(currentUser())) OR countAccess(currentUser(), skuGroup(concrete)); // без OR NOT skuGroup(concrete)
END
