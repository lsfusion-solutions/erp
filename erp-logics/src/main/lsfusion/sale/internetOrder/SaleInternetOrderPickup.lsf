MODULE SaleInternetOrderPickup;

REQUIRE SaleInternetOrder;

NAMESPACE Sale;

isPickup 'Самовывоз' = ABSTRACT CASE BOOLEAN (InternetOrder);

EXTEND FORM internetOrder
    PROPERTIES (o) isPickup
;
DESIGN internetOrder {
    second {
        MOVE PROPERTY (isPickup(o));
    }
}

EXTEND FORM internetOrders PROPERTIES (o) READONLYIF isReadonly() isPickup BEFORE isClosed(o);