MODULE POSKrok;

REQUIRE POS, ZReportKrok;

NAMESPACE POS;

// Оплата по QR-коду через платежную систему "Крок"

minKrokPaymentType () = GROUP MIN PaymentType t IF isKrok(t);

onStarted() + {
    IF NOT minKrokPaymentType() THEN APPLY { loadDefaultType('КРОК', PaymentMeans.paymentMeansKrok, 'krok'); }
}

// ----------------------------------- Платеж ---------------------------- //

krokPaymentUid 'Идентификатор платежа КРОК' = DATA STRING[100] (Payment);
krokInvoiceId 'Идентификатор инвойса КРОК' = DATA STRING[100] (Payment);
krokCncp 'КПСО КРОК' = DATA INTEGER (Payment);

EXTEND FORM zReports
    PROPERTIES(p) READONLY krokPaymentUid, krokInvoiceId, krokCncp
;

EXTEND FORM zReport
    PROPERTIES(p) READONLY krokPaymentUid, krokInvoiceId, krokCncp
;

// на каких кассах доступна оплата КРОК, определяет реализация проведения платежа
extraShowKrok = ABSTRACT VALUE BOOLEAN (Receipt);
showKrok (Receipt r) = minKrokPaymentType() AND extraShowKrok(r);

krokPayment (Receipt r) = GROUP LAST Payment p ORDER p WHERE isKrok(paymentType(p)) AND sum(p) AND receipt(p) = r;

// проведение платежа (оплата или возврат); при неудаче реализация выставляет returnPost
processKrok 'Провести платеж КРОК' ABSTRACT LIST (Payment);

// ----------------------------------- Оплата чека ---------------------------- //

overCreatePayment(Receipt r) + {
    IF showKrok(r) THEN {
        NEW p = Payment {
            receipt(p) <- r;
            paymentType(p) <- minKrokPaymentType();
        }
    }
}

prePostPrint(Receipt r) + {
    IF krokPayment(r) AND NOT krokPaymentUid(krokPayment(r)) THEN processKrok(krokPayment(r));
}

postKrok 'КРОК' (Receipt receipt) {
    returnPost() <- NULL;
    IF (bonusPaid(receipt) OR bonusSum(receipt)) AND NOT discountCard(receipt) AND NOT [GROUP SUM 1 IF discountCard(ReceiptReturnDetail d) BY receipt(d)](receipt) THEN {
        MESSAGE 'Выберите дисконтную карту';
        RETURN;
    }
    IF signedBonusPaid(receipt) > 0 AND NOT (OVERRIDE totalBonuses(receipt), 0.0) >= signedBonusPaid(receipt) THEN {
        MESSAGE 'Нельзя оплачивать бонусами больше, чем доступно бонусов на дисконтной карте';
        RETURN;
    }
    IF incorrectReceipt(receipt) THEN {
        MESSAGE incorrectReceipt(receipt);
        RETURN;
    }
    prePost(receipt);
    IF sumReceiptDetail(receipt) THEN {
        NEW p = Payment {
            receipt(p) <- receipt;
            paymentType(p) <- minKrokPaymentType();
            sum(p) <- sumReceiptDetail(receipt);
        }
        prePostPrint(receipt);
        IF returnPost() THEN {
            DELETE Payment p WHERE receipt(p) = receipt;
            RETURN;
        }
        postPrint(receipt);
        afterPostPrint(receipt);
    }
} IN receiptAction;

EXTEND FORM POS
    PROPERTIES(r) postKrok SHOWIF showKrok(r) AND currentZReport()
;

DESIGN POS {
    GROUP(receiptAction, r) {
        MOVE PROPERTY(postKrok(r)) BEFORE PROPERTY(cancel(r)) { alignment = STRETCH; focusable = FALSE; font = 'bold 22'; }
    }
}
