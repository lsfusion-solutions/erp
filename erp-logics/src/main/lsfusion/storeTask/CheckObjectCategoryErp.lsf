MODULE CheckObjectCategoryErp;

REQUIRE ObjectCategory, CheckObjectStoreErp, Store;

NAMESPACE StoreTask;

// Формат магазина — категория объекта проверки. Правило авто-создания задач
// (SchedulePlan) отбирает объекты по категории, а без этого моста у магазинов её
// не было: «проверка пожарной безопасности во всех магазинах такого-то формата раз в месяц»
// не находила ни одного магазина.
//
// Мост на готовый классификатор erp, а не свой справочник категорий: формат и так ведут
// в карточке магазина, второй источник разошёлся бы с ним в первый же день.
EXTEND CLASS StoreType : ObjectCategory;

// Правило хранит категорию кодом, а не ссылкой. Код формата в erp заполняют не всегда (у Соседей
// — ни у одного из семи форматов), поэтому запасной вариант — внутренний номер объекта: он
// стабилен, пока формат не пересоздают, а на случай пересоздания и заводят код в erp.
// OVERRIDE в собственных скобках: иначе его запятая прочтётся как разделитель аргументов
// приведения.
id (StoreType t) += ISTRING[30]((OVERRIDE Store.id(t), 'ST' + STRING(LONG(t))));
name (StoreType t) += Store.name(t);

category (Store s) += Store.storeType(s);
