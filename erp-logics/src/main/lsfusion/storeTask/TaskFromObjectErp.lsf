MODULE TaskFromObjectErp;

// TaskFromObject — метакод @defineTaskObjectContext из артефакта; Store/CashRegister/Scales
// — формы, на которые вешается пункт (транзитивному REQUIRE не доверять)
REQUIRE TaskFromObject, CheckObjectStoreErp, CheckObjectMachineryErp,
        Store, CashRegister, Scales;

NAMESPACE StoreTask;

// «Создать задачу» правым кликом по строке — на тех справочниках, которые у нас уже
// объекты проверки: магазин, касса, весы. Шов для них написан руками в соседних модулях,
// поэтому здесь только пункт меню: само действие createTask объявлено в артефакте один
// раз на весь CheckObject, имя объекта оно берёт из name(CheckObject), который эти
// мостики и реализуют.
//
// Имена формы, объекта и колонки — без квалификатора namespace: в этих позициях парсер
// его не принимает. Колонки выбраны те, что стоят в самих объявлениях форм и видны
// всегда, без SHOWIF.

// Магазины: пункт на названии магазина.
@defineTaskObjectContext(stores, s, name);

// Кассы: список касс живёт на форме групп касс, колонка — номер кассы.
@defineTaskObjectContext(groupsCashRegister, c, npp);

// Весы: то же самое на форме групп весов.
@defineTaskObjectContext(groupsScales, s, npp);
