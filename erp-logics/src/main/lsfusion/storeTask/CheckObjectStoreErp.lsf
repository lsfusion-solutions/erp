MODULE CheckObjectStoreErp;

// Geo нужен явно: адрес и координаты берутся не из собственных свойств Store, а через
// POI. Транзитивно он приезжает и со Store, но зависимость тут настоящая.
REQUIRE CheckObject, Store, Geo;

// Пространство подсистемы задач, а не собственное: элементы этого модуля — реализации
// её абстрактных свойств, и они принадлежат её домену. Заодно это то, что позволяет
// писать слева неквалифицированное name/id — в StoreTask они разрешаются раньше
// одноимённых свойств Store.
NAMESPACE StoreTask;

// Переопределение сущности «магазин»: Store становится объектом проверки. Подсистема
// задач держит CheckObject абстрактным именно ради этого — она не должна знать, что
// проверяют в конкретной логике.
EXTEND CLASS Store : CheckObject;

name(Store s) += Store.name(s);

// Адрес и координаты — через POI, а не через собственные address/latitude/longitude
// магазина. Store их и реализует, так что значение то же самое, но POI — канонический
// ответ erp на вопрос «где этот объект»: Geo.address доклеивает additionalAddress, а
// Geo.latitude уже DOUBLE, тогда как Store.latitude — NUMERIC[11,6], и его пришлось бы
// приводить руками.
//
// Именно own*, а не address/latitude/longitude: ядро развело «что объект ХРАНИТ» и
// «что он ПОКАЗЫВАЕТ». Показываемое считается по дереву (CheckObject.site), и касса
// получает координаты своего магазина именно отсюда.
ownAddress(Store s) += Geo.address(s);
ownLatitude(Store s) += Geo.latitude(s);
ownLongitude(Store s) += Geo.longitude(s);

// Собственный код магазина, а не наименование: именно его мобильное
// устройство запоминает как objectId, чтобы спросить «задачи магазина, в котором я
// стою», а переименовывают магазин куда охотнее, чем перекодируют.
// STRING[100] сужается до ISTRING[30] — коды магазинов короткие.
id(Store s) += ISTRING[30](Store.id(s));
