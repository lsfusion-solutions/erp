MODULE StoreTaskErp;

// Подключение подсистемы задач по магазинам (артефакт storetask-logics) к erp. Одна
// строка, которую про неё знает конфигурация: ErpDefault или клиентская.
//
// Требуется StoreTaskLib — host-независимая половина артефакта. Его собственный
// ERP-агрегатор (StoreTask) сюда не годится: он тянет мостики erp/ артефакта, написанные
// под mycompany (Assignee, Inventory.Location, Activity), а таких классов в lsfusion-erp нет.
//
// Мостики — здесь, в erp-logics, а не в артефакте и не в клиентской логике: артефакт не
// должен знать, что в erp исполнитель — это Employee, объект проверки — Store, а внутри
// магазина стоят кассы и весы; а сами эти факты — общие для любой конфигурации erp, и
// держать их копию у каждого клиента незачем. Клиент добавляет только своё — см.
// точки расширения в TaskItemRowErp.
//
// Переопределение сущностей и расширения разнесены по модулям намеренно, чтобы было
// видно, где закрывается абстракция подсистемы, а где заводится собственное знание.
REQUIRE StoreTaskLib,
        // запуск внешних приложений с главного экрана. В StoreTaskLib модуль намеренно не
        // входит — его подключает хост; без него клиент зовёт apiExternalApps и получает 404
        ExternalApp,
        // переопределение сущностей: магазин и сотрудник
        CheckObjectStoreErp, TaskPerformerEmployeeErp,
        // расширение: кассы и весы стоят в магазине (через отдел)
        CheckObjectMachineryErp,
        // «Создать задачу» правым кликом по строке магазина, кассы и весов
        // (метакод @defineTaskObjectContext артефакта)
        TaskFromObjectErp,
        // товар как предмет строки табличной части: пересчёт остатков и проверка
        // ценников — хост сам наполняет строки остатком и ценой
        TaskItemRowErp,
        // доступ исполнителя к объектам: за какие магазины отвечает человек. В StoreTaskLib
        // модуль не входит — подключает хост, как ExternalApp
        CheckObjectAccess,
        // расширение: формат магазина — категория объекта, по ней правило авто-создания
        // задач отбирает магазины
        CheckObjectCategoryErp,
        // расширение: группа поверки магазина — категория его весов, по ней график
        // поверки весов ставит задачи
        ScalesVerificationErp;

NAMESPACE StoreTask;
