MODULE TaskPerformerEmployeeErp;

// Store/EmployeeStock — фильтр предметов канала сотрудников по объекту: «свои» для
// магазина — сотрудники магазинов (Store.in), #37497; RefValue — абстракт available,
// который реализует эта строка
REQUIRE TaskPerformer, Employee, Store, EmployeeStock, RefValue;

NAMESPACE StoreTask;

// Переопределение сущности «исполнитель»: единственный вопрос, который подсистема задач
// намеренно не решает за хост, — кто может ставить задачу, получать её и выполнять.
// Здесь это сотрудник.
//
// Якорь именно Employee, а не CustomUser: в erp сотрудник уже пользователь
// (Employee : CustomUser), поэтому учётка администратора или сервисный аккаунт
// исполнителем не становятся, а карточка сотрудника остаётся единственным местом, где
// человека заводят.
EXTEND CLASS Employee : TaskPerformer;

// Идентификатор исполнителя: код сотрудника, а если его нет — логин.
//
// Запасной вариант не для красоты. Мобильный клиент считает вход неудачным, когда в
// ответе apiCurrentUser нет непустого `id`, и показывает «Нет доступа к задачам»
// (task_repository.dart). Код сотрудника в erp заполняют далеко не всегда (у Соседей — у одного
// человека из 1516), и без этой строки в приложение не вошёл бы почти никто.
// Логин же есть у каждого, кто вообще заходит в систему, и он уникален.
//
// STRING[100] -> ISTRING: приведение явное, чтобы реализация заведомо укладывалась в
// класс абстрактного свойства. OVERRIDE в собственных скобках: иначе его запятая
// прочтётся как разделитель аргументов приведения.
id (Employee e) += ISTRING[100]((OVERRIDE Employee.id(e), login(e)));

// «Имя Фамилия»: Employee.name — это name[User], то есть в итоге name[Contact].
name (Employee e) += Employee.name(e);

// email у сотрудника — платформенное свойство контакта (Authentication), а не erp'шное:
// в erp `email` есть у LegalEntity, и квалификатор Employee.email не разрешается вовсе.
email (Employee e) += Authentication.email(e);

// Именно inactive, а не isLocked: заблокированная учётка — про вход в систему, а
// «в архиве» здесь про то, можно ли назначить человеку задачу.
archived (Employee e) += Employee.inactive(e);

// Групп исполнителей в erp нет, поэтому in() — тождество. Подсистема при этом написана
// в расчёте на отношение, а не на равенство: появится команда — менять только эту строку.
in (Employee p, User u) += p AS Employee = u AS Employee;

// Приведение обязательно, а не для красоты: голый параметр справа от `+=` роняет
// парсер 6.3 (NullPointerException в getExplicitClasses — LP у параметра нет).
performer (Employee e) += e AS Employee;

// «Свои» для канала сотрудников (#37497): кандидаты пункта «Ознакомил с результатами» —
// сотрудники этого магазина. Каноническое отношение — состав отделов магазина
// (EmployeeStock.in, агрегат Store.in); архивные в канале уже отсеяны гейтом apiRowSubjects
// через retired (archived выше). Квалификация Store. обязательна: NAMESPACE StoreTask
// перекрывает имя своим двухаргументным in (TaskPerformer).
available (Employee e, Store st) += TRUE IF Store.in(st, e);
