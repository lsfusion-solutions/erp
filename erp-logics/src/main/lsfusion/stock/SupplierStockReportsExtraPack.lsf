MODULE SupplierStockReportsExtraPack;

REQUIRE SupplierStockReports, PurchaseInvoiceExtraPack;

NAMESPACE StockReports;

overUnitInvoicePriceBatch (Batch b) += WHEN isExtraPack(invoiceDetail(b)) AND quantity(invoiceDetail(b)) != 0
    THEN NUMERIC[16,4](invoiceSum(invoiceDetail(b)) / quantity(invoiceDetail(b)));
overUnitPriceBatch (Batch b) += WHEN isExtraPack(invoiceDetail(b)) AND quantity(invoiceDetail(b)) != 0
    THEN NUMERIC[16,4](sum(invoiceDetail(b)) / quantity(invoiceDetail(b)));