MODULE WriteOffLotSecond;

REQUIRE WriteOffLot, WriteOffTerminal, LotSecondExtra;

NAMESPACE WriteOff;

@defineOperationProperty(lotSecond, 'Оценённые товары', showContainer);

lotSecond (WriteOff i) = lotSecond(operation(i));
lotSecond (WriteOffDetail d) = lotSecond(operation(d));

@defineConstraintLotDetail(writeOff, 'списания');

@defineDocumentLotDetail(userWriteOff, w);

WHEN LOCAL FORMS userWriteOff SETCHANGED(dataIndex(UserWriteOffDetail d)) AND index(d) > 1000000 DO {
    MESSAGE 'ОШИБКА! Сканирование произведено в номер строки.\nПовторите сканирование этого товара!';
    dataIndex(d) <- PREV(dataIndex(d));
}

sumLotWeightWriteOffDetail 'Вес оценённых товаров, кг' (WriteOff i)= GROUP SUM weight(Lot l) IF quantity(i, l) IN documentSum MATERIALIZED;

EXTEND FORM userWriteOff
    PROPERTIES (w) READONLY sumLotWeightWriteOffDetail
;

EXTEND FORM writeOffs
    PROPERTIES (w) READONLY sumLotWeightWriteOffDetail AFTER quantityWriteOffDetail(w)
;

importLotXLSX 'Импорт из xlsx' (UserWriteOff s) {
    LOCAL barcode = STRING (INTEGER);
    LOCAL count = INTEGER();
    INPUT f = EXCELFILE DO {
        IMPORT XLS NOHEADER FROM f TO barcode = B;

        FOR barcode(INTEGER i) DO {
            IF lot(barcode(i)) THEN
                processInputBarcodeUserWriteOffDetail(s, barcode(i));
            ELSE
                count() <- count() (+) 1;
        }
        IF count() > 0 THEN
            MESSAGE CONCAT ' ', 'Не найдено кодов:', count();
    }
}

EXTEND FORM userWriteOff
    PROPERTIES (w) importLotXLSX
;

DESIGN userWriteOff {
    headerTabbedPane {
        NEW import {
            caption = 'Импорт';
            fill = 1;
            horizontal = TRUE;
            MOVE PROPERTY(addDetailDialogTerminalUserWriteOffDetail(w));
            MOVE PROPERTY(importLotXLSX(w));
        }
    }
}

cycleFrom = DATA Cycle (UserWriteOff) INDEXED;
descriptionCycleFrom 'Цикл из' (UserWriteOff i) = description(cycleFrom(i));

WHEN LOCAL FORMS userWriteOff CHANGED(stock(UserWriteOff i)) DO
    cycleFrom(i) <- NULL;

@defineOperationProperty(isCycleFrom, 'Должен быть указан цикл', constraintContainer);

onStarted () + { 
    IF operation('second') AND NOT isCycleFrom(operation('second')) THEN NEWSESSION {
        isCycleFrom(operation('second')) <- TRUE;
        APPLY;
    }
}

CONSTRAINT (SET(isPosted(UserWriteOff i)) OR CHANGED(stock(i))) AND isPosted(i) AND stock(i) IS DepartmentStore AND NOT stock(cycleFrom(i)) == stock(i)
    AND isCycleFrom(operation(i)) AND [GROUP MIN UserWriteOffDetail d IF isSecond(sku(d)) BY userWriteOff(d)](i)
    MESSAGE 'Должен быть указан цикл, из которого товары';

CONSTRAINT SETCHANGED(cycleFrom(UserWriteOff i)) AND (stock(cycleFrom(i)) != stock(i) OR fromDate(cycleFrom(i)) > currentDate())
    CHECKED BY cycleFrom[UserWriteOff]
    MESSAGE 'Выбран цикл другого магазина, либо цикл ещё не начался';

changeDescriptionCycleFrom(UserWriteOff o)  {
    DIALOG dialogCycles OBJECTS c = cycleFrom(o) CHANGE LIST description(c);
}

EXTEND FORM userWriteOff
    PROPERTIES (w) descriptionCycleFrom ON CHANGE changeDescriptionCycleFrom(w) SHOWIF (isCycleFrom(operation(w)) AND stock(w) IS DepartmentStore)
;

EXTEND FORM writeOffs
    PROPERTIES (w) READONLY descriptionCycleFrom AFTER nameStock(w)
;

DESIGN userWriteOff {
    first {
        MOVE PROPERTY (descriptionCycleFrom(w));
    }
}