MODULE TerminalHandlerPromotion;

REQUIRE TerminalHandler, PriceListPromotion;

NAMESPACE TerminalHandler;

skipVoicePromotion = ABSTRACT BOOLEAN (PriceListDetail);
inVoicePromotion (Sku s, Stock st) = TRUE IF prevPromotionPriceListDetailA(s, st) AND NOT skipVoicePromotion(prevPromotionPriceListDetailA(s, st));

in(Sku s, Stock st, TerminalBarcodeFlags f) += WHEN inVoicePromotion(s, st) AND f == TerminalBarcodeFlags.voicePromotion THEN TRUE;
