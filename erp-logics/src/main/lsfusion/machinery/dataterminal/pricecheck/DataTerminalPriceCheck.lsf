MODULE DataTerminalPriceCheck;

// Операция ТСД «Проверка цен»: поиск товара по штрихкоду, карточка с ценой и остатком на складе сотрудника.
// Отдельного экрана нет: пункт главного меню открывает экран строки документа в режиме PRICE_CHECK
// (DataTerminalDocumentDetailEdit.lsf), здесь - обработка штрихкода и карточка товара
REQUIRE DataTerminalDefault, TerminalHandler, EmployeeStock, DataTerminalSkuImage;

NAMESPACE DataTerminal;

beforeDataTerminalStart() + { INTERNAL CLIENT 'dataTerminalPriceCheck.css'; }

priceCheckStock () = stock(currentEmployee());

priceCheckSku = DATA LOCAL Sku ();
// Последний отсканированный штрихкод: показывается под полем ввода, если товар по нему не найден - карточка «Товар не найден»
priceCheckBarcode = DATA LOCAL STRING ();

// Карточка товара: цена (крупно) и остаток на складе сотрудника, миниатюра товара (smallImage) - справа под наименованием
priceCheckDetail '' (Sku s, Stock st) = CONCAT '',
    '<div class=price-check>',
        '<div class=name>', name(s), '</div>',
        htmlSmallImage(s),
        '<div class=price><span class=label>Цена</span><span class=value>',
            (OVERRIDE STRING(NUMERIC[16,2](currentPriceInTerminal(s, st))), '—'), '</span></div>',
        '<div class=balance><span class=label>Остаток</span><span class=value>',
            (OVERRIDE STRING(NUMERIC[16,3](currentBalance(s, st))), '0'), '</span></div>',
        '<div class=info>', (CONCAT ' ● ', id(s AS Item), name(Item.manufacturer(s AS Item))), '</div>',
    '</div>';

// Пункт главного меню (экран открывает doMenuItemPriceCheck в DataTerminalDocumentDetailEdit.lsf)
@addMenuItem(priceCheck, 'Проверка цен', '2', lineAction4);

// Начало проверки цен: карточки нет
startPriceCheck () {
    priceCheckSku() <- NULL;
    priceCheckBarcode() <- NULL;
}

// Товар не найден - не модальное окно (лишнее касание при потоковом сканировании), а карточка ошибки на месте
// карточки товара и звук ошибки
processPriceCheckBarcode (STRING barcode) {
    IF NOT priceCheckStock() THEN {
        message('<em>У сотрудника не задан основной склад</em>');
        RETURN;
    }
    priceCheckBarcode() <- barcode;
    priceCheckSku() <- skuBarcode(STRING[15](barcode));
    IF NOT priceCheckSku() THEN
        playError();
}

priceCheckCard '' () =
    IF priceCheckSku() THEN priceCheckDetail(priceCheckSku(), priceCheckStock())
    ELSE '<div class="price-check not-found"><div class=title>Товар не найден</div><div class=hint>Штрихкода нет в справочнике товаров</div></div>';

// Отсканированный штрихкод - строкой под полем ввода (только код, без подписи)
priceCheckScanned '' () = '<div class=price-check-barcode>' + priceCheckBarcode() + '</div>';
