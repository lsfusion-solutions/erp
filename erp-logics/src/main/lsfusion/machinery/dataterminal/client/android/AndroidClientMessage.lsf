MODULE AndroidClientMessage;

REQUIRE DataTerminalAndroidClient;

NAMESPACE AndroidClient;

toast(STRING message, Connection c) + WHEN message IS STRING AND isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        showToast(message);
    } ELSE {
        NEWSESSION NEWTHREAD { showToast(message); } CONNECTION c;
    }
}

messageAsync(STRING message, Connection c) + WHEN message IS STRING AND isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        showMessage(message);
    } ELSE {
        NEWSESSION NEWTHREAD { showMessage(message); } CONNECTION c;
    }
}

playRingtone(Connection c) + WHEN isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        playRingtone();
    } ELSE {
        NEWSESSION NEWTHREAD { playRingtone(); } CONNECTION c;
    }
}

playAlarm(Connection c) + WHEN isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        playAlarm();
    } ELSE {
        NEWSESSION NEWTHREAD { playAlarm(); } CONNECTION c;
    }
}

playNotify(Connection c) + WHEN isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        playNotify();
    } ELSE {
        NEWSESSION NEWTHREAD { playNotify(); } CONNECTION c;
    }
}

playError(Connection c) + WHEN isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        playError();
    } ELSE {
        NEWSESSION NEWTHREAD { playError(); } CONNECTION c;
    }
}

stopRingtone(Connection c) + WHEN isAndroidClient(c) THEN {
    IF c = currentConnection() THEN {
        stopRingtone();
    } ELSE {
        NEWSESSION NEWTHREAD { stopRingtone(); } CONNECTION c;
    }
}
