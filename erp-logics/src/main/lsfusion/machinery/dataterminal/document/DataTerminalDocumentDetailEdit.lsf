MODULE DataTerminalDocumentDetailEdit;

// Экран ввода полей строки документа ТСД: поля, запрашиваемые по настройкам типа документа, вводятся по одному.
// Enter - проверка поля и следующее поле по кругу (после последнего - первое), OK в шапке - сохранение с любого поля,
// Esc - возврат к строкам без сохранения. Режимы: EDIT - пункт «Редактировать» меню «⋮» строки, ADD - кнопка
// «Добавить» на экране строк (строки добавляются сканированием штрихкода), PRICE_CHECK - пункт «Проверка цен»
// главного меню (DataTerminalPriceCheck.lsf): карточка товара с ценой и остатком на складе сотрудника
REQUIRE DataTerminalDocumentDetails, DataTerminalPriceCheck, BarcodeParser;

NAMESPACE DataTerminal;

beforeDataTerminalStart() + { INTERNAL CLIENT 'dataTerminalDocumentDetailEdit.css'; }

// Поля строки в порядке запроса
CLASS TerminalDetailField 'Поле строки документа ТСД' {
    quantity 'Количество',
    extraQuantity 'Доп. количество',
    price 'Цена',
    date1 'Дата 1',
    date2 'Дата 2',
    field1 'Поле 1',
    field2 'Поле 2',
    field3 'Поле 3'
}

order (TerminalDetailField f) = CASE
    WHEN f = TerminalDetailField.quantity THEN 1
    WHEN f = TerminalDetailField.extraQuantity THEN 2
    WHEN f = TerminalDetailField.price THEN 3
    WHEN f = TerminalDetailField.date1 THEN 4
    WHEN f = TerminalDetailField.date2 THEN 5
    WHEN f = TerminalDetailField.field1 THEN 6
    WHEN f = TerminalDetailField.field2 THEN 7
    WHEN f = TerminalDetailField.field3 THEN 8;

// Наименования дополнительных полей - из настроек ТСД (GENERAL_ALIAS_*, preferenceAlias в DataTerminalDocumentDetails.lsf),
// если настройка включена и заполнена; иначе - наименование поля по умолчанию
aliasPreference (TerminalDetailField f) = CASE
    WHEN f = TerminalDetailField.extraQuantity THEN Preference.GENERAL_ALIAS_EXTRAQUANT
    WHEN f = TerminalDetailField.date1 THEN Preference.GENERAL_ALIAS_DATE1
    WHEN f = TerminalDetailField.date2 THEN Preference.GENERAL_ALIAS_DATE2
    WHEN f = TerminalDetailField.field1 THEN Preference.GENERAL_ALIAS_FIELD1
    WHEN f = TerminalDetailField.field2 THEN Preference.GENERAL_ALIAS_FIELD2
    WHEN f = TerminalDetailField.field3 THEN Preference.GENERAL_ALIAS_FIELD3;

fieldCaption (TerminalDetailField f) = OVERRIDE preferenceAlias(aliasPreference(f)), caption(f);

// Поле запрашивается по настройкам типа документа строки (preferences)
requested (TerminalDetailField f, TerminalDocumentDetail d) = CASE
    WHEN f = TerminalDetailField.quantity THEN
        (d IS TerminalDocumentDetail AND NOT noRequestQuantity(preferences(d)) AND NOT banEditQuantity(preferences(d)))
    WHEN f = TerminalDetailField.extraQuantity THEN requestExtraQuantity(preferences(d))
    WHEN f = TerminalDetailField.price THEN requestPrice(preferences(d))
    WHEN f = TerminalDetailField.date1 THEN
        (requestDate1(preferences(d)) AND (NOT requestDate1ForWeightItem(preferences(d)) OR (passScales(sku(d)) AND split(sku(d)))))
    WHEN f = TerminalDetailField.date2 THEN requestDate2(preferences(d))
    WHEN f = TerminalDetailField.field1 THEN requestField1(preferences(d))
    WHEN f = TerminalDetailField.field2 THEN requestField2(preferences(d))
    WHEN f = TerminalDetailField.field3 THEN requestField3(preferences(d));

required (TerminalDetailField f, TerminalDocumentDetail d) = CASE
    WHEN f = TerminalDetailField.date1 THEN requiredDate1(preferences(d))
    WHEN f = TerminalDetailField.date2 THEN requiredDate2(preferences(d))
    WHEN f = TerminalDetailField.field1 THEN requiredField1(preferences(d))
    WHEN f = TerminalDetailField.field2 THEN requiredField2(preferences(d))
    WHEN f = TerminalDetailField.field3 THEN requiredField3(preferences(d));

firstField (TerminalDocumentDetail d) = GROUP LAST TerminalDetailField f ORDER DESC order(f), f WHERE requested(f, d);

// Строка, которую редактируют, текущее поле и введенные значения: в строку пишутся только при сохранении
editedDetail = DATA LOCAL TerminalDocumentDetail ();
currentField = DATA LOCAL TerminalDetailField ();

editQuantity 'Количество' = DATA LOCAL NUMERIC[14,3] ();
editExtraQuantity 'Доп. количество' = DATA LOCAL NUMERIC[14,3] ();
editPrice 'Цена' = DATA LOCAL NUMERIC[16,4] ();
editDate1 'Дата 1' = DATA LOCAL DATE ();
editDate2 'Дата 2' = DATA LOCAL DATE ();
editField1 'Поле 1' = DATA LOCAL STRING[100] ();
editField2 'Поле 2' = DATA LOCAL STRING[100] ();
editField3 'Поле 3' = DATA LOCAL STRING[100] ();

// Режим экрана: EDIT - редактирование строки («Редактировать» в меню строки), ADD - добавление строк сканированием
// (кнопка «Добавить» на экране строк): поле штрихкода сверху, строка отсканированного товара - в поля ввода,
// PRICE_CHECK - проверка цен (пункт «Проверка цен» главного меню): поле штрихкода и карточка товара, без документа
CLASS TerminalDetailScreenMode 'Режим экрана строки документа ТСД' {
    edit 'EDIT',
    add 'ADD',
    priceCheck 'PRICE_CHECK'
}
screenMode = DATA LOCAL TerminalDetailScreenMode ();
// Режимы с полем штрихкода
scanMode () = screenMode() = TerminalDetailScreenMode.add OR screenMode() = TerminalDetailScreenMode.priceCheck;

// Документ, в который добавляют строки (ADD): до первого скана строки еще нет
editedDocument = DATA LOCAL TerminalDocument ();
// Сообщение под полем штрихкода (ADD, PRICE_CHECK): товар не найден, вне заказа, строка сохранена
addMessage '' = DATA LOCAL STRING ();
// Фокус в поле штрихкода: реализация - после добавления поля на форму
focusAddBarcode ABSTRACT LIST ();

// Режим PRICE_CHECK: склад сотрудника, отсканированный товар и его штрихкод упаковки. До первого скана и после скана
// неизвестного штрихкода товара нет - карточки нет
priceCheckStock () = stock(currentEmployee());
priceCheckSku = DATA LOCAL Sku ();
priceCheckBarcode = DATA LOCAL STRING[30] ();

// Экран ввода: возврат (Esc, стрелка в шапке) - к строкам документа
@defSubMenu(terminalDocumentDetailEditOperation, operation, terminalDocumentDetailsOperation, 'Строка документа');

// Карточка товара - общая для всех режимов: наименование, миниатюра товара (smallImage) справа под ним, штрихкод
// и ед. изм., справа от них - side, ниже - body (по режиму)
htmlSkuCard '' (Sku s, STRING barcode, STRING side, STRING body) = CONCAT '',
    '<div class=terminal-document-detail-edit>',
        '<div class=name>', name(s), '</div>',
        htmlSmallImage(s),
        '<div class=header>',
            '<div class=barcode>', barcode, ' <b>' + shortNameUOM(s) + '</b>', '</div>',
            side,
        '</div>',
        body,
    '</div>';

// PRICE_CHECK: цена (крупно) и остаток на складе сотрудника, код и производитель товара
htmlPriceCheck '' (Sku s, Stock st) = CONCAT '',
    '<div class=price><span class=label>Цена</span><span class=value>',
        (OVERRIDE STRING(NUMERIC[16,2](currentPriceInTerminal(s, st))), '—'), '</span></div>',
    '<div class=balance><span class=label>Остаток</span><span class=value>',
        (OVERRIDE STRING(NUMERIC[16,3](currentBalance(s, st))), '0'), '</span></div>',
    '<div class=info>', (CONCAT ' ● ', id(s AS Item), name(Item.manufacturer(s AS Item))), '</div>';

// Шапка экрана - карточка товара: в EDIT и ADD - товар строки и количество по заказу, в PRICE_CHECK - отсканированный
// товар с ценой и остатком. В режимах ADD и PRICE_CHECK до скана карточки нет (подсказка - в поле штрихкода)
htmlEditDetailHeader '' () = CASE
    WHEN editedDetail() THEN htmlSkuCard(sku(editedDetail()), barcode(editedDetail()),
        ('<div class=order><span>Заказ</span>' + (OVERRIDE shortQuantity(NUMERIC[16,3](orderQuantity(editedDetail()))), '0') + '</div>')
            IF terminalOrder(terminalDocument(editedDetail())),
        '')
    WHEN screenMode() = TerminalDetailScreenMode.priceCheck AND priceCheckSku() THEN
        htmlSkuCard(priceCheckSku(), priceCheckBarcode(), '', htmlPriceCheck(priceCheckSku(), priceCheckStock()));

// На экране все поля, видно только текущее. Числа - с цифровой экранной клавиатурой (inputDecimalText),
// даты - ДД.ММ.ГГ (inputDateKeyboard), строки - с обычной (inputText). Варианты ...Selected при появлении
// поля ставят в него фокус и выделяют текст
EXTEND FORM dataTerminalInternal
    PROPERTIES READONLY terminalDocumentDetailEditHeader = htmlEditDetailHeader() CUSTOM 'htmlText'
    PROPERTIES dtEditQuantity = editQuantity() CUSTOM 'inputDecimalTextSelected' SHOWIF currentField() = TerminalDetailField.quantity,
               dtEditExtraQuantity = editExtraQuantity() CUSTOM 'inputDecimalTextSelected' HEADER fieldCaption(TerminalDetailField.extraQuantity)
                   SHOWIF currentField() = TerminalDetailField.extraQuantity,
               dtEditPrice = editPrice() CUSTOM 'inputDecimalTextSelected' SHOWIF currentField() = TerminalDetailField.price,
               dtEditDate1 = editDate1() CUSTOM 'inputDateKeyboardSelected' HEADER fieldCaption(TerminalDetailField.date1)
                   SHOWIF currentField() = TerminalDetailField.date1,
               dtEditDate2 = editDate2() CUSTOM 'inputDateKeyboardSelected' HEADER fieldCaption(TerminalDetailField.date2)
                   SHOWIF currentField() = TerminalDetailField.date2,
               dtEditField1 = editField1() CUSTOM 'inputTextSelected' HEADER fieldCaption(TerminalDetailField.field1)
                   SHOWIF currentField() = TerminalDetailField.field1,
               dtEditField2 = editField2() CUSTOM 'inputTextSelected' HEADER fieldCaption(TerminalDetailField.field2)
                   SHOWIF currentField() = TerminalDetailField.field2,
               dtEditField3 = editField3() CUSTOM 'inputTextSelected' HEADER fieldCaption(TerminalDetailField.field3)
                   SHOWIF currentField() = TerminalDetailField.field3
;

DESIGN dataTerminalInternal {
    terminalDocumentDetailEditOperation {
        fill = 1;
        MOVE PROPERTY (terminalDocumentDetailEditHeader) {
            focusable = FALSE;
            align = STRETCH;
        }
        NEW terminalDocumentDetailEditFields {
            align = STRETCH;
            MOVE PROPERTY (dtEditQuantity) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditExtraQuantity) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditPrice) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditDate1) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditDate2) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditField1) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditField2) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
            MOVE PROPERTY (dtEditField3) { align = STRETCH; captionVertical = TRUE; class = 'dt-edit-field'; captionClass = 'dt-edit-field-caption'; valueClass = 'dt-edit-field-value'; }
        }
    }
}

// Фокус в поле ввода текущего поля
focusCurrentField () {
    CASE
        WHEN currentField() = TerminalDetailField.quantity THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditQuantity;
        WHEN currentField() = TerminalDetailField.extraQuantity THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditExtraQuantity;
        WHEN currentField() = TerminalDetailField.price THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditPrice;
        WHEN currentField() = TerminalDetailField.date1 THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditDate1;
        WHEN currentField() = TerminalDetailField.date2 THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditDate2;
        WHEN currentField() = TerminalDetailField.field1 THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditField1;
        WHEN currentField() = TerminalDetailField.field2 THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditField2;
        WHEN currentField() = TerminalDetailField.field3 THEN ACTIVATE PROPERTY dataTerminalInternal.dtEditField3;
}

// Значения строки - в поля ввода, текущее - первое запрашиваемое поле
loadEditedDetail (TerminalDocumentDetail d) {
    editedDetail() <- d;
    editQuantity() <- quantity(d);
    editExtraQuantity() <- extraQuantity(d);
    editPrice() <- price(d);
    editDate1() <- extraDate1(d);
    editDate2() <- extraDate2(d);
    editField1() <- extraField1(d);
    editField2() <- extraField2(d);
    editField3() <- extraField3(d);
    currentField() <- firstField(d);
}

// Открытие экрана в режиме EDIT
startEditTerminalDocumentDetail (TerminalDocumentDetail d) {
    screenMode() <- TerminalDetailScreenMode.edit;
    editedDocument() <- terminalDocument(d);
    addMessage() <- NULL;
    loadEditedDetail(d);
    toMenuItem(MenuItem.terminalDocumentDetailEditOperation);
    focusCurrentField();
}

// Пункт меню «⋮» строки. Экран ввода открывается в форме ТСД после закрытия меню (afterTerminalDocumentDetailMenu)
editRequestedDetail = DATA LOCAL TerminalDocumentDetail ();

editTerminalDocumentDetail (TerminalDocumentDetail d) {
    IF NOT isOpened(terminalDocument(d)) THEN {
        message('<em>Документ закрыт</em>');
        RETURN;
    }
    IF NOT firstField(d) THEN {
        message('<em>Для строки нет полей для ввода</em>');
        RETURN;
    }
    editRequestedDetail() <- d;
    close();
}
@defButtonCustom(editTerminalDocumentDetail, 'Редактировать', terminalDocumentDetailMenu, d, '2', );
DESIGN terminalDocumentDetailMenu { items { MOVE PROPERTY (editTerminalDocumentDetail); } }

afterTerminalDocumentDetailMenu (TerminalDocumentDetail d) + {
    IF editRequestedDetail() = d THEN {
        editRequestedDetail() <- NULL;
        startEditTerminalDocumentDetail(d);
    }
}

// Проверка введенного значения поля: перед переходом к следующему (текущее поле) и перед сохранением по OK (все поля).
// Количество 0 допустимо всегда (обнуление строки)
fieldError (TerminalDetailField f) = CASE
    WHEN f = TerminalDetailField.quantity AND NOT editQuantity()
        THEN 'Введите количество'
    WHEN f = TerminalDetailField.quantity AND editQuantity() < 0
        THEN 'Количество не может быть отрицательным'
    WHEN f = TerminalDetailField.quantity AND banFractQuantityForPieceItem(preferences(editedDetail()))
            AND NOT split(sku(editedDetail())) AND editQuantity() AND NOT (floor(editQuantity()) = editQuantity())
        THEN 'Для штучного товара количество должно быть целым'
    WHEN f = TerminalDetailField.date1 AND required(TerminalDetailField.date1, editedDetail()) AND NOT editDate1()
        THEN 'Заполните поле «' + fieldCaption(f) + '»'
    WHEN f = TerminalDetailField.date1 AND banExpiredDate1(preferences(editedDetail())) AND editDate1() < currentDate()
        THEN '«' + fieldCaption(f) + '»: дата меньше текущей'
    WHEN f = TerminalDetailField.date2 AND required(TerminalDetailField.date2, editedDetail()) AND NOT editDate2()
        THEN 'Заполните поле «' + fieldCaption(f) + '»'
    WHEN f = TerminalDetailField.date2 AND banExpiredDate2(preferences(editedDetail())) AND editDate2() < currentDate()
        THEN '«' + fieldCaption(f) + '»: дата меньше текущей'
    WHEN f = TerminalDetailField.field1 AND required(TerminalDetailField.field1, editedDetail()) AND NOT editField1()
        THEN 'Заполните поле «' + fieldCaption(f) + '»'
    WHEN f = TerminalDetailField.field2 AND required(TerminalDetailField.field2, editedDetail()) AND NOT editField2()
        THEN 'Заполните поле «' + fieldCaption(f) + '»'
    WHEN f = TerminalDetailField.field3 AND required(TerminalDetailField.field3, editedDetail()) AND NOT editField3()
        THEN 'Заполните поле «' + fieldCaption(f) + '»';

// Первое по порядку запрашиваемое поле с ошибкой
errorField () = GROUP LAST TerminalDetailField f ORDER DESC order(f), f WHERE requested(f, editedDetail()) AND fieldError(f);

// Экран без строки (ADD до скана и после сохранения): полей ввода нет
clearEditedDetail () {
    editedDetail() <- NULL;
    currentField() <- NULL;
    editQuantity() <- NULL;
    editExtraQuantity() <- NULL;
    editPrice() <- NULL;
    editDate1() <- NULL;
    editDate2() <- NULL;
    editField1() <- NULL;
    editField2() <- NULL;
    editField3() <- NULL;
}

// Сохранение: в строку пишутся только запрашиваемые поля; при изменении количества - время сканирования.
// Затем в EDIT - возврат к строкам документа на сохраненную строку, в ADD - ожидание следующего скана
editSaved = DATA LOCAL BOOLEAN ();

// Строка берется до NEWSESSION: успешный APPLY очищает локальные свойства новой сессии, и в эту сессию
// вернулся бы пустой editedDetail
saveEditedDetail () {
    FOR TerminalDocumentDetail d = editedDetail() DO {
        editSaved() <- NULL;
        NEWSESSION NESTED (editQuantity, editExtraQuantity, editPrice, editDate1, editDate2,
                           editField1, editField2, editField3, editSaved) {
            IF requested(TerminalDetailField.quantity, d) THEN {
                IF NOT ((OVERRIDE quantity(d), 0) = (OVERRIDE editQuantity(), 0)) THEN
                    dateTimeScan(d) <- currentDateTime();
                quantity(d) <- editQuantity();
            }
            IF requested(TerminalDetailField.extraQuantity, d) THEN extraQuantity(d) <- editExtraQuantity();
            IF requested(TerminalDetailField.price, d) THEN price(d) <- editPrice();
            IF requested(TerminalDetailField.date1, d) THEN extraDate1(d) <- editDate1();
            IF requested(TerminalDetailField.date2, d) THEN extraDate2(d) <- editDate2();
            IF requested(TerminalDetailField.field1, d) THEN extraField1(d) <- editField1();
            IF requested(TerminalDetailField.field2, d) THEN extraField2(d) <- editField2();
            IF requested(TerminalDetailField.field3, d) THEN extraField3(d) <- editField3();
            APPLY;
            // успешный APPLY очищает локальные свойства сессии, поэтому признак ставится после него
            IF NOT canceled() THEN
                editSaved() <- TRUE;
        }
        IF editSaved() THEN {
            IF screenMode() = TerminalDetailScreenMode.add THEN {
                // ADD: остаемся на экране и ждем следующий скан
                addMessage() <- '<div class="dt-add-message saved">Сохранено: ' + name(d) + '</div>';
                clearEditedDetail();
                focusAddBarcode();
            } ELSE {
                currentField() <- NULL;
                toPrevMenuItem();
                ACTIVATE dataTerminalInternal.terminalDocumentDetail = d;
            }
        }
    }
}

// Enter: проверка поля и следующее поле по кругу (после последнего - первое). Сохраняет только OK
nextDetailField () {
    IF NOT editedDetail() THEN {
        message('<em>Отсканируйте штрихкод товара</em>');
        RETURN;
    }
    IF fieldError(currentField()) THEN {
        message('<em>' + fieldError(currentField()) + '</em>');
        RETURN;
    }
    currentField() <- OVERRIDE (GROUP LAST TerminalDetailField f ORDER DESC order(f), f
                                    WHERE requested(f, editedDetail()) AND order(f) > order(currentField())),
                               firstField(editedDetail());
    focusCurrentField();
}
@defButtonCustom(nextDetailField, 'Далее', dataTerminalInternal, 'ENTER', );
// Пока строки нет (ADD до скана) - полей нет, «Далее» не показываем
hideNextDetailFieldDataTerminalInternal() += NOT editedDetail();

// OK (кнопка в шапке): сохранение строки с любого поля, без прохода по остальным. Сначала проверяются все
// запрашиваемые поля: при ошибке - переход на первое поле с ошибкой
okDetailField () {
    IF NOT editedDetail() THEN {
        message('<em>Отсканируйте штрихкод товара</em>');
        RETURN;
    }
    IF errorField() THEN {
        currentField() <- errorField();
        focusCurrentField();
        message('<em>' + fieldError(currentField()) + '</em>');
        RETURN;
    }
    saveEditedDetail();
}

// Заголовок по режиму; в EDIT - шапка другого цвета (dt-header-edit, dataTerminalDocumentDetailEdit.css).
// Заголовок короткий: текст шапки не сжимается, и длинный («Редактирование строки») вместе со стрелкой «Назад»
// выталкивает OK за край экрана
overHeaderTitle () += CASE
    WHEN lastMenuItem() = MenuItem.terminalDocumentDetailEditOperation AND screenMode() = TerminalDetailScreenMode.edit
        THEN 'Редактирование'
    WHEN lastMenuItem() = MenuItem.terminalDocumentDetailEditOperation AND screenMode() = TerminalDetailScreenMode.priceCheck
        THEN 'Проверка цен';
headerClass (MenuItem i) += WHEN i = MenuItem.terminalDocumentDetailEditOperation AND screenMode() = TerminalDetailScreenMode.edit
    THEN 'dt-header-edit';

// OK в шапке - не в режимах со сканированием (ADD, PRICE_CHECK)
showHeaderOk (MenuItem i) += WHEN i = MenuItem.terminalDocumentDetailEditOperation AND NOT scanMode() THEN TRUE;
headerOk (MenuItem i) + WHEN i = MenuItem.terminalDocumentDetailEditOperation THEN { okDetailField(); }

DESIGN dataTerminalInternal {
    terminalDocumentDetailEditOperation {
        NEW terminalDocumentDetailEditButtons {
            align = STRETCH;
            horizontal = TRUE;
            class = 'dt-edit-buttons';
            MOVE PROPERTY (nextDetailField) { fill = 1; }
        }
    }
}

// Режим ADD: добавление строк сканированием

editPreferences () = preferences(terminalDocumentType(editedDocument()));

// Поставщик документа: аналитика вида «Организация» (terminalHandbookType, код значения - exportId + id, как
// заполняется при выборе заказа - selectNewDocumentOrder и выгрузке поставщиков на ТСД). Читается один раз при
// входе в режим ADD - на сканах не пересчитывается
documentSupplier 'Поставщик' = DATA LOCAL Stock ();

// Последняя строка товара в документе
documentDetail (TerminalDocument doc, Sku s) = GROUP LAST TerminalDocumentDetail d ORDER number(d), d
    WHERE terminalDocument(d) = doc AND sku(d) = s;

// Товар в заказе-основании документа: те же строки заказа, что добавляются при создании документа по заказу
inOrder (TerminalDocument doc, Sku s) = GROUP SUM 1 IF order(TerminalOrderDetail od) = terminalOrder(doc) AND sku(od) = s
    AND forNewDocument(od, terminalDocumentType(doc));
orderQuantity (TerminalDocument doc, Sku s) = GROUP SUM orderQuantity(TerminalOrderDetail od) IF order(od) = terminalOrder(doc)
    AND sku(od) = s AND forNewDocument(od, terminalDocumentType(doc));

// Ошибка скана - сообщение под полем штрихкода (не модальное окно: лишнее касание при потоковом сканировании) и звук
addError (STRING title, STRING barcode) {
    addMessage() <- '<div class="dt-add-message error"><div class=title>' + title + '</div><div class=barcode>'
        + barcode + '</div></div>';
    playError();
    focusAddBarcode();
}

addedDetail = DATA LOCAL TerminalDocumentDetail ();

// Заполнение полей ввода строки из разобранного штрихкода (BarcodeParser: parsedBarcode по группам BarcodeGroup).
// Вызывается при скане и ручном вводе штрихкода в режиме ADD, когда строка товара уже загружена в поля ввода
// (editedDetail, edit*) и количество (в т.ч. из штрихкода) подставлено - реализации могут его переопределить.
// barcode - введенный штрихкод целиком. В строку при сохранении пишутся только запрашиваемые поля. Пример реализации
// в другой логике (группы штрихкода - EXTEND CLASS BarcodeGroup, номера групп - в форме «Парсеры штрихкодов»):
//   fillEditFromBarcode (STRING barcode) + {
//       IF parsedBarcode(barcode, BarcodeGroup.extraQuantity) THEN
//           editExtraQuantity() <- NUMERIC[14,3](parsedBarcode(barcode, BarcodeGroup.extraQuantity));
//       IF parsedBarcode(barcode, BarcodeGroup.date1) THEN
//           editDate1() <- toDateFormat(parsedBarcode(barcode, BarcodeGroup.date1), 'YYMMDD');
//   }
fillEditFromBarcode ABSTRACT LIST (STRING);

// Скан или ручной ввод штрихкода в режиме ADD. Идет ввод полей товара - сначала сохраняется его строка (как по OK;
// при ошибке в полях скан отбрасывается). Штрихкод разбирается парсерами штрихкодов (BarcodeParser): товар ищется
// и в строку пишется по штрихкоду упаковки (packBarcode). Документ по заказу: строка товара из заказа; товар вне
// заказа - запрет (banItemOutsideOrder) или как без заказа; новая строка вне ассортимента поставщика - запрет
// (controlSupplierAssortment) или подтверждение (allowOutsideSupplierAssortment). Без заказа: при группировке по товару
// (groupItems) - уже отсканированная строка товара, иначе новая строка - только при allowNewItem; новая строка сразу
// добавляется в документ, затем вводятся ее поля.
// Количество: есть в штрихкоде - новая строка с ним, найденная строка - + оно. Иначе строка заказа без количества -
// по заказу (quantityFromOrder), найденная строка - +1, новая - 1 (при zeroQuantityDefault - пустое поле).
// Остальные поля из штрихкода - fillEditFromBarcode
processAddBarcode (STRING barcode) {
    addMessage() <- NULL;
    IF editedDetail() THEN {
        editSaved() <- NULL;
        okDetailField();
        IF NOT editSaved() THEN RETURN;
        addMessage() <- NULL;
    }
    FOR TerminalDocument doc = editedDocument() DO {
        FOR Sku s = skuBarcode(STRING[15](packBarcode(barcode))) DO {
            IF terminalOrder(doc) AND NOT inOrder(doc, s) AND banItemOutsideOrder(editPreferences()) THEN {
                addError('Товара нет в заказе', barcode);
                RETURN;
            }
            IF inOrder(doc, s) OR groupItems(editPreferences()) THEN
                FOR TerminalDocumentDetail d = documentDetail(doc, s) DO {
                    loadEditedDetail(d);
                    editQuantity() <- IF hasParsedQuantity(barcode) THEN quantity(d) (+) parsedQuantity(barcode)
                        ELSE (IF inOrder(doc, s) AND quantityFromOrder(editPreferences()) AND NOT (quantity(d) > 0)
                            THEN orderQuantity(doc, s)
                            ELSE quantity(d) (+) 1);
                    fillEditFromBarcode(barcode);
                    focusCurrentField();
                    RETURN;
                }
            // Контроль ассортимента поставщика (controlSupplierAssortment): поставщик - аналитика «Организация»
            // документа, товар в ассортименте - есть цена в прайс-листе поставщика (price по priceListTypeTerminal,
            // TerminalHandler). Вне ассортимента: запрет или подтверждение (allowOutsideSupplierAssortment)
            IF controlSupplierAssortment(editPreferences()) AND documentSupplier()
                    AND NOT price(s, stock(doc), documentSupplier()) THEN {
                IF NOT allowOutsideSupplierAssortment(editPreferences()) THEN {
                    addError('Товар вне ассортимента поставщика', barcode);
                    RETURN;
                }
                askYesNo(CONCAT '<br>', 'Товар вне ассортимента поставщика', '<b>' + name(s) + '</b>');
                IF NOT askedYesNo() THEN {
                    focusAddBarcode();
                    RETURN;
                }
            }
            IF NOT allowNewItem(editPreferences()) THEN {
                addError('Добавление нового товара запрещено', barcode);
                RETURN;
            }
            addedDetail() <- NULL;
            NEWSESSION NESTED (addedDetail) {
                NEW d = TerminalDocumentDetail {
                    terminalDocument(d) <- doc;
                    number(d) <- (GROUP MAX number(TerminalDocumentDetail x) IF terminalDocument(x) = doc) (+) 1;
                    barcode(d) <- STRING[30](packBarcode(barcode));
                    sku(d) <- s;
                    price(d) <- OVERRIDE (GROUP MAX overPrice(TerminalOrderDetail od) IF order(od) = terminalOrder(doc)
                                              AND sku(od) = s AND forNewDocument(od, terminalDocumentType(doc))),
                                         currentPriceInTerminal(s, stock(doc));
                    quantity(d) <- IF hasParsedQuantity(barcode) THEN parsedQuantity(barcode)
                        ELSE (IF inOrder(doc, s) AND quantityFromOrder(preferences(terminalDocumentType(doc)))
                            THEN orderQuantity(doc, s)
                            ELSE (1 IF NOT zeroQuantityDefault(preferences(terminalDocumentType(doc)))));
                    dateTimeScan(d) <- currentDateTime();
                    APPLY;
                    // успешный APPLY очищает локальные свойства сессии, поэтому строка запоминается после него
                    IF NOT canceled() THEN
                        addedDetail() <- d;
                }
            }
            FOR TerminalDocumentDetail d = addedDetail() DO {
                loadEditedDetail(d);
                fillEditFromBarcode(barcode);
                focusCurrentField();
            }
        } ELSE
            addError('Товар не найден', barcode);
    }
}

// Скан в режиме PRICE_CHECK: товар - по штрихкоду упаковки (парсеры штрихкодов, BarcodeParser), его карточка - в шапке
// экрана. Товар не найден - то же сообщение под полем штрихкода и звук, что в режиме ADD
processPriceCheckBarcode (STRING barcode) {
    IF NOT priceCheckStock() THEN {
        message('<em>У сотрудника не задан основной склад</em>');
        RETURN;
    }
    addMessage() <- NULL;
    priceCheckBarcode() <- STRING[30](packBarcode(barcode));
    priceCheckSku() <- skuBarcode(STRING[15](packBarcode(barcode)));
    IF NOT priceCheckSku() THEN
        addError('Товар не найден', barcode);
}

// Скан по режиму: ADD - строка документа, PRICE_CHECK - карточка товара
processScannedBarcode (STRING barcode) {
    IF screenMode() = TerminalDetailScreenMode.priceCheck THEN {
        processPriceCheckBarcode(barcode);
        focusAddBarcode();
    } ELSE
        processAddBarcode(barcode);
}

// Поле штрихкода (режимы ADD и PRICE_CHECK): аппаратный сканер слушается, пока поле видно, и во время ввода полей строки
// (inputBarcodeScan, AndroidClient.js). Набранный вручную текст приходит по мере ввода (addBarcode); скан и Enter
// в поле - с завершающим '\n', как в defReadBarcode. Кнопка «↵» справа - то же, что Enter
// Подписи нет - подсказка внутри поля (placeholder в inputBarcodeScan)
addBarcode '' = DATA LOCAL STRING ();

enterAddBarcode '↵' () {
    IF NOT addBarcode() > '' THEN {
        focusAddBarcode();
        RETURN;
    }
    FOR STRING raw = addBarcode() DO {
        // поле - пустое, к следующему скану
        addBarcode() <- NULL;
        processScannedBarcode(OVERRIDE translateBarcode(raw), raw);
    }
}

EXTEND FORM dataTerminalInternal
    PROPERTIES dtAddBarcode = addBarcode() CUSTOM 'inputBarcodeScan' SHOWIF scanMode() ON CHANGE {
        INPUT s = STRING DO {
            IF wordCount(s, '\n') > 1 THEN {
                addBarcode() <- NULL;
                processScannedBarcode(OVERRIDE translateBarcode(getWord(s, '\n', 1)), getWord(s, '\n', 1));
            } ELSE
                addBarcode() <- s;
        }
    }
    PROPERTIES enterAddBarcode() SHOWIF scanMode()
    PROPERTIES READONLY dtAddMessage = addMessage() CUSTOM 'htmlText' SHOWIF addMessage()
;

DESIGN dataTerminalInternal {
    terminalDocumentDetailEditOperation {
        // Поле и кнопка «↵» справа в одной строке (сетка, dataTerminalDocumentDetailEdit.css)
        NEW terminalDocumentDetailAddBarcode BEFORE PROPERTY (terminalDocumentDetailEditHeader) {
            align = STRETCH;
            class = 'input-container dt-add-barcode';
            MOVE PROPERTY (dtAddBarcode) {
                captionVertical = TRUE;
                class = 'input-single';
                captionClass = 'input-single-caption';
                valueClass = 'input-single-value';
            }
            MOVE PROPERTY (enterAddBarcode()) {
                focusable = FALSE;
                class = 'custom-button enterAddBarcode ok input-right';
            }
        }
        MOVE PROPERTY (dtAddMessage) BEFORE PROPERTY (terminalDocumentDetailEditHeader) {
            focusable = FALSE;
            align = STRETCH;
        }
    }
}

focusAddBarcode () + {
    ACTIVATE PROPERTY dataTerminalInternal.dtAddBarcode;
}

// «Назад» (Esc, стрелка в шапке) в режиме ADD подтверждает ввод строки: введенное сохраняется (как по OK),
// при ошибке в полях экран остается на месте. В EDIT (и будущем REPLACE) - возврат к строкам без сохранения
beforePrevMenuItem (MenuItem i) + WHEN i = MenuItem.terminalDocumentDetailEditOperation AND editedDetail()
        AND screenMode() = TerminalDetailScreenMode.add THEN {
    editSaved() <- NULL;
    okDetailField();
    IF NOT editSaved() THEN
        consumedPrevMenuItem() <- TRUE;
}

// Кнопка «Добавить» на экране строк документа: экран строки в режиме ADD (для закрытого документа скрыта)
addTerminalDocumentDetail () {
    screenMode() <- TerminalDetailScreenMode.add;
    editedDocument() <- selectedTerminalDocument();
    documentSupplier() <- GROUP MAX Stock st
        IF exportId() + id(st) = handbook(editedDocument(), terminalHandbookType());
    addMessage() <- NULL;
    clearEditedDetail();
    toMenuItem(MenuItem.terminalDocumentDetailEditOperation);
    focusAddBarcode();
}
@defButtonCustom(addTerminalDocumentDetail, 'Добавить', dataTerminalInternal, 'F3', ok);
hideAddTerminalDocumentDetailDataTerminalInternal() += NOT isOpened(selectedTerminalDocument());

DESIGN dataTerminalInternal {
    terminalDocumentDetailsOperation {
        MOVE PROPERTY (addTerminalDocumentDetail);
    }
}

// Пункт «Проверка цен» главного меню: экран в режиме PRICE_CHECK, документа нет
doMenuItemPriceCheck () + {
    screenMode() <- TerminalDetailScreenMode.priceCheck;
    editedDocument() <- NULL;
    addMessage() <- NULL;
    clearEditedDetail();
    priceCheckSku() <- NULL;
    priceCheckBarcode() <- NULL;
    toMenuItem(MenuItem.terminalDocumentDetailEditOperation);
    focusAddBarcode();
}

// «Назад» в PRICE_CHECK - на экран, с которого пришли (главный), а не к строкам документа (up экрана - строки документа,
// up хранится и от режима не зависит): как ветка без up в toPrevMenuItem
beforePrevMenuItem (MenuItem i) + WHEN i = MenuItem.terminalDocumentDetailEditOperation
        AND screenMode() = TerminalDetailScreenMode.priceCheck THEN {
    toMenuItem(top());
    pop();
    pop();
    CANCEL;
    // после CANCEL: он сбрасывает и этот признак
    consumedPrevMenuItem() <- TRUE;
}
