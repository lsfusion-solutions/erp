MODULE DataTerminalMenu;

REQUIRE DataTerminalDialogForms;

NAMESPACE DataTerminal;

@defSubMenu(actions, main, '');

initMenuItem() += MenuItem.main;

DESIGN dataTerminalInternal {
    actions {
        NEW lineAction1 { align = STRETCH; }
        NEW lineAction2 { align = STRETCH; }
        NEW lineAction3 { align = STRETCH; }
        NEW lineAction4 { align = STRETCH; }
        NEW lineAction5 { align = STRETCH; }
        NEW lineAction6 { align = STRETCH; }
        NEW lineAction7 { align = STRETCH; }
        NEW lineAction8 { align = STRETCH; }
        NEW lineAction9 { align = STRETCH; }
        NEW lineAction0 { align = STRETCH; }
        NEW lineAction10 { align = STRETCH; }
    }
}

@addMenuItem(logout, '(Esc) Выйти', 'ESCAPE', lineAction10);

doMenuItemLogout() + {
    askYesNo('Выйти?');
    IF askedYesNo() THEN {
        restart[]();
    }
}
