MODULE DataTerminalInternal;

REQUIRE DataTerminal, Security, DataTerminalInternalMeta;

NAMESPACE DataTerminal;

isDataTerminal = ABSTRACT VALUE BOOLEAN (Connection);
isDataTerminal() = isDataTerminal(currentConnection());

beforeDataTerminalStart ABSTRACT LIST ();

// Сброс прочитанных на ТСД значений (defReadedField) при выходе в начальное меню
clearReadedFields ABSTRACT LIST (Employee);

// Действие после обработки отсканированного штрихкода (defReadBarcode)
afterReadBarcode ABSTRACT LIST ();

// Иерархия меню ТСД
CLASS MenuItem 'Элемент меню' { tab }
TABLE menuItem (MenuItem);

// Стек переходов по меню
stack = DATA LOCAL NESTED MenuItem (INTEGER);
topIndex 'Вершина' () = GROUP MAX INTEGER i IF stack(i);
top () = stack(topIndex());

push (MenuItem i) {
    stack(topIndex() (+) 1) <- i;
}

pop () {
    stack(topIndex()) <- NULL;
}

clean () {
    stack(INTEGER i) <- NULL;
}

name = DATA STRING (MenuItem);
onStarted() + {
    name(MenuItem i) <- STRING(caption(i)) IF i AS MenuItem != MenuItem.tab AND caption(i) != '';
}

parent = ABSTRACT CASE MenuItem (MenuItem);
up = ABSTRACT CASE MenuItem (MenuItem) MATERIALIZED;

activeTab = ABSTRACT CASE BOOLEAN (MenuItem);

level 'Уровень элемента меню' (MenuItem child, MenuItem parent) =
    RECURSION 1 IF child IS MenuItem AND parent = child STEP 2 IF parent = parent($parent) MATERIALIZED INDEXED;

onStarted() + {
    RECALCULATE level(MenuItem child, MenuItem parent);
    RECALCULATE up(MenuItem i);
}

// Пункт меню на экране: активны вкладки его и всех родителей. Вложенная вкладка неактивной вкладки
// остается выбранной (ACTIVE TAB), например «Проверка цен» внутри «Операции» при открытии формы
onScreen (MenuItem i) = i IS MenuItem AND NOT (GROUP SUM 1 IF level(i, MenuItem p) AND p != MenuItem.tab AND NOT activeTab(p));

lastMenuItem = DATA LOCAL NESTED MenuItem();

activateMenuItem ABSTRACT CASE (MenuItem);

toMenuItem (MenuItem i) {
    IF lastMenuItem() = i THEN RETURN;
    push(lastMenuItem());
    FOR level(i, MenuItem parent) DO activateMenuItem(parent);
} WAIT;

beforePrevMenuItem ABSTRACT CASE (MenuItem);
toPrevMenuItem 'Назад к предыдущему пункту меню' () {
    beforePrevMenuItem(lastMenuItem());
    IF up(lastMenuItem()) THEN {
        WHILE top() != up(lastMenuItem()) DO pop();
        toMenuItem(up(lastMenuItem()));
    } ELSE {
        toMenuItem(top());
    }
    pop();
    pop();
    CANCEL;
} WAIT;

initMenuItem = ABSTRACT MenuItem();

toInitMenuItem () {
    clearReadedFields(currentEmployee());
    toMenuItem(initMenuItem());
    clean();
} WAIT;

path (MenuItem m) =
    GROUP CONCAT STRING(name(MenuItem i)) IF level(m, i), ' / ' ORDER -level(m, i), i;

// Шапка как Toolbar в Android: заголовок - название экрана (ближайший пункт меню с названием),
// подзаголовок - объект экрана (objectId, например номер документа), без него - сотрудник
title (MenuItem m) = GROUP LAST name(MenuItem i) ORDER -level(m, i), i WHERE level(m, i) AND name(i);
overHeaderTitle = ABSTRACT STRING ();
headerTitle () = OVERRIDE overHeaderTitle(), title(lastMenuItem());

objectId = ABSTRACT STRING ();
headerSubtitle () = OVERRIDE objectId(), name(currentEmployee());

// Быстрый поиск в шапке: справа лупа, по нажатию вместо текста шапки - поле ввода и ✕ (Esc в поле - как ✕).
// Включается по экрану (пункту меню lastMenuItem):
//   showHeaderSearch(MenuItem i) += WHEN i = MenuItem.<экран> THEN TRUE;
//   headerSearchPlaceholder(MenuItem i) += WHEN i = MenuItem.<экран> THEN 'Номер документа'; // по умолчанию 'Поиск'
// headerSearch() - NULL или строка от 3 символов (поле отправляет ее через 0,5 с после ввода), экран отбирает по ней:
//   FILTERS NOT headerSearch() OR isISubstring(<поле>(x), headerSearch())
// При смене экрана поиск сбрасывается
showHeaderSearch = ABSTRACT CASE BOOLEAN (MenuItem);
headerSearchPlaceholder = ABSTRACT CASE STRING (MenuItem);
placeholderHeaderSearch () = OVERRIDE headerSearchPlaceholder(lastMenuItem()), 'Поиск';

headerSearchActive = DATA LOCAL BOOLEAN ();
headerSearch 'Поиск' = DATA LOCAL STRING[100] ();

WHEN LOCAL CHANGED(lastMenuItem()) DO {
    headerSearch() <- NULL;
    headerSearchActive() <- NULL;
}

// Подсказку поля поиска рендерер headerSearchInput берет из атрибута data-search-placeholder
topInfoPanel '' () = CONCAT '', '<div class=topInfoPanel data-search-placeholder="', placeholderHeaderSearch(), '">',
                                                '<div class=title>', headerTitle(), '</div>',
                                                '<div class=subtitle>', headerSubtitle(), '</div>',
                                            '</div>';

// Кнопки заголовка ТСД: слева стрелка «Назад», справа меню «⋮». Настраиваются по экрану (пункту меню lastMenuItem).
// «Назад» показывается на всех экранах, кроме начального (initMenuItem и вложенных в него), скрыть на экране:
//   hideHeaderBack(MenuItem i) += WHEN i = MenuItem.<экран> THEN TRUE;
// Меню показывается только на экранах, где оно задано:
//   showHeaderMenu(MenuItem i) += WHEN i = MenuItem.<экран> THEN TRUE;
//   headerMenu(MenuItem i) + WHEN i = MenuItem.<экран> THEN { ... }
hideHeaderBack = ABSTRACT CASE BOOLEAN (MenuItem);
showHeaderBack () = lastMenuItem() AND NOT level(lastMenuItem(), initMenuItem()) AND NOT hideHeaderBack(lastMenuItem());

showHeaderMenu = ABSTRACT CASE BOOLEAN (MenuItem);
headerMenu ABSTRACT CASE (MenuItem);

headerBackButton '' () {
    toPrevMenuItem();
}
headerMenuButton '' () {
    headerMenu(lastMenuItem());
}

headerSearchButton '' () {
    headerSearchActive() <- TRUE;
}
headerSearchClose '' () {
    headerSearch() <- NULL;
    headerSearchActive() <- NULL;
}

FORM dataTerminalInternal 'Терминал сбора данных'
    EVENTS ON QUERYCLOSE {  }
    PROPERTIES READONLY topInfoPanel() CUSTOM 'htmlText'
    PROPERTIES headerBackButton() SHOWIF showHeaderBack(),
               headerSearchField '' = headerSearch() CUSTOM 'headerSearchInput' SHOWIF headerSearchActive(),
               headerSearchButton() SHOWIF showHeaderSearch(lastMenuItem()) AND NOT headerSearchActive(),
               headerSearchClose() SHOWIF headerSearchActive(),
               headerMenuButton() SHOWIF showHeaderMenu(lastMenuItem()) AND NOT headerSearchActive()
;

// Действие обновляет форму ТСД для пользователей
needRefresh = ABSTRACT BOOLEAN ();
formRefresh (Connection c) {
    IF c THEN {
        NEWTHREAD {
            ACTIVE FORM dataTerminalInternal;
            IF isActiveForm() AND needRefresh() THEN {
                formRefresh();
            }
        } CONNECTION c;
    }
}

formRefresh (Employee e) {
    FOR connectionStatus(Connection c) = ConnectionStatus.connectedConnection AND user(c) = e DO {
        formRefresh(c);
    }
}

DESIGN dataTerminalInternal {
    REMOVE TOOLBARBOX;
    NEW topInfoPanel {
        align = STRETCH;
        horizontal = TRUE;
        class = 'dt-header';
        MOVE PROPERTY (headerBackButton()) {
            focusable = FALSE;
            align = STRETCH;
            class = 'dt-header-button dt-header-back';
        }
        // в режиме поиска текст шапки скрыт классом, а не SHOWIF: из его html поле берет подсказку
        MOVE PROPERTY (topInfoPanel()) {
            focusable = FALSE;
            align = STRETCH;
            fill = 1;
            class = 'dt-header-hidden' IF headerSearchActive();
        }
        MOVE PROPERTY (headerSearchField) {
            align = STRETCH;
            fill = 1;
            class = 'dt-header-search';
        }
        MOVE PROPERTY (headerSearchButton()) {
            focusable = FALSE;
            align = STRETCH;
            class = 'dt-header-button dt-header-search-open';
        }
        MOVE PROPERTY (headerSearchClose()) {
            focusable = FALSE;
            align = STRETCH;
            class = 'dt-header-button dt-header-search-close';
        }
        MOVE PROPERTY (headerMenuButton()) {
            focusable = FALSE;
            align = STRETCH;
            class = 'dt-header-button dt-header-menu';
        }
    }
    NEW topMenu {
        margin = 0;
        grid = TRUE;
        lines = 4;
        align = STRETCH;
    }
    NEW underTopMenu {
        align = STRETCH;
    }

    NEW tab {
        align = STRETCH;
        fill = 1;
    }
}
@defDtTab(main, 'Главная', 'F1', topMenu);

@defDtTab(operation, 'Операция', 'F2', topMenu);

toPrevMenuItemOperation() {
    toPrevMenuItem();
}
@defButtonCustom(toPrevMenuItemOperation, '(Esc) Назад', dataTerminalInternal, 'ESCAPE', cancel);

DESIGN dataTerminalInternal {
    operationTab {
        MOVE PROPERTY (toPrevMenuItemOperation);
    }
    // Кнопки вкладок (F1) Главная / (F2) Операция не показываем: навигация - через меню и (Esc) Назад.
    // Сами вкладки main / operation (@defDtTab) остаются - на них построены меню и все операции ТСД
    REMOVE topMenu;
}

// CUSTOM-рендереры ТСД грузятся при инициализации страницы: INTERNAL CLIENT загружает
// скрипт асинхронно, и форма, показанная сразу после него, рендерера еще не видит
onWebClientInit() + {
    onWebClientInit('dataTerminalHtmlText.js') <- 11;
    onWebClientInit('inputDT.js') <- 12;
    onWebClientInit('inputDecimal.js') <- 13;
    onWebClientInit('dataTerminalHeaderSearch.js') <- 14;
}

beforeWebClientStarted ABSTRACT LIST ();
BEFORE onWebClientStarted() DO {
    beforeWebClientStarted();
    IF isDataTerminal() AND currentUser() IS Employee THEN {
        // Стили ТСД рассчитаны на светлую тему: в темной фоны остаются светлыми, а текст берет светлые цвета темы.
        // Тема меняется только на клиенте, настройка пользователя не меняется
        changeColorThemeAction(ColorTheme.light);
        beforeDataTerminalStart();
        INTERNAL CLIENT 'data-terminal.css';
        INTERNAL CLIENT 'dropEscape';
        SHOW dataTerminalInternal NOWAIT;
        maximizeForm();
    }
}

// Общие действия по кнопкам в модальных диалогах
ok() { formOk(); }

close() { formClose(); }

// Активные ТСД
EXTEND CLASS Employee : ActivePDT;

lastActivity (Employee e) += lastActivity(lastConnection(e));
pdt (Employee e) += STRING(Authentication.hostname(computer(lastConnection(e))));
user (Employee e) += user(lastConnection(e));
dateTime (Employee e) += connectTime(lastConnection(e));
online (Employee e) += hasConnectedConnections(e) > 0;
inactive (Employee e) += e IS Employee AND NOT lastConnection(e);
